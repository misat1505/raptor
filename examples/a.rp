struct User derives Debug {
    i64 id,
    str name

    fn get_id(self): i64 {
        return self.id;
    }
};

extend User {
    fn get_name(self): str {
        return self.name;
    }
};

extend User {
    fn default(): User {
        return User { id: 2137, name: "Elon" };
    }
};

extend char {
    fn is_digit(self): bool {
        return self as u8 >= '0' as u8 && self as u8 <= '9' as u8;
    }
};

extend char {
    fn is_upper(self): bool {
        return self as u8 >= 'A' as u8 && self as u8 <= 'Z' as u8;
    }
};

extend i64[] {
    fn sum(self): i64 {
        let result = 0;

        for (let i = 0; i < self.size(); i += 1) {
            result += self[i];
        }

        return result;
    }
};

let user = User { id: 1, name: "Bob" };
println(user.get_id() as str);
println(user.get_name());
println(User.default().debug());

let c = '0';
println(c.is_digit() as str);

let d = 'A';
println(d.is_upper() as str);

let numbers = [1, 2, 3];
println(numbers.sum() as str);
