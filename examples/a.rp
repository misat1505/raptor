fn split_by_delim(str text, char delim): str[] {
    str[] segments = [];
    str word = "";

    for (i64 i = 0; i < str_len(text); i += 1) {
        char c = text[i];
        if (c == delim) {
            vector_push(&segments, word);
            word = "";
        } else {
            word += c;
        }
    }

    vector_push(&segments, word);

    return segments;
}

str[] segments = split_by_delim("Users/misat/Desktop/studia/sem6/tkom/projekt", '/');
println(vector_stringify(segments));

str[] text = ["hello world"];
text[0][0] = 'a';
println(vector_stringify(text));

fn capitalize(char c): char {
    u8 ascii = c as u8;
    ascii -= 32 as u8;
    return ascii as char;
}

println(capitalize('a') as str);
