fn get_first(str[] arr): str {
  str name = arr[0];
  arr[0] = "Elon";
  return name;
}

str[][] names = [["Bob"], ["Fred"], ["George"]];

for (i64 i = 0; i < 3; i = i + 1) {
  vector_push(&names, ["1"]);
}

str[] a = names[0];
vector_push(&a, "2");

for (i64 i = 0; i < vector_size(&names); i = i + 1) {
  println(names[i][0]);
}

println(vector_stringify(names));

names[0][0] = "Elon";
println(vector_stringify(names));