enum Status derives Debug, Clone, Json {
    Active,
    OutOfStock

    fn foo(self): i64 {
        return 1;
    }
};

struct Product derives Debug, Clone, Json {
    i64 id,
    str name,
    i64 price,
    Status status

    fn get_total_price(self, &i64 quantity): i64 {
        return self.price * quantity;
    }

    fn new(i64 id, str name, i64 price): Product {
        return Product {
            id: id,
            name: name,
            price: price
        };
    }

    fn do_nothing(self): void {}
};

let product = Product {
    id: 1,
    name: "Bananas",
    price: 433,
    status: Status::OutOfStock
};

println(product.get_total_price(&5) as str);
println(product.status.foo() as str);
