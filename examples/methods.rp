enum Status {
    Active,
    OutOfStock

    fn foo(self, &Status s): i64 {
        return 1;
    }
};

struct Product {
    i64 id,
    str name,
    i64 price,
    Status status

    fn get_total_price(self, &i64 quantity): i64 {
        return self.price * quantity;
    }

    fn new(i64 id, str name, i64 price): Product {
        return Product {
            id: id,
            name: name,
            price: price,
            status: Status::Active
        };
    }

    fn do_nothing(self): void {}
};

let product = Product {
    id: 1,
    name: "Bananas",
    price: 433,
    status: Status::OutOfStock
};

println(product.get_total_price(&5) as str);
println(product.status.foo(&Status::OutOfStock) as str);
product = Product.new(2, "Potato", 3516);
let a = product.do_nothing();
