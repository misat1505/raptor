fn is_prime(i64 x): bool {
    if (x < 2) {
        return false;
    }

    for (let i = 2; i < x; i += 1) {
        if (x % i == 0) {
            return false;
        }
    }

    return true;
}


for (let x = 0; x < 1000; x = x + 1) {
    if (is_prime(x)) {
        println(x as str + " is a prime.");
    }
}
