import "./ast.rp";


struct JsonSerializer {
    str serialized,
    i64 indentation

    fn new(): JsonSerializer {
        return JsonSerializer { serialized: "", indentation: 0 };
    }

    fn process(self, &Node node): void {
        match (node.kind) {
            NodeKind::KeyValue(kv_node) {
                self.process_kv_node(&kv_node);
            },
            NodeKind::Array(arr_node) {
                self.process_arr_node(&arr_node);
            },
            NodeKind::Literal(literal_node) {
                self.process_literal_node(&literal_node);
            }
        }
    }

    fn process_kv_node(self, &KeyValueNode node): void {
        self.serialized += "{\n";
        self.indentation += 1;

        for (let i = 0; i < node.keys.size(); i += 1) {
            self.serialized += self.get_indentation();
            self.serialized += "\"" + node.keys[i] + "\": ";
            self.process(&node.nodes[i]);
            if (i != node.keys.size() - 1) {
                self.serialized += ",";
            }
            self.serialized += '\n';
        }

        self.indentation -= 1;
        self.serialized += self.get_indentation() + "}";
    }

    fn process_arr_node(self, &Node[] nodes): void {
        self.serialized += "[\n";
        self.indentation += 1;

        for (let i = 0; i < nodes.size(); i += 1) {
            self.serialized += self.get_indentation();
            self.process(&nodes[i]);
            if (i != nodes.size() - 1) {
                self.serialized += ",";
            }
            self.serialized += '\n';
        }

        self.indentation -= 1;
        self.serialized += self.get_indentation() + "]";
    }

    fn process_literal_node(self, &NodeLiteral node): void {
        match (node) {
            NodeLiteral::Number(num) {
                self.serialized += num as str;
            },
            NodeLiteral::Str(text) {
                self.serialized += "\"" + text + "\"";
            }
        }
    }

    fn get_indentation(self): str {
        let indentation = "";
        for (let i = 0; i < self.indentation; i += 1) {
            indentation += "  ";
        }
        return indentation;
    }
};
