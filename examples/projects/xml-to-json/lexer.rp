import "./tokens.rp";
import "./source.rp";
import "../../../stdlib/string.rp";


struct Lexer {
    Source source,
    i64 offset,
    Token current_token,
    Token next_token

    fn new(str source): Lexer {
        let src = Source.new(source);

        let init_token = Token {
            kind: TokenKind::STX,
            value: OptionTokenValue::None,
            position: src.position.clone()
        };

        let init_token2 = Token {
            kind: TokenKind::STX,
            value: OptionTokenValue::None,
            position: src.position.clone()
        };

        let lexer = Lexer {
            offset: 0,
            source: src,
            current_token: init_token,
            next_token: init_token2
        };

        lexer.generate_next_token();
        lexer.next_token();

        return lexer;
    }

    fn advance_whitespace(self): void {
        while (true) {
            if (self.source.get_current_char() matches OptionChar::Some(ch)) {
                if (ch == ' ' || ch == '\n' || ch == '\r') {
                    self.source.consume_char();
                } else {
                    return;
                }
            } else {
                break;
            }
        }
    }

    fn next_token(self): Token {
        self.current_token = self.next_token;
        self.generate_next_token();

        return self.current_token;
    }

    fn generate_next_token(self): void {
        self.advance_whitespace();

        if (self.try_generating_sign() matches OptionToken::Some(token)) {
            self.next_token = token;
            return;
        } else if (self.try_generating_string() matches OptionToken::Some(token)) {
            self.next_token = token;
            return;
        } else if (self.try_generating_number() matches OptionToken::Some(token)) {
            self.next_token = token;
            return;
        }

        self.next_token = Token {
            kind: TokenKind::ETX,
            value: OptionTokenValue::None,
            position: self.source.position.clone()
        };
    }

    fn try_generating_number(self): OptionToken {
        match (self.source.get_current_char()) {
            OptionChar::None {
                return OptionToken::None;
            },
            OptionChar::Some(ch) {
                if (!char_is_digit(ch)) {
                    return OptionToken::None;
                }
            }
        }

        let start_position = self.source.position.clone();
        let number = 0;

        while (true) {
            if (self.source.get_current_char() matches OptionChar::Some(ch)) {
                if (!char_is_digit(ch)) {
                    break;
                }

                if (number == 0) {
                    number = char_to_digit(ch);
                } else {
                    number = number * 10 + char_to_digit(ch);
                }

                self.source.consume_char();
            } else {
                break;
            }
        }

        let token = Token {
            kind: TokenKind::Literal,
            value: OptionTokenValue::Some(TokenValue::Number(number)),
            position: start_position
        };

        return OptionToken::Some(token);
    }

    fn try_generating_string(self): OptionToken {
        match (self.source.get_current_char()) {
            OptionChar::None {
                return OptionToken::None;
            },
            OptionChar::Some(ch) {
                if (!char_is_letter(ch)) {
                    return OptionToken::None;
                }
            }
        }

        let start_position = self.source.position.clone();
        let chars = ['<', '>', '/'];
        let text = "";

        while (true) {
            if (self.source.get_current_char() matches OptionChar::Some(ch)) {
                let break_at_the_end = false;

                for (let i = 0; i < vector_size(&chars); i += 1) {
                    if (ch == chars[i]) {
                        break_at_the_end = true;
                    }
                }

                if (break_at_the_end) {
                    break;
                }

                self.source.consume_char();
                text += ch;
            } else {
                break;
            }
        }

        let token = Token {
            kind: TokenKind::Literal,
            value: OptionTokenValue::Some(TokenValue::Str(str_trim_right(text))),
            position: start_position
        };

        return OptionToken::Some(token);
    }

    fn try_generating_sign(self): OptionToken {
        let chars = ['<', '>', '/'];
        let token_kinds = [TokenKind::Less, TokenKind::Greater, TokenKind::Slash];

        match (self.source.get_current_char()) {
            OptionChar::None {
                return OptionToken::None;
            },
            OptionChar::Some(ch) {
                for (let i = 0; i < vector_size(&chars); i += 1) {
                    if (ch == chars[i]) {
                        let position = self.source.position.clone();

                        self.source.consume_char();

                        let token_kind = token_kinds[i];

                        return OptionToken::Some(Token {
                            kind: token_kind,
                            value: OptionTokenValue::None,
                            position
                        });
                    }
                }

                return OptionToken::None;
            }
        }
    }
};
