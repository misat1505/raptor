import "./lexer.rp";
import "./parser.rp";
import "./json-serializer.rp";


fn main(): void {
    let source = read_file("./examples/projects/xml-to-json/data/data1.xml");
    let lexer = Lexer.new(source);
    let parser = Parser.new(&lexer);
    let ast = parser.parse();
    let serializer = JsonSerializer.new();
    serializer.process(&ast);
    write_file("./examples/projects/xml-to-json/output/out1.json", serializer.serialized);
    let a = 5;
}


main();
