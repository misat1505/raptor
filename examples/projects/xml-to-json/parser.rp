import "./lexer.rp";
import "./ast.rp";


struct Parser {
    Lexer lexer

    fn new(&Lexer lexer): Parser {
        return Parser { lexer };
    }

    fn parse(self): Node {
        let position = self.lexer.current_token.position.clone();
        let named = self.parse_element();

        let keys: str[] = [];
        let nodes: Node[] = [];

        vector_push(&keys, named.key);
        vector_push(&nodes, named.node);

        return Node { kind: NodeKind::KeyValue(KeyValueNode { keys, nodes }), position };
    }

    fn parse_element(self): NamedNode {
        self.lexer.next_token();  # consume '<', current = tag name literal

        let key = "";

        if (self.lexer.current_token.value matches OptionTokenValue::Some(value)) {
            match (value) {
                TokenValue::Str(text) {
                    key = text;
                },
                TokenValue::Number(num) {
                    key = num as str;
                }
            }
        }

        self.lexer.next_token();  # consume tag name, current = '>'
        self.lexer.next_token();  # consume '>', current = first token of value

        let value_node = self.parse_value();

        self.lexer.next_token();  # consume '<' of closing tag
        self.lexer.next_token();  # consume '/'
        self.lexer.next_token();  # consume tag name
        self.lexer.next_token();  # consume '>'

        return NamedNode { key, node: value_node };
    }

    fn parse_value(self): Node {
        if (self.lexer.current_token.kind matches TokenKind::Literal) {
            return self.parse_literal_value();
        } else if (self.lexer.next_token.value matches OptionTokenValue::Some(value)) {
            match (value) {
                TokenValue::Number {
                    return self.parse_array_value();
                },
                TokenValue::Str {
                    return self.parse_object_value();
                }
            }
        }

        return self.parse_object_value();
    }

    fn parse_literal_value(self): Node {
        let position = self.lexer.current_token.position.clone();
        let node_literal = NodeLiteral::Number(0);

        if (self.lexer.current_token.value matches OptionTokenValue::Some(value)) {
            match (value) {
                TokenValue::Number(num) {
                    node_literal = NodeLiteral::Number(num);
                },
                TokenValue::Str(text) {
                    node_literal = NodeLiteral::Str(text);
                }
            }
        }

        self.lexer.next_token();  # consume literal, current = '<' of closing tag

        return Node { kind: NodeKind::Literal(node_literal), position };
    }

    fn parse_object_value(self): Node {
        let position = self.lexer.current_token.position.clone();

        let keys: str[] = [];
        let nodes: Node[] = [];

        while (true) {
            if (self.lexer.current_token.kind matches TokenKind::Less) {
                if (self.lexer.next_token.kind matches TokenKind::Slash) {
                    break;
                }

                let named = self.parse_element();

                vector_push(&keys, named.key);
                vector_push(&nodes, named.node);
            } else {
                break;
            }
        }

        return Node { kind: NodeKind::KeyValue(KeyValueNode { keys, nodes }), position };
    }

    fn parse_array_value(self): Node {
        let position = self.lexer.current_token.position.clone();

        let nodes: Node[] = [];

        while (true) {
            if (self.lexer.current_token.kind matches TokenKind::Less) {
                if (self.lexer.next_token.kind matches TokenKind::Slash) {
                    break;
                }

                let named = self.parse_element();
                vector_push(&nodes, named.node);
            } else {
                break;
            }
        }

        return Node { kind: NodeKind::Array(nodes), position };
    }
};

struct NamedNode {
    str key,
    Node node
};
