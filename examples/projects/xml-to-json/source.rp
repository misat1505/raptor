import "./position.rp";


enum OptionChar {
    Some(char),
    None
};

struct Source {
    str source,
    Position position

    fn new(str source): Source {
        let position = Position { line: 1, column: 1, offset: 0 };
        return Source { source, position };
    }

    fn get_current_char(self): OptionChar {
        let idx = self.position.offset;
        if (str_len(self.source) <= idx) {
            return OptionChar::None;
        }
        return OptionChar::Some(self.source[idx]);
    }

    fn consume_char(self): OptionChar {
        let idx = self.position.offset;
        if (str_len(self.source) <= idx) {
            return OptionChar::None;
        }

        let ch = self.source[idx];
        self.position.offset += 1;
        if (ch == '\n') {
            self.position.line += 1;
            self.position.column = 1;
        } else {
            self.position.column += 1;
        }
        return OptionChar::Some(ch);
    }
};
