# This is an example of using FFI in Raptor with raylib.
# 
# Note:
# Raptor currently does not support C structs in FFI, so raylib's Color
# type cannot be passed directly as a struct.
#
# Instead, Color can be represented as a packed i64 value:
#
#   a * 256^3 + b * 256^2 + g * 256 + r
#
# The four color channels are stored as consecutive 8-bit values:
#
#   0xAABBGGRR
#
# For example, a blue color:
#
#   r = 0
#   g = 0
#   b = 255
#   a = 0
#
#   clear_background(a * 256^3 + b * 256^2 + g * 256 + r)
#
# Build and run:
#
# cargo run -- --compile --run -O3 --link <path_to_libraylib.a> --link -lm --link -lX11 examples/raylib.rp

extern fn InitWindow(i64 x, i64 y, str name): void as init_window;
extern fn WindowShouldClose(): bool as window_should_close;
extern fn BeginDrawing(): void as begin_drawing;
extern fn ClearBackground(i64 color): void as clear_background;
extern fn EndDrawing(): void as end_drawing;

# aliases are optional - you can use original name
extern fn CloseWindow(): void;

init_window(800, 600, "Raylib from Raptor");

while (!window_should_close()) {
    begin_drawing();

    i64 r = 0;
    i64 g = 0;
    i64 b = 255;
    i64 a = 0;

    clear_background(a * 256 * 256 * 256 + b * 256 * 256 + g * 256 + r);

    end_drawing();
}

CloseWindow();
