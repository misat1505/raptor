# This is an example of using FFI in Raptor with raylib.
# 
# Note:
# Raptor currently does not support C structs in FFI, so raylib's Color
# type cannot be passed directly as a struct.
#
# Instead, Color can be represented as a packed i64 value:
#
#   a * 256^3 + b * 256^2 + g * 256 + r
#
# The four color channels are stored as consecutive 8-bit values:
#
#   0xAABBGGRR
#
# For example, a blue color:
#
#   r = 0
#   g = 0
#   b = 255
#   a = 0
#
#   ClearBackground(a * 256^3 + b * 256^2 + g * 256 + r)
#
# Build and run:
#
# cargo run -- --compile --run -O3 \
#   --link <path_to_libraylib.a> \
#   --link -lm \
#   --link -lX11 \
#   examples/raylib.rp

extern fn InitWindow(i64 x, i64 y, str name): void;
extern fn WindowShouldClose(): bool;
extern fn BeginDrawing(): void;
extern fn EndDrawing(): void;
extern fn CloseWindow(): void;
extern fn ClearBackground(i64 color): void;

InitWindow(800, 600, "Raylib from Raptor");

while (!WindowShouldClose()) {
    BeginDrawing();

    i64 r = 0;
    i64 g = 0;
    i64 b = 255;
    i64 a = 0;

    ClearBackground(a * 256 * 256 * 256 + b * 256 * 256 + g * 256 + r);

    EndDrawing();
}

CloseWindow();
