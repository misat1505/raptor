extern fn InitWindow(i64 x, i64 y, str name): void as init_window;
extern fn WindowShouldClose(): bool as window_should_close;
extern fn BeginDrawing(): void as begin_drawing;
extern fn ClearBackground(i64 color): void as clear_background;
extern fn EndDrawing(): void as end_drawing;
extern fn CloseWindow(): void as close_window;
extern fn SetTargetFPS(i64 fps): void as set_target_fps;
extern fn DrawRectangle(i64 x, i64 y, i64 w, i64 h, i64 color): void as draw_rectangle;
extern fn DrawText(str text, i64 x, i64 y, i64 font_size, i64 color): void as draw_text;
extern fn IsKeyPressed(i64 key): bool as is_key_pressed;


fn make_color(i64 r, i64 g, i64 b, i64 a): i64 {
    return a * 256 * 256 * 256 + b * 256 * 256 + g * 256 + r;
}

fn tcp_read_all(i64 socket): str {
    let result = "";
    while (true) {
        let chunk = tcp_read(socket);
        if (str_len(chunk) == 0) {
            break;
        }
        result += chunk;
    }
    return result;
}

fn split_by_delim(str text, char delim): str[] {
    let segments: str[] = [];
    let word = "";

    for (let i = 0; i < str_len(text); i += 1) {
        let c = text[i];
        if (c == delim) {
            vector_push(&segments, word);
            word = "";
        } else {
            word += c;
        }
    }

    vector_push(&segments, word);

    return segments;
}

fn fetch_world(str host, i64 port, i64 player_id, i64 dx, i64 dy): str {
    let sock = tcp_connect(host, port);
    println("DEBUG player " + player_id as str + " sock=" + sock as str);
    if (sock == -1) {
        return "";
    }
    let msg = "INPUT " + player_id as str + " " + dx as str + " " + dy as str;
    tcp_write(sock, msg);
    let response = tcp_read_all(sock);
    println("DEBUG player " + player_id as str + " response len=" + str_len(response) as str);
    tcp_close(sock);
    return response;
}

fn send_reset(str host, i64 port): void {
    let sock = tcp_connect(host, port);
    if (sock == -1) {
        return;
    }
    tcp_write(sock, "RESET");
    tcp_read_all(sock);
    tcp_close(sock);
}

fn parse_coords(str s): i64[] {
    let xy = split_by_delim(s, ',');
    return [xy[0] as i64, xy[1] as i64];
}

fn parse_snake(str field): i64[][] {
    let kv = split_by_delim(field, ':');
    let cells = split_by_delim(kv[1], ';');
    let result: i64[][] = [];
    for (let i = 0; i < vector_size(&cells); i += 1) {
        vector_push(&result, parse_coords(cells[i]));
    }
    return result;
}

fn draw_cell(i64 x, i64 y, i64 color): void {
    let CELL_SIZE = 20;
    draw_rectangle(x * CELL_SIZE, y * CELL_SIZE, CELL_SIZE - 1, CELL_SIZE - 1, color);
}


let PLAYER_ID = 0;

let SERVER_HOST = "localhost";
let SERVER_PORT = 8080;

let CELL_SIZE = 20;
let GRID_W = 30;
let GRID_H = 20;

let KEY_RIGHT = 262;
let KEY_LEFT = 263;
let KEY_DOWN = 264;
let KEY_UP = 265;
let KEY_ENTER = 257;

let COLOR_BG = make_color(24, 24, 24, 255);
let COLOR_SNAKE_ME = make_color(0, 200, 60, 255);
let COLOR_SNAKE_OTHER = make_color(60, 120, 220, 255);
let COLOR_APPLE = make_color(220, 30, 30, 255);
let COLOR_TEXT = make_color(255, 255, 255, 255);

init_window(
    GRID_W * CELL_SIZE,
    GRID_H * CELL_SIZE,
    "Snake Online - Player " + (PLAYER_ID + 1) as str
);
set_target_fps(15);

let dx = 1;
let dy = 0;
if (PLAYER_ID == 1) {
    dx = -1;
    dy = 0;
}

let snake0: i64[][] = [];
let snake1: i64[][] = [];
let apple = [0, 0];
let score0 = 0;
let score1 = 0;
let game_over = false;

while (!window_should_close()) {
    if (!game_over) {
        if (is_key_pressed(KEY_RIGHT) && dx != -1) {
            dx = 1;
            dy = 0;
        }
        if (is_key_pressed(KEY_LEFT) && dx != 1) {
            dx = -1;
            dy = 0;
        }
        if (is_key_pressed(KEY_UP) && dy != 1) {
            dx = 0;
            dy = -1;
        }
        if (is_key_pressed(KEY_DOWN) && dy != -1) {
            dx = 0;
            dy = 1;
        }
    }

    if (game_over && is_key_pressed(KEY_ENTER)) {
        send_reset(SERVER_HOST, SERVER_PORT);
    }

    let world = fetch_world(SERVER_HOST, SERVER_PORT, PLAYER_ID, dx, dy);

    if (str_len(world) > 0) {
        let fields = split_by_delim(world, '|');

        let go_kv = split_by_delim(fields[0], ':');
        game_over = go_kv[1] as i64 == 1;

        let s0_kv = split_by_delim(fields[1], ':');
        score0 = s0_kv[1] as i64;

        let s1_kv = split_by_delim(fields[2], ':');
        score1 = s1_kv[1] as i64;

        let apple_kv = split_by_delim(fields[3], ':');
        apple = parse_coords(apple_kv[1]);

        snake0 = parse_snake(fields[4]);
        snake1 = parse_snake(fields[5]);
    }

    begin_drawing();
    clear_background(COLOR_BG);

    for (let i = 0; i < vector_size(&snake0); i += 1) {
        let c = COLOR_SNAKE_OTHER;
        if (PLAYER_ID == 0) {
            c = COLOR_SNAKE_ME;
        }
        draw_cell(snake0[i][0], snake0[i][1], c);
    }
    for (let i = 0; i < vector_size(&snake1); i += 1) {
        let c = COLOR_SNAKE_OTHER;
        if (PLAYER_ID == 1) {
            c = COLOR_SNAKE_ME;
        }
        draw_cell(snake1[i][0], snake1[i][1], c);
    }
    draw_cell(apple[0], apple[1], COLOR_APPLE);

    draw_text("Player 1: " + score0 as str, 10, 5, 18, COLOR_TEXT);
    draw_text("Player 2: " + score1 as str, 10, 25, 18, COLOR_TEXT);

    if (game_over) {
        draw_text("GAME OVER - ENTER to play again", 20, 190, 20, COLOR_TEXT);
    }

    end_drawing();
}

close_window();
