# Snake written in Raptor, using raylib
# 
# Build and run:
# cargo run --bin raptor -- --compile --run -O3 --link <path_to_libraylib.a> --link -lm --link -lX11 examples/snake.rp

extern fn InitWindow(i64 x, i64 y, str name): void as init_window;
extern fn WindowShouldClose(): bool as window_should_close;
extern fn BeginDrawing(): void as begin_drawing;
extern fn ClearBackground(i64 color): void as clear_background;
extern fn EndDrawing(): void as end_drawing;
extern fn CloseWindow(): void;
extern fn SetTargetFPS(i64 fps): void as set_target_fps;
extern fn DrawRectangle(i64 x, i64 y, i64 w, i64 h, i64 color): void as draw_rectangle;
extern fn DrawText(str text, i64 x, i64 y, i64 font_size, i64 color): void as draw_text;
extern fn IsKeyPressed(i64 key): bool as is_key_pressed;
extern fn GetRandomValue(i64 min, i64 max): i64 as get_random_value;

fn make_color(i64 r, i64 g, i64 b, i64 a): i64 {
    return a * 256 * 256 * 256 + b * 256 * 256 + g * 256 + r;
}

i64 CELL_SIZE = 20;
i64 GRID_W = 30;
i64 GRID_H = 20;

i64 KEY_RIGHT = 262;
i64 KEY_LEFT = 263;
i64 KEY_DOWN = 264;
i64 KEY_UP = 265;
i64 KEY_ENTER = 257;

i64 COLOR_BG = make_color(24, 24, 24, 255);
i64 COLOR_SNAKE = make_color(0, 200, 60, 255);
i64 COLOR_APPLE = make_color(220, 30, 30, 255);
i64 COLOR_TEXT = make_color(255, 255, 255, 255);

fn is_on_snake(&i64[][] snake, i64 x, i64 y): bool {
    for (i64 i = 0; i < vector_size(&snake); i += 1) {
        if (snake[i][0] == x && snake[i][1] == y) return true;
    }
    return false;
}

fn spawn_apple(&i64[][] snake): i64[] {
    i64 GRID_W = 30;
    i64 GRID_H = 20;

    i64 x = get_random_value(0, GRID_W - 1);
    i64 y = get_random_value(0, GRID_H - 1);
    while (is_on_snake(&snake, x, y)) {
        x = get_random_value(0, GRID_W - 1);
        y = get_random_value(0, GRID_H - 1);
    }
    return [x, y];
}

fn draw_cell(i64 x, i64 y, i64 color): void {
    i64 CELL_SIZE = 20;
    draw_rectangle(x * CELL_SIZE, y * CELL_SIZE, CELL_SIZE - 1, CELL_SIZE - 1, color);
}

fn new_snake_start(): i64[][] {
    return [[5, 10], [4, 10], [3, 10]];
}

init_window(GRID_W * CELL_SIZE, GRID_H * CELL_SIZE, "Snake - Raptor + raylib");
set_target_fps(60);

i64[][] snake = new_snake_start();
i64 dx = 1;
i64 dy = 0;
i64[] apple = spawn_apple(&snake);
i64 tick = 0;
i64 tick_speed = 8;
bool game_over = false;

while (!window_should_close()) {

    if (game_over) {
        if (is_key_pressed(KEY_ENTER)) {
            snake = new_snake_start();
            dx = 1;
            dy = 0;
            apple = spawn_apple(&snake);
            tick = 0;
            game_over = false;
        }
    } else {
        if (is_key_pressed(KEY_RIGHT) && dx != -1) { dx = 1; dy = 0; }
        if (is_key_pressed(KEY_LEFT) && dx != 1) { dx = -1; dy = 0; }
        if (is_key_pressed(KEY_UP) && dy != 1) { dx = 0; dy = -1; }
        if (is_key_pressed(KEY_DOWN) && dy != -1) { dx = 0; dy = 1; }

        tick += 1;
        if (tick >= tick_speed) {
            tick = 0;

            i64 head_x = snake[0][0] + dx;
            i64 head_y = snake[0][1] + dy;

            bool hit_wall = head_x < 0 || head_x >= GRID_W || head_y < 0 || head_y >= GRID_H;

            bool hit_self = false;
            for (i64 i = 0; i < vector_size(&snake) - 1; i += 1) {
                if (snake[i][0] == head_x && snake[i][1] == head_y) hit_self = true;
            }

            if (hit_wall || hit_self) {
                game_over = true;
            } else {
                bool ate = (head_x == apple[0] && head_y == apple[1]);

                i64[][] new_snake = [[head_x, head_y]];
                i64 copy_len = vector_size(&snake);
                if (!ate) copy_len = copy_len - 1;

                for (i64 i = 0; i < copy_len; i += 1) {
                    vector_push(&new_snake, snake[i]);
                }

                snake = new_snake;

                if (ate) {
                    apple = spawn_apple(&snake);
                }
            }
        }
    }

    begin_drawing();
    clear_background(COLOR_BG);

    for (i64 i = 0; i < vector_size(&snake); i += 1) {
        draw_cell(snake[i][0], snake[i][1], COLOR_SNAKE);
    }
    draw_cell(apple[0], apple[1], COLOR_APPLE);

    if (game_over) {
        draw_text("GAME OVER - ENTER, aby zagrac ponownie", 20, 190, 20, COLOR_TEXT);
    }

    end_drawing();
}

CloseWindow();
