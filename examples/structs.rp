struct Hobby {
  u64 id,
  str description
};

struct Person {
  u64 id,
  str name,
  Hobby[] hobbies
};

let hobby = Hobby {
  id: 123 as u64,
  description: "Play football"
};

let person = Person {
  id: 2137 as u64,
  name: "Elon",
  hobbies: [hobby]
};

fn person_get_person(&Person person): Person {
  return person;
}

fn person_get_person2(&Person[] person): Person {
  return person[0];
}

fn person_get_person_array(&Person person): Person[] {
  return [person];
}

fn person_get_person_array2(&Person[] person): Person[] {
  return [person[0]];
}

let arr = [person];
person_get_person_array(&arr[0]);
person_get_person_array2(&arr);
