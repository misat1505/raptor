struct Post {
  u64 id,
  str description
};

struct User {
  u64 id,
  str name,
  Post[] posts
};

let post = Post {
  id: 123 as u64,
  description: "Play football"
};

let user = User {
  id: 2137 as u64,
  name: "Elon",
  posts: [post]
};

fn user_get_user(&User user): User {
  return user;
}

fn user_get_user2(&User[] user): User {
  return user[0];
}

fn user_get_user_array(&User user): User[] {
  return [user];
}

fn user_get_user_array2(&User[] user): User[] {
  return [user[0]];
}

let arr = [user];
user_get_user_array(&arr[0]);
user_get_user_array2(&arr);


extern fn ab(User u): User;

let i = ab(user);