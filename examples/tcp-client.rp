fn tcp_read_all(i64 socket): str {
    let result = "";
    while (true) {
        let chunk = tcp_read(socket);
        if (str_len(chunk) == 0) {
            break;
        }
        result += chunk;
    }
    return result;
}

fn main(): void {
    let host = "localhost";
    let port = 8080;

    let sock = tcp_connect(host, port);

    if (sock == -1) {
        println("Failed to connect to " + host + ":" + port as str);
        return;
    }

    let request = "GET / HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n";
    tcp_write(sock, request);

    let response = tcp_read_all(sock);
    tcp_close(sock);

    println("Server response:");
    println(response);
}


main();
