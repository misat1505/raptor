fn get_vector(): i64[][] {
  return [[1, 2, 3], [4, 5, 6]];
}

i64[][] vec = get_vector();
println(vector_stringify(vec));

vec = [[1]];
println(vector_stringify(vec));

str[] names = ["Aboba", "foo"];
println(vector_stringify(names));

vector_push(&names, "Elon");
println(vector_stringify(names));

