import "./position.rp";

enum NodeLiteral derives Debug {
    Str(str),
    Number(i64)
};

struct KeyValueNode derives Debug {
    str[] keys,
    Node[] nodes
};

enum NodeKind derives Debug {
    Literal(NodeLiteral),
    Array(Node[]),
    KeyValue(KeyValueNode)
};

struct Node derives Debug {
    NodeKind kind,
    Position position
};

enum OptionNode derives Debug {
    Some(Node),
    None
};
