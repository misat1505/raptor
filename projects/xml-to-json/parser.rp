import "./lexer.rp";
import "./ast.rp";

struct Parser {
    Lexer lexer
};

fn parser_new(&Lexer lexer): Parser {
    return Parser { lexer };
}

struct NamedNode {
    str key,
    Node node
};

fn parser_parse(&Parser parser): Node {
    let position = position_clone(&parser.lexer.current_token.position);
    let named = parser_parse_element(&parser);

    let keys: str[] = [];
    let nodes: Node[] = [];

    vector_push(&keys, named.key);
    vector_push(&nodes, named.node);

    return Node {
        kind: NodeKind::KeyValue(KeyValueNode { keys, nodes }),
        position
    };
}

fn parser_parse_element(&Parser parser): NamedNode {
    lexer_next_token(&parser.lexer); # consume '<', current = tag name literal

    let key = "";

    if (parser.lexer.current_token.value matches OptionTokenValue::Some(value)) {
        match (value) {
            TokenValue::Str(text) { key = text; },
            TokenValue::Number(num) { key = num as str; }
        }
    }

    lexer_next_token(&parser.lexer); # consume tag name, current = '>'
    lexer_next_token(&parser.lexer); # consume '>', current = first token of value

    let value_node = parser_parse_value(&parser);

    lexer_next_token(&parser.lexer); # consume '<' of closing tag
    lexer_next_token(&parser.lexer); # consume '/'
    lexer_next_token(&parser.lexer); # consume tag name
    lexer_next_token(&parser.lexer); # consume '>'

    return NamedNode { key, node: value_node };
}

fn parser_parse_value(&Parser parser): Node {
    if (parser.lexer.current_token.kind matches TokenKind::Literal) {
        return parser_parse_literal_value(&parser);
    } else if (parser.lexer.next_token.value matches OptionTokenValue::Some(value)) {
        match (value) {
            TokenValue::Number return parser_parse_array_value(&parser);,
            TokenValue::Str return parser_parse_object_value(&parser);
        }
    }

    return parser_parse_object_value(&parser);
}

fn parser_parse_literal_value(&Parser parser): Node {
    let position = position_clone(&parser.lexer.current_token.position);
    let node_literal = NodeLiteral::Number(0);

    if (parser.lexer.current_token.value matches OptionTokenValue::Some(value)) {
        match (value) {
            TokenValue::Number(num) { node_literal = NodeLiteral::Number(num); },
            TokenValue::Str(text) { node_literal = NodeLiteral::Str(text); }
        }
    }

    lexer_next_token(&parser.lexer); # consume literal, current = '<' of closing tag

    return Node {
        kind: NodeKind::Literal(node_literal),
        position
    };
}

fn parser_parse_object_value(&Parser parser): Node {
    let position = position_clone(&parser.lexer.current_token.position);

    let keys: str[] = [];
    let nodes: Node[] = [];

    while (parser.lexer.current_token.kind matches TokenKind::Less) {
        if (parser.lexer.next_token.kind matches TokenKind::Slash) break;

        let named = parser_parse_element(&parser);

        vector_push(&keys, named.key);
        vector_push(&nodes, named.node);
    }

    return Node {
        kind: NodeKind::KeyValue(KeyValueNode { keys, nodes }),
        position
    };
}

fn parser_parse_array_value(&Parser parser): Node {
    let position = position_clone(&parser.lexer.current_token.position);

    let nodes: Node[] = [];

    while (parser.lexer.current_token.kind matches TokenKind::Less) {
        if (parser.lexer.next_token.kind matches TokenKind::Slash) break;

        let named = parser_parse_element(&parser);
        vector_push(&nodes, named.node);
    }

    return Node {
        kind: NodeKind::Array(nodes),
        position
    };
}
