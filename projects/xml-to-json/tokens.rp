import "./position.rp";

enum TokenKind derives Debug {
    Less,
    Greater,
    Slash,
    Literal,
    ETX,
    STX
};

enum TokenValue derives Debug {
    Str(str),
    Number(i64)
};

enum OptionTokenValue derives Debug {
    Some(TokenValue),
    None
};

struct Token derives Debug {
    TokenKind kind,
    OptionTokenValue value,
    Position position
};

enum OptionToken derives Debug {
    Some(Token),
    None
};
