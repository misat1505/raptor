# ============================================================
# Mirrors src/backend/llvm/compiler/core.rs::compile
# ============================================================

import "../../frontend/parser/ast.rp";
import "./compiler-core.rp";
import "./ir-builder.rp";
import "./libc-decls.rp";
import "./arc.rp";
import "./functions.rp";
import "./statements.rp";
import "./types-ir.rp";

fn llvm_compiler_compile(&LlvmCompiler c, &Program program): str {
    ir_emit_header(&c.ir, "; Generated by Raptor selfhost LLVM IR emitter");
    ir_emit_header(&c.ir, "; Mirrors src/backend/llvm/compiler (inkwell -> text)");
    ir_emit_header(&c.ir, "target datalayout = \"e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\"");
    ir_emit_header(&c.ir, "target triple = \"x86_64-unknown-linux-gnu\"");

    # Keep program for type lookups (struct/enum layouts)
    c.program = program;

    ir_emit_libc_declarations(&c.ir);
    if (c.overflow != "ignore") {
        ir_emit_overflow_intrinsics(&c.ir);
    }
    if (c.arc) {
        ir_emit_arc_runtime(&c.ir);
    }

    for (let i = 0; i < vector_size(&program.extern_functions); i += 1) {
        llvm_compile_extern(&c, program.extern_functions[i]);
    }
    ir_emit(&c.ir, "");

    for (let i = 0; i < vector_size(&program.functions); i += 1) {
        llvm_compile_function_body(&c, program.functions[i]);
    }

    ir_emit(&c.ir, "define i32 @main(i32 %argc, ptr %argv) {");
    llvm_begin_body(&c);
    ir_emit(&c.ir, "  store i32 %argc, ptr @raptor_argc");
    ir_emit(&c.ir, "  store ptr %argv, ptr @raptor_argv");
    ir_emit(&c.ir, "  br label %allocas");
    ir_emit(&c.ir, "start:");

    c.current_ret_ty = "i32";
    c.has_terminator = false;
    let compiler_vars: CompilerVar[] = [];
    c.locals = compiler_vars;

    for (let i = 0; i < vector_size(&program.statements); i += 1) {
        if (c.has_terminator) {
            break;
        }
        llvm_compile_statement(&c, program.statements[i]);
    }

    if (!c.has_terminator) {
        # Top-level variables are released like any other scope's.
        llvm_emit_release_locals_from(&c, 0);
        ir_emit(&c.ir, "  ret i32 0");
    }
    llvm_end_body(&c);
    ir_emit(&c.ir, "}");

    llvm_emit_drop_functions(&c);
    for (let i = 0; i < vector_size(&c.extra_fns); i += 1) {
        ir_emit(&c.ir, c.extra_fns[i]);
    }

    return ir_finish(&c.ir);
}

# Generates the LLVM IR text for `program`. Code generation errors are appended
# to `errors` (the IR is then incomplete and must not be used).
fn llvm_compiler_generate(&Program program, bool arc, str overflow, &str[] errors): str {
    let c = llvm_compiler_new();
    c.arc = arc;
    c.overflow = overflow;
    let ir = llvm_compiler_compile(&c, &program);
    for (let i = 0; i < vector_size(&c.errors); i += 1) {
        vector_push(&errors, c.errors[i]);
    }
    return ir;
}
