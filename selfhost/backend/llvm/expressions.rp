# ============================================================
# Mirrors src/backend/llvm/compiler/expressions.rs + visitor literals
# ============================================================

import "../../frontend/parser/ast.rp";
import "./compiler-core.rp";
import "./ir-builder.rp";
import "./types-ir.rp";

fn llvm_compile_literal(&LlvmCompiler c, Literal lit): void {
    match (lit) {
        Literal::True {
            llvm_compiler_set_last(&c, "1", "i1");
        },
        Literal::False {
            llvm_compiler_set_last(&c, "0", "i1");
        },
        Literal::I64(v) {
            llvm_compiler_set_last(&c, v as str, "i64");
        },
        Literal::F64(v) {
            llvm_compiler_set_last(&c, v as str, "double");
        },
        Literal::String(s) {
            let g = ir_cstr_global(&c.ir, s);
            let n = str_len(s) + 1;
            let tmp = ir_tmp(&c.ir);
            ir_emit(&c.ir, "  " + tmp + " = getelementptr inbounds [" + n as str + " x i8], ptr " + g + ", i64 0, i64 0");
            llvm_compiler_set_last(&c, tmp, "ptr");
        },
        Literal::Char(ch) {
            llvm_compiler_set_last(&c, ((ch as u8) as i64) as str, "i32");
        }
    }
}

fn llvm_compile_binary_i64(
    &LlvmCompiler c,
    ExpressionNode left,
    ExpressionNode right,
    str op
): void {
    llvm_compile_expression(&c, left);
    let lv = c.last_value;
    let lt = c.last_type;
    llvm_compile_expression(&c, right);
    let rv = c.last_value;
    let result = ir_tmp(&c.ir);
    if (lt == "i1") {
        # promote bool if needed later
    }
    ir_emit(&c.ir, "  " + result + " = " + op + " i64 " + lv + ", " + rv);
    llvm_compiler_set_last(&c, result, "i64");
}

fn llvm_compile_cmp(
    &LlvmCompiler c,
    ExpressionNode left,
    ExpressionNode right,
    str pred
): void {
    llvm_compile_expression(&c, left);
    let lv = c.last_value;
    llvm_compile_expression(&c, right);
    let rv = c.last_value;
    let result = ir_tmp(&c.ir);
    ir_emit(&c.ir, "  " + result + " = icmp " + pred + " i64 " + lv + ", " + rv);
    llvm_compiler_set_last(&c, result, "i1");
}

fn llvm_compile_function_call(&LlvmCompiler c, FunctionCallExpression call): void {
    let name = call.identifier.value;
    let arg_vals: str[] = [];
    let arg_tys: str[] = [];

    for (let i = 0; i < vector_size(&call.arguments); i += 1) {
        llvm_compile_expression(&c, call.arguments[i].value.value);
        vector_push(&arg_vals, c.last_value);
        vector_push(&arg_tys, c.last_type);
    }

    # --- std builtins (textual lowering, mirrors std_functions compile) ---
    if (name == "println") {
        if (vector_size(&arg_vals) == 0) {
            let g = ir_cstr_global(&c.ir, "\n");
            let p = ir_tmp(&c.ir);
            ir_emit(&c.ir, "  " + p + " = getelementptr inbounds [2 x i8], ptr " + g + ", i64 0, i64 0");
            ir_emit(&c.ir, "  " + ir_tmp(&c.ir) + " = call i32 (ptr, ...) @printf(ptr " + p + ")");
            llvm_compiler_set_last(&c, "0", "i64");
            return;
        }
        let a = arg_vals[0];
        let at = arg_tys[0];
        if (at == "ptr") {
            let fmt = ir_cstr_global(&c.ir, "%s\n");
            let fp = ir_tmp(&c.ir);
            ir_emit(&c.ir, "  " + fp + " = getelementptr inbounds [4 x i8], ptr " + fmt + ", i64 0, i64 0");
            ir_emit(&c.ir, "  " + ir_tmp(&c.ir) + " = call i32 (ptr, ...) @printf(ptr " + fp + ", ptr " + a + ")");
        } else {
            if (at == "i1") {
                let ext = ir_tmp(&c.ir);
                ir_emit(&c.ir, "  " + ext + " = zext i1 " + a + " to i64");
                a = ext;
            }
            let fmt = ir_cstr_global(&c.ir, "%lld\n");
            let fp = ir_tmp(&c.ir);
            ir_emit(&c.ir, "  " + fp + " = getelementptr inbounds [6 x i8], ptr " + fmt + ", i64 0, i64 0");
            ir_emit(&c.ir, "  " + ir_tmp(&c.ir) + " = call i32 (ptr, ...) @printf(ptr " + fp + ", i64 " + a + ")");
        }
        llvm_compiler_set_last(&c, "0", "i64");
        return;
    }

    if (name == "print") {
        if (vector_size(&arg_vals) >= 1) {
            let a = arg_vals[0];
            let at = arg_tys[0];
            if (at == "ptr") {
                let fmt = ir_cstr_global(&c.ir, "%s");
                let fp = ir_tmp(&c.ir);
                ir_emit(&c.ir, "  " + fp + " = getelementptr inbounds [3 x i8], ptr " + fmt + ", i64 0, i64 0");
                ir_emit(&c.ir, "  " + ir_tmp(&c.ir) + " = call i32 (ptr, ...) @printf(ptr " + fp + ", ptr " + a + ")");
            } else {
                let fmt = ir_cstr_global(&c.ir, "%lld");
                let fp = ir_tmp(&c.ir);
                ir_emit(&c.ir, "  " + fp + " = getelementptr inbounds [5 x i8], ptr " + fmt + ", i64 0, i64 0");
                ir_emit(&c.ir, "  " + ir_tmp(&c.ir) + " = call i32 (ptr, ...) @printf(ptr " + fp + ", i64 " + a + ")");
            }
        }
        llvm_compiler_set_last(&c, "0", "i64");
        return;
    }

    if (name == "str_len") {
        let r = ir_tmp(&c.ir);
        ir_emit(&c.ir, "  " + r + " = call i64 @strlen(ptr " + arg_vals[0] + ")");
        llvm_compiler_set_last(&c, r, "i64");
        return;
    }

    if (name == "sleep_ms") {
        let micros = ir_tmp(&c.ir);
        ir_emit(&c.ir, "  " + micros + " = mul i64 " + arg_vals[0] + ", 1000");
        let trunc = ir_tmp(&c.ir);
        ir_emit(&c.ir, "  " + trunc + " = trunc i64 " + micros + " to i32");
        ir_emit(&c.ir, "  " + ir_tmp(&c.ir) + " = call i32 @usleep(i32 " + trunc + ")");
        llvm_compiler_set_last(&c, "0", "i64");
        return;
    }

    if (name == "cli_args") {
        # Returns ptr to a simple null-terminated representation is hard;
        # emit argc as i64 for MVP via load of @raptor_argc
        let a = ir_tmp(&c.ir);
        ir_emit(&c.ir, "  " + a + " = load i32, ptr @raptor_argc");
        let e = ir_tmp(&c.ir);
        ir_emit(&c.ir, "  " + e + " = sext i32 " + a + " to i64");
        llvm_compiler_set_last(&c, e, "i64");
        llvm_compiler_error(&c, "cli_args full str[] lowering not complete in selfhost IR; returned argc as i64");
        return;
    }

    # User / extern function call
    let args_ir = "";
    for (let i = 0; i < vector_size(&arg_vals); i += 1) {
        if (i > 0) {
            args_ir += ", ";
        }
        args_ir += arg_tys[i] + " " + arg_vals[i];
    }
    let r = ir_tmp(&c.ir);
    ir_emit(&c.ir, "  " + r + " = call i64 @" + name + "(" + args_ir + ")");
    llvm_compiler_set_last(&c, r, "i64");
}

fn llvm_compile_expression(&LlvmCompiler c, ExpressionNode node): void {
    match (node.value) {
        Expression::Literal(lit) {
            llvm_compile_literal(&c, lit);
        },
        Expression::Variable(name) {
            let idx = llvm_compiler_find_local(&c, name);
            if (idx < 0) {
                llvm_compiler_error(&c, "Undefined variable '" + name + "' in expression");
                llvm_compiler_set_last(&c, "0", "i64");
                return;
            }
            let v = c.locals[idx];
            let tmp = ir_tmp(&c.ir);
            ir_emit(&c.ir, "  " + tmp + " = load " + v.ty + ", ptr " + v.ptr);
            llvm_compiler_set_last(&c, tmp, v.ty);
        },
        Expression::Addition(bin) {
            llvm_compile_expression(&c, bin.left);
            let lv = c.last_value;
            let lt = c.last_type;
            llvm_compile_expression(&c, bin.right);
            let rv = c.last_value;
            let rt = c.last_type;
            if (lt == "ptr" || rt == "ptr") {
                # string concat via malloc+strcpy+strcat (simple)
                let lptr = lv;
                let rptr = rv;
                if (lt != "ptr") {
                    llvm_compiler_error(&c, "string + non-string not supported in IR emitter");
                }
                let llen = ir_tmp(&c.ir);
                ir_emit(&c.ir, "  " + llen + " = call i64 @strlen(ptr " + lptr + ")");
                let rlen = ir_tmp(&c.ir);
                ir_emit(&c.ir, "  " + rlen + " = call i64 @strlen(ptr " + rptr + ")");
                let sum = ir_tmp(&c.ir);
                ir_emit(&c.ir, "  " + sum + " = add i64 " + llen + ", " + rlen);
                let size = ir_tmp(&c.ir);
                ir_emit(&c.ir, "  " + size + " = add i64 " + sum + ", 1");
                let buf = ir_tmp(&c.ir);
                ir_emit(&c.ir, "  " + buf + " = call ptr @malloc(i64 " + size + ")");
                ir_emit(&c.ir, "  " + ir_tmp(&c.ir) + " = call ptr @strcpy(ptr " + buf + ", ptr " + lptr + ")");
                ir_emit(&c.ir, "  " + ir_tmp(&c.ir) + " = call ptr @strcat(ptr " + buf + ", ptr " + rptr + ")");
                llvm_compiler_set_last(&c, buf, "ptr");
            } else {
                let result = ir_tmp(&c.ir);
                ir_emit(&c.ir, "  " + result + " = add i64 " + lv + ", " + rv);
                llvm_compiler_set_last(&c, result, "i64");
            }
        },
        Expression::Subtraction(bin) llvm_compile_binary_i64(&c, bin.left, bin.right, "sub");,
        Expression::Multiplication(bin) llvm_compile_binary_i64(&c, bin.left, bin.right, "mul");,
        Expression::Division(bin) llvm_compile_binary_i64(&c, bin.left, bin.right, "sdiv");,
        Expression::Modulo(bin) llvm_compile_binary_i64(&c, bin.left, bin.right, "srem");,
        Expression::Equal(bin) llvm_compile_cmp(&c, bin.left, bin.right, "eq");,
        Expression::NotEqual(bin) llvm_compile_cmp(&c, bin.left, bin.right, "ne");,
        Expression::Less(bin) llvm_compile_cmp(&c, bin.left, bin.right, "slt");,
        Expression::LessEqual(bin) llvm_compile_cmp(&c, bin.left, bin.right, "sle");,
        Expression::Greater(bin) llvm_compile_cmp(&c, bin.left, bin.right, "sgt");,
        Expression::GreaterEqual(bin) llvm_compile_cmp(&c, bin.left, bin.right, "sge");,
        Expression::BooleanNegation(inner) {
            llvm_compile_expression(&c, inner);
            let r = ir_tmp(&c.ir);
            ir_emit(&c.ir, "  " + r + " = xor i1 " + c.last_value + ", true");
            llvm_compiler_set_last(&c, r, "i1");
        },
        Expression::ArithmeticNegation(inner) {
            llvm_compile_expression(&c, inner);
            let r = ir_tmp(&c.ir);
            ir_emit(&c.ir, "  " + r + " = sub i64 0, " + c.last_value);
            llvm_compiler_set_last(&c, r, "i64");
        },
        Expression::FunctionCall(call) {
            llvm_compile_function_call(&c, call);
        },
        Expression::Casting(cast) {
            llvm_compile_expression(&c, cast.value);
            let to = type_to_llvm(cast.to_type.value);
            if (to == c.last_type) {
                return;
            }
            if (c.last_type == "i1" && to == "i64") {
                let r = ir_tmp(&c.ir);
                ir_emit(&c.ir, "  " + r + " = zext i1 " + c.last_value + " to i64");
                llvm_compiler_set_last(&c, r, "i64");
                return;
            }
            if (to == "ptr") {
                # i64/str cast via snprintf
                let buf = ir_tmp(&c.ir);
                ir_emit(&c.ir, "  " + buf + " = call ptr @malloc(i64 32)");
                let fmt = ir_cstr_global(&c.ir, "%lld");
                let fp = ir_tmp(&c.ir);
                ir_emit(&c.ir, "  " + fp + " = getelementptr inbounds [5 x i8], ptr " + fmt + ", i64 0, i64 0");
                ir_emit(&c.ir, "  " + ir_tmp(&c.ir) + " = call i32 (ptr, i64, ptr, ...) @snprintf(ptr " + buf + ", i64 32, ptr " + fp + ", i64 " + c.last_value + ")");
                llvm_compiler_set_last(&c, buf, "ptr");
                return;
            }
            llvm_compiler_set_last(&c, c.last_value, to);
        },
        Expression::Alternative(bin) {
            # a || b  ->  or i1
            llvm_compile_expression(&c, bin.left);
            let lv = c.last_value;
            llvm_compile_expression(&c, bin.right);
            let rv = c.last_value;
            let r = ir_tmp(&c.ir);
            ir_emit(&c.ir, "  " + r + " = or i1 " + lv + ", " + rv);
            llvm_compiler_set_last(&c, r, "i1");
        },
        Expression::Concatenation(bin) {
            llvm_compile_expression(&c, bin.left);
            let lv = c.last_value;
            llvm_compile_expression(&c, bin.right);
            let rv = c.last_value;
            let r = ir_tmp(&c.ir);
            ir_emit(&c.ir, "  " + r + " = and i1 " + lv + ", " + rv);
            llvm_compiler_set_last(&c, r, "i1");
        },
        Expression::Vector(elems) {
            llvm_compiler_error(&c, "Vector literals not yet lowered in selfhost IR");
            llvm_compiler_set_last(&c, "null", "ptr");
        },
        Expression::Index(ix) {
            llvm_compiler_error(&c, "Index not yet lowered in selfhost IR");
            llvm_compiler_set_last(&c, "0", "i64");
        },
        Expression::FieldAccess(fa) {
            llvm_compiler_error(&c, "FieldAccess not yet lowered in selfhost IR");
            llvm_compiler_set_last(&c, "0", "i64");
        },
        Expression::StructLiteral(sl) {
            llvm_compiler_error(&c, "StructLiteral not yet lowered in selfhost IR");
            llvm_compiler_set_last(&c, "null", "ptr");
        },
        Expression::EnumLiteral(el) {
            llvm_compiler_error(&c, "EnumLiteral not yet lowered in selfhost IR");
            llvm_compiler_set_last(&c, "null", "ptr");
        }
    }
}
