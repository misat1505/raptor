# ============================================================
# Mirrors src/backend/llvm/compiler/statements.rs
# ============================================================

import "../../frontend/parser/ast.rp";
import "./compiler-core.rp";
import "./expressions.rp";
import "./ir-builder.rp";
import "./types-ir.rp";

fn llvm_compile_block(&LlvmCompiler c, BlockNode block): void {
    let marker = llvm_compiler_push_scope_marker(&c);
    for (let i = 0; i < vector_size(&block.value.statements); i += 1) {
        if (c.has_terminator) {
            break;
        }
        llvm_compile_statement(&c, block.value.statements[i]);
    }
    llvm_compiler_pop_scope(&c, marker);
}

fn llvm_compile_declaration(&LlvmCompiler c, DeclarationStatement decl): void {
    match (decl.kind) {
        VariableDeclarationKind::LET(k) {
            llvm_compile_expression(&c, k.value);
            let ty = c.last_type;
            match (k.var_type) {
                OptionTypeNode::Some(tn) {
                    ty = type_to_llvm(tn.value);
                },
                OptionTypeNode::None {}
            }
            let ptr = llvm_compiler_declare_local(&c, decl.identifier.value, ty);
            ir_emit(&c.ir, "  store " + c.last_type + " " + c.last_value + ", ptr " + ptr);
        },
        VariableDeclarationKind::TYPE(k) {
            let ty = type_to_llvm(k.var_type.value);
            let ptr = llvm_compiler_declare_local(&c, decl.identifier.value, ty);
            match (k.value) {
                OptionExpressionNode::Some(expr) {
                    llvm_compile_expression(&c, expr);
                    ir_emit(&c.ir, "  store " + c.last_type + " " + c.last_value + ", ptr " + ptr);
                },
                OptionExpressionNode::None {
                    ir_emit(&c.ir, "  store " + ty + " " + type_default_llvm(k.var_type.value) + ", ptr " + ptr);
                }
            }
        }
    }
}

fn llvm_compile_assignment(&LlvmCompiler c, AssignmentStatement assign): void {
    llvm_compile_expression(&c, assign.value);
    let rval = c.last_value;
    let rty = c.last_type;
    let idx = llvm_compiler_find_local(&c, assign.identifier.value);
    if (idx < 0) {
        llvm_compiler_error(&c, "Assign to undeclared '" + assign.identifier.value + "'");
        return;
    }
    let v = c.locals[idx];
    if (vector_size(&assign.accessors) == 0) {
        ir_emit(&c.ir, "  store " + rty + " " + rval + ", ptr " + v.ptr);
        return;
    }
    # Load base
    let base = ir_tmp(&c.ir);
    ir_emit(&c.ir, "  " + base + " = load " + v.ty + ", ptr " + v.ptr);
    let cur = base;
    for (let i = 0; i < vector_size(&assign.accessors); i += 1) {
        let is_last = i == vector_size(&assign.accessors) - 1;
        match (assign.accessors[i].value) {
            Accessor::Field(field) {
                let fidx = 0;
                for (let t = 0; t < vector_size(&c.program.declared_types); t += 1) {
                    match (c.program.declared_types[t].value) {
                        DeclaredType::Struct(s) {
                            for (let m = 0; m < vector_size(&s.members); m += 1) {
                                if (s.members[m].value.identifier.value == field.value) {
                                    fidx = m;
                                }
                            }
                        },
                        rest {}
                    }
                }
                let gep = ir_tmp(&c.ir);
                ir_emit(&c.ir, "  " + gep + " = getelementptr i8, ptr " + cur + ", i64 " + (fidx * 8) as str);
                if (is_last) {
                    if (rty == "ptr") {
                        ir_emit(&c.ir, "  store ptr " + rval + ", ptr " + gep);
                    } else {
                        let sv = rval;
                        if (rty == "i1") {
                            let e = ir_tmp(&c.ir);
                            ir_emit(&c.ir, "  " + e + " = zext i1 " + sv + " to i64");
                            sv = e;
                        } else {
                            if (rty == "i8" || rty == "i16" || rty == "i32") {
                                let e = ir_tmp(&c.ir);
                                ir_emit(&c.ir, "  " + e + " = zext " + rty + " " + sv + " to i64");
                                sv = e;
                            }
                        }
                        ir_emit(&c.ir, "  store i64 " + sv + ", ptr " + gep);
                    }
                } else {
                    let n = ir_tmp(&c.ir);
                    ir_emit(&c.ir, "  " + n + " = load ptr, ptr " + gep);
                    cur = n;
                }
            },
            Accessor::Index(index_expr) {
                llvm_compile_expression(&c, index_expr);
                let i_val = c.last_value;
                let data_p = ir_tmp(&c.ir);
                ir_emit(&c.ir, "  " + data_p + " = getelementptr i8, ptr " + cur + ", i64 8");
                let data = ir_tmp(&c.ir);
                ir_emit(&c.ir, "  " + data + " = load ptr, ptr " + data_p);
                let slot = ir_tmp(&c.ir);
                ir_emit(&c.ir, "  " + slot + " = getelementptr ptr, ptr " + data + ", i64 " + i_val);
                if (is_last) {
                    if (rty == "ptr") {
                        ir_emit(&c.ir, "  store ptr " + rval + ", ptr " + slot);
                    } else {
                        let sv = rval;
                        if (rty == "i1") {
                            let e = ir_tmp(&c.ir);
                            ir_emit(&c.ir, "  " + e + " = zext i1 " + sv + " to i64");
                            sv = e;
                        } else {
                            if (rty == "i8" || rty == "i16" || rty == "i32") {
                                let e = ir_tmp(&c.ir);
                                ir_emit(&c.ir, "  " + e + " = zext " + rty + " " + sv + " to i64");
                                sv = e;
                            }
                        }
                        ir_emit(&c.ir, "  store i64 " + sv + ", ptr " + slot);
                    }
                } else {
                    let n = ir_tmp(&c.ir);
                    ir_emit(&c.ir, "  " + n + " = load ptr, ptr " + slot);
                    cur = n;
                }
            }
        }
    }
}

fn llvm_compile_if(&LlvmCompiler c, ConditionalStatement stmt): void {
    llvm_compile_expression(&c, stmt.condition);
    let cond = c.last_value;
    if (c.last_type != "i1") {
        let t = ir_tmp(&c.ir);
        ir_emit(&c.ir, "  " + t + " = icmp ne i64 " + cond + ", 0");
        cond = t;
    }
    let then_l = ir_label(&c.ir, "if.then");
    let else_l = ir_label(&c.ir, "if.else");
    let end_l = ir_label(&c.ir, "if.end");
    let has_else = false;
    match (stmt.else_block) {
        OptionBlockNode::Some(b) has_else = true;,
        OptionBlockNode::None {}
    }
    if (has_else) {
        ir_emit(&c.ir, "  br i1 " + cond + ", label %" + then_l + ", label %" + else_l);
    } else {
        ir_emit(&c.ir, "  br i1 " + cond + ", label %" + then_l + ", label %" + end_l);
    }

    ir_emit(&c.ir, then_l + ":");
    c.has_terminator = false;
    llvm_compile_block(&c, stmt.if_block);
    if (!c.has_terminator) {
        ir_emit(&c.ir, "  br label %" + end_l);
    }

    match (stmt.else_block) {
        OptionBlockNode::Some(eb) {
            ir_emit(&c.ir, else_l + ":");
            c.has_terminator = false;
            llvm_compile_block(&c, eb);
            if (!c.has_terminator) {
                ir_emit(&c.ir, "  br label %" + end_l);
            }
        },
        OptionBlockNode::None {}
    }

    ir_emit(&c.ir, end_l + ":");
    c.has_terminator = false;
}

fn llvm_compile_while(&LlvmCompiler c, WhileLoopStatement stmt): void {
    let cond_l = ir_label(&c.ir, "while.cond");
    let body_l = ir_label(&c.ir, "while.body");
    let end_l = ir_label(&c.ir, "while.end");
    ir_emit(&c.ir, "  br label %" + cond_l);
    ir_emit(&c.ir, cond_l + ":");
    c.has_terminator = false;
    llvm_compile_expression(&c, stmt.condition);
    let cond = c.last_value;
    if (c.last_type != "i1") {
        let t = ir_tmp(&c.ir);
        ir_emit(&c.ir, "  " + t + " = icmp ne i64 " + cond + ", 0");
        cond = t;
    }
    ir_emit(&c.ir, "  br i1 " + cond + ", label %" + body_l + ", label %" + end_l);
    ir_emit(&c.ir, body_l + ":");
    c.has_terminator = false;
    vector_push(&c.break_stack, end_l);
    vector_push(&c.continue_stack, cond_l);
    llvm_compile_block(&c, stmt.block);
    # pop stacks
    let nb: str[] = [];
    for (let i = 0; i < vector_size(&c.break_stack) - 1; i += 1) {
        vector_push(&nb, c.break_stack[i]);
    }
    c.break_stack = nb;
    let nc: str[] = [];
    for (let i = 0; i < vector_size(&c.continue_stack) - 1; i += 1) {
        vector_push(&nc, c.continue_stack[i]);
    }
    c.continue_stack = nc;
    if (!c.has_terminator) {
        ir_emit(&c.ir, "  br label %" + cond_l);
    }
    ir_emit(&c.ir, end_l + ":");
    c.has_terminator = false;
}

fn llvm_compile_for(&LlvmCompiler c, ForLoopStatement stmt): void {
    let marker = llvm_compiler_push_scope_marker(&c);
    match (stmt.declaration) {
        OptionStatementNode::Some(d) llvm_compile_statement(&c, d);,
        OptionStatementNode::None {}
    }
    let cond_l = ir_label(&c.ir, "for.cond");
    let body_l = ir_label(&c.ir, "for.body");
    let step_l = ir_label(&c.ir, "for.step");
    let end_l = ir_label(&c.ir, "for.end");
    ir_emit(&c.ir, "  br label %" + cond_l);
    ir_emit(&c.ir, cond_l + ":");
    c.has_terminator = false;
    llvm_compile_expression(&c, stmt.condition);
    let cond = c.last_value;
    if (c.last_type != "i1") {
        let t = ir_tmp(&c.ir);
        ir_emit(&c.ir, "  " + t + " = icmp ne i64 " + cond + ", 0");
        cond = t;
    }
    ir_emit(&c.ir, "  br i1 " + cond + ", label %" + body_l + ", label %" + end_l);
    ir_emit(&c.ir, body_l + ":");
    c.has_terminator = false;
    vector_push(&c.break_stack, end_l);
    vector_push(&c.continue_stack, step_l);
    llvm_compile_block(&c, stmt.block);
    let nb: str[] = [];
    for (let i = 0; i < vector_size(&c.break_stack) - 1; i += 1) {
        vector_push(&nb, c.break_stack[i]);
    }
    c.break_stack = nb;
    let nc: str[] = [];
    for (let i = 0; i < vector_size(&c.continue_stack) - 1; i += 1) {
        vector_push(&nc, c.continue_stack[i]);
    }
    c.continue_stack = nc;
    if (!c.has_terminator) {
        ir_emit(&c.ir, "  br label %" + step_l);
    }
    ir_emit(&c.ir, step_l + ":");
    c.has_terminator = false;
    match (stmt.assignment) {
        OptionStatementNode::Some(a) llvm_compile_statement(&c, a);,
        OptionStatementNode::None {}
    }
    ir_emit(&c.ir, "  br label %" + cond_l);
    ir_emit(&c.ir, end_l + ":");
    c.has_terminator = false;
    llvm_compiler_pop_scope(&c, marker);
}


fn llvm_compile_match(&LlvmCompiler c, MatchStatement m): void {
    llvm_compile_expression(&c, m.expression);
    let scrut = c.last_value;
    # load tag at offset 8
    let tag_p = ir_tmp(&c.ir);
    ir_emit(&c.ir, "  " + tag_p + " = getelementptr i8, ptr " + scrut + ", i64 8");
    let tag = ir_tmp(&c.ir);
    ir_emit(&c.ir, "  " + tag + " = load i64, ptr " + tag_p);
    let pay_p = ir_tmp(&c.ir);
    ir_emit(&c.ir, "  " + pay_p + " = getelementptr i8, ptr " + scrut + ", i64 16");

    let end_l = ir_label(&c.ir, "match.end");
    let arm_labels: str[] = [];
    for (let i = 0; i < vector_size(&m.match_arms); i += 1) {
        vector_push(&arm_labels, ir_label(&c.ir, "match.arm"));
    }
    let rest_l = ir_label(&c.ir, "match.rest");

    # chain of icmp + br
    for (let i = 0; i < vector_size(&m.match_arms); i += 1) {
        let arm = m.match_arms[i];
        let expected = llvm_enum_variant_tag(&c, arm.value.enum_name.value, arm.value.variant_name.value);
        let cmp = ir_tmp(&c.ir);
        ir_emit(&c.ir, "  " + cmp + " = icmp eq i64 " + tag + ", " + expected as str);
        let next_check = ir_label(&c.ir, "match.chk");
        ir_emit(&c.ir, "  br i1 " + cmp + ", label %" + arm_labels[i] + ", label %" + next_check);
        ir_emit(&c.ir, next_check + ":");
    }
    # no arm matched -> rest or end
    match (m.rest_arm) {
        OptionBlockNode::Some(b) ir_emit(&c.ir, "  br label %" + rest_l);,
        OptionBlockNode::None ir_emit(&c.ir, "  br label %" + end_l);
    }

    for (let i = 0; i < vector_size(&m.match_arms); i += 1) {
        let arm = m.match_arms[i];
        ir_emit(&c.ir, arm_labels[i] + ":");
        c.has_terminator = false;
        let marker = llvm_compiler_push_scope_marker(&c);
        match (arm.value.variant_value) {
            OptionIdentifierNode::Some(bind) {
                let ptr = llvm_compiler_declare_local(&c, bind.value, "ptr");
                let pay = ir_tmp(&c.ir);
                ir_emit(&c.ir, "  " + pay + " = load ptr, ptr " + pay_p);
                ir_emit(&c.ir, "  store ptr " + pay + ", ptr " + ptr);
            },
            OptionIdentifierNode::None {}
        }
        llvm_compile_block(&c, arm.value.block);
        llvm_compiler_pop_scope(&c, marker);
        if (!c.has_terminator) {
            ir_emit(&c.ir, "  br label %" + end_l);
        }
    }

    match (m.rest_arm) {
        OptionBlockNode::Some(b) {
            ir_emit(&c.ir, rest_l + ":");
            c.has_terminator = false;
            llvm_compile_block(&c, b);
            if (!c.has_terminator) {
                ir_emit(&c.ir, "  br label %" + end_l);
            }
        },
        OptionBlockNode::None {}
    }

    ir_emit(&c.ir, end_l + ":");
    c.has_terminator = false;
}

fn llvm_compile_statement(&LlvmCompiler c, StatementNode node): void {
    match (node.value) {
        Statement::Declaration(d) llvm_compile_declaration(&c, d);,
        Statement::Assignment(a) llvm_compile_assignment(&c, a);,
        Statement::Conditional(s) llvm_compile_if(&c, s);,
        Statement::WhileLoop(s) llvm_compile_while(&c, s);,
        Statement::ForLoop(s) llvm_compile_for(&c, s);,
        Statement::Return(opt) {
            match (opt) {
                OptionExpressionNode::Some(expr) {
                    llvm_compile_expression(&c, expr);
                    if (c.current_ret_ty == "void") {
                        ir_emit(&c.ir, "  ret void");
                    } else {
                        let v = c.last_value;
                        let from = c.last_type;
                        let to = c.current_ret_ty;
                        if (from != to) {
                            if (from == "ptr" && to == "i64") {
                                let t = ir_tmp(&c.ir);
                                ir_emit(&c.ir, "  " + t + " = ptrtoint ptr " + v + " to i64");
                                v = t;
                            } else {
                                if (from == "ptr" && to == "i32") {
                                    let t = ir_tmp(&c.ir);
                                    ir_emit(&c.ir, "  " + t + " = ptrtoint ptr " + v + " to i64");
                                    let t2 = ir_tmp(&c.ir);
                                    ir_emit(&c.ir, "  " + t2 + " = trunc i64 " + t + " to i32");
                                    v = t2;
                                } else {
                                    if (from == "i64" && to == "ptr") {
                                        let t = ir_tmp(&c.ir);
                                        ir_emit(&c.ir, "  " + t + " = inttoptr i64 " + v + " to ptr");
                                        v = t;
                                    } else {
                                        if (from == "i64" && to == "i32") {
                                            let t = ir_tmp(&c.ir);
                                            ir_emit(&c.ir, "  " + t + " = trunc i64 " + v + " to i32");
                                            v = t;
                                        } else {
                                            if (from == "i32" && to == "i64") {
                                                let t = ir_tmp(&c.ir);
                                                ir_emit(&c.ir, "  " + t + " = sext i32 " + v + " to i64");
                                                v = t;
                                            } else {
                                                if (from == "i1" && to == "i64") {
                                                    let t = ir_tmp(&c.ir);
                                                    ir_emit(&c.ir, "  " + t + " = zext i1 " + v + " to i64");
                                                    v = t;
                                                } else {
                                                    if (from == "i1" && to == "i32") {
                                                        let t = ir_tmp(&c.ir);
                                                        ir_emit(&c.ir, "  " + t + " = zext i1 " + v + " to i32");
                                                        v = t;
                                                    } else {
                                                        # last resort: bitcast if same width-ish
                                                        let t = ir_tmp(&c.ir);
                                                        ir_emit(&c.ir, "  " + t + " = bitcast " + from + " " + v + " to " + to);
                                                        v = t;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        ir_emit(&c.ir, "  ret " + to + " " + v);
                    }
                },
                OptionExpressionNode::None {
                    if (c.current_ret_ty == "void") {
                        ir_emit(&c.ir, "  ret void");
                    } else {
                        if (c.current_ret_ty == "ptr") {
                            ir_emit(&c.ir, "  ret ptr null");
                        } else {
                            ir_emit(&c.ir, "  ret " + c.current_ret_ty + " 0");
                        }
                    }
                }
            }
            c.has_terminator = true;
        },
        Statement::Break {
            if (vector_size(&c.break_stack) == 0) {
                llvm_compiler_error(&c, "break outside loop");
            } else {
                let t = c.break_stack[vector_size(&c.break_stack) - 1];
                ir_emit(&c.ir, "  br label %" + t);
                c.has_terminator = true;
            }
        },
        Statement::Continue {
            if (vector_size(&c.continue_stack) == 0) {
                llvm_compiler_error(&c, "continue outside loop");
            } else {
                let t = c.continue_stack[vector_size(&c.continue_stack) - 1];
                ir_emit(&c.ir, "  br label %" + t);
                c.has_terminator = true;
            }
        },
        Statement::FunctionCall(call) {
            # Statement form of call - wrap as expression
            llvm_compile_function_call(&c, call);
        },
        Statement::Match(m) {
            llvm_compile_match(&c, m);
        },
        Statement::Switch(s) {
            llvm_compiler_error(&c, "switch not yet lowered in selfhost IR");
        },
        Statement::Import(imp) {
            # imports already resolved before compile
        }
    }
}
