import "./span.rp";
import "./position.rp";
import "../../stdlib/string.rp";


enum ErrorSeverity derives Debug {
    HIGH,
    LOW
};


struct LexerError derives Debug {
    str message,
    ErrorSeverity level,
    Span span
};

struct ParserError derives Debug {
    str message,
    ErrorSeverity level,
    Span span
};

struct SemanticCheckerError derives Debug {
    str message,
    ErrorSeverity level,
    Span span
};

struct InterpreterError derives Debug {
