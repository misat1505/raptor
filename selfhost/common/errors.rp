import "./span.rp";
import "./position.rp";


enum ErrorSeverity derives Debug {
    HIGH,
    LOW
};


struct LexerError derives Debug {
    str message,
    ErrorSeverity level,
    Span span
};

struct ParserError derives Debug {
    str message,
    ErrorSeverity level,
    Span span
};

struct SemanticCheckerError derives Debug {
    str message,
    ErrorSeverity level,
    Span span
};

struct InterpreterError derives Debug {
    str message,
    ErrorSeverity level,
    Span span
};

struct ComputationError derives Debug {
    str message,
    ErrorSeverity level,
    Span span
};

struct ScopeManagerError derives Debug {
    str message,
    ErrorSeverity level,
    Span span
};

struct StackOverflowError derives Debug {
    str message,
    ErrorSeverity level,
    Span span
};

struct StdFunctionError derives Debug {
    str message,
    ErrorSeverity level,
    Span span
};

struct CompilerError derives Debug {
    str message,
    ErrorSeverity level,
    Span span
};

struct MacroExpanderError derives Debug {
    str message,
    ErrorSeverity level,
    Span span
};


fn error_severity_to_string(ErrorSeverity severity): str {
    match (severity) {
        ErrorSeverity::HIGH return "\x1b[1;31merror\x1b[0m";,
        ErrorSeverity::LOW return "\x1b[1;33mwarning\x1b[0m";
    }
}


fn error_severity_color(ErrorSeverity severity): str {
    match (severity) {
        ErrorSeverity::HIGH return "\x1b[1;31m";,
        ErrorSeverity::LOW return "\x1b[1;33m";
    }
}


fn lexer_error_new(ErrorSeverity level, str message, Span span): LexerError {
    return LexerError {
        message,
        level,
        span
    };
}


fn lexer_error_at(ErrorSeverity level, str summary, Span span): LexerError {
    return LexerError {
        message: summary,
        level,
        span
    };
}


fn lexer_error_expected_found(
    ErrorSeverity level,
    str summary,
    str expected,
    str found,
    Span span
): LexerError {
    let message = summary
        + "\n  expected: " + expected
        + "\n  found:    " + found;

    return LexerError {
        message,
        level,
        span
    };
}


