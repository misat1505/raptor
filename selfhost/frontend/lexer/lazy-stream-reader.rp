import "../../common/position.rp";


enum OptionU8Vec derives Debug {
    Some(u8[]),
    None
};

enum OptionChar derives Debug {
    Some(char),
    None
};


struct LazyStreamReader derives Debug {
    str src,
    i64 src_len,

    # Cursor used for reading bytes from src.
    # This is separate from current_position.offset.
    i64 read_offset,

    str current_line,
    char current_char,

    OptionU8Vec newline,

    Position current_position,
    OptionStr filename
};

fn lazy_stream_reader_current(&LazyStreamReader lsr): char {
    return lsr.current_char;
}

fn lazy_stream_reader_next(&LazyStreamReader lsr): char {
    let new_char = lazy_stream_reader_read_char(&lsr);
    lazy_stream_reader_update_position(&lsr, lsr.current_char);
    lsr.current_char = new_char;
    return lsr.current_char;
}

fn lazy_stream_reader_position(&LazyStreamReader lsr): Position {
    return lsr.current_position;
}

fn lazy_stream_reader_new(
    str src,
    OptionStr filename
): LazyStreamReader {
    return LazyStreamReader {
        src,
        src_len: str_len(src),
        read_offset: 0,
        current_line: "",
        current_char: (2 as u8) as char, # STX
        newline: OptionU8Vec::None,
        current_position: Position {
            line: 0,
            column: 0,
            offset: 0,
            filename
        },
        filename
    };
}

fn lazy_stream_reader_read_char(
    &LazyStreamReader lsr
): char {
    let new_char = '\0';
    match (lazy_stream_reader_try_handle_newline(&lsr)) {
        OptionChar::Some(ch) new_char = ch;,
        OptionChar::None {
            new_char = lazy_stream_reader_process_char(&lsr);
        }
    }
    return new_char;
}

fn lazy_stream_reader_try_handle_newline(
    &LazyStreamReader lsr
): OptionChar {
    if (lsr.read_offset >= lsr.src_len) return OptionChar::None;

    let first_char = lsr.src[lsr.read_offset];
    if (first_char == '\r') {
        let newline_seq = [first_char as u8];
        lsr.read_offset += 1;
        if (lsr.read_offset < lsr.src_len) {
            let second_char = lsr.src[lsr.read_offset];
            if (second_char == '\n') {
                vector_push(&newline_seq, second_char as u8);
                lsr.read_offset += 1;
            }
        }
        lsr.newline = OptionU8Vec::Some(newline_seq);
        return OptionChar::Some('\n');
    }

    if (first_char == '\n') {
        lsr.read_offset += 1;
        lsr.newline = OptionU8Vec::Some([
            first_char as u8
        ]);
        return OptionChar::Some('\n');
    }

    return OptionChar::None;
}

fn lazy_stream_reader_process_char(
    &LazyStreamReader lsr
): char {
    if (lsr.read_offset >= lsr.src_len) return (3 as u8) as char; # ETX

    let first_byte = lsr.src[lsr.read_offset];
    lsr.read_offset += 1;
    return first_byte;
}


fn lazy_stream_reader_update_position(
    &LazyStreamReader lsr,
    char read_character
): void {
    if (read_character == (2 as u8) as char) {
        lsr.current_position = Position {
            line: 1,
            column: 1,
            offset: 0,
            filename: lsr.filename
        };
        return;
    }
    if (read_character == (3 as u8) as char) return;
    if (read_character == '\n') {
        match (lsr.newline) {
            OptionU8Vec::Some(seq) {
                lsr.current_position.offset += vector_size(&seq);
            },
            OptionU8Vec::None {
                lsr.current_position.offset += 1;
            }
        }
        lsr.current_position.line += 1;
        lsr.current_position.column = 1;
        lsr.current_line = "";
        return;
    }
    lsr.current_position.offset += 1;
    lsr.current_position.column += 1;

    lsr.current_line += read_character;
}
