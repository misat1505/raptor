import "../../../common/span.rp";
import "../../tokens.rp";
import "../ast.rp";
import "../parser_results.rp";
import "../core.rp";

# Shared by `parse_function_declaration` and
# `parse_extern_function_declaration`: mirrors Rust's
# `match self.parse_type() { Ok(Some(t)) => t, _ => self.void_type_or_error()? }`
# - note that this deliberately swallows any `Err` from `parse_type` too
# (the `_` arm), falling back to `void_type_or_error` (which produces its
# own, more specific error) instead of propagating it.
fn parser_parse_return_type(&Parser parser): ResultTypeNode {
    let type_call = parser_parse_type(&parser);

    if (type_call matches ResultOptionTypeNode::Ok(option_type)) {
        if (option_type matches OptionTypeNode::Some(t)) return ResultTypeNode::Ok(t);
    }

    return parser_void_type_or_error(&parser);
}

fn parser_parse_function_declaration(&Parser parser): ResultOptionFunctionDeclarationNode {
    # function_declaration = "fn", identifier, "(", parameters, ")", ":", type | "void", statement_block;
    let fn_consumed = parser_consume_if_matches(&parser, TokenCategory::Fn);

    let fn_token = parser_current_token(&parser);
    let has_fn = false;
    match (fn_consumed) {
        ResultOptionToken::Err(err) return ResultOptionFunctionDeclarationNode::Err(parser_error_from_lexer_error(&err));,
        ResultOptionToken::Ok(option_fn) {
            if (option_fn matches OptionToken::Some(token)) {
                fn_token = token;
                has_fn = true;
            }
        }
    }

    if (!has_fn) return ResultOptionFunctionDeclarationNode::Ok(OptionFunctionDeclarationNode::None);

    let identifier_call = parser_parse_identifier(&parser);
    let identifier = IdentifierNode { value: "", span: parser_current_token(&parser).span };
    let found_identifier = false;
    match (identifier_call) {
        ResultOptionIdentifierNode::Err(err) return ResultOptionFunctionDeclarationNode::Err(err);,
        ResultOptionIdentifierNode::Ok(option_identifier) {
            if (option_identifier matches OptionIdentifierNode::Some(i)) {
                identifier = i;
                found_identifier = true;
            }
        }
    }

    if (!found_identifier) return ResultOptionFunctionDeclarationNode::Err(
        parser_create_parser_error(&parser, "Couldn't create identifier while parsing function declaration.")
    );

    let paren_open = parser_consume_must_be(&parser, TokenCategory::ParenOpen);
    if (paren_open matches ResultToken::Err(err)) return ResultOptionFunctionDeclarationNode::Err(err);

    let parameters_call = parser_parse_parameters(&parser);
    let parameters: ParameterNode[] = [];
    match (parameters_call) {
        ResultParameterNodeVec::Err(err) return ResultOptionFunctionDeclarationNode::Err(err);,
        ResultParameterNodeVec::Ok(parsed) parameters = parsed;
    }

    let paren_close = parser_consume_must_be(&parser, TokenCategory::ParenClose);
    if (paren_close matches ResultToken::Err(err)) return ResultOptionFunctionDeclarationNode::Err(err);

    let colon_consumed = parser_consume_must_be(&parser, TokenCategory::Colon);
    if (colon_consumed matches ResultToken::Err(err)) return ResultOptionFunctionDeclarationNode::Err(err);

    let return_type_call = parser_parse_return_type(&parser);
    let return_type = TypeNode { value: Type::Void, span: parser_current_token(&parser).span };
    match (return_type_call) {
        ResultTypeNode::Err(err) return ResultOptionFunctionDeclarationNode::Err(err);,
        ResultTypeNode::Ok(t) return_type = t;
    }

    let block_call = parser_parse_statement_block(&parser);
    match (block_call) {
        ResultOptionBlockNode::Err(err) return ResultOptionFunctionDeclarationNode::Err(err);,
        ResultOptionBlockNode::Ok(option_block) {
            match (option_block) {
                OptionBlockNode::None return ResultOptionFunctionDeclarationNode::Err(
                    parser_create_parser_error(&parser, "Couldn't create statement block while parsing function declaration.")
                );,
                OptionBlockNode::Some(block) return ResultOptionFunctionDeclarationNode::Ok(OptionFunctionDeclarationNode::Some(FunctionDeclarationNode {
                    value: FunctionDeclaration { identifier: identifier, parameters: parameters, return_type: return_type, block: block },
                    span: span_new(fn_token.span.start, block.span.end)
                }));
            }
        }
    }
}
