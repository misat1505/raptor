import "./expressions/arguments.rp";
import "./expressions/identifier-or-call-or-struct-literal-or-enum-literal.rp";
import "./expressions/factor.rp";
import "./expressions/unary-term.rp";
import "./expressions/casted-term.rp";
import "./expressions/multiplicative-term.rp";
import "./expressions/additive-term.rp";
import "./expressions/relation-term.rp";
import "./expressions/concatenation-term.rp";
import "./expressions/expression.rp";

import "./statements/block.rp";
import "./statements/assign-or-call.rp";
import "./statements/declaration.rp";
import "./statements/return-statement.rp";
import "./statements/break-statement.rp";
import "./statements/continue-statement.rp";
import "./statements/import-declaration.rp";
import "./statements/match-statement.rp";
import "./statements/switch-statement.rp";
import "./statements/for-statement.rp";
import "./statements/while-statement.rp";
import "./statements/if-statement.rp";

import "./functions/parameters.rp";
import "./functions/function-declaration.rp";
import "./functions/extern-function-declaration.rp";

import "./structs/struct-declaration.rp";

import "./enums/enum-declaration.rp";

import "./program.rp";
