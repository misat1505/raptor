import "./statements/if_statement.rp";

import "./functions/parameters.rp";
import "./functions/function_declaration.rp";
import "./functions/extern_function_declaration.rp";

import "./structs/struct_declaration.rp";

import "./enums/enum_declaration.rp";

import "./program.rp";
