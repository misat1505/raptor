import "../../../common/span.rp";
import "../../tokens.rp";
import "../ast.rp";
import "../parser-results.rp";
import "../core.rp";

fn parser_parse_break_statement(&Parser parser): ResultOptionStatementNode {
    # break_statement = "break", ";";
    let break_consumed = parser_consume_if_matches(&parser, TokenCategory::Break);

    let break_token = parser_current_token(&parser);
    let has_break = false;
    match (break_consumed) {
        ResultOptionToken::Err(err) return ResultOptionStatementNode::Err(parser_error_from_lexer_error(&err));,
        ResultOptionToken::Ok(option_break) {
            if (option_break matches OptionToken::Some(token)) {
                break_token = token;
                has_break = true;
            }
        }
    }

    if (!has_break) return ResultOptionStatementNode::Ok(OptionStatementNode::None);

    let semicolon_consumed = parser_consume_must_be(&parser, TokenCategory::Semicolon);
    match (semicolon_consumed) {
        ResultToken::Err(err) return ResultOptionStatementNode::Err(err);,
        ResultToken::Ok(semicolon_token) return ResultOptionStatementNode::Ok(OptionStatementNode::Some(StatementNode {
            value: Statement::Break,
            span: span_new(break_token.span.start, semicolon_token.span.end)
        }));
    }
}
