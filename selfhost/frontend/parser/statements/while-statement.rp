import "../../../common/span.rp";
import "../../../common/position.rp";
import "../../../common/errors.rp";
import "../../tokens.rp";
import "../ast.rp";
import "../parser-results.rp";
import "../core.rp";
import "./match-statement.rp";
import "./block.rp";
import "../expressions/expression.rp";

fn while_synthetic_break_block(Span span): BlockNode {
    return BlockNode {
        value: Block { statements: [StatementNode { value: Statement::Break, span: span }] },
        span: span
    };
}

fn parser_parse_while_statement(&Parser parser): ResultOptionStatementNode {
    # while_statement = "while", "(", expression, (
    #      ( ")", statement_block ) |
    #      ( [ "not" ], "matches", match_arm_without_block, ")", statement_block ) );
    let while_consumed = parser_consume_if_matches(&parser, TokenCategory::While);

    let while_token = parser_current_token(&parser);
    let has_while = false;
    match (while_consumed) {
        ResultOptionToken::Err(err) return ResultOptionStatementNode::Err(parser_error_from_lexer_error(&err));,
        ResultOptionToken::Ok(option_while) {
            if (option_while matches OptionToken::Some(token)) {
                while_token = token;
                has_while = true;
            }
        }
    }

    if (!has_while) return ResultOptionStatementNode::Ok(OptionStatementNode::None);

    let paren_open = parser_consume_must_be(&parser, TokenCategory::ParenOpen);
    if (paren_open matches ResultToken::Err(err)) return ResultOptionStatementNode::Err(err);

    let condition_call = parser_parse_expression(&parser);
    let condition = ExpressionNode { value: Expression::Literal(Literal::True), span: parser_current_token(&parser).span };
    let found_condition = false;
    match (condition_call) {
        ResultOptionExpressionNode::Err(err) return ResultOptionStatementNode::Err(err);,
        ResultOptionExpressionNode::Ok(option_condition) {
            if (option_condition matches OptionExpressionNode::Some(expr)) {
                condition = expr;
                found_condition = true;
            }
        }
    }

    if (!found_condition) return ResultOptionStatementNode::Err(
        parser_create_parser_error(&parser, "Couldn't create expression while parsing while statement.")
    );

    let paren_close_consumed = parser_consume_if_matches(&parser, TokenCategory::ParenClose);
    match (paren_close_consumed) {
        ResultOptionToken::Err(err) return ResultOptionStatementNode::Err(parser_error_from_lexer_error(&err));,
        ResultOptionToken::Ok(option_close) {
            if (option_close matches OptionToken::None) {
                return parser_finish_while_matches_statement(&parser, condition, while_token.span.start);
            }
        }
    }

    let block_call = parser_parse_statement_block(&parser);
    match (block_call) {
        ResultOptionBlockNode::Err(err) return ResultOptionStatementNode::Err(err);,
        ResultOptionBlockNode::Ok(option_block) {
            match (option_block) {
                OptionBlockNode::None return ResultOptionStatementNode::Err(
                    parser_create_parser_error(&parser, "Couldn't create statement block while parsing while statement.")
                );,
                OptionBlockNode::Some(block) return ResultOptionStatementNode::Ok(OptionStatementNode::Some(StatementNode {
                    value: Statement::WhileLoop(WhileLoopStatement { condition: condition, block: block }),
                    span: span_new(while_token.span.start, block.span.end)
                }));
            }
        }
    }
}

fn parser_finish_while_matches_statement(&Parser parser, ExpressionNode condition, Position start_position): ResultOptionStatementNode {
    let not_consumed = parser_consume_if_matches(&parser, TokenCategory::Not);
    let is_negating = false;
    match (not_consumed) {
        ResultOptionToken::Err(err) return ResultOptionStatementNode::Err(parser_error_from_lexer_error(&err));,
        ResultOptionToken::Ok(option_not) {
            if (option_not matches OptionToken::Some) is_negating = true;
        }
    }

    let matches_consumed = parser_consume_must_be(&parser, TokenCategory::Matches);
    if (matches_consumed matches ResultToken::Err(err)) return ResultOptionStatementNode::Err(err); 

    let arm_call = parser_parse_match_arm_without_block(&parser);
    let arm = MatchArmNode {
        value: MatchArm { enum_name: IdentifierNode { value: "", span: condition.span }, variant_name: IdentifierNode { value: "", span: condition.span }, variant_value: OptionIdentifierNode::None, block: while_synthetic_break_block(condition.span) },
        span: condition.span
    };
    let found_arm = false;
    match (arm_call) {
        ResultOptionMatchArmNode::Err(err) return ResultOptionStatementNode::Err(err);,
        ResultOptionMatchArmNode::Ok(option_arm) {
            if (option_arm matches OptionMatchArmNode::Some(parsed_arm)) {
                arm = parsed_arm;
                found_arm = true;
            }
        }
    }

    if (!found_arm) return ResultOptionStatementNode::Err(
        parser_create_parser_error(&parser, "Couldn't create match arm while parsing while-matches statement.")
    );

    let paren_close = parser_consume_must_be(&parser, TokenCategory::ParenClose);
    if (paren_close matches ResultToken::Err(err)) return ResultOptionStatementNode::Err(err);

    let body_call = parser_parse_statement_block(&parser);
    let body = while_synthetic_break_block(condition.span);
    let found_body = false;
    match (body_call) {
        ResultOptionBlockNode::Err(err) return ResultOptionStatementNode::Err(err);,
        ResultOptionBlockNode::Ok(option_body) {
            if (option_body matches OptionBlockNode::Some(parsed_body)) {
                body = parsed_body;
                found_body = true;
            }
        }
    }

    if (!found_body) return ResultOptionStatementNode::Err(
        parser_create_parser_error(&parser, "Couldn't create statement block while parsing while-matches statement.")
    );

    if (is_negating) {
        if (arm.value.variant_value matches OptionIdentifierNode::Some(var_val)) return ResultOptionStatementNode::Err(
            parser_error_at(ErrorSeverity::HIGH, "Cannot take the inner value of enum variant in while-not-matches statement.", var_val.span)
        );
    }

    let match_span = span_new(condition.span.start, body.span.end);
    let loop_span = span_new(start_position, body.span.end);
    let break_block = while_synthetic_break_block(condition.span);

    let true_condition = ExpressionNode { value: Expression::Literal(Literal::True), span: condition.span };

    let arm_block = body;
    let rest_block = break_block;
    if (is_negating) {
        arm_block = break_block;
        rest_block = body;
    }

    arm.value.block = arm_block;

    let match_stmt = StatementNode {
        value: Statement::Match(MatchStatement { expression: condition, match_arms: [arm], rest_arm: OptionBlockNode::Some(rest_block) }),
        span: match_span
    };

    let loop_block = BlockNode { value: Block { statements: [match_stmt] }, span: match_span };

    return ResultOptionStatementNode::Ok(OptionStatementNode::Some(StatementNode {
        value: Statement::WhileLoop(WhileLoopStatement { condition: true_condition, block: loop_block }),
        span: loop_span
    }));
}
