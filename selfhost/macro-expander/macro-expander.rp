# ============================================================
# Mirrors `src/macro_expander/macro_expander.rs`
# ============================================================

import "../common/errors.rp";
import "../common/span.rp";
import "../common/position.rp";
import "../../stdlib/string.rp";
import "../frontend/parser/ast.rp";
import "../frontend/parser/parser-results.rp";

struct MacroExpander {
    str[] supported_derives,
    MacroExpanderError[] errors
};

fn macro_expander_new(): MacroExpander {
    return MacroExpander {
        supported_derives: ["Debug", "Json", "Clone"],
        errors: []
    };
}

fn macro_expander_run(&MacroExpander me, &Program program): void {
    macro_expander_expand_derive_macros(&me, &program);
}

fn macro_expander_expand_derive_macros(&MacroExpander me, &Program program): void {
    # Snapshot declared types so we can insert functions while iterating.
    let types: DeclaredType[] = [];
    for (let i = 0; i < vector_size(&program.declared_types); i += 1) {
        vector_push(&types, program.declared_types[i].value);
    }

    for (let i = 0; i < vector_size(&types); i += 1) {
        macro_expander_expand_derive_macros_of_type(&me, &program, types[i]);
    }
}

fn macro_expander_expand_derive_macros_of_type(
    &MacroExpander me,
    &Program program,
    DeclaredType declared_type
): void {
    let type_name = "";
    let type_derives: IdentifierNode[] = [];

    match (declared_type) {
        DeclaredType::Enum(enum_declaration) {
            type_name = enum_declaration.identifier.value;
            type_derives = enum_declaration.enum_derives;
        },
        DeclaredType::Struct(struct_declaration) {
            type_name = struct_declaration.identifier.value;
            type_derives = struct_declaration.struct_derives;
        }
    }

    for (let i = 0; i < vector_size(&type_derives); i += 1) {
        let derive = type_derives[i];
        let is_supported = false;
        for (let j = 0; j < vector_size(&me.supported_derives); j += 1) {
            if (me.supported_derives[j] == derive.value) {
                is_supported = true;
            }
        }

        if (!is_supported) {
            let available = str_join(me.supported_derives, ", ");
            vector_push(&me.errors, macro_expander_error_at(
                ErrorSeverity::HIGH,
                "Use of unsupported derive macro '" + derive.value + "' on type '" + type_name + "'. Available derive macros: " + available + ".",
                derive.span
            ));
            continue;
        }

        if (derive.value == "Debug") {
            macro_expander_derive_debug(&me, &program, declared_type, derive.span);
        } else if (derive.value == "Json") {
            macro_expander_derive_json(&me, &program, declared_type, derive.span);
        } else if (derive.value == "Clone") {
            macro_expander_derive_clone(&me, &program, declared_type, derive.span);
        }
    }
}

fn macro_expander_insert_function(
    &MacroExpander me,
    &Program program,
    FunctionDeclaration function,
    Span derive_span
): void {
    let function_name = function.identifier.value;

    for (let i = 0; i < vector_size(&program.functions); i += 1) {
        if (program.functions[i].value.identifier.value == function_name) {
            vector_push(&me.errors, macro_expander_error_at(
                ErrorSeverity::HIGH,
                "Function '" + function_name + "' conflicts with a function generated by a derive macro. Remove the manually declared function or remove the corresponding derive.",
                derive_span
            ));
            return;
        }
    }

    vector_push(&program.functions, FunctionDeclarationNode {
        value: function,
        span: me_span()
    });
}

fn to_snake_case(str value): str {
    let result = "";
    for (let i = 0; i < str_len(value); i += 1) {
        let c = value[i];
        if (char_is_upper(c) && i > 0) {
            result += "_";
            result += char_to_lower(c);
        } else {
            result += char_to_lower(c);
        }
    }
    return result;
}

# ---------- AST construction helpers (macro_node) ----------

fn me_span(): Span {
    return span_new(
        position_new(0, 0, 0, OptionStr::None),
        position_new(0, 0, 0, OptionStr::None)
    );
}

fn me_ident(str value): IdentifierNode {
    return IdentifierNode { value: value, span: me_span() };
}

fn me_expr(Expression value): ExpressionNode {
    return ExpressionNode { value: value, span: me_span() };
}

fn me_stmt(Statement value): StatementNode {
    return StatementNode { value: value, span: me_span() };
}

fn me_type(Type value): TypeNode {
    return TypeNode { value: value, span: me_span() };
}

fn me_block(StatementNode[] statements): BlockNode {
    return BlockNode { value: Block { statements: statements }, span: me_span() };
}

fn me_str_lit(str s): Expression {
    return Expression::Literal(Literal::String(s));
}

fn me_i64_lit(i64 n): Expression {
    return Expression::Literal(Literal::I64(n));
}

fn me_var(str name): Expression {
    return Expression::Variable(name);
}

fn me_addition(Expression left, Expression right): Expression {
    return Expression::Addition(BinaryExpression {
        left: me_expr(left),
        right: me_expr(right)
    });
}

fn me_less(Expression left, Expression right): Expression {
    return Expression::Less(BinaryExpression {
        left: me_expr(left),
        right: me_expr(right)
    });
}

fn me_field_access(str instance, str field): Expression {
    return Expression::FieldAccess(FieldAccessExpression {
        instance: me_expr(me_var(instance)),
        field: me_ident(field)
    });
}

fn me_index(str collection, str index): Expression {
    return Expression::Index(IndexExpression {
        collection: me_expr(me_var(collection)),
        index: me_expr(me_var(index))
    });
}

fn me_cast_to_str(Expression value): Expression {
    return Expression::Casting(CastingExpression {
        value: me_expr(value),
        to_type: me_type(Type::Str)
    });
}

fn me_call_ref(str fn_name, Expression arg): Expression {
    let args: ArgumentNode[] = [];
    vector_push(&args, ArgumentNode {
        value: Argument {
            value: me_expr(arg),
            passed_by: PassedBy::Reference
        },
        span: me_span()
    });
    return Expression::FunctionCall(FunctionCallExpression {
        identifier: me_ident(fn_name),
        arguments: args
    });
}

fn me_call_value(str fn_name, Expression arg): Expression {
    let args: ArgumentNode[] = [];
    vector_push(&args, ArgumentNode {
        value: Argument {
            value: me_expr(arg),
            passed_by: PassedBy::Value
        },
        span: me_span()
    });
    return Expression::FunctionCall(FunctionCallExpression {
        identifier: me_ident(fn_name),
        arguments: args
    });
}

fn me_return_expr(Expression e): Statement {
    return Statement::Return(OptionExpressionNode::Some(me_expr(e)));
}

fn me_let(str name, Expression value): Statement {
    return Statement::Declaration(DeclarationStatement {
        identifier: me_ident(name),
        kind: VariableDeclarationKind::LET(LetDeclarationKind {
            var_type: OptionTypeNode::None,
            value: me_expr(value)
        })
    });
}

fn me_assign(str name, Expression value): Statement {
    return Statement::Assignment(AssignmentStatement {
        identifier: me_ident(name),
        accessors: [],
        value: me_expr(value)
    });
}

fn me_append_str(str result_var, Expression piece): Statement {
    return me_assign(result_var, me_addition(me_var(result_var), piece));
}

fn me_combine_strings(Expression[] expressions): Expression {
    if (vector_size(&expressions) == 0) return me_str_lit("");
    let result = expressions[0];
    for (let i = 1; i < vector_size(&expressions); i += 1) {
        result = me_addition(result, expressions[i]);
    }
    return result;
}

fn me_param_ref(str type_name, str param_name): ParameterNode {
    return ParameterNode {
        value: Parameter {
            passed_by: PassedBy::Reference,
            parameter_type: me_type(Type::Unresolved(type_name)),
            identifier: me_ident(param_name)
        },
        span: me_span()
    };
}

fn me_find_declared_type(&Program program, str name): OptionDeclaredType {
    for (let i = 0; i < vector_size(&program.declared_types); i += 1) {
        let dt = program.declared_types[i].value;
        let n = "";
        match (dt) {
            DeclaredType::Struct(s) n = s.identifier.value;,
            DeclaredType::Enum(e) n = e.identifier.value;
        }
        if (n == name) return OptionDeclaredType::Some(dt);
    }
    return OptionDeclaredType::None;
}

fn me_type_has_derive(&Program program, str type_name, str derive_name): bool {
    let found = me_find_declared_type(&program, type_name);
    match (found) {
        OptionDeclaredType::None return false;,
        OptionDeclaredType::Some(dt) {
            let type_derives: IdentifierNode[] = [];
            match (dt) {
                DeclaredType::Struct(s) type_derives = s.struct_derives;,
                DeclaredType::Enum(e) type_derives = e.enum_derives;
            }
            for (let i = 0; i < vector_size(&type_derives); i += 1) {
                if (type_derives[i].value == derive_name) return true;
            }
            return false;
        }
    }
}

fn me_function_exists(&Program program, str name): bool {
    for (let i = 0; i < vector_size(&program.functions); i += 1) {
        if (program.functions[i].value.identifier.value == name) return true;
    }
    return false;
}

# Optional declared type carrier for lookups (parser has no OptionDeclaredType).
enum OptionDeclaredType {
    Some(DeclaredType),
    None
};
