import "./frontend/lexer/lazy-stream-reader.rp";
import "./frontend/lexer/lexer.rp";

struct TokenCapture derives Debug {
    Token[] tokens
};

fn main(): void {
    let myself = "./selfhost/main.rp";
    let source = read_file(myself);

    let src = lazy_stream_reader_new(source, OptionStr::Some(myself));

    let options = LexerOptions {
        max_comment_length: 1024,
        max_identifier_length: 256
    };

    let lexer = lexer_new(src, options);

    let token_capture = TokenCapture { tokens: [] };

    while (true) {
        let token_result = lexer_next(&lexer);

        match (token_result) {
            ResultOptionToken::Err(err) {
                println(lexer_error_get_stderr_message(&err));
                break;
            },
            ResultOptionToken::Ok(token) {
                match (token) {
                    OptionToken::Some(value) {
                        vector_push(&token_capture.tokens, value);

                        if (value.category matches TokenCategory::ETX) {
                            break;
                        }

                        let stringified = token_category_to_string(value.category);
                        let whitespaces = 20 - str_len(stringified);
                        print(token_category_to_string(value.category));
                        for (let i = 0; i < whitespaces; i += 1) print(" ");
                        println(position_display(&value.span.start) + "\t-> " + position_display(&value.span.end));
                    },

                    OptionToken::None {
                        println("No token produced");
                        break;
                    }
                }
            }
        }
    }

    # Dump into rust file only to use it's formatter since Raptor code and Rust code are similar.
    let output_path = "./selfhost/tokens.rs";
    let rust_code = "fn main() {let foo = " + token_capture_debug(&token_capture) + ";}";
    write_file(output_path, rust_code);
}

main();
