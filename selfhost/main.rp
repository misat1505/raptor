import "./frontend/lexer/lazy-stream-reader.rp";

fn main(): void {
    let code = "let a = 2 + 3;";
    let lsr = lazy_stream_reader_new(code, OptionStr::Some("foo.rp"));
    
    while (lazy_stream_reader_current(&lsr) != (3 as u8) as char) {
        println(lazy_stream_reader_current(&lsr) as str);
        lazy_stream_reader_next(&lsr);
    }
}

main();
