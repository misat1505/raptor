import "./frontend/lexer/lazy-stream-reader.rp";
import "./frontend/lexer/lexer.rp";
import "./frontend/parser/parser-mod.rp";
import "./import-resolver/import-resolver.rp";
import "./macro-expander/macro-expander-mod.rp";

fn main(): void {
    let myself = "./selfhost/raptor.rp";
    let source = read_file(myself);

    let src = lazy_stream_reader_new(source, OptionStr::Some(myself));

    let options = LexerOptions {
        max_comment_length: 1024,
        max_identifier_length: 256
    };

    let lexer = lexer_new(src, options);

    let parser_result = parser_new(lexer);

    match (parser_result) {
        ResultParser::Err(err) {
            println(parser_error_get_stderr_message(&err));
            return;
        },
        ResultParser::Ok(parser) {
            let program_result = parser_parse(&parser);

            match (program_result) {
                ResultProgram::Err(err) {
                    println(parser_error_get_stderr_message(&err));
                    return;
                },
                ResultProgram::Ok(program) {
                    # 1) Import resolution (merge modules, cycle detection, cache)
                    let resolver = import_resolver_new(options);
                    let resolved_result = import_resolver_resolve(
                        &resolver,
                        myself,
                        &program
                    );

                    match (resolved_result) {
                        ResultProgram::Err(err) {
                            println(parser_error_get_stderr_message(&err));
                            return;
                        },
                        ResultProgram::Ok(merged) {
                            # 2) Macro expansion (derive Debug / Json / Clone)
                            let expander = macro_expander_new();
                            macro_expander_run(&expander, &merged);

                            if (vector_size(&expander.errors) > 0) {
                                for (let i = 0; i < vector_size(&expander.errors); i += 1) {
                                    let err = expander.errors[i];
                                    println(error_severity_to_string(err.level) + ": " + err.message);
                                }
                                println("Macro expander finished with "
                                    + vector_size(&expander.errors) as str
                                    + " error(s).");
                                return;
                            }

                            println("Pipeline OK: "
                                + vector_size(&merged.statements) as str + " statement(s), "
                                + vector_size(&merged.functions) as str + " function(s) (incl. derived), "
                                + vector_size(&merged.extern_functions) as str + " extern(s), "
                                + vector_size(&merged.declared_types) as str + " type(s).");

                            let output_path = "./selfhost/ast.rp";
                            let dump = "let ast = " + program_debug(&merged) + ";";
                            write_file(output_path, dump);

                            println("Wrote expanded AST dump to " + output_path);
                        }
                    }
                }
            }
        }
    }
}

main();
