# Shared helpers for the selfhost semantic checker.

import "../common/errors.rp";
import "../common/span.rp";
import "../frontend/parser/ast.rp";

enum ResultType {
    Ok(Type),
    Err(SemanticCheckerError)
};

enum OptionType {
    Some(Type),
    None
};

enum ResultSem {
    Ok,
    Err(SemanticCheckerError)
};

fn type_to_string(Type t): str {
    match (t) {
        Type::Bool return "bool";,
        Type::Str return "str";,
        Type::Char return "char";,
        Type::I8 return "i8";,
        Type::I16 return "i16";,
        Type::I32 return "i32";,
        Type::I64 return "i64";,
        Type::U8 return "u8";,
        Type::U16 return "u16";,
        Type::U32 return "u32";,
        Type::U64 return "u64";,
        Type::F64 return "f64";,
        Type::Void return "void";,
        Type::Vector(inner) return type_to_string(inner) + "[]";,
        Type::Unresolved(name) return name;
    }
}

fn type_eq(Type a, Type b): bool {
    match (a) {
        Type::Bool {
            if (b matches Type::Bool) return true;
            return false;
        },
        Type::Str {
            if (b matches Type::Str) return true;
            return false;
        },
        Type::Char {
            if (b matches Type::Char) return true;
            return false;
        },
        Type::I8 {
            if (b matches Type::I8) return true;
            return false;
        },
        Type::I16 {
            if (b matches Type::I16) return true;
            return false;
        },
        Type::I32 {
            if (b matches Type::I32) return true;
            return false;
        },
        Type::I64 {
            if (b matches Type::I64) return true;
            return false;
        },
        Type::U8 {
            if (b matches Type::U8) return true;
            return false;
        },
        Type::U16 {
            if (b matches Type::U16) return true;
            return false;
        },
        Type::U32 {
            if (b matches Type::U32) return true;
            return false;
        },
        Type::U64 {
            if (b matches Type::U64) return true;
            return false;
        },
        Type::F64 {
            if (b matches Type::F64) return true;
            return false;
        },
        Type::Void {
            if (b matches Type::Void) return true;
            return false;
        },
        Type::Vector(ai) {
            match (b) {
                Type::Vector(bi) return type_eq(ai, bi);,
                rest return false;
            }
        },
        Type::Unresolved(an) {
            match (b) {
                Type::Unresolved(bn) return an == bn;,
                rest return false;
            }
        }
    }
}

# Empty vector of any element type is compatible with typed vectors.
fn type_compatible(Type expected, Type actual): bool {
    if (type_eq(expected, actual)) return true;

    match (expected) {
        Type::Vector(ei) {
            match (actual) {
                Type::Vector(ai) {
                    if (ai matches Type::Void) return true;
                    return type_eq(ei, ai);
                },
                rest return false;
            }
        },
        rest return false;
    }
}