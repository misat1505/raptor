
    fn is_prime(i64 x): bool {
      if (x < 2) {
        return false;
      }

      for (i64 i = 2; i < x / 2; i = i + 1) {
        if (x % i == 0) {
          return false;
        }
      }

      return true;
    }

    bool is_5 = is_prime(5);
    bool is_6 = is_prime(6);
    println(is_5 as str);
    println(is_6 as str);
    