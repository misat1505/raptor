
enum AccountStatus {
    Active,
    Suspended(str),
    Deleted(Timestamp)
};

struct Timestamp {
    i64 day,
    i64 month,
    i64 year
};

let statuses = [
    AccountStatus::Active,
    AccountStatus::Suspended("spam"),
    AccountStatus::Deleted(Timestamp { day: 17, month: 9, year: 2026 })
];

for (let i = 0; i < vector_size(&statuses); i += 1) {
    if (statuses[i] not matches AccountStatus::Active) {
        println("inactive");
    } else {
        println("active");
    }
}
        