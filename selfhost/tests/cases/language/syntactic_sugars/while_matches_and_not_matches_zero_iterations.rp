enum AccountStatus {
    Active,
    Suspended(str),
    Deleted(Timestamp)
};

struct Timestamp {
    i64 day,
    i64 month,
    i64 year
};


let status = AccountStatus::Active;

while (true) {
    if (status matches AccountStatus::Deleted(timestamp)) {
        println("should not print (matches)");
        break;
    } else {
        break;
    }
}

while (true) {
    if (status matches AccountStatus::Active) {
        break;
    } else {
        println("should not print (not matches)");
        break;
    }
}

println("done");
