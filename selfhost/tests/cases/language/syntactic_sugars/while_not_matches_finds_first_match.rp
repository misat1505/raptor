enum AccountStatus {
    Active,
    Suspended(str),
    Deleted(Timestamp)
};

struct Timestamp {
    i64 day,
    i64 month,
    i64 year
};


let statuses = [
    AccountStatus::Active,
    AccountStatus::Suspended("spam"),
    AccountStatus::Deleted(Timestamp { day: 17, month: 9, year: 2026 })
];

let idx = 0;

while (true) {
    if (statuses[idx] matches AccountStatus::Deleted) {
        break;
    } else {
        idx += 1;
    }
}

println(idx as str);
