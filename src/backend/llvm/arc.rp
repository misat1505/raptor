# ============================================================
# Automatic reference counting for the self-hosted LLVM backend.
#
# Every managed object (str, vector, struct, enum) is allocated with a 16-byte
# header IN FRONT of the pointer user code sees:
#
#       p - 16 : i64 refcount   (negative = immortal, e.g. string literals)
#       p -  8 : ptr drop       (void(ptr) releasing children, or null)
#       p      : the object, laid out exactly as before
#
# Because the header is in front, a `str` is still a plain char* (libc keeps
# working on it) and no field offset changes. retain / release are type
# agnostic: all type knowledge lives in the per-type drop functions.
# ============================================================

import "./ir-builder.rp";
import "./compiler-core.rp";
import "../../frontend/parser/ast.rp";


extend LLVMIRCodegen {
    fn emit_drop_functions(self): void {
        if (!self.arc) {
            return;
        }
        for (let t = 0; t < vector_size(&self.program.declared_types); t += 1) {
            if (self.program.declared_types[t].value matches DeclaredType::Struct(sd)) {
                let name = sd.identifier.value;
                if (self.struct_drop_ref(name) != "null") {
                    self.ir.emit("define void @drop.struct." + name + "(ptr %p) {");
                    self.ir.emit("entry:");
                    for (let m = 0; m < vector_size(&sd.members); m += 1) {
                        if (self.type_is_managed(sd.members[m].value.member_type.value)) {
                            self.ir.emit(
                                "  %f"
                                    + m as str
                                    + ".p = getelementptr i8, ptr %p, i64 "
                                    + (m * 8) as str
                            );
                            self.ir.emit(
                                "  %f" + m as str + " = load ptr, ptr %f" + m as str + ".p"
                            );
                            self.ir.emit("  call void @rt_release(ptr %f" + m as str + ")");
                        }
                    }
                    self.ir.emit("  ret void");
                    self.ir.emit("}");
                    self.ir.emit("");
                }
            }
            if (self.program.declared_types[t].value matches DeclaredType::Enum(ed)) {
                let name = ed.identifier.value;
                if (self.enum_drop_ref(name) != "null") {
                    self.ir.emit("define void @drop.enum." + name + "(ptr %p) {");
                    self.ir.emit("entry:");
                    self.ir.emit("  %tagp = getelementptr i8, ptr %p, i64 8");
                    self.ir.emit("  %tag = load i64, ptr %tagp");
                    self.ir.emit("  %payp = getelementptr i8, ptr %p, i64 16");
                    let cases = "";
                    for (let m = 0; m < vector_size(&ed.members); m += 1) {
                        if (ed.members[m].value.member_type matches OptionTypeNode::Some(tn)) {
                            if (self.type_is_managed(tn.value)) {
                                cases += " i64 " + m as str + ", label %v" + m as str;
                            }
                        }
                    }
                    self.ir.emit("  switch i64 %tag, label %done [" + cases + " ]");
                    for (let m = 0; m < vector_size(&ed.members); m += 1) {
                        if (ed.members[m].value.member_type matches OptionTypeNode::Some(tn)) {
                            if (self.type_is_managed(tn.value)) {
                                self.ir.emit("v" + m as str + ":");
                                self.ir.emit("  %pl" + m as str + " = load ptr, ptr %payp");
                                self.ir.emit("  call void @rt_release(ptr %pl" + m as str + ")");
                                self.ir.emit("  br label %done");
                            }
                        }
                    }
                    self.ir.emit("done:");
                    self.ir.emit("  ret void");
                    self.ir.emit("}");
                    self.ir.emit("");
                }
            }
        }
    }

    fn copy_alloc(self, str size, str drop): str {
        if (self.arc) {
            return "call ptr @rt_alloc(i64 " + size + ", ptr " + drop + ")";
        }
        return "call ptr @malloc(i64 " + size + ")";
    }

    fn emit_copy_functions(self): void {
        let L: str[] = [];

        # ---- str ----
        vector_push(&L, "define ptr @rt_str_copy(ptr %s) {");
        vector_push(&L, "entry:");
        vector_push(&L, "  %isnull = icmp eq ptr %s, null");
        vector_push(&L, "  br i1 %isnull, label %nul, label %cp");
        vector_push(&L, "nul:");
        vector_push(&L, "  ret ptr null");
        vector_push(&L, "cp:");
        vector_push(&L, "  %len = call i64 @strlen(ptr %s)");
        vector_push(&L, "  %sz = add i64 %len, 1");
        vector_push(&L, "  %buf = " + self.copy_alloc("%sz", "null"));
        vector_push(&L, "  %r = call ptr @memcpy(ptr %buf, ptr %s, i64 %sz)");
        vector_push(&L, "  ret ptr %buf");
        vector_push(&L, "}");
        vector_push(&L, "");

        # ---- vector: { elements_are_managed, data, len, cap } ----
        vector_push(&L, "define ptr @rt_vec_copy(ptr %v) {");
        vector_push(&L, "entry:");
        vector_push(&L, "  %flag = load i64, ptr %v");
        vector_push(&L, "  %dpp = getelementptr i8, ptr %v, i64 8");
        vector_push(&L, "  %data = load ptr, ptr %dpp");
        vector_push(&L, "  %lp = getelementptr i8, ptr %v, i64 16");
        vector_push(&L, "  %len = load i64, ptr %lp");
        vector_push(&L, "  %cp = getelementptr i8, ptr %v, i64 24");
        vector_push(&L, "  %cap = load i64, ptr %cp");
        vector_push(&L, "  %new = " + self.copy_alloc("32", "@rt_drop_vec"));
        vector_push(&L, "  store i64 %flag, ptr %new");
        vector_push(&L, "  %ndp = getelementptr i8, ptr %new, i64 8");
        vector_push(&L, "  %nlp = getelementptr i8, ptr %new, i64 16");
        vector_push(&L, "  store i64 %len, ptr %nlp");
        vector_push(&L, "  %ncp = getelementptr i8, ptr %new, i64 24");
        vector_push(&L, "  store i64 %cap, ptr %ncp");
        vector_push(&L, "  %has = icmp sgt i64 %cap, 0");
        vector_push(&L, "  br i1 %has, label %copy, label %empty");
        vector_push(&L, "empty:");
        vector_push(&L, "  store ptr null, ptr %ndp");
        vector_push(&L, "  ret ptr %new");
        vector_push(&L, "copy:");
        vector_push(&L, "  %cb = mul i64 %cap, 8");
        vector_push(&L, "  %nd = call ptr @malloc(i64 %cb)");
        vector_push(&L, "  store ptr %nd, ptr %ndp");
        vector_push(&L, "  %lb = mul i64 %len, 8");
        vector_push(&L, "  %m = call ptr @memcpy(ptr %nd, ptr %data, i64 %lb)");
        if (self.arc) {
            vector_push(&L, "  %mg = icmp ne i64 %flag, 0");
            vector_push(&L, "  %idx = alloca i64");
            vector_push(&L, "  store i64 0, ptr %idx");
            vector_push(&L, "  br i1 %mg, label %rc, label %done");
            vector_push(&L, "rc:");
            vector_push(&L, "  %i = load i64, ptr %idx");
            vector_push(&L, "  %k = icmp slt i64 %i, %len");
            vector_push(&L, "  br i1 %k, label %rb, label %done");
            vector_push(&L, "rb:");
            vector_push(&L, "  %slot = getelementptr ptr, ptr %nd, i64 %i");
            vector_push(&L, "  %el = load ptr, ptr %slot");
            vector_push(&L, "  call void @rt_retain(ptr %el)");
            vector_push(&L, "  %nx = add i64 %i, 1");
            vector_push(&L, "  store i64 %nx, ptr %idx");
            vector_push(&L, "  br label %rc");
            vector_push(&L, "done:");
        }
        vector_push(&L, "  ret ptr %new");
        vector_push(&L, "}");
        vector_push(&L, "");
        for (let i = 0; i < vector_size(&L); i += 1) {
            self.ir.emit(L[i]);
        }

        # ---- one copy function per struct ----
        for (let t = 0; t < vector_size(&self.program.declared_types); t += 1) {
            if (self.program.declared_types[t].value matches DeclaredType::Struct(sd)) {
                let name = sd.identifier.value;
                let nf = vector_size(&sd.members);
                self.ir.emit("define ptr @copy.struct." + name + "(ptr %p) {");
                self.ir.emit("entry:");
                self.ir.emit(
                    "  %new = " + self.copy_alloc(((nf + 1) * 8) as str, self.struct_drop_ref(name))
                );
                for (let m = 0; m < nf; m += 1) {
                    let off = (m * 8) as str;
                    self.ir.emit("  %s" + m as str + " = getelementptr i8, ptr %p, i64 " + off);
                    self.ir.emit("  %d" + m as str + " = getelementptr i8, ptr %new, i64 " + off);
                    if (self.arc && self.type_is_managed(sd.members[m].value.member_type.value)) {
                        self.ir.emit("  %v" + m as str + " = load ptr, ptr %s" + m as str);
                        self.ir.emit("  store ptr %v" + m as str + ", ptr %d" + m as str);
                        self.ir.emit("  call void @rt_retain(ptr %v" + m as str + ")");
                    } else {
                        self.ir.emit("  %v" + m as str + " = load i64, ptr %s" + m as str);
                        self.ir.emit("  store i64 %v" + m as str + ", ptr %d" + m as str);
                    }
                }
                self.ir.emit("  %rcp = getelementptr i8, ptr %new, i64 " + (nf * 8) as str);
                self.ir.emit("  store i64 1, ptr %rcp");
                self.ir.emit("  ret ptr %new");
                self.ir.emit("}");
                self.ir.emit("");
            }
        }
    }
};

# One `void(ptr)` per struct / enum that owns managed fields / payloads.
# Emits the allocation of `size` bytes in the mode the program is compiled in.
