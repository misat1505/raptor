import "../../frontend/parser/ast.rp";
import "../../common/span.rp";
import "./ir-builder.rp";
import "./types-ir.rp";
import "../../common/errors.rp";


# Source file kept in memory for runtime-check diagnostics.
struct SourceLines {
    str path,
    str[] lines
};

struct CompilerVar {
    str name,
    str ptr,
    str ty,
    str rty,
    bool owned
};

# Raptor-level type name of the variable: "str", a struct name, or "" when
# unknown. In the LLVM IR `str`, vectors and structs are all plain `ptr`,
# so this is what lets indexing tell a string (bytes) apart from a vector
# (8-byte slots), and lets field access find the right struct.

# True when this slot owns a reference (ARC): it is released when the scope
# ends. Parameters and match bindings only borrow, so they are not owned.

# Memory management mode: true = automatic reference counting (default),
# false = leak everything (fast for short-lived processes).

# Integer overflow policy: "ignore" (default, no checks), "warn" (print and
# continue with the wrapped value) or "error" (print and exit(1)).

# locals.len() at the start of each enclosing loop body (parallel to
# break_stack), so `break` / `continue` know which locals to release.

# `alloca`s of the current function. They are emitted in one block after the
# body (entry -> allocas -> start): an alloca inside a loop would otherwise
# grow the stack on every iteration.

# Helper functions generated on demand (vector_stringify per element type),
# emitted after the program.

# Fresh (+1) values that were only used as the base of `.field` / `[i]`
# (`make().field`). The field is borrowed from them, so they are released when
# the statement that created them ends (or on return / break / continue).

# temps.len() at the start of each enclosing loop body (parallel to break_stack)

# Same for `continue`: it targets the enclosing loop even from inside a switch,
# so it needs marks that only loops (not switches) push.

struct LLVMIRCodegen {
    IrBuilder ir,
    CompilerVar[] locals,
    str last_value,
    str last_type,
    str[] errors,
    str[] break_stack,
    str[] continue_stack,
    str current_ret_ty,
    bool has_terminator,
    Program program,
    i64 local_id,
    bool arc,
    str overflow,
    i64[] loop_marks,
    str[] allocas,
    SourceLines[] sources,
    str[] extra_fn_names,
    str[] extra_fns,
    str[] temps,
    i64[] loop_temp_marks,
    i64[] cont_marks,
    i64[] cont_temp_marks

    fn new(): LLVMIRCodegen {
        return LLVMIRCodegen {
            ir: IrBuilder.new(),
            locals: [],
            last_value: "0",
            last_type: "i64",
            errors: [],
            break_stack: [],
            continue_stack: [],
            current_ret_ty: "i32",
            has_terminator: false,
            program: Program {
                statements: [],
                functions: [],
                extern_functions: [],
                declared_types: [],
                extend_blocks: [],
                interfaces: []
            },
            local_id: 0,
            arc: true,
            overflow: "ignore",
            loop_marks: [],
            allocas: [],
            sources: [],
            extra_fn_names: [],
            extra_fns: [],
            temps: [],
            loop_temp_marks: [],
            cont_marks: [],
            cont_temp_marks: []
        };
    }

    fn error(self, str msg): void {
        self.errors.push(msg);
    }

    fn set_last(self, str value, str ty): void {
        self.last_value = value;
        self.last_type = ty;
    }

    fn find_local(self, str name): i64 {
        for (let i = self.locals.size() - 1; i >= 0; i -= 1) {
            if (self.locals[i].name == name) {
                return i;
            }
        }
        return -1;
    }

    fn declare_local(self, str name, str ty): str {
        let n = self.local_id;
        self.local_id += 1;
        let ptr = "%" + name + "." + n as str + ".addr";
        self.allocas.push("  " + ptr + " = alloca " + ty);
        self.locals.push(CompilerVar { name, ptr, ty, rty: "", owned: false });
        return ptr;
    }

    fn set_last_local_rty(self, str rty): void {
        let last = self.locals.size() - 1;
        if (last >= 0) {
            self.locals[last].rty = rty;
        }
    }

    fn llvm_rty_element(str rty): str {
        let n = rty.size();

        # Raptor's `&&` does not short-circuit and indexing is bounds-checked, so
        # the length test has to be its own `if`.
        if (n < 2) {
            return "";
        }
        if (rty[n - 1] == ']' && rty[n - 2] == '[') {
            let out = "";
            for (let i = 0; i < n - 2; i += 1) {
                out += rty[i];
            }
            return out;
        }
        return "";
    }

    fn push_scope_marker(self): i64 {
        return self.locals.size();
    }

    fn pop_scope(self, i64 marker): void {
        let kept: CompilerVar[] = [];
        for (let i = 0; i < marker; i += 1) {
            kept.push(self.locals[i]);
        }
        self.locals = kept;
    }

    fn lookup_struct(self, str name): OptionStructDeclaration {
        for (let i = 0; i < self.program.declared_types.size(); i += 1) {
            if (self.program.declared_types[i].value matches DeclaredType::Struct(s)) {
                if (s.identifier.value == name) {
                    return OptionStructDeclaration::Some(s);
                }
            }
        }
        return OptionStructDeclaration::None;
    }

    fn lookup_enum(self, str name): OptionEnumDeclaration {
        for (let i = 0; i < self.program.declared_types.size(); i += 1) {
            if (self.program.declared_types[i].value matches DeclaredType::Enum(e)) {
                if (e.identifier.value == name) {
                    return OptionEnumDeclaration::Some(e);
                }
            }
        }
        return OptionEnumDeclaration::None;
    }

    fn enum_variant_tag(self, str enum_name, str variant): i64 {
        if (self.lookup_enum(enum_name) matches OptionEnumDeclaration::Some(ed)) {
            for (let i = 0; i < ed.members.size(); i += 1) {
                if (ed.members[i].value.identifier.value == variant) {
                    return i;
                }
            }
        }
        return 0;
    }

    fn struct_field_index(self, str struct_name, str field): i64 {
        if (self.lookup_struct(struct_name) matches OptionStructDeclaration::Some(sd)) {
            for (let i = 0; i < sd.members.size(); i += 1) {
                if (sd.members[i].value.identifier.value == field) {
                    return i;
                }
            }
        }
        return 0;
    }

    fn struct_field_count(self, str struct_name): i64 {
        match (self.lookup_struct(struct_name)) {
            OptionStructDeclaration::Some(sd) {
                return sd.members.size();
            },
            OptionStructDeclaration::None {
                return 0;
            }
        }
    }

    fn char_to_str(self, str value): str {
        let buf = self.alloc_bytes("2", "null");
        let byte = self.ir.tmp();
        self.ir.emit("  " + byte + " = trunc i32 " + value + " to i8");
        self.ir.emit("  store i8 " + byte + ", ptr " + buf);
        let nul_p = self.ir.tmp();
        self.ir.emit("  " + nul_p + " = getelementptr i8, ptr " + buf + ", i64 1");
        self.ir.emit("  store i8 0, ptr " + nul_p);
        return buf;
    }

    fn to_str_value(self, str value, str ty): str {
        if (ty == "ptr") {
            return value;
        }
        if (ty == "i1") {
            return self.bool_to_str(value);
        }
        let buf = self.alloc_bytes("64", "null");
        if (ty == "double") {
            let dfmt = self.ir.cstr_global("%g");
            let dfp = self.ir.tmp();
            self.ir.emit(
                "  " + dfp + " = getelementptr inbounds [3 x i8], ptr " + dfmt + ", i64 0, i64 0"
            );
            self.ir.emit(
                "  "
                    + self.ir.tmp()
                    + " = call i32 (ptr, i64, ptr, ...) @snprintf(ptr "
                    + buf
                    + ", i64 64, ptr "
                    + dfp
                    + ", double "
                    + value
                    + ")"
            );
            return buf;
        }
        let fmt = self.ir.cstr_global("%lld");
        let n = 5;
        let fp = self.ir.tmp();
        self.ir.emit(
            "  "
                + fp
                + " = getelementptr inbounds ["
                + n as str
                + " x i8], ptr "
                + fmt
                + ", i64 0, i64 0"
        );

        # snprintf expects i64 for %lld
        let v = value;
        if (ty == "i64") {
            v = value;
        } else if (ty == "i1") {
            let e = self.ir.tmp();
            self.ir.emit("  " + e + " = zext i1 " + value + " to i64");
            v = e;
        } else if (ty == "i8" || ty == "i16" || ty == "i32") {
            let e = self.ir.tmp();
            self.ir.emit("  " + e + " = zext " + ty + " " + value + " to i64");
            v = e;
        } else if (ty == "double") {
            let e = self.ir.tmp();
            self.ir.emit("  " + e + " = fptosi double " + value + " to i64");
            v = e;
        }

        self.ir.emit(
            "  "
                + self.ir.tmp()
                + " = call i32 (ptr, i64, ptr, ...) @snprintf(ptr "
                + buf
                + ", i64 64, ptr "
                + fp
                + ", i64 "
                + v
                + ")"
        );
        return buf;
    }

    fn mark_last_owned(self): void {
        let last = self.locals.size() - 1;
        if (last >= 0) {
            self.locals[last].owned = true;
        }
    }

    fn emit_retain(self, str v): void {
        if (self.arc) {
            self.ir.emit("  call void @rt_retain(ptr " + v + ")");
        }
    }

    fn emit_release(self, str v): void {
        if (self.arc) {
            self.ir.emit("  call void @rt_release(ptr " + v + ")");
        }
    }

    fn alloc_bytes(self, str size, str drop): str {
        let p = self.ir.tmp();
        if (self.arc) {
            self.ir.emit("  " + p + " = call ptr @rt_alloc(i64 " + size + ", ptr " + drop + ")");
        } else {
            self.ir.emit("  " + p + " = call ptr @malloc(i64 " + size + ")");
        }
        return p;
    }

    fn str_literal(self, str text): str {
        let n = text.size() + 1;
        let tmp = self.ir.tmp();
        if (self.arc) {
            let g = self.ir.managed_str_global(text);
            self.ir.emit(
                "  "
                    + tmp
                    + " = getelementptr inbounds { i64, i64, ["
                    + n as str
                    + " x i8] }, ptr "
                    + g
                    + ", i32 0, i32 2"
            );
        } else {
            let g = self.ir.cstr_global(text);
            self.ir.emit(
                "  "
                    + tmp
                    + " = getelementptr inbounds ["
                    + n as str
                    + " x i8], ptr "
                    + g
                    + ", i64 0, i64 0"
            );
        }
        return tmp;
    }

    fn emit_release_locals_from(self, i64 start): void {
        if (!self.arc) {
            return;
        }
        let i = self.locals.size() - 1;
        while (i >= start) {
            if (self.locals[i].owned) {
                let v = self.ir.tmp();
                self.ir.emit("  " + v + " = load ptr, ptr " + self.locals[i].ptr);
                self.emit_release(v);
            }
            i -= 1;
        }
    }

    fn expr_is_borrowed(ExpressionNode e): bool {
        match (e.value) {
            Expression::Variable {
                return true;
            },
            Expression::FieldAccess {
                return true;
            },
            Expression::Index {
                return true;
            },
            rest {
                return false;
            }
        }
    }

    fn type_is_managed(self, Type t): bool {
        if (t matches Type::Str) {
            return true;
        }
        if (t matches Type::Vector) {
            return true;
        }
        if (t matches Type::Unresolved(n)) {
            if (self.lookup_struct(n) matches OptionStructDeclaration::Some) {
                return true;
            }
            if (self.lookup_enum(n) matches OptionEnumDeclaration::Some) {
                return true;
            }
        }
        return false;
    }

    fn struct_drop_ref(self, str name): str {
        if (!self.arc) {
            return "null";
        }
        if (self.lookup_struct(name) matches OptionStructDeclaration::Some(sd)) {
            for (let m = 0; m < sd.members.size(); m += 1) {
                if (self.type_is_managed(sd.members[m].value.member_type.value)) {
                    return "@drop.struct." + name;
                }
            }
        }
        return "null";
    }

    fn enum_drop_ref(self, str name): str {
        if (!self.arc) {
            return "null";
        }
        if (self.lookup_enum(name) matches OptionEnumDeclaration::Some(ed)) {
            for (let m = 0; m < ed.members.size(); m += 1) {
                if (ed.members[m].value.member_type matches OptionTypeNode::Some(tn)) {
                    if (self.type_is_managed(tn.value)) {
                        return "@drop.enum." + name;
                    }
                }
            }
        }
        return "null";
    }

    fn rname_prim_ty(str rty): str {
        if (rty == "bool") {
            return "i1";
        }
        if (rty == "i8" || rty == "u8") {
            return "i8";
        }
        if (rty == "i16" || rty == "u16") {
            return "i16";
        }
        if (rty == "i32" || rty == "u32" || rty == "char") {
            return "i32";
        }
        if (rty == "i64" || rty == "u64") {
            return "i64";
        }
        if (rty == "f64") {
            return "double";
        }
        return "";
    }

    fn begin_body(self): void {
        let fresh: str[] = [];
        self.allocas = fresh;
        let no_temps: str[] = [];
        self.temps = no_temps;
        self.ir.emit("entry:");
    }

    fn end_body(self): void {
        self.ir.emit("allocas:");
        for (let i = 0; i < self.allocas.size(); i += 1) {
            self.ir.emit(self.allocas[i]);
        }
        self.ir.emit("  br label %start");
    }

    fn rname_is_unsigned(str r): bool {
        return r == "u8" || r == "u16" || r == "u32" || r == "u64" || r == "char" || r == "bool";
    }

    fn rname_is_int(str r): bool {
        return
            r == "i8"
                || r == "i16"
                || r == "i32"
                || r == "i64"
                || r == "u8"
                || r == "u16"
                || r == "u32"
                || r == "u64";
    }

    fn ty_bits(str ty): i64 {
        if (ty == "i1") {
            return 1;
        }
        if (ty == "i8") {
            return 8;
        }
        if (ty == "i16") {
            return 16;
        }
        if (ty == "i32") {
            return 32;
        }
        return 64;
    }

    fn ty_default_rty(str ty): str {
        if (ty == "i1") {
            return "bool";
        }
        if (ty == "i8") {
            return "i8";
        }
        if (ty == "i16") {
            return "i16";
        }
        if (ty == "i32") {
            return "i32";
        }
        if (ty == "i64") {
            return "i64";
        }
        if (ty == "double") {
            return "f64";
        }
        return "";
    }

    fn int_max_signed(i64 bits): str {
        if (bits == 8) {
            return "127";
        }
        if (bits == 16) {
            return "32767";
        }
        if (bits == 32) {
            return "2147483647";
        }
        return "9223372036854775807";
    }

    fn int_min_signed(i64 bits): str {
        if (bits == 8) {
            return "-128";
        }
        if (bits == 16) {
            return "-32768";
        }
        if (bits == 32) {
            return "-2147483648";
        }
        return "-9223372036854775808";
    }

    fn int_max_unsigned(i64 bits): str {
        if (bits == 8) {
            return "255";
        }
        if (bits == 16) {
            return "65535";
        }
        if (bits == 32) {
            return "4294967295";
        }
        return "-1";
    }

    fn resize_int(self, str v, str from, str to, bool from_signed): str {
        if (from == to) {
            return v;
        }
        let src = v;
        let src_ty = from;
        if (from == "ptr") {
            let p = self.ir.tmp();
            self.ir.emit("  " + p + " = ptrtoint ptr " + v + " to i64");
            src = p;
            src_ty = "i64";
        }
        if (src_ty == to) {
            return src;
        }
        let r = self.ir.tmp();
        if (LLVMIRCodegen.ty_bits(src_ty) > LLVMIRCodegen.ty_bits(to)) {
            self.ir.emit("  " + r + " = trunc " + src_ty + " " + src + " to " + to);
        } else if (from_signed) {
            self.ir.emit("  " + r + " = sext " + src_ty + " " + src + " to " + to);
        } else {
            self.ir.emit("  " + r + " = zext " + src_ty + " " + src + " to " + to);
        }
        return r;
    }

    fn source_lines(self, str path): str[] {
        for (let i = 0; i < self.sources.size(); i += 1) {
            if (self.sources[i].path == path) {
                return self.sources[i].lines;
            }
        }
        let lines: str[] = [];
        if (exists_file(path)) {
            lines = str_split(read_file(path), "\n");
        }
        self.sources.push(SourceLines { path, lines });
        return lines;
    }

    fn diag_text(self, str message, ErrorSeverity level, Span span): str {
        let text = level.to_string() + ": " + message;
        match (span.start.filename) {
            OptionStr::None {
                return text;
            },
            OptionStr::Some(filename) {
                let lines = self.source_lines(filename);
                if (lines.size() == 0) {
                    return text;
                }
                return generic_error_with_source(text, &level, &span, filename, &lines);
            }
        }
    }

    fn emit_diag(self, str cond, str message, Span span, bool is_error): void {
        let err_l = self.ir.label("diag.err");
        let ok_l = self.ir.label("diag.ok");
        self.ir.emit("  br i1 " + cond + ", label %" + err_l + ", label %" + ok_l);
        self.ir.emit(err_l + ":");
        let level = ErrorSeverity::LOW;
        if (is_error) {
            level = ErrorSeverity::HIGH;
        }
        let text = self.diag_text(message, level, span) + "\n";
        let g = self.ir.cstr_global(text);
        let gp = self.ir.tmp();
        self.ir.emit(
            "  "
                + gp
                + " = getelementptr inbounds ["
                + (text.size() + 1) as str
                + " x i8], ptr "
                + g
                + ", i64 0, i64 0"
        );
        let fg = self.ir.cstr_global("%s");
        let fp = self.ir.tmp();
        self.ir.emit(
            "  " + fp + " = getelementptr inbounds [3 x i8], ptr " + fg + ", i64 0, i64 0"
        );
        let e = self.ir.tmp();
        self.ir.emit("  " + e + " = load ptr, ptr @stderr");
        self.ir.emit(
            "  "
                + self.ir.tmp()
                + " = call i32 (ptr, ptr, ...) @fprintf(ptr "
                + e
                + ", ptr "
                + fp
                + ", ptr "
                + gp
                + ")"
        );
        if (is_error) {
            self.ir.emit("  call void @exit(i32 1)");
            self.ir.emit("  unreachable");
        } else {
            self.ir.emit("  br label %" + ok_l);
        }
        self.ir.emit(ok_l + ":");
    }

    fn emit_overflow_diag(self, str cond, str message, Span span): void {
        self.emit_diag(cond, message, span, self.overflow == "error");
    }

    fn note_temp_base(self, ExpressionNode base, str value, str ty): void {
        if (!self.arc) {
            return;
        }
        if (ty != "ptr") {
            return;
        }
        if (LLVMIRCodegen.expr_is_borrowed(base)) {
            return;
        }
        self.temps.push(value);
    }

    fn release_temps_from(self, i64 start): void {
        if (!self.arc) {
            return;
        }
        let i = self.temps.size() - 1;
        while (i >= start) {
            self.emit_release(self.temps[i]);
            i -= 1;
        }
    }

    fn forget_temps_from(self, i64 start): void {
        let kept: str[] = [];
        for (let i = 0; i < start; i += 1) {
            if (i < self.temps.size()) {
                kept.push(self.temps[i]);
            }
        }
        self.temps = kept;
    }

    fn flush_temps_from(self, i64 start): void {
        self.release_temps_from(start);
        self.forget_temps_from(start);
    }
};
