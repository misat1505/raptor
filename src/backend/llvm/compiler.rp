import "../../frontend/parser/ast.rp";
import "./compiler-core.rp";
import "./ir-builder.rp";
import "./libc-decls.rp";
import "./arc.rp";
import "./functions.rp";
import "./statements.rp";
import "./types-ir.rp";


extend LLVMIRCodegen {
    fn compile(self, &Program program): str {
        self.ir.emit_header("; Generated by Raptor selfhost LLVM IR emitter");
        self.ir.emit_header(
            "target datalayout = \"e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\""
        );
        self.ir.emit_header("target triple = \"x86_64-unknown-linux-gnu\"");

        # Keep program for type lookups (struct/enum layouts)
        self.program = program;

        self.ir.emit_libc_declarations();
        if (self.overflow != "ignore") {
            self.ir.emit_overflow_intrinsics();
        }
        if (self.arc) {
            self.ir.emit_arc_runtime();
        }

        for (let i = 0; i < program.extern_functions.size(); i += 1) {
            self.compile_extern(program.extern_functions[i]);
        }
        self.ir.emit("");

        for (let i = 0; i < program.functions.size(); i += 1) {
            self.compile_function_body(program.functions[i]);
        }

        self.ir.emit("define i32 @main(i32 %argc, ptr %argv) {");
        self.begin_body();
        self.ir.emit("  store i32 %argc, ptr @raptor_argc");
        self.ir.emit("  store ptr %argv, ptr @raptor_argv");
        self.ir.emit("  br label %allocas");
        self.ir.emit("start:");

        self.current_ret_ty = "i32";
        self.has_terminator = false;
        let compiler_vars: CompilerVar[] = [];
        self.locals = compiler_vars;

        for (let i = 0; i < program.statements.size(); i += 1) {
            if (self.has_terminator) {
                break;
            }
            self.compile_statement(program.statements[i]);
        }

        if (!self.has_terminator) {
            # Top-level variables are released like any other scope's.
            self.emit_release_locals_from(0);
            self.ir.emit("  ret i32 0");
        }
        self.end_body();
        self.ir.emit("}");

        self.emit_drop_functions();
        self.emit_copy_functions();
        for (let i = 0; i < self.extra_fns.size(); i += 1) {
            self.ir.emit(self.extra_fns[i]);
        }

        return self.ir.finish();
    }

    fn generate(&Program program, bool arc, str overflow, &str[] errors): str {
        let codegen = LLVMIRCodegen.new();
        codegen.arc = arc;
        codegen.overflow = overflow;
        let ir = codegen.compile(&program);
        for (let i = 0; i < codegen.errors.size(); i += 1) {
            errors.push(codegen.errors[i]);
        }
        return ir;
    }
};
