import "../../frontend/parser/ast.rp";
import "./compiler-core.rp";
import "./ir-builder.rp";
import "./types-ir.rp";


extend LLVMIRCodegen {
    fn compile_literal(self, Literal lit): void {
        match (lit) {
            Literal::True {
                self.set_last("1", "i1");
            },
            Literal::False {
                self.set_last("0", "i1");
            },
            Literal::I64(v) {
                self.set_last(v as str, "i64");
            },
            Literal::F64(v) {
                self.set_last(
                    LLVMIRCodegen.double_const(LLVMIRCodegen.f64_literal_text(v)),
                    "double"
                );
            },
            Literal::String(s) {
                self.set_last(self.str_literal(s), "ptr");
            },
            Literal::Char(ch) {
                self.set_last(((ch as u8) as i64) as str, "i32");
            }
        }
    }

    fn as_double(self, str value, str ty): str {
        if (ty == "double") {
            return value;
        }
        let as64 = self.as_i64(value, ty);
        let t = self.ir.tmp();
        self.ir.emit("  " + t + " = sitofp i64 " + as64 + " to double");
        return t;
    }

    fn float_op(str op): str {
        if (op == "add") {
            return "fadd";
        }
        if (op == "sub") {
            return "fsub";
        }
        if (op == "mul") {
            return "fmul";
        }
        if (op == "sdiv") {
            return "fdiv";
        }
        return "frem";
    }

    fn expr_is_int_literal(ExpressionNode e): bool {
        if (e.value matches Expression::Literal(lit)) {
            if (lit matches Literal::I64) {
                return true;
            }
        }
        if (e.value matches Expression::ArithmeticNegation(inner)) {
            return LLVMIRCodegen.expr_is_int_literal(inner);
        }
        return false;
    }

    fn arith_rty(self, ExpressionNode left, ExpressionNode right): str {
        let l = self.expr_rtype(left);
        let r = self.expr_rtype(right);
        if (LLVMIRCodegen.expr_is_int_literal(left) && r != "") {
            return r;
        }
        if (LLVMIRCodegen.expr_is_int_literal(right) && l != "") {
            return l;
        }
        if (l != "") {
            return l;
        }
        return r;
    }

    fn resolve_num_rty(str hint, str lt, str rt): str {
        if (lt == "double" || rt == "double") {
            return "f64";
        }
        if (hint == "f64") {
            return "f64";
        }
        if (hint != "") {
            if (LLVMIRCodegen.rname_prim_ty(hint) != "") {
                return hint;
            }
        }
        let best = "";
        if (lt != "ptr") {
            best = lt;
        }
        if (rt != "ptr") {
            if (best == "") {
                best = rt;
            } else if (LLVMIRCodegen.ty_bits(rt) > LLVMIRCodegen.ty_bits(best)) {
                best = rt;
            }
        }
        let d = LLVMIRCodegen.ty_default_rty(best);
        if (d == "") {
            return "i64";
        }
        return d;
    }

    fn emit_arith(self, str lv, str lt, str rv, str rt, str op, str hint, Span span): void {
        let rty = LLVMIRCodegen.resolve_num_rty(hint, lt, rt);
        let result = self.ir.tmp();
        if (rty == "f64") {
            let ld = self.as_double(lv, lt);
            let rd = self.as_double(rv, rt);
            self.ir.emit(
                "  " + result + " = " + LLVMIRCodegen.float_op(op) + " double " + ld + ", " + rd
            );
            self.set_last(result, "double");
            return;
        }
        let ity = LLVMIRCodegen.rname_prim_ty(rty);
        let unsigned = LLVMIRCodegen.rname_is_unsigned(rty);
        let a = self.resize_int(lv, lt, ity, !unsigned);
        let b = self.resize_int(rv, rt, ity, !unsigned);

        if (op == "add" || op == "sub" || op == "mul") {
            if (self.overflow == "ignore") {
                self.ir.emit("  " + result + " = " + op + " " + ity + " " + a + ", " + b);
            } else {
                let sign = "s";
                if (unsigned) {
                    sign = "u";
                }
                let pair = self.ir.tmp();
                self.ir.emit(
                    "  "
                        + pair
                        + " = call { "
                        + ity
                        + ", i1 } @llvm."
                        + sign
                        + op
                        + ".with.overflow."
                        + ity
                        + "("
                        + ity
                        + " "
                        + a
                        + ", "
                        + ity
                        + " "
                        + b
                        + ")"
                );
                self.ir.emit("  " + result + " = extractvalue { " + ity + ", i1 } " + pair + ", 0");
                let flag = self.ir.tmp();
                self.ir.emit("  " + flag + " = extractvalue { " + ity + ", i1 } " + pair + ", 1");
                let what = "integer addition overflow";
                if (op == "sub") {
                    what = "integer subtraction overflow";
                }
                if (op == "mul") {
                    what = "integer multiplication overflow";
                }
                self.emit_overflow_diag(flag, what, span);
            }
        } else {
            let opcode = op;
            if (unsigned) {
                if (op == "sdiv") {
                    opcode = "udiv";
                } else {
                    opcode = "urem";
                }
            }

            self.ir.emit("  " + result + " = " + opcode + " " + ity + " " + a + ", " + b);
        }
        self.set_last(result, ity);
    }

    fn compile_binary_i64(
        self,
        ExpressionNode left,
        ExpressionNode right,
        str op,
        Span span
    ): void {
        self.compile_expression(left);
        let lv = self.last_value;
        let lt = self.last_type;
        self.compile_expression(right);
        let rv = self.last_value;
        let rt = self.last_type;
        self.emit_arith(lv, lt, rv, rt, op, self.arith_rty(left, right), span);
    }

    fn to_slot_i64(self, str value, str ty): str {
        if (ty == "i64") {
            return value;
        }
        if (ty == "double") {
            let t = self.ir.tmp();
            self.ir.emit("  " + t + " = bitcast double " + value + " to i64");
            return t;
        }
        if (ty == "ptr") {
            let t = self.ir.tmp();
            self.ir.emit("  " + t + " = ptrtoint ptr " + value + " to i64");
            return t;
        }
        if (ty == "i1") {
            let t = self.ir.tmp();
            self.ir.emit("  " + t + " = zext i1 " + value + " to i64");
            return t;
        }
        if (ty == "i8" || ty == "i16" || ty == "i32") {
            let t = self.ir.tmp();
            self.ir.emit("  " + t + " = zext " + ty + " " + value + " to i64");
            return t;
        }
        return value;
    }

    fn as_i64(self, str value, str ty): str {
        if (ty == "i64") {
            return value;
        }
        if (ty == "ptr") {
            let t = self.ir.tmp();
            self.ir.emit("  " + t + " = ptrtoint ptr " + value + " to i64");
            return t;
        }
        if (ty == "i1") {
            let t = self.ir.tmp();
            self.ir.emit("  " + t + " = zext i1 " + value + " to i64");
            return t;
        }
        if (ty == "i8" || ty == "i16" || ty == "i32") {
            let t = self.ir.tmp();
            self.ir.emit("  " + t + " = zext " + ty + " " + value + " to i64");
            return t;
        }
        if (ty == "double") {
            let t = self.ir.tmp();
            self.ir.emit("  " + t + " = fptosi double " + value + " to i64");
            return t;
        }
        return value;
    }

    fn compile_owned(self, ExpressionNode e): void {
        self.compile_expression(e);
        if (self.last_type == "ptr") {
            # A str is a value: storing a variable / field / element / literal makes a
            # private copy (so `a[0] = 'x'` can never be seen through another name).
            if (self.expr_rtype(e) == "str") {
                if (LLVMIRCodegen.expr_is_borrowed(e) || LLVMIRCodegen.expr_is_str_literal(e)) {
                    let copy = self.ir.tmp();
                    self.ir.emit(
                        "  " + copy + " = call ptr @rt_str_copy(ptr " + self.last_value + ")"
                    );
                    self.set_last(copy, "ptr");
                    return;
                }
            }
            if (self.arc) {
                if (LLVMIRCodegen.expr_is_borrowed(e)) {
                    self.emit_retain(self.last_value);
                }
            }
        }
    }

    fn expr_is_str_literal(ExpressionNode e): bool {
        if (e.value matches Expression::Literal(lit)) {
            if (lit matches Literal::String) {
                return true;
            }
        }
        return false;
    }

    fn user_function_index(self, str name): i64 {
        for (let i = 0; i < self.program.functions.size(); i += 1) {
            if (self.program.functions[i].value.identifier.value == name) {
                return i;
            }
        }
        return 0 - 1;
    }

    fn copy_for_param(self, str fname, i64 arg_index, ExpressionNode arg, str value): str {
        let fi = self.user_function_index(fname);
        if (fi < 0) {
            return "";
        }
        if (arg_index >= self.program.functions[fi].value.parameters.size()) {
            return "";
        }
        let pty = self.program.functions[fi].value.parameters[arg_index].value.parameter_type.value;
        let copy = self.ir.tmp();
        if (pty matches Type::Str) {
            if (LLVMIRCodegen.expr_is_borrowed(arg) || LLVMIRCodegen.expr_is_str_literal(arg)) {
                self.ir.emit("  " + copy + " = call ptr @rt_str_copy(ptr " + value + ")");
                return copy;
            }
            return "";
        }
        if (!LLVMIRCodegen.expr_is_borrowed(arg)) {
            return "";
        }
        if (pty matches Type::Vector) {
            self.ir.emit("  " + copy + " = call ptr @rt_vec_copy(ptr " + value + ")");
            return copy;
        }
        if (pty matches Type::Unresolved(sname)) {
            if (self.lookup_struct(sname) matches OptionStructDeclaration::Some) {
                self.ir.emit(
                    "  " + copy + " = call ptr @copy.struct." + sname + "(ptr " + value + ")"
                );
                return copy;
            }
        }
        return "";
    }

    fn f64_literal_text(f64 v): str {
        if (v < 0.0) {
            return "-" + LLVMIRCodegen.f64_literal_text(0.0 - v);
        }
        if (v >= 1000000000000000000.0) {
            return v as str;
        }
        let whole = v as i64;
        let frac = v - whole as f64;
        let out = whole as str + ".";
        for (let i = 0; i < 17; i += 1) {
            frac = frac * 10.0;
            let d = frac as i64;
            out += d as str;
            frac = frac - d as f64;
        }
        return out;
    }

    fn int_to_str(self, str v64, bool signed): str {
        let buf = self.alloc_bytes("32", "null");
        let fmt = "%llu";
        if (signed) {
            fmt = "%lld";
        }
        let fg = self.ir.cstr_global(fmt);
        let fp = self.ir.tmp();
        self.ir.emit(
            "  " + fp + " = getelementptr inbounds [5 x i8], ptr " + fg + ", i64 0, i64 0"
        );
        self.ir.emit(
            "  "
                + self.ir.tmp()
                + " = call i32 (ptr, i64, ptr, ...) @snprintf(ptr "
                + buf
                + ", i64 32, ptr "
                + fp
                + ", i64 "
                + v64
                + ")"
        );
        return buf;
    }

    fn f64_to_str(self, str v): str {
        let buf = self.alloc_bytes("32", "null");
        let fg = self.ir.cstr_global("%g");
        let fp = self.ir.tmp();
        self.ir.emit(
            "  " + fp + " = getelementptr inbounds [3 x i8], ptr " + fg + ", i64 0, i64 0"
        );
        self.ir.emit(
            "  "
                + self.ir.tmp()
                + " = call i32 (ptr, i64, ptr, ...) @snprintf(ptr "
                + buf
                + ", i64 32, ptr "
                + fp
                + ", double "
                + v
                + ")"
        );
        return buf;
    }

    fn bool_to_str(self, str v): str {
        let t = self.str_literal("true");
        let f = self.str_literal("false");
        let r = self.ir.tmp();
        self.ir.emit("  " + r + " = select i1 " + v + ", ptr " + t + ", ptr " + f);
        return r;
    }

    fn int_range_is_subset(i64 sb, bool ssigned, i64 tb, bool tsigned): bool {
        if (ssigned == tsigned) {
            return sb <= tb;
        }
        return sb < tb;
    }

    fn emit_cast_range_check(
        self,
        str val,
        str sty,
        i64 sb,
        bool ssigned,
        i64 tb,
        bool tsigned,
        Span span
    ): void {
        let below = "";
        if (ssigned) {
            let min_c = "0";
            if (tsigned) {
                min_c = LLVMIRCodegen.int_min_signed(tb);
            }
            if (!tsigned || tb < sb) {
                below = self.ir.tmp();
                self.ir.emit("  " + below + " = icmp slt " + sty + " " + val + ", " + min_c);
            }
        }
        let above = "";
        let max_c = LLVMIRCodegen.int_max_unsigned(tb);
        let check_above = tb < sb;
        if (tsigned) {
            max_c = LLVMIRCodegen.int_max_signed(tb);
            check_above = tb <= sb;
            if (ssigned) {
                check_above = tb < sb;
            }
        }
        if (check_above) {
            let pred = "ugt";
            if (ssigned) {
                pred = "sgt";
            }
            above = self.ir.tmp();
            self.ir.emit("  " + above + " = icmp " + pred + " " + sty + " " + val + ", " + max_c);
        }
        let cond = below;
        if (below.size() > 0 && above.size() > 0) {
            cond = self.ir.tmp();
            self.ir.emit("  " + cond + " = or i1 " + below + ", " + above);
        }
        if (below.size() == 0) {
            cond = above;
        }
        if (cond.size() == 0) {
            return;
        }
        let sign = "unsigned";
        if (tsigned) {
            sign = "signed";
        }
        self.emit_overflow_diag(
            cond,
            "Integer overflow in cast (" + sb as str + " -> " + tb as str + ":" + sign + ")",
            span
        );
    }

    fn cast_int_int(self, str val, str frty, str trty, Span span): void {
        let sty = LLVMIRCodegen.rname_prim_ty(frty);
        let tty = LLVMIRCodegen.rname_prim_ty(trty);
        let sb = LLVMIRCodegen.ty_bits(sty);
        let tb = LLVMIRCodegen.ty_bits(tty);
        let ssigned = !LLVMIRCodegen.rname_is_unsigned(frty);
        let tsigned = !LLVMIRCodegen.rname_is_unsigned(trty);
        if (self.overflow != "ignore" && frty != "char" && trty != "char") {
            if (!LLVMIRCodegen.int_range_is_subset(sb, ssigned, tb, tsigned)) {
                self.emit_cast_range_check(val, sty, sb, ssigned, tb, tsigned, span);
            }
        }
        self.set_last(self.resize_int(val, sty, tty, ssigned), tty);
    }

    fn compile_cast(self, CastingExpression cast, Span span): void {
        self.compile_expression(cast.value);
        let val = self.last_value;
        let from = self.last_type;
        let to_rty = cast.to_type.value.llvm_type_rname();
        let from_rty = self.expr_rtype(cast.value);
        if (from == "ptr") {
            from_rty = "str";
        } else if (LLVMIRCodegen.rname_prim_ty(from_rty) != from) {
            from_rty = LLVMIRCodegen.ty_default_rty(from);
        }

        # Same type. A str stays a (shared) str; for ARC it is a +1 value.
        if (from_rty == to_rty) {
            if (from == "ptr" && LLVMIRCodegen.expr_is_borrowed(cast.value)) {
                self.emit_retain(val);
            }
            self.set_last(val, from);
            return;
        }

        # -> str
        if (to_rty == "str") {
            if (from_rty == "char") {
                self.set_last(self.char_to_str(val), "ptr");
                return;
            }
            if (from_rty == "bool") {
                self.set_last(self.bool_to_str(val), "ptr");
                return;
            }
            if (from_rty == "f64") {
                self.set_last(self.f64_to_str(val), "ptr");
                return;
            }
            if (LLVMIRCodegen.rname_is_int(from_rty)) {
                let uns = LLVMIRCodegen.rname_is_unsigned(from_rty);
                let wide = self.resize_int(val, from, "i64", !uns);
                self.set_last(self.int_to_str(wide, !uns), "ptr");
                return;
            }
            self.set_last(self.to_str_value(val, from), "ptr");
            return;
        }

        let tty = LLVMIRCodegen.rname_prim_ty(to_rty);

        # str ->
        if (from_rty == "str") {
            if (to_rty == "f64") {
                let r = self.ir.tmp();
                self.ir.emit("  " + r + " = call double @atof(ptr " + val + ")");
                self.set_last(r, "double");
                return;
            }
            if (to_rty == "bool") {
                let len = self.ir.tmp();
                self.ir.emit("  " + len + " = call i64 @strlen(ptr " + val + ")");
                let r = self.ir.tmp();
                self.ir.emit("  " + r + " = icmp ne i64 " + len + ", 0");
                self.set_last(r, "i1");
                return;
            }
            if (tty != "") {
                let parsed = self.ir.tmp();
                self.ir.emit("  " + parsed + " = call i64 @atoll(ptr " + val + ")");
                self.set_last(self.resize_int(parsed, "i64", tty, true), tty);
                return;
            }
            self.set_last(val, from);
            return;
        }

        # numeric <-> numeric / bool / char
        let from_is_int = LLVMIRCodegen.rname_is_int(from_rty) || from_rty == "char";
        let to_is_int = LLVMIRCodegen.rname_is_int(to_rty) || to_rty == "char";
        let from_uns = LLVMIRCodegen.rname_is_unsigned(from_rty);

        if (from_is_int && to_is_int) {
            self.cast_int_int(val, from_rty, to_rty, span);
            return;
        }
        if (from_is_int && to_rty == "f64") {
            let r = self.ir.tmp();
            let op = "sitofp";
            if (from_uns) {
                op = "uitofp";
            }
            self.ir.emit("  " + r + " = " + op + " " + from + " " + val + " to double");
            self.set_last(r, "double");
            return;
        }
        if (from_rty == "f64" && to_is_int) {
            let r = self.ir.tmp();
            let op = "fptosi";
            if (LLVMIRCodegen.rname_is_unsigned(to_rty)) {
                op = "fptoui";
            }
            self.ir.emit("  " + r + " = " + op + " double " + val + " to " + tty);
            self.set_last(r, tty);
            return;
        }
        if (from_is_int && to_rty == "bool") {
            let r = self.ir.tmp();
            let pred = "sgt";
            if (from_uns) {
                pred = "ugt";
            }
            self.ir.emit("  " + r + " = icmp " + pred + " " + from + " " + val + ", 0");
            self.set_last(r, "i1");
            return;
        }
        if (from_rty == "f64" && to_rty == "bool") {
            let r = self.ir.tmp();
            self.ir.emit("  " + r + " = fcmp ogt double " + val + ", 0.0");
            self.set_last(r, "i1");
            return;
        }
        if (from_rty == "bool" && to_is_int) {
            self.set_last(self.resize_int(val, "i1", tty, false), tty);
            return;
        }
        if (from_rty == "bool" && to_rty == "f64") {
            let w = self.resize_int(val, "i1", "i64", false);
            let r = self.ir.tmp();
            self.ir.emit("  " + r + " = uitofp i64 " + w + " to double");
            self.set_last(r, "double");
            return;
        }

        # Unknown combination (the semantic checker rejects these): keep the value.
        self.set_last(val, from);
    }

    fn vstr_supported(str elem): bool {
        let inner = LLVMIRCodegen.llvm_rty_element(elem);
        if (inner != "") {
            return LLVMIRCodegen.vstr_supported(inner);
        }
        return LLVMIRCodegen.rname_is_int(elem) || elem == "f64" || elem == "bool" || elem == "str";
    }

    fn vstr_cstr(self, str text, str reg): str {
        let g = self.ir.cstr_global(text);
        return
            "  "
                + reg
                + " = getelementptr inbounds ["
                + (text.size() + 1) as str
                + " x i8], ptr "
                + g
                + ", i64 0, i64 0";
    }

    fn vstr_sanitize(str rty): str {
        let out = "";
        for (let i = 0; i < rty.size(); i += 1) {
            let ch = rty[i];
            if (ch == '[') {
                out += "_";
            } else if (ch != ']') {
                out += ch;
            }
        }
        return out;
    }

    fn vstr_fn(self, str elem): str {
        let name = "@rt_vstr." + LLVMIRCodegen.vstr_sanitize(elem);
        for (let i = 0; i < self.extra_fn_names.size(); i += 1) {
            if (self.extra_fn_names[i] == name) {
                return name;
            }
        }
        self.extra_fn_names.push(name);

        let alloc = "call ptr @malloc(i64 %total)";
        if (self.arc) {
            alloc = "call ptr @rt_alloc(i64 %total, ptr null)";
        }
        let is_str = elem == "str";
        let inner_elem = LLVMIRCodegen.llvm_rty_element(elem);
        let is_vec = inner_elem != "";
        let inner_fn = "";
        if (is_vec) {
            inner_fn = self.vstr_fn(inner_elem);
        }
        let lines: str[] = [
            "define ptr " + name + "(ptr %v) {",
            "entry:",
            "  %lp = getelementptr i8, ptr %v, i64 16",
            "  %len = load i64, ptr %lp",
            "  %dpp = getelementptr i8, ptr %v, i64 8",
            "  %data = load ptr, ptr %dpp",
            "  %szp = alloca i64",
            "  %ip = alloca i64",
            "  store i64 3, ptr %szp",
            "  store i64 0, ptr %ip",
            "  br label %c1",
            "c1:",
            "  %i1 = load i64, ptr %ip",
            "  %k1 = icmp slt i64 %i1, %len",
            "  br i1 %k1, label %b1, label %alloc",
            "b1:"
        ];
        if (is_vec) {
            # Nested vector: format the inner one only to learn its length.
            lines.push("  %s1 = getelementptr ptr, ptr %data, i64 %i1");
            lines.push("  %sp1 = load ptr, ptr %s1");
            lines.push("  %tmp1 = call ptr " + inner_fn + "(ptr %sp1)");
            lines.push("  %sl1 = call i64 @strlen(ptr %tmp1)");
            if (self.arc) {
                lines.push("  call void @rt_release(ptr %tmp1)");
            }
            lines.push("  %es = add i64 %sl1, 4");
        } else if (is_str) {
            lines.push("  %s1 = getelementptr ptr, ptr %data, i64 %i1");
            lines.push("  %sp1 = load ptr, ptr %s1");
            lines.push("  %sl1 = call i64 @strlen(ptr %sp1)");
            lines.push("  %es = add i64 %sl1, 4");
        } else {
            lines.push("  %es = add i64 0, 28");
        }
        lines.push("  %sz0 = load i64, ptr %szp");
        lines.push("  %sz1 = add i64 %sz0, %es");
        lines.push("  store i64 %sz1, ptr %szp");
        lines.push("  %in1 = add i64 %i1, 1");
        lines.push("  store i64 %in1, ptr %ip");
        lines.push("  br label %c1");
        lines.push("alloc:");
        lines.push("  %total = load i64, ptr %szp");
        lines.push("  %buf = " + alloc);
        lines.push("  store i8 91, ptr %buf");
        lines.push("  %posp = alloca i64");
        lines.push("  store i64 1, ptr %posp");
        lines.push("  store i64 0, ptr %ip");
        lines.push("  br label %c2");
        lines.push("c2:");
        lines.push("  %i2 = load i64, ptr %ip");
        lines.push("  %k2 = icmp slt i64 %i2, %len");
        lines.push("  br i1 %k2, label %b2, label %fin");
        lines.push("b2:");
        lines.push("  %pos0 = load i64, ptr %posp");
        lines.push("  %first = icmp eq i64 %i2, 0");
        lines.push("  br i1 %first, label %elem, label %sep");
        lines.push("sep:");
        lines.push("  %sp0 = getelementptr i8, ptr %buf, i64 %pos0");
        lines.push("  store i8 44, ptr %sp0");
        lines.push("  %sp0b = getelementptr i8, ptr %sp0, i64 1");
        lines.push("  store i8 32, ptr %sp0b");
        lines.push("  %pos1 = add i64 %pos0, 2");
        lines.push("  br label %elem");
        lines.push("elem:");
        lines.push("  %pos = phi i64 [ %pos0, %b2 ], [ %pos1, %sep ]");
        lines.push("  %dst = getelementptr i8, ptr %buf, i64 %pos");
        lines.push("  %cap = sub i64 %total, %pos");
        lines.push("  %slot = getelementptr ptr, ptr %data, i64 %i2");
        let call = "";
        if (is_vec) {
            lines.push("  %vp = load ptr, ptr %slot");
            lines.push("  %vs = call ptr " + inner_fn + "(ptr %vp)");
            lines.push(self.vstr_cstr("%s", "%fmt"));
            lines.push(
                "  %w = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %dst, i64 %cap, ptr %fmt, ptr %vs)"
            );
            if (self.arc) {
                lines.push("  call void @rt_release(ptr %vs)");
            }
            call = "";
        } else if (is_str) {
            lines.push("  %ep = load ptr, ptr %slot");
            lines.push(self.vstr_cstr("\"%s\"", "%fmt"));
            call =
                "  %w = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %dst, i64 %cap, ptr %fmt, ptr %ep)";
        } else {
            lines.push("  %raw = load i64, ptr %slot");
            if (elem == "f64") {
                lines.push("  %dv = bitcast i64 %raw to double");
                lines.push(self.vstr_cstr("%g", "%fmt"));
                call =
                    "  %w = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %dst, i64 %cap, ptr %fmt, double %dv)";
            } else if (elem == "bool") {
                lines.push("  %bv = trunc i64 %raw to i1");
                lines.push(self.vstr_cstr("true", "%tt"));
                lines.push(self.vstr_cstr("false", "%ff"));
                lines.push("  %bs = select i1 %bv, ptr %tt, ptr %ff");
                lines.push(self.vstr_cstr("%s", "%fmt"));
                call =
                    "  %w = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %dst, i64 %cap, ptr %fmt, ptr %bs)";
            } else {
                let ity = LLVMIRCodegen.rname_prim_ty(elem);
                let uns = LLVMIRCodegen.rname_is_unsigned(elem);
                let wide = "%raw";
                if (ity != "i64") {
                    let ext = "sext";
                    if (uns) {
                        ext = "zext";
                    }
                    lines.push("  %nv = trunc i64 %raw to " + ity);
                    lines.push("  %xv = " + ext + " " + ity + " %nv to i64");
                    wide = "%xv";
                }
                let fmt = "%lld";
                if (uns) {
                    fmt = "%llu";
                }
                lines.push(self.vstr_cstr(fmt, "%fmt"));
                call =
                    "  %w = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %dst, i64 %cap, ptr %fmt, i64 "
                        + wide
                        + ")";
            }
        }
        if (call.size() > 0) {
            lines.push(call);
        }
        lines.push("  %w64 = sext i32 %w to i64");
        lines.push("  %posn = add i64 %pos, %w64");
        lines.push("  store i64 %posn, ptr %posp");
        lines.push("  %in2 = add i64 %i2, 1");
        lines.push("  store i64 %in2, ptr %ip");
        lines.push("  br label %c2");
        lines.push("fin:");
        lines.push("  %endp = load i64, ptr %posp");
        lines.push("  %e0 = getelementptr i8, ptr %buf, i64 %endp");
        lines.push("  store i8 93, ptr %e0");
        lines.push("  %e1 = getelementptr i8, ptr %e0, i64 1");
        lines.push("  store i8 0, ptr %e1");
        lines.push("  ret ptr %buf");
        lines.push("}");
        lines.push("");

        let text = "";
        for (let i = 0; i < lines.size(); i += 1) {
            text += lines[i] + "\n";
        }
        self.extra_fns.push(text);
        return name;
    }

    fn compile_cmp(self, ExpressionNode left, ExpressionNode right, str pred): void {
        self.compile_expression(left);
        let lv = self.last_value;
        let lt = self.last_type;
        self.compile_expression(right);
        let rv = self.last_value;
        let rt = self.last_type;
        let result = self.ir.tmp();
        if (lt == "ptr" && rt == "ptr") {
            # `str == str` must compare contents, not addresses. The type checker
            # guarantees both sides are `str` when one of them is.
            if (
                (pred == "eq" || pred == "ne")
                    && (self.expr_is_str(left) || self.expr_is_str(right))
            ) {
                let cmp = self.ir.tmp();
                self.ir.emit("  " + cmp + " = call i32 @strcmp(ptr " + lv + ", ptr " + rv + ")");
                self.ir.emit("  " + result + " = icmp " + pred + " i32 " + cmp + ", 0");
                if (!LLVMIRCodegen.expr_is_borrowed(left)) {
                    self.emit_release(lv);
                }
                if (!LLVMIRCodegen.expr_is_borrowed(right)) {
                    self.emit_release(rv);
                }
            } else {
                self.ir.emit("  " + result + " = icmp " + pred + " ptr " + lv + ", " + rv);
            }
        } else {
            let crty = LLVMIRCodegen.resolve_num_rty(self.arith_rty(left, right), lt, rt);
            if (crty == "f64") {
                let ld = self.as_double(lv, lt);
                let rd = self.as_double(rv, rt);
                let fpred = "oeq";
                if (pred == "ne") {
                    fpred = "une";
                }
                if (pred == "slt") {
                    fpred = "olt";
                }
                if (pred == "sle") {
                    fpred = "ole";
                }
                if (pred == "sgt") {
                    fpred = "ogt";
                }
                if (pred == "sge") {
                    fpred = "oge";
                }
                self.ir.emit("  " + result + " = fcmp " + fpred + " double " + ld + ", " + rd);
            } else {
                # Compare at the operands' real width; unsigned types use u* predicates.
                let cty = LLVMIRCodegen.rname_prim_ty(crty);
                let cuns = LLVMIRCodegen.rname_is_unsigned(crty);
                let li = self.resize_int(lv, lt, cty, !cuns);
                let ri = self.resize_int(rv, rt, cty, !cuns);
                let ipred = pred;
                if (cuns) {
                    if (pred == "slt") {
                        ipred = "ult";
                    }
                    if (pred == "sle") {
                        ipred = "ule";
                    }
                    if (pred == "sgt") {
                        ipred = "ugt";
                    }
                    if (pred == "sge") {
                        ipred = "uge";
                    }
                }
                self.ir.emit("  " + result + " = icmp " + ipred + " " + cty + " " + li + ", " + ri);
            }
        }
        self.set_last(result, "i1");
    }

    fn vector_alloc_empty(self): str {
        let p = self.alloc_bytes("32", "@rt_drop_vec");
        let rc_gep = self.ir.tmp();
        self.ir.emit("  " + rc_gep + " = getelementptr i8, ptr " + p + ", i64 0");
        self.ir.emit("  store i64 0, ptr " + rc_gep);  # slot 0: "elements are managed" flag
        let d_gep = self.ir.tmp();
        self.ir.emit("  " + d_gep + " = getelementptr i8, ptr " + p + ", i64 8");
        self.ir.emit("  store ptr null, ptr " + d_gep);
        let l_gep = self.ir.tmp();
        self.ir.emit("  " + l_gep + " = getelementptr i8, ptr " + p + ", i64 16");
        self.ir.emit("  store i64 0, ptr " + l_gep);
        let c_gep = self.ir.tmp();
        self.ir.emit("  " + c_gep + " = getelementptr i8, ptr " + p + ", i64 24");
        self.ir.emit("  store i64 0, ptr " + c_gep);
        return p;
    }

    fn vector_push_ptr(self, str vec, str elem): void {
        let len_p = self.ir.tmp();
        self.ir.emit("  " + len_p + " = getelementptr i8, ptr " + vec + ", i64 16");
        let len = self.ir.tmp();
        self.ir.emit("  " + len + " = load i64, ptr " + len_p);
        let cap_p = self.ir.tmp();
        self.ir.emit("  " + cap_p + " = getelementptr i8, ptr " + vec + ", i64 24");
        let cap = self.ir.tmp();
        self.ir.emit("  " + cap + " = load i64, ptr " + cap_p);
        let data_p = self.ir.tmp();
        self.ir.emit("  " + data_p + " = getelementptr i8, ptr " + vec + ", i64 8");
        let data = self.ir.tmp();
        self.ir.emit("  " + data + " = load ptr, ptr " + data_p);

        let need = self.ir.tmp();
        self.ir.emit("  " + need + " = icmp sge i64 " + len + ", " + cap);
        let grow_l = self.ir.label("vec.grow");
        let merge_l = self.ir.label("vec.merge");
        self.ir.emit("  br i1 " + need + ", label %" + grow_l + ", label %" + merge_l);

        self.ir.emit(grow_l + ":");
        let new_cap = self.ir.tmp();
        self.ir.emit("  " + new_cap + " = add i64 " + cap + ", 8");
        let z = self.ir.tmp();
        self.ir.emit("  " + z + " = icmp eq i64 " + cap + ", 0");
        let nc2 = self.ir.tmp();
        self.ir.emit("  " + nc2 + " = select i1 " + z + ", i64 4, i64 " + new_cap);
        let bytes = self.ir.tmp();
        self.ir.emit("  " + bytes + " = mul i64 " + nc2 + ", 8");
        let nd = self.ir.tmp();
        self.ir.emit("  " + nd + " = call ptr @realloc(ptr " + data + ", i64 " + bytes + ")");
        self.ir.emit("  store ptr " + nd + ", ptr " + data_p);
        self.ir.emit("  store i64 " + nc2 + ", ptr " + cap_p);
        self.ir.emit("  br label %" + merge_l);

        self.ir.emit(merge_l + ":");
        let data2 = self.ir.tmp();
        self.ir.emit("  " + data2 + " = load ptr, ptr " + data_p);
        let len2 = self.ir.tmp();
        self.ir.emit("  " + len2 + " = load i64, ptr " + len_p);
        let slot = self.ir.tmp();
        self.ir.emit("  " + slot + " = getelementptr ptr, ptr " + data2 + ", i64 " + len2);
        self.ir.emit("  store ptr " + elem + ", ptr " + slot);
        self.ir.emit("  store i64 1, ptr " + vec);  # elements are managed pointers
        let nlen = self.ir.tmp();
        self.ir.emit("  " + nlen + " = add i64 " + len2 + ", 1");
        self.ir.emit("  store i64 " + nlen + ", ptr " + len_p);
    }

    fn vector_push_i64(self, str vec, str elem, str elem_ty): void {
        let elem_i64 = self.to_slot_i64(elem, elem_ty);

        let len_p = self.ir.tmp();
        self.ir.emit("  " + len_p + " = getelementptr i8, ptr " + vec + ", i64 16");
        let len = self.ir.tmp();
        self.ir.emit("  " + len + " = load i64, ptr " + len_p);
        let cap_p = self.ir.tmp();
        self.ir.emit("  " + cap_p + " = getelementptr i8, ptr " + vec + ", i64 24");
        let cap = self.ir.tmp();
        self.ir.emit("  " + cap + " = load i64, ptr " + cap_p);
        let data_p = self.ir.tmp();
        self.ir.emit("  " + data_p + " = getelementptr i8, ptr " + vec + ", i64 8");
        let data = self.ir.tmp();
        self.ir.emit("  " + data + " = load ptr, ptr " + data_p);

        let need = self.ir.tmp();
        self.ir.emit("  " + need + " = icmp sge i64 " + len + ", " + cap);
        let grow_l = self.ir.label("vec.grow64");
        let merge_l = self.ir.label("vec.merge64");
        self.ir.emit("  br i1 " + need + ", label %" + grow_l + ", label %" + merge_l);

        self.ir.emit(grow_l + ":");
        let new_cap = self.ir.tmp();
        self.ir.emit("  " + new_cap + " = add i64 " + cap + ", 8");
        let z = self.ir.tmp();
        self.ir.emit("  " + z + " = icmp eq i64 " + cap + ", 0");
        let nc2 = self.ir.tmp();
        self.ir.emit("  " + nc2 + " = select i1 " + z + ", i64 4, i64 " + new_cap);
        let bytes = self.ir.tmp();
        self.ir.emit("  " + bytes + " = mul i64 " + nc2 + ", 8");
        let nd = self.ir.tmp();
        self.ir.emit("  " + nd + " = call ptr @realloc(ptr " + data + ", i64 " + bytes + ")");
        self.ir.emit("  store ptr " + nd + ", ptr " + data_p);
        self.ir.emit("  store i64 " + nc2 + ", ptr " + cap_p);
        self.ir.emit("  br label %" + merge_l);

        self.ir.emit(merge_l + ":");
        let data2 = self.ir.tmp();
        self.ir.emit("  " + data2 + " = load ptr, ptr " + data_p);
        let len2 = self.ir.tmp();
        self.ir.emit("  " + len2 + " = load i64, ptr " + len_p);
        let slot = self.ir.tmp();
        self.ir.emit("  " + slot + " = getelementptr i64, ptr " + data2 + ", i64 " + len2);
        self.ir.emit("  store i64 " + elem_i64 + ", ptr " + slot);
        let nlen = self.ir.tmp();
        self.ir.emit("  " + nlen + " = add i64 " + len2 + ", 1");
        self.ir.emit("  store i64 " + nlen + ", ptr " + len_p);
    }

    fn compile_vector_literal(self, ExpressionNode[] elems): void {
        let vec = self.vector_alloc_empty();
        for (let i = 0; i < elems.size(); i += 1) {
            self.compile_owned(elems[i]);
            if (self.last_type == "ptr") {
                self.vector_push_ptr(vec, self.last_value);
            } else {
                self.vector_push_i64(vec, self.last_value, self.last_type);
            }
        }
        self.set_last(vec, "ptr");
    }

    fn compile_struct_literal(self, StructLiteralNode node): void {
        let name = node.value.identifier.value;
        let nfields = self.struct_field_count(name);
        if (nfields == 0) {
            nfields = node.value.fields.size();
        }
        let bytes = (nfields + 1) * 8;
        let p = self.alloc_bytes(bytes as str, self.struct_drop_ref(name));
        for (let i = 0; i < nfields; i += 1) {
            let gep = self.ir.tmp();
            self.ir.emit("  " + gep + " = getelementptr i8, ptr " + p + ", i64 " + (i * 8) as str);
            self.ir.emit("  store i64 0, ptr " + gep);
        }
        let rc_gep = self.ir.tmp();
        self.ir.emit(
            "  " + rc_gep + " = getelementptr i8, ptr " + p + ", i64 " + (nfields * 8) as str
        );
        self.ir.emit("  store i64 1, ptr " + rc_gep);

        for (let i = 0; i < node.value.fields.size(); i += 1) {
            let f = node.value.fields[i];
            let idx = self.struct_field_index(name, f.value.identifier.value);
            self.compile_owned(f.value.value);
            let gep = self.ir.tmp();
            self.ir.emit(
                "  " + gep + " = getelementptr i8, ptr " + p + ", i64 " + (idx * 8) as str
            );
            if (self.last_type == "ptr") {
                self.ir.emit("  store ptr " + self.last_value + ", ptr " + gep);
            } else {
                let sv = self.to_slot_i64(self.last_value, self.last_type);
                self.ir.emit("  store i64 " + sv + ", ptr " + gep);
            }
        }
        self.set_last(p, "ptr");
    }

    fn compile_enum_literal(self, EnumLiteralExpression el): void {
        let tag = self.enum_variant_tag(el.enum_name.value, el.variant_name.value);
        let p = self.alloc_bytes("24", self.enum_drop_ref(el.enum_name.value));
        let rc_g = self.ir.tmp();
        self.ir.emit("  " + rc_g + " = getelementptr i8, ptr " + p + ", i64 0");
        self.ir.emit("  store i64 1, ptr " + rc_g);
        let tag_g = self.ir.tmp();
        self.ir.emit("  " + tag_g + " = getelementptr i8, ptr " + p + ", i64 8");
        self.ir.emit("  store i64 " + tag as str + ", ptr " + tag_g);
        let pay_g = self.ir.tmp();
        self.ir.emit("  " + pay_g + " = getelementptr i8, ptr " + p + ", i64 16");
        match (el.variant_value) {
            OptionExpressionNode::Some(expr) {
                self.compile_owned(expr);
                if (self.last_type == "ptr") {
                    self.ir.emit("  store ptr " + self.last_value + ", ptr " + pay_g);
                } else {
                    let sv = self.to_slot_i64(self.last_value, self.last_type);
                    self.ir.emit("  store i64 " + sv + ", ptr " + pay_g);
                }
            },
            OptionExpressionNode::None {
                self.ir.emit("  store i64 0, ptr " + pay_g);
            }
        }
        self.set_last(p, "ptr");
    }

    fn compile_field_access(self, FieldAccessExpression fa): void {
        self.compile_expression(fa.instance);
        let base = self.last_value;
        self.note_temp_base(fa.instance, base, self.last_type);

        let idx = 0;
        let field_ty = "i64";
        for (let t = 0; t < self.program.declared_types.size(); t += 1) {
            if (self.program.declared_types[t].value matches DeclaredType::Struct(s)) {
                for (let m = 0; m < s.members.size(); m += 1) {
                    if (s.members[m].value.identifier.value == fa.field.value) {
                        idx = m;
                        field_ty = s.members[m].value.member_type.value.to_llvm();
                    }
                }
            }
        }

        # The by-name scan above is ambiguous when several structs share a field
        # name (e.g. `filename`, `src`). If the instance's struct is known, use its
        # own layout instead.
        let base_rty = self.expr_rtype(fa.instance);
        if (base_rty != "") {
            if (self.lookup_struct(base_rty) matches OptionStructDeclaration::Some(sd)) {
                for (let m = 0; m < sd.members.size(); m += 1) {
                    if (sd.members[m].value.identifier.value == fa.field.value) {
                        idx = m;
                        field_ty = sd.members[m].value.member_type.value.to_llvm();
                    }
                }
            }
        }

        let gep = self.ir.tmp();
        self.ir.emit("  " + gep + " = getelementptr i8, ptr " + base + ", i64 " + (idx * 8) as str);

        if (field_ty == "ptr") {
            let val = self.ir.tmp();
            self.ir.emit("  " + val + " = load ptr, ptr " + gep);
            self.set_last(val, "ptr");
        } else {
            let raw = self.ir.tmp();
            self.ir.emit("  " + raw + " = load i64, ptr " + gep);
            if (field_ty == "i64") {
                self.set_last(raw, "i64");
            } else if (field_ty == "double") {
                let d = self.ir.tmp();
                self.ir.emit("  " + d + " = bitcast i64 " + raw + " to double");
                self.set_last(d, "double");
            } else if (field_ty == "i1") {
                let tr = self.ir.tmp();
                self.ir.emit("  " + tr + " = trunc i64 " + raw + " to i1");
                self.set_last(tr, "i1");
            } else if (field_ty == "i8" || field_ty == "i16" || field_ty == "i32") {
                let tr = self.ir.tmp();
                self.ir.emit("  " + tr + " = trunc i64 " + raw + " to " + field_ty);
                self.set_last(tr, field_ty);
            } else {
                self.set_last(raw, "i64");
            }
        }
    }

    fn expr_rtype(self, ExpressionNode e): str {
        match (e.value) {
            Expression::Literal(lit) {
                if (lit matches Literal::String) {
                    return "str";
                }
                if (lit matches Literal::Char) {
                    return "char";
                }
                if (lit matches Literal::I64) {
                    return "i64";
                }
                if (lit matches Literal::F64) {
                    return "f64";
                }
                if (lit matches Literal::True) {
                    return "bool";
                }
                if (lit matches Literal::False) {
                    return "bool";
                }
                return "";
            },
            Expression::Addition(bin) {
                if (self.expr_rtype(bin.left) == "str") {
                    return "str";
                }
                if (self.expr_rtype(bin.right) == "str") {
                    return "str";
                }
                return self.arith_rty(bin.left, bin.right);
            },
            Expression::Subtraction(bin) {
                return self.arith_rty(bin.left, bin.right);
            },
            Expression::Multiplication(bin) {
                return self.arith_rty(bin.left, bin.right);
            },
            Expression::Division(bin) {
                return self.arith_rty(bin.left, bin.right);
            },
            Expression::Modulo(bin) {
                return self.arith_rty(bin.left, bin.right);
            },
            Expression::ArithmeticNegation(inner) {
                return self.expr_rtype(inner);
            },
            Expression::BooleanNegation {
                return "bool";
            },
            Expression::Alternative {
                return "bool";
            },
            Expression::Concatenation {
                return "bool";
            },
            Expression::Equal {
                return "bool";
            },
            Expression::NotEqual {
                return "bool";
            },
            Expression::Less {
                return "bool";
            },
            Expression::LessEqual {
                return "bool";
            },
            Expression::Greater {
                return "bool";
            },
            Expression::GreaterEqual {
                return "bool";
            },
            Expression::Index(ix) {
                let col_rty = self.expr_rtype(ix.collection);
                if (col_rty == "str") {
                    return "char";
                }
                return LLVMIRCodegen.llvm_rty_element(col_rty);
            },
            Expression::Vector(elems) {
                if (elems.size() == 0) {
                    return "";
                }
                return self.expr_rtype(elems[0]) + "[]";
            },
            Expression::Casting(cs) {
                return cs.to_type.value.llvm_type_rname();
            },
            Expression::StructLiteral(sl) {
                return sl.value.identifier.value;
            },
            Expression::Variable(name) {
                let li = self.find_local(name);
                if (li < 0) {
                    return "";
                }
                return self.locals[li].rty;
            },
            Expression::FieldAccess(fa) {
                let base = self.expr_rtype(fa.instance);
                if (base != "") {
                    if (self.lookup_struct(base) matches OptionStructDeclaration::Some(sd)) {
                        for (let m = 0; m < sd.members.size(); m += 1) {
                            if (sd.members[m].value.identifier.value == fa.field.value) {
                                return sd.members[m].value.member_type.value.llvm_type_rname();
                            }
                        }
                        return "";
                    }
                }

                # Instance type unknown: accept the field only if every struct that
                # declares it agrees on its type.
                let found = false;
                let result = "";
                for (let t = 0; t < self.program.declared_types.size(); t += 1) {
                    if (self.program.declared_types[t].value matches DeclaredType::Struct(s)) {
                        for (let m = 0; m < s.members.size(); m += 1) {
                            if (s.members[m].value.identifier.value == fa.field.value) {
                                let name = s.members[m].value.member_type.value.llvm_type_rname();
                                if (found && name != result) {
                                    return "";
                                }
                                found = true;
                                result = name;
                            }
                        }
                    }
                }
                return result;
            },
            Expression::FunctionCall(call) {
                for (let i = 0; i < self.program.functions.size(); i += 1) {
                    if (self.program.functions[i].value.identifier.value == call.identifier.value) {
                        return self.program.functions[i].value.return_type.value.llvm_type_rname();
                    }
                }
                if (call.identifier.value == "cli_args") {
                    return "str[]";
                }
                if (call.identifier.value == "read_file") {
                    return "str";
                }
                if (call.identifier.value == "input") {
                    return "str";
                }
                return "";
            },
            rest {
                return "";
            }
        }
    }

    fn expr_is_str(self, ExpressionNode e): bool {
        return self.expr_rtype(e) == "str";
    }

    fn emit_bounds_check(self, str col, str idx, bool is_string, Span span): void {
        let len = self.ir.tmp();
        if (is_string) {
            self.ir.emit("  " + len + " = call i64 @strlen(ptr " + col + ")");
        } else {
            let lp = self.ir.tmp();
            self.ir.emit("  " + lp + " = getelementptr i8, ptr " + col + ", i64 16");
            self.ir.emit("  " + len + " = load i64, ptr " + lp);
        }
        let below = self.ir.tmp();
        self.ir.emit("  " + below + " = icmp slt i64 " + idx + ", 0");
        let above = self.ir.tmp();
        self.ir.emit("  " + above + " = icmp sge i64 " + idx + ", " + len);
        let oob = self.ir.tmp();
        self.ir.emit("  " + oob + " = or i1 " + below + ", " + above);
        self.emit_diag(oob, "Index out of bounds.", span, true);
    }

    fn compile_index(self, IndexExpression ix): void {
        self.compile_expression(ix.collection);
        let col = self.last_value;
        self.note_temp_base(ix.collection, col, self.last_type);
        self.compile_expression(ix.index);
        let idx = self.resize_int(
            self.last_value,
            self.last_type,
            "i64",
            !LLVMIRCodegen.rname_is_unsigned(self.expr_rtype(ix.index))
        );
        let is_string = self.expr_is_str(ix.collection);

        self.emit_bounds_check(col, idx, is_string, ix.index.span);

        # str[i]: the string is a raw byte buffer; yield the byte as a `char` (i32).
        if (self.expr_is_str(ix.collection)) {
            let byte_p = self.ir.tmp();
            self.ir.emit("  " + byte_p + " = getelementptr i8, ptr " + col + ", i64 " + idx);
            let byte_v = self.ir.tmp();
            self.ir.emit("  " + byte_v + " = load i8, ptr " + byte_p);
            let wide = self.ir.tmp();
            self.ir.emit("  " + wide + " = zext i8 " + byte_v + " to i32");
            self.set_last(wide, "i32");
            return;
        }

        let data_p = self.ir.tmp();
        self.ir.emit("  " + data_p + " = getelementptr i8, ptr " + col + ", i64 8");
        let data = self.ir.tmp();
        self.ir.emit("  " + data + " = load ptr, ptr " + data_p);
        let slot = self.ir.tmp();
        self.ir.emit("  " + slot + " = getelementptr ptr, ptr " + data + ", i64 " + idx);

        # Elements of a vector of primitives are i64 slots: read them back with
        # their real type (a `ptr` here would later be retained / released).
        let elem_ty = LLVMIRCodegen.rname_prim_ty(
            LLVMIRCodegen.llvm_rty_element(self.expr_rtype(ix.collection))
        );
        if (elem_ty != "") {
            let raw = self.ir.tmp();
            self.ir.emit("  " + raw + " = load i64, ptr " + slot);
            if (elem_ty == "i64") {
                self.set_last(raw, "i64");
            } else if (elem_ty == "double") {
                let d = self.ir.tmp();
                self.ir.emit("  " + d + " = bitcast i64 " + raw + " to double");
                self.set_last(d, "double");
            } else {
                let nr = self.ir.tmp();
                self.ir.emit("  " + nr + " = trunc i64 " + raw + " to " + elem_ty);
                self.set_last(nr, elem_ty);
            }
            return;
        }
        let val = self.ir.tmp();
        self.ir.emit("  " + val + " = load ptr, ptr " + slot);
        self.set_last(val, "ptr");
    }

    fn compile_function_call(self, FunctionCallExpression call): void {
        let arg_vals: str[] = [];
        let arg_tys: str[] = [];

        # "1" when the argument is a fresh (+1) temporary the caller must release.
        let arg_fresh: str[] = [];
        for (let i = 0; i < call.arguments.size(); i += 1) {
            let arg_ref = false;
            if (call.arguments[i].value.passed_by matches PassedBy::Reference) {
                arg_ref = true;
            }

            # `&x` where x is a primitive local: pass the address of x so the
            # callee can write through it (see self.param_is_prim_ref).
            let addr = "";
            if (arg_ref) {
                if (call.arguments[i].value.value.value matches Expression::Variable(vname)) {
                    let li = self.find_local(vname);
                    if (li >= 0) {
                        if (self.locals[li].ty != "ptr") {
                            addr = self.locals[li].ptr;
                        }
                    }
                }
            }
            if (addr != "") {
                arg_vals.push(addr);
                arg_tys.push("ptr");
                arg_fresh.push("0");
                continue;
            }
            self.compile_expression(call.arguments[i].value.value);
            let arg_copy = "";
            if (!arg_ref && self.last_type == "ptr") {
                arg_copy = self.copy_for_param(
                    call.identifier.value,
                    i,
                    call.arguments[i].value.value,
                    self.last_value
                );
            }
            if (arg_copy.size() > 0) {
                arg_vals.push(arg_copy);
                arg_tys.push("ptr");
                arg_fresh.push("1");
                continue;
            }
            if (arg_ref && self.last_type != "ptr") {
                # Not a plain variable (field, index, temporary): pass a temporary's
                # address. Writes by the callee are not propagated back.
                let tmp = self.ir.tmp();
                self.allocas.push("  " + tmp + " = alloca " + self.last_type);
                self.ir.emit("  store " + self.last_type + " " + self.last_value + ", ptr " + tmp);
                arg_vals.push(tmp);
                arg_tys.push("ptr");
                arg_fresh.push("0");
                continue;
            }
            arg_vals.push(self.last_value);
            arg_tys.push(self.last_type);
            if (
                self.last_type == "ptr"
                    && !LLVMIRCodegen.expr_is_borrowed(call.arguments[i].value.value)
            ) {
                arg_fresh.push("1");
            } else {
                arg_fresh.push("0");
            }
        }

        self.compile_call_dispatch(call, arg_vals, arg_tys, arg_fresh);

        # Temporaries passed as arguments were only borrowed by the callee.
        if (self.arc) {
            for (let i = 0; i < arg_vals.size(); i += 1) {
                if (arg_fresh[i] == "1") {
                    let consumed = false;
                    if (call.identifier.value == "vector_push" && i == 1) {
                        consumed = true;
                    }
                    if (!consumed) {
                        self.emit_release(arg_vals[i]);
                    }
                }
            }
        }
    }

    fn compile_call_dispatch(
        self,
        FunctionCallExpression call,
        str[] arg_vals,
        str[] arg_tys,
        str[] arg_fresh
    ): void {
        let name = call.identifier.value;

        # ========== IO ==========
        if (name == "println") {
            if (arg_vals.size() == 0) {
                let g = self.ir.cstr_global("\n");
                let p = self.ir.tmp();
                self.ir.emit(
                    "  " + p + " = getelementptr inbounds [2 x i8], ptr " + g + ", i64 0, i64 0"
                );
                self.ir.emit(
                    "  " + self.ir.tmp() + " = call i32 (ptr, ...) @printf(ptr " + p + ")"
                );
                self.ir.emit("  " + self.ir.tmp() + " = call i32 @fflush(ptr null)");
                self.set_last("0", "i64");
                return;
            }
            let a = arg_vals[0];
            let at = arg_tys[0];
            if (at != "ptr") {
                a = self.to_str_value(a, at);
            }
            let fmt = self.ir.cstr_global("%s\n");
            let fp = self.ir.tmp();
            self.ir.emit(
                "  " + fp + " = getelementptr inbounds [4 x i8], ptr " + fmt + ", i64 0, i64 0"
            );
            self.ir.emit(
                "  "
                    + self.ir.tmp()
                    + " = call i32 (ptr, ...) @printf(ptr "
                    + fp
                    + ", ptr "
                    + a
                    + ")"
            );
            self.ir.emit("  " + self.ir.tmp() + " = call i32 @fflush(ptr null)");
            self.set_last("0", "i64");
            return;
        }

        if (name == "print") {
            if (arg_vals.size() >= 1) {
                let a = arg_vals[0];
                let at = arg_tys[0];
                if (at != "ptr") {
                    a = self.to_str_value(a, at);
                }
                let fmt = self.ir.cstr_global("%s");
                let fp = self.ir.tmp();
                self.ir.emit(
                    "  " + fp + " = getelementptr inbounds [3 x i8], ptr " + fmt + ", i64 0, i64 0"
                );
                self.ir.emit(
                    "  "
                        + self.ir.tmp()
                        + " = call i32 (ptr, ...) @printf(ptr "
                        + fp
                        + ", ptr "
                        + a
                        + ")"
                );
                self.ir.emit("  " + self.ir.tmp() + " = call i32 @fflush(ptr null)");
            }
            self.set_last("0", "i64");
            return;
        }

        if (name == "input") {
            # read up to 4095 chars from stdin via fgets
            let buf = self.alloc_bytes("4096", "null");
            let stdin_p = self.ir.tmp();
            self.ir.emit("  " + stdin_p + " = load ptr, ptr @stdin");
            self.ir.emit(
                "  "
                    + self.ir.tmp()
                    + " = call ptr @fgets(ptr "
                    + buf
                    + ", i32 4096, ptr "
                    + stdin_p
                    + ")"
            );

            # strip trailing newline if present
            let ln = self.ir.tmp();
            self.ir.emit("  " + ln + " = call i64 @strlen(ptr " + buf + ")");
            let cmp = self.ir.tmp();
            self.ir.emit("  " + cmp + " = icmp ugt i64 " + ln + ", 0");
            let strip_l = self.ir.label("input.strip");
            let done_l = self.ir.label("input.done");
            self.ir.emit("  br i1 " + cmp + ", label %" + strip_l + ", label %" + done_l);
            self.ir.emit(strip_l + ":");
            let last_i = self.ir.tmp();
            self.ir.emit("  " + last_i + " = sub i64 " + ln + ", 1");
            let last_p = self.ir.tmp();
            self.ir.emit("  " + last_p + " = getelementptr i8, ptr " + buf + ", i64 " + last_i);
            let last_c = self.ir.tmp();
            self.ir.emit("  " + last_c + " = load i8, ptr " + last_p);
            let is_nl = self.ir.tmp();
            self.ir.emit("  " + is_nl + " = icmp eq i8 " + last_c + ", 10");
            let do_l = self.ir.label("input.do_strip");
            self.ir.emit("  br i1 " + is_nl + ", label %" + do_l + ", label %" + done_l);
            self.ir.emit(do_l + ":");
            self.ir.emit("  store i8 0, ptr " + last_p);
            self.ir.emit("  br label %" + done_l);
            self.ir.emit(done_l + ":");
            self.set_last(buf, "ptr");
            return;
        }

        if (name == "cli_args") {
            let argc32 = self.ir.tmp();
            self.ir.emit("  " + argc32 + " = load i32, ptr @raptor_argc");
            let argc = self.ir.tmp();
            self.ir.emit("  " + argc + " = sext i32 " + argc32 + " to i64");
            let argv = self.ir.tmp();
            self.ir.emit("  " + argv + " = load ptr, ptr @raptor_argv");
            let vec = self.vector_alloc_empty();
            let i_ptr = self.ir.tmp();
            self.ir.emit("  " + i_ptr + " = alloca i64");
            self.ir.emit("  store i64 0, ptr " + i_ptr);
            let cond_l = self.ir.label("cli.cond");
            let body_l = self.ir.label("cli.body");
            let end_l = self.ir.label("cli.end");
            self.ir.emit("  br label %" + cond_l);
            self.ir.emit(cond_l + ":");
            let i_val = self.ir.tmp();
            self.ir.emit("  " + i_val + " = load i64, ptr " + i_ptr);
            let cmp = self.ir.tmp();
            self.ir.emit("  " + cmp + " = icmp slt i64 " + i_val + ", " + argc);
            self.ir.emit("  br i1 " + cmp + ", label %" + body_l + ", label %" + end_l);
            self.ir.emit(body_l + ":");
            let slot = self.ir.tmp();
            self.ir.emit("  " + slot + " = getelementptr ptr, ptr " + argv + ", i64 " + i_val);
            let cstr = self.ir.tmp();
            self.ir.emit("  " + cstr + " = load ptr, ptr " + slot);
            let ln = self.ir.tmp();
            self.ir.emit("  " + ln + " = call i64 @strlen(ptr " + cstr + ")");
            let sz = self.ir.tmp();
            self.ir.emit("  " + sz + " = add i64 " + ln + ", 1");
            let buf = self.alloc_bytes(sz, "null");
            self.ir.emit(
                "  "
                    + self.ir.tmp()
                    + " = call ptr @memcpy(ptr "
                    + buf
                    + ", ptr "
                    + cstr
                    + ", i64 "
                    + sz
                    + ")"
            );
            self.vector_push_ptr(vec, buf);
            let inext = self.ir.tmp();
            self.ir.emit("  " + inext + " = add i64 " + i_val + ", 1");
            self.ir.emit("  store i64 " + inext + ", ptr " + i_ptr);
            self.ir.emit("  br label %" + cond_l);
            self.ir.emit(end_l + ":");
            self.set_last(vec, "ptr");
            return;
        }

        # ========== FILES ==========
        if (name == "exists_file") {
            let a = self.ir.tmp();
            self.ir.emit("  " + a + " = call i32 @access(ptr " + arg_vals[0] + ", i32 0)");
            let ok = self.ir.tmp();
            self.ir.emit("  " + ok + " = icmp eq i32 " + a + ", 0");
            self.set_last(ok, "i1");
            return;
        }

        if (name == "delete_file") {
            self.ir.emit("  " + self.ir.tmp() + " = call i32 @remove(ptr " + arg_vals[0] + ")");
            self.set_last("0", "i64");
            return;
        }

        if (name == "read_file") {
            let mode = self.ir.cstr_global("rb");
            let mode_p = self.ir.tmp();
            self.ir.emit(
                "  " + mode_p + " = getelementptr inbounds [3 x i8], ptr " + mode + ", i64 0, i64 0"
            );
            let fp = self.ir.tmp();
            self.ir.emit(
                "  " + fp + " = call ptr @fopen(ptr " + arg_vals[0] + ", ptr " + mode_p + ")"
            );
            let is_null = self.ir.tmp();
            self.ir.emit("  " + is_null + " = icmp eq ptr " + fp + ", null");
            let err_l = self.ir.label("rf.err");
            let ok_l = self.ir.label("rf.ok");
            let end_l = self.ir.label("rf.end");
            let res_slot = self.ir.tmp();
            self.ir.emit("  " + res_slot + " = alloca ptr");
            self.ir.emit("  br i1 " + is_null + ", label %" + err_l + ", label %" + ok_l);
            self.ir.emit(err_l + ":");
            let empty_p = self.str_literal("");
            self.ir.emit("  store ptr " + empty_p + ", ptr " + res_slot);
            self.ir.emit("  br label %" + end_l);
            self.ir.emit(ok_l + ":");
            self.ir.emit("  " + self.ir.tmp() + " = call i32 @fseek(ptr " + fp + ", i64 0, i32 2)");
            let sz = self.ir.tmp();
            self.ir.emit("  " + sz + " = call i64 @ftell(ptr " + fp + ")");
            self.ir.emit("  " + self.ir.tmp() + " = call i32 @fseek(ptr " + fp + ", i64 0, i32 0)");
            let bufsz = self.ir.tmp();
            self.ir.emit("  " + bufsz + " = add i64 " + sz + ", 1");
            let buf = self.alloc_bytes(bufsz, "null");
            self.ir.emit(
                "  "
                    + self.ir.tmp()
                    + " = call i64 @fread(ptr "
                    + buf
                    + ", i64 1, i64 "
                    + sz
                    + ", ptr "
                    + fp
                    + ")"
            );
            let nul_p = self.ir.tmp();
            self.ir.emit("  " + nul_p + " = getelementptr i8, ptr " + buf + ", i64 " + sz);
            self.ir.emit("  store i8 0, ptr " + nul_p);
            self.ir.emit("  " + self.ir.tmp() + " = call i32 @fclose(ptr " + fp + ")");
            self.ir.emit("  store ptr " + buf + ", ptr " + res_slot);
            self.ir.emit("  br label %" + end_l);
            self.ir.emit(end_l + ":");
            let res = self.ir.tmp();
            self.ir.emit("  " + res + " = load ptr, ptr " + res_slot);
            self.set_last(res, "ptr");
            return;
        }

        if (name == "write_file" || name == "append_file") {
            let mode_s = "wb";
            if (name == "append_file") {
                mode_s = "ab";
            }
            let mode = self.ir.cstr_global(mode_s);
            let mode_n = 3;
            let mode_p = self.ir.tmp();
            self.ir.emit(
                "  "
                    + mode_p
                    + " = getelementptr inbounds ["
                    + mode_n as str
                    + " x i8], ptr "
                    + mode
                    + ", i64 0, i64 0"
            );
            let fp = self.ir.tmp();
            self.ir.emit(
                "  " + fp + " = call ptr @fopen(ptr " + arg_vals[0] + ", ptr " + mode_p + ")"
            );
            let is_null = self.ir.tmp();
            self.ir.emit("  " + is_null + " = icmp eq ptr " + fp + ", null");
            let skip_l = self.ir.label("wf.skip");
            let do_l = self.ir.label("wf.do");
            let end_l = self.ir.label("wf.end");
            self.ir.emit("  br i1 " + is_null + ", label %" + skip_l + ", label %" + do_l);
            self.ir.emit(do_l + ":");
            let ln = self.ir.tmp();
            self.ir.emit("  " + ln + " = call i64 @strlen(ptr " + arg_vals[1] + ")");
            self.ir.emit(
                "  "
                    + self.ir.tmp()
                    + " = call i64 @fwrite(ptr "
                    + arg_vals[1]
                    + ", i64 1, i64 "
                    + ln
                    + ", ptr "
                    + fp
                    + ")"
            );
            self.ir.emit("  " + self.ir.tmp() + " = call i32 @fclose(ptr " + fp + ")");
            self.ir.emit("  br label %" + end_l);
            self.ir.emit(skip_l + ":");
            self.ir.emit("  br label %" + end_l);
            self.ir.emit(end_l + ":");
            self.set_last("0", "i64");
            return;
        }

        # ========== VECTORS ==========
        if (name == "vector_size") {
            let len_p = self.ir.tmp();
            self.ir.emit("  " + len_p + " = getelementptr i8, ptr " + arg_vals[0] + ", i64 16");
            let r = self.ir.tmp();
            self.ir.emit("  " + r + " = load i64, ptr " + len_p);
            self.set_last(r, "i64");
            return;
        }

        if (name == "vector_push") {
            if (arg_tys[1] == "ptr") {
                let elem_val = arg_vals[1];
                let elem_expr = call.arguments[1].value.value;
                if (
                    self.expr_rtype(elem_expr) == "str"
                        && (arg_fresh[1] != "1" || LLVMIRCodegen.expr_is_str_literal(elem_expr))
                ) {
                    # str elements are values too
                    elem_val = self.ir.tmp();
                    self.ir.emit(
                        "  " + elem_val + " = call ptr @rt_str_copy(ptr " + arg_vals[1] + ")"
                    );
                } else if (arg_fresh[1] != "1") {
                    self.emit_retain(arg_vals[1]);
                }
                self.vector_push_ptr(arg_vals[0], elem_val);
            } else {
                self.vector_push_i64(arg_vals[0], arg_vals[1], arg_tys[1]);
            }
            self.set_last("0", "i64");
            return;
        }

        if (name == "vector_stringify") {
            let elem = LLVMIRCodegen.llvm_rty_element(
                self.expr_rtype(call.arguments[0].value.value)
            );
            if (LLVMIRCodegen.vstr_supported(elem)) {
                let fname = self.vstr_fn(elem);
                let r = self.ir.tmp();
                self.ir.emit("  " + r + " = call ptr " + fname + "(ptr " + arg_vals[0] + ")");
                self.set_last(r, "ptr");
                return;
            }

            # Elements we cannot format (structs, enums, nested vectors, chars).
            let p = self.str_literal("[vector]");
            self.set_last(p, "ptr");
            return;
        }

        if (name == "vector_extend") {
            # target.extend(source): one realloc + one memcpy.
            # Slots are 8 bytes for every element kind, so a flat copy is valid.
            let tgt = arg_vals[0];
            let src = arg_vals[1];

            let s_len_p = self.ir.tmp();
            self.ir.emit("  " + s_len_p + " = getelementptr i8, ptr " + src + ", i64 16");
            let s_len = self.ir.tmp();
            self.ir.emit("  " + s_len + " = load i64, ptr " + s_len_p);
            let s_flag = self.ir.tmp();
            self.ir.emit("  " + s_flag + " = load i64, ptr " + src);

            let has = self.ir.tmp();
            self.ir.emit("  " + has + " = icmp sgt i64 " + s_len + ", 0");
            let do_l = self.ir.label("vext.do");
            let grow_l = self.ir.label("vext.grow");
            let merge_l = self.ir.label("vext.merge");
            let end_l = self.ir.label("vext.end");
            self.ir.emit("  br i1 " + has + ", label %" + do_l + ", label %" + end_l);

            self.ir.emit(do_l + ":");
            let t_len_p = self.ir.tmp();
            self.ir.emit("  " + t_len_p + " = getelementptr i8, ptr " + tgt + ", i64 16");
            let t_len = self.ir.tmp();
            self.ir.emit("  " + t_len + " = load i64, ptr " + t_len_p);
            let t_cap_p = self.ir.tmp();
            self.ir.emit("  " + t_cap_p + " = getelementptr i8, ptr " + tgt + ", i64 24");
            let t_cap = self.ir.tmp();
            self.ir.emit("  " + t_cap + " = load i64, ptr " + t_cap_p);
            let t_data_p = self.ir.tmp();
            self.ir.emit("  " + t_data_p + " = getelementptr i8, ptr " + tgt + ", i64 8");
            let new_len = self.ir.tmp();
            self.ir.emit("  " + new_len + " = add i64 " + t_len + ", " + s_len);
            let need = self.ir.tmp();
            self.ir.emit("  " + need + " = icmp sgt i64 " + new_len + ", " + t_cap);
            self.ir.emit("  br i1 " + need + ", label %" + grow_l + ", label %" + merge_l);

            self.ir.emit(grow_l + ":");
            let old_data = self.ir.tmp();
            self.ir.emit("  " + old_data + " = load ptr, ptr " + t_data_p);
            let dbl = self.ir.tmp();
            self.ir.emit("  " + dbl + " = mul i64 " + t_cap + ", 2");
            let big = self.ir.tmp();
            self.ir.emit("  " + big + " = icmp sgt i64 " + new_len + ", " + dbl);
            let nc = self.ir.tmp();
            self.ir.emit("  " + nc + " = select i1 " + big + ", i64 " + new_len + ", i64 " + dbl);
            let small = self.ir.tmp();
            self.ir.emit("  " + small + " = icmp slt i64 " + nc + ", 4");
            let nc2 = self.ir.tmp();
            self.ir.emit("  " + nc2 + " = select i1 " + small + ", i64 4, i64 " + nc);
            let bytes = self.ir.tmp();
            self.ir.emit("  " + bytes + " = mul i64 " + nc2 + ", 8");
            let nd = self.ir.tmp();
            self.ir.emit(
                "  " + nd + " = call ptr @realloc(ptr " + old_data + ", i64 " + bytes + ")"
            );
            self.ir.emit("  store ptr " + nd + ", ptr " + t_data_p);
            self.ir.emit("  store i64 " + nc2 + ", ptr " + t_cap_p);
            self.ir.emit("  br label %" + merge_l);

            self.ir.emit(merge_l + ":");

            # Reload both data pointers AFTER the realloc: source may alias target.
            let data = self.ir.tmp();
            self.ir.emit("  " + data + " = load ptr, ptr " + t_data_p);
            let s_data_p = self.ir.tmp();
            self.ir.emit("  " + s_data_p + " = getelementptr i8, ptr " + src + ", i64 8");
            let s_data = self.ir.tmp();
            self.ir.emit("  " + s_data + " = load ptr, ptr " + s_data_p);
            let dst = self.ir.tmp();
            self.ir.emit("  " + dst + " = getelementptr i64, ptr " + data + ", i64 " + t_len);
            let nbytes = self.ir.tmp();
            self.ir.emit("  " + nbytes + " = mul i64 " + s_len + ", 8");
            self.ir.emit(
                "  "
                    + self.ir.tmp()
                    + " = call ptr @memcpy(ptr "
                    + dst
                    + ", ptr "
                    + s_data
                    + ", i64 "
                    + nbytes
                    + ")"
            );
            self.ir.emit("  store i64 " + new_len + ", ptr " + t_len_p);

            # Managed-elements flag: target |= source (same convention as rt_vec_copy).
            let t_flag = self.ir.tmp();
            self.ir.emit("  " + t_flag + " = load i64, ptr " + tgt);
            let n_flag = self.ir.tmp();
            self.ir.emit("  " + n_flag + " = or i64 " + t_flag + ", " + s_flag);
            self.ir.emit("  store i64 " + n_flag + ", ptr " + tgt);

            if (self.arc) {
                # The copied pointers are now shared by two vectors: retain each one.
                let ip = self.ir.tmp();
                self.allocas.push("  " + ip + " = alloca i64");
                let mg = self.ir.tmp();
                self.ir.emit("  " + mg + " = icmp ne i64 " + s_flag + ", 0");
                let rinit_l = self.ir.label("vext.rinit");
                let rloop_l = self.ir.label("vext.rloop");
                let rbody_l = self.ir.label("vext.rbody");
                self.ir.emit("  br i1 " + mg + ", label %" + rinit_l + ", label %" + end_l);

                self.ir.emit(rinit_l + ":");
                self.ir.emit("  store i64 0, ptr " + ip);
                self.ir.emit("  br label %" + rloop_l);

                self.ir.emit(rloop_l + ":");
                let i = self.ir.tmp();
                self.ir.emit("  " + i + " = load i64, ptr " + ip);
                let k = self.ir.tmp();
                self.ir.emit("  " + k + " = icmp slt i64 " + i + ", " + s_len);
                self.ir.emit("  br i1 " + k + ", label %" + rbody_l + ", label %" + end_l);

                self.ir.emit(rbody_l + ":");
                let slot = self.ir.tmp();
                self.ir.emit("  " + slot + " = getelementptr ptr, ptr " + s_data + ", i64 " + i);
                let el = self.ir.tmp();
                self.ir.emit("  " + el + " = load ptr, ptr " + slot);
                self.ir.emit("  call void @rt_retain(ptr " + el + ")");
                let inext = self.ir.tmp();
                self.ir.emit("  " + inext + " = add i64 " + i + ", 1");
                self.ir.emit("  store i64 " + inext + ", ptr " + ip);
                self.ir.emit("  br label %" + rloop_l);
            } else {
                self.ir.emit("  br label %" + end_l);
            }

            self.ir.emit(end_l + ":");
            self.set_last("0", "i64");
            return;
        }

        # ========== STRINGS ==========
        if (name == "str_len") {
            let r = self.ir.tmp();
            self.ir.emit("  " + r + " = call i64 @strlen(ptr " + arg_vals[0] + ")");
            self.set_last(r, "i64");
            return;
        }

        if (name == "str_to_char_vector") {
            # One allocation of len*8 bytes, then widen each byte into an i64 slot.
            let s = arg_vals[0];
            let len = self.ir.tmp();
            self.ir.emit("  " + len + " = call i64 @strlen(ptr " + s + ")");
            let vec = self.vector_alloc_empty();

            let has = self.ir.tmp();
            self.ir.emit("  " + has + " = icmp sgt i64 " + len + ", 0");
            let fill_l = self.ir.label("s2c.fill");
            let loop_l = self.ir.label("s2c.loop");
            let body_l = self.ir.label("s2c.body");
            let done_l = self.ir.label("s2c.done");
            self.ir.emit("  br i1 " + has + ", label %" + fill_l + ", label %" + done_l);

            self.ir.emit(fill_l + ":");
            let bytes = self.ir.tmp();
            self.ir.emit("  " + bytes + " = mul i64 " + len + ", 8");
            let data = self.ir.tmp();
            self.ir.emit("  " + data + " = call ptr @malloc(i64 " + bytes + ")");
            let d_p = self.ir.tmp();
            self.ir.emit("  " + d_p + " = getelementptr i8, ptr " + vec + ", i64 8");
            self.ir.emit("  store ptr " + data + ", ptr " + d_p);
            let l_p = self.ir.tmp();
            self.ir.emit("  " + l_p + " = getelementptr i8, ptr " + vec + ", i64 16");
            self.ir.emit("  store i64 " + len + ", ptr " + l_p);
            let c_p = self.ir.tmp();
            self.ir.emit("  " + c_p + " = getelementptr i8, ptr " + vec + ", i64 24");
            self.ir.emit("  store i64 " + len + ", ptr " + c_p);
            let ip = self.ir.tmp();
            self.allocas.push("  " + ip + " = alloca i64");
            self.ir.emit("  store i64 0, ptr " + ip);
            self.ir.emit("  br label %" + loop_l);

            self.ir.emit(loop_l + ":");
            let i = self.ir.tmp();
            self.ir.emit("  " + i + " = load i64, ptr " + ip);
            let k = self.ir.tmp();
            self.ir.emit("  " + k + " = icmp slt i64 " + i + ", " + len);
            self.ir.emit("  br i1 " + k + ", label %" + body_l + ", label %" + done_l);

            self.ir.emit(body_l + ":");
            let bp = self.ir.tmp();
            self.ir.emit("  " + bp + " = getelementptr i8, ptr " + s + ", i64 " + i);
            let b = self.ir.tmp();
            self.ir.emit("  " + b + " = load i8, ptr " + bp);
            let w = self.ir.tmp();
            self.ir.emit("  " + w + " = zext i8 " + b + " to i64");
            let sp = self.ir.tmp();
            self.ir.emit("  " + sp + " = getelementptr i64, ptr " + data + ", i64 " + i);
            self.ir.emit("  store i64 " + w + ", ptr " + sp);
            let inext = self.ir.tmp();
            self.ir.emit("  " + inext + " = add i64 " + i + ", 1");
            self.ir.emit("  store i64 " + inext + ", ptr " + ip);
            self.ir.emit("  br label %" + loop_l);

            self.ir.emit(done_l + ":");
            self.set_last(vec, "ptr");
            return;
        }

        if (name == "char_vector_to_str") {
            # Narrow each i64 slot to one byte; NUL-terminate.
            let vec = arg_vals[0];
            let len_p = self.ir.tmp();
            self.ir.emit("  " + len_p + " = getelementptr i8, ptr " + vec + ", i64 16");
            let len = self.ir.tmp();
            self.ir.emit("  " + len + " = load i64, ptr " + len_p);
            let data_p = self.ir.tmp();
            self.ir.emit("  " + data_p + " = getelementptr i8, ptr " + vec + ", i64 8");
            let data = self.ir.tmp();
            self.ir.emit("  " + data + " = load ptr, ptr " + data_p);

            let n1 = self.ir.tmp();
            self.ir.emit("  " + n1 + " = add i64 " + len + ", 1");
            let buf = self.alloc_bytes(n1, "null");

            let ip = self.ir.tmp();
            self.allocas.push("  " + ip + " = alloca i64");
            self.ir.emit("  store i64 0, ptr " + ip);
            let loop_l = self.ir.label("c2s.loop");
            let body_l = self.ir.label("c2s.body");
            let done_l = self.ir.label("c2s.done");
            self.ir.emit("  br label %" + loop_l);

            self.ir.emit(loop_l + ":");
            let i = self.ir.tmp();
            self.ir.emit("  " + i + " = load i64, ptr " + ip);
            let k = self.ir.tmp();
            self.ir.emit("  " + k + " = icmp slt i64 " + i + ", " + len);
            self.ir.emit("  br i1 " + k + ", label %" + body_l + ", label %" + done_l);

            self.ir.emit(body_l + ":");
            let slot = self.ir.tmp();
            self.ir.emit("  " + slot + " = getelementptr i64, ptr " + data + ", i64 " + i);
            let raw = self.ir.tmp();
            self.ir.emit("  " + raw + " = load i64, ptr " + slot);
            let b = self.ir.tmp();
            self.ir.emit("  " + b + " = trunc i64 " + raw + " to i8");
            let bp = self.ir.tmp();
            self.ir.emit("  " + bp + " = getelementptr i8, ptr " + buf + ", i64 " + i);
            self.ir.emit("  store i8 " + b + ", ptr " + bp);
            let inext = self.ir.tmp();
            self.ir.emit("  " + inext + " = add i64 " + i + ", 1");
            self.ir.emit("  store i64 " + inext + ", ptr " + ip);
            self.ir.emit("  br label %" + loop_l);

            self.ir.emit(done_l + ":");
            let endp = self.ir.tmp();
            self.ir.emit("  " + endp + " = getelementptr i8, ptr " + buf + ", i64 " + len);
            self.ir.emit("  store i8 0, ptr " + endp);
            self.set_last(buf, "ptr");
            return;
        }

        # ========== TIME ==========
        if (name == "sleep_ms") {
            let micros = self.ir.tmp();
            self.ir.emit("  " + micros + " = mul i64 " + arg_vals[0] + ", 1000");
            let trunc = self.ir.tmp();
            self.ir.emit("  " + trunc + " = trunc i64 " + micros + " to i32");
            self.ir.emit("  " + self.ir.tmp() + " = call i32 @usleep(i32 " + trunc + ")");
            self.set_last("0", "i64");
            return;
        }

        # ========== NETWORK (stubs via libc socket API — minimal) ==========
        if (name == "tcp_close") {
            let fd = self.ir.tmp();
            self.ir.emit("  " + fd + " = trunc i64 " + arg_vals[0] + " to i32");
            self.ir.emit("  " + self.ir.tmp() + " = call i32 @close(i32 " + fd + ")");
            self.set_last("0", "i64");
            return;
        }

        if (name == "tcp_listen") {
            # socket(AF_INET=2, SOCK_STREAM=1, 0) → bind → listen → return fd as i64
            let sock = self.ir.tmp();
            self.ir.emit("  " + sock + " = call i32 @socket(i32 2, i32 1, i32 0)");

            let sa = self.ir.tmp();
            self.ir.emit("  " + sa + " = alloca { i16, i16, i32, [8 x i8] }");

            let fam_p = self.ir.tmp();
            self.ir.emit(
                "  "
                    + fam_p
                    + " = getelementptr { i16, i16, i32, [8 x i8] }, ptr "
                    + sa
                    + ", i32 0, i32 0"
            );
            self.ir.emit("  store i16 2, ptr " + fam_p);  # AF_INET

            let port_i32 = self.ir.tmp();
            self.ir.emit("  " + port_i32 + " = trunc i64 " + arg_vals[0] + " to i32");
            let port_lo = self.ir.tmp();
            self.ir.emit("  " + port_lo + " = and i32 " + port_i32 + ", 255");
            let port_hi_m = self.ir.tmp();
            self.ir.emit("  " + port_hi_m + " = and i32 " + port_i32 + ", 65280");
            let port_hi = self.ir.tmp();
            self.ir.emit("  " + port_hi + " = lshr i32 " + port_hi_m + ", 8");
            let port_lo_s = self.ir.tmp();
            self.ir.emit("  " + port_lo_s + " = shl i32 " + port_lo + ", 8");
            let port_be = self.ir.tmp();
            self.ir.emit("  " + port_be + " = or i32 " + port_lo_s + ", " + port_hi);
            let port_be16 = self.ir.tmp();
            self.ir.emit("  " + port_be16 + " = trunc i32 " + port_be + " to i16");

            let port_p = self.ir.tmp();
            self.ir.emit(
                "  "
                    + port_p
                    + " = getelementptr { i16, i16, i32, [8 x i8] }, ptr "
                    + sa
                    + ", i32 0, i32 1"
            );
            self.ir.emit("  store i16 " + port_be16 + ", ptr " + port_p);

            let addr_p = self.ir.tmp();
            self.ir.emit(
                "  "
                    + addr_p
                    + " = getelementptr { i16, i16, i32, [8 x i8] }, ptr "
                    + sa
                    + ", i32 0, i32 2"
            );
            self.ir.emit("  store i32 0, ptr " + addr_p);  # INADDR_ANY

            let zero_p = self.ir.tmp();
            self.ir.emit(
                "  "
                    + zero_p
                    + " = getelementptr { i16, i16, i32, [8 x i8] }, ptr "
                    + sa
                    + ", i32 0, i32 3"
            );
            self.ir.emit("  store [8 x i8] zeroinitializer, ptr " + zero_p);

            self.ir.emit(
                "  " + self.ir.tmp() + " = call i32 @bind(i32 " + sock + ", ptr " + sa + ", i32 16)"
            );
            self.ir.emit("  " + self.ir.tmp() + " = call i32 @listen(i32 " + sock + ", i32 128)");

            let fd64 = self.ir.tmp();
            self.ir.emit("  " + fd64 + " = zext i32 " + sock + " to i64");
            self.set_last(fd64, "i64");
            return;
        }

        if (name == "tcp_accept") {
            let fd32 = self.ir.tmp();
            self.ir.emit("  " + fd32 + " = trunc i64 " + arg_vals[0] + " to i32");
            let client = self.ir.tmp();
            self.ir.emit(
                "  " + client + " = call i32 @accept(i32 " + fd32 + ", ptr null, ptr null)"
            );
            let fd64 = self.ir.tmp();
            self.ir.emit("  " + fd64 + " = zext i32 " + client + " to i64");
            self.set_last(fd64, "i64");
            return;
        }

        if (name == "tcp_connect") {
            # host = arg_vals[0] (ptr / char*), port = arg_vals[1] (i64)
            let sock = self.ir.tmp();
            self.ir.emit("  " + sock + " = call i32 @socket(i32 2, i32 1, i32 0)");

            let sa = self.ir.tmp();
            self.ir.emit("  " + sa + " = alloca { i16, i16, i32, [8 x i8] }");

            let fam_p = self.ir.tmp();
            self.ir.emit(
                "  "
                    + fam_p
                    + " = getelementptr { i16, i16, i32, [8 x i8] }, ptr "
                    + sa
                    + ", i32 0, i32 0"
            );
            self.ir.emit("  store i16 2, ptr " + fam_p);

            let port_i32 = self.ir.tmp();
            self.ir.emit("  " + port_i32 + " = trunc i64 " + arg_vals[1] + " to i32");
            let port_lo = self.ir.tmp();
            self.ir.emit("  " + port_lo + " = and i32 " + port_i32 + ", 255");
            let port_hi_m = self.ir.tmp();
            self.ir.emit("  " + port_hi_m + " = and i32 " + port_i32 + ", 65280");
            let port_hi = self.ir.tmp();
            self.ir.emit("  " + port_hi + " = lshr i32 " + port_hi_m + ", 8");
            let port_lo_s = self.ir.tmp();
            self.ir.emit("  " + port_lo_s + " = shl i32 " + port_lo + ", 8");
            let port_be = self.ir.tmp();
            self.ir.emit("  " + port_be + " = or i32 " + port_lo_s + ", " + port_hi);
            let port_be16 = self.ir.tmp();
            self.ir.emit("  " + port_be16 + " = trunc i32 " + port_be + " to i16");

            let port_p = self.ir.tmp();
            self.ir.emit(
                "  "
                    + port_p
                    + " = getelementptr { i16, i16, i32, [8 x i8] }, ptr "
                    + sa
                    + ", i32 0, i32 1"
            );
            self.ir.emit("  store i16 " + port_be16 + ", ptr " + port_p);

            let localhost_g = self.ir.cstr_global("localhost");
            let loopback_g = self.ir.cstr_global("127.0.0.1");
            let lh_p = self.ir.tmp();
            self.ir.emit(
                "  "
                    + lh_p
                    + " = getelementptr inbounds [10 x i8], ptr "
                    + localhost_g
                    + ", i64 0, i64 0"
            );
            let lb_p = self.ir.tmp();
            self.ir.emit(
                "  "
                    + lb_p
                    + " = getelementptr inbounds [10 x i8], ptr "
                    + loopback_g
                    + ", i64 0, i64 0"
            );
            let cmp = self.ir.tmp();
            self.ir.emit(
                "  " + cmp + " = call i32 @strcmp(ptr " + arg_vals[0] + ", ptr " + lh_p + ")"
            );
            let is_lh = self.ir.tmp();
            self.ir.emit("  " + is_lh + " = icmp eq i32 " + cmp + ", 0");
            let resolved = self.ir.tmp();
            self.ir.emit(
                "  " + resolved + " = select i1 " + is_lh + ", ptr " + lb_p + ", ptr " + arg_vals[0]
            );

            let addr_be = self.ir.tmp();
            self.ir.emit("  " + addr_be + " = call i32 @inet_addr(ptr " + resolved + ")");
            let addr_p = self.ir.tmp();
            self.ir.emit(
                "  "
                    + addr_p
                    + " = getelementptr { i16, i16, i32, [8 x i8] }, ptr "
                    + sa
                    + ", i32 0, i32 2"
            );
            self.ir.emit("  store i32 " + addr_be + ", ptr " + addr_p);

            let zero_p = self.ir.tmp();
            self.ir.emit(
                "  "
                    + zero_p
                    + " = getelementptr { i16, i16, i32, [8 x i8] }, ptr "
                    + sa
                    + ", i32 0, i32 3"
            );
            self.ir.emit("  store [8 x i8] zeroinitializer, ptr " + zero_p);

            let conn = self.ir.tmp();
            self.ir.emit(
                "  " + conn + " = call i32 @connect(i32 " + sock + ", ptr " + sa + ", i32 16)"
            );
            let failed = self.ir.tmp();
            self.ir.emit("  " + failed + " = icmp slt i32 " + conn + ", 0");

            let close_l = self.ir.label("tcp_connect.close");
            let cont_l = self.ir.label("tcp_connect.cont");
            self.ir.emit("  br i1 " + failed + ", label %" + close_l + ", label %" + cont_l);
            self.ir.emit(close_l + ":");
            self.ir.emit("  " + self.ir.tmp() + " = call i32 @close(i32 " + sock + ")");
            self.ir.emit("  br label %" + cont_l);
            self.ir.emit(cont_l + ":");

            let fd64 = self.ir.tmp();
            self.ir.emit("  " + fd64 + " = zext i32 " + sock + " to i64");
            let result = self.ir.tmp();
            self.ir.emit("  " + result + " = select i1 " + failed + ", i64 -1, i64 " + fd64);
            self.set_last(result, "i64");
            return;
        }

        if (name == "tcp_read") {
            # recv do bufora 4096, NUL-terminate, zwróć jako str (char*)
            let fd32 = self.ir.tmp();
            self.ir.emit("  " + fd32 + " = trunc i64 " + arg_vals[0] + " to i32");
            let buf = self.alloc_bytes("4096", "null");
            let n = self.ir.tmp();
            self.ir.emit(
                "  " + n + " = call i64 @recv(i32 " + fd32 + ", ptr " + buf + ", i64 4095, i32 0)"
            );

            # jeśli n < 0 → traktuj jako 0 (pusty string)
            let n_neg = self.ir.tmp();
            self.ir.emit("  " + n_neg + " = icmp slt i64 " + n + ", 0");
            let n_ok = self.ir.tmp();
            self.ir.emit("  " + n_ok + " = select i1 " + n_neg + ", i64 0, i64 " + n);
            let end_p = self.ir.tmp();
            self.ir.emit("  " + end_p + " = getelementptr i8, ptr " + buf + ", i64 " + n_ok);
            self.ir.emit("  store i8 0, ptr " + end_p);
            self.set_last(buf, "ptr");
            return;
        }

        if (name == "tcp_write") {
            # send(fd, data, strlen(data), 0)
            let fd32 = self.ir.tmp();
            self.ir.emit("  " + fd32 + " = trunc i64 " + arg_vals[0] + " to i32");
            let len = self.ir.tmp();
            self.ir.emit("  " + len + " = call i64 @strlen(ptr " + arg_vals[1] + ")");
            self.ir.emit(
                "  "
                    + self.ir.tmp()
                    + " = call i64 @send(i32 "
                    + fd32
                    + ", ptr "
                    + arg_vals[1]
                    + ", i64 "
                    + len
                    + ", i32 0)"
            );
            self.set_last("0", "i64");
            return;
        }

        # ========== user / extern ==========
        let ret_ty = "i64";
        let extern_str = false;
        let extern_link = "";
        for (let i = 0; i < self.program.functions.size(); i += 1) {
            if (self.program.functions[i].value.identifier.value == name) {
                ret_ty = self.program.functions[i].value.return_type.value.to_llvm();
            }
        }
        for (let i = 0; i < self.program.extern_functions.size(); i += 1) {
            let ef = self.program.extern_functions[i].value;
            let n = ef.identifier.value;
            if (ef.alias matches OptionIdentifierNode::Some(a)) {
                n = a.value;
            }
            if (n == name) {
                ret_ty = ef.return_type.value.to_llvm();
                extern_link = ef.identifier.value;
                if (ef.return_type.value matches Type::Str) {
                    extern_str = true;
                }
            }
        }
        let args_ir = "";
        for (let i = 0; i < arg_vals.size(); i += 1) {
            if (i > 0) {
                args_ir += ", ";
            }
            args_ir += arg_tys[i] + " " + arg_vals[i];
        }
        let link = name;
        if (!extern_link.is_empty()) {
            link = extern_link;
        }
        if (name == "main") {
            link = "raptor_main";
        }
        if (ret_ty == "void") {
            self.ir.emit("  call void @" + link + "(" + args_ir + ")");
            self.set_last("0", "i64");
        } else {
            let r = self.ir.tmp();
            self.ir.emit("  " + r + " = call " + ret_ty + " @" + link + "(" + args_ir + ")");
            if (extern_str && self.arc) {
                # C strings have no ARC header: copy into a managed string.
                let adopted = self.ir.tmp();
                self.ir.emit("  " + adopted + " = call ptr @rt_adopt_cstr(ptr " + r + ")");
                r = adopted;
            }
            self.set_last(r, ret_ty);
        }
    }

    fn compile_expression(self, ExpressionNode node): void {
        match (node.value) {
            Expression::Literal(lit) {
                self.compile_literal(lit);
            },
            Expression::Variable(name) {
                let idx = self.find_local(name);
                if (idx < 0) {
                    self.error("Undefined variable '" + name + "'");
                    self.set_last("0", "i64");
                    return;
                }
                let v = self.locals[idx];
                let tmp = self.ir.tmp();
                self.ir.emit("  " + tmp + " = load " + v.ty + ", ptr " + v.ptr);
                self.set_last(tmp, v.ty);
            },
            Expression::Addition(bin) {
                self.compile_expression(bin.left);
                let lv = self.last_value;
                let lt = self.last_type;
                self.compile_expression(bin.right);
                let rv = self.last_value;
                let rt = self.last_type;
                let l_is_char = lt != "ptr" && self.expr_rtype(bin.left) == "char";
                let r_is_char = rt != "ptr" && self.expr_rtype(bin.right) == "char";
                let l_is_strish = lt == "ptr";
                let r_is_strish = rt == "ptr";

                # `str + char` / `char + str` append the character itself.
                if (
                    l_is_strish && r_is_char || l_is_char && r_is_strish || l_is_char && r_is_char
                ) {
                    l_is_strish = true;
                    r_is_strish = true;
                }
                if (l_is_strish || r_is_strish) {
                    let lptr = lv;
                    if (l_is_char) {
                        lptr = self.char_to_str(lv);
                    } else {
                        lptr = self.to_str_value(lv, lt);
                    }
                    let rptr = rv;
                    if (r_is_char) {
                        rptr = self.char_to_str(rv);
                    } else {
                        rptr = self.to_str_value(rv, rt);
                    }
                    let llen = self.ir.tmp();
                    self.ir.emit("  " + llen + " = call i64 @strlen(ptr " + lptr + ")");
                    let rlen = self.ir.tmp();
                    self.ir.emit("  " + rlen + " = call i64 @strlen(ptr " + rptr + ")");
                    let sum = self.ir.tmp();
                    self.ir.emit("  " + sum + " = add i64 " + llen + ", " + rlen);
                    let size = self.ir.tmp();
                    self.ir.emit("  " + size + " = add i64 " + sum + ", 1");
                    let buf = self.alloc_bytes(size, "null");
                    self.ir.emit(
                        "  "
                            + self.ir.tmp()
                            + " = call ptr @strcpy(ptr "
                            + buf
                            + ", ptr "
                            + lptr
                            + ")"
                    );
                    self.ir.emit(
                        "  "
                            + self.ir.tmp()
                            + " = call ptr @strcat(ptr "
                            + buf
                            + ", ptr "
                            + rptr
                            + ")"
                    );

                    # The operands were only read: drop the temporaries (converted
                    # numbers / chars, or fresh strings such as nested concatenations).
                    if (lt != "ptr" || !LLVMIRCodegen.expr_is_borrowed(bin.left)) {
                        self.emit_release(lptr);
                    }
                    if (rt != "ptr" || !LLVMIRCodegen.expr_is_borrowed(bin.right)) {
                        self.emit_release(rptr);
                    }
                    self.set_last(buf, "ptr");
                } else {
                    self.emit_arith(
                        lv,
                        lt,
                        rv,
                        rt,
                        "add",
                        self.arith_rty(bin.left, bin.right),
                        node.span
                    );
                }
            },
            Expression::Subtraction(bin) {
                self.compile_binary_i64(bin.left, bin.right, "sub", node.span);
            },
            Expression::Multiplication(bin) {
                self.compile_binary_i64(bin.left, bin.right, "mul", node.span);
            },
            Expression::Division(bin) {
                self.compile_binary_i64(bin.left, bin.right, "sdiv", node.span);
            },
            Expression::Modulo(bin) {
                self.compile_binary_i64(bin.left, bin.right, "srem", node.span);
            },
            Expression::Equal(bin) {
                self.compile_cmp(bin.left, bin.right, "eq");
            },
            Expression::NotEqual(bin) {
                self.compile_cmp(bin.left, bin.right, "ne");
            },
            Expression::Less(bin) {
                self.compile_cmp(bin.left, bin.right, "slt");
            },
            Expression::LessEqual(bin) {
                self.compile_cmp(bin.left, bin.right, "sle");
            },
            Expression::Greater(bin) {
                self.compile_cmp(bin.left, bin.right, "sgt");
            },
            Expression::GreaterEqual(bin) {
                self.compile_cmp(bin.left, bin.right, "sge");
            },
            Expression::BooleanNegation(inner) {
                self.compile_expression(inner);
                let v = self.last_value;
                let t = self.last_type;
                if (t != "i1") {
                    if (t == "ptr") {
                        let p = self.ir.tmp();
                        self.ir.emit("  " + p + " = icmp ne ptr " + v + ", null");
                        v = p;
                    } else {
                        let as64 = self.as_i64(v, t);
                        let p = self.ir.tmp();
                        self.ir.emit("  " + p + " = icmp ne i64 " + as64 + ", 0");
                        v = p;
                    }
                }
                let r = self.ir.tmp();
                self.ir.emit("  " + r + " = xor i1 " + v + ", true");
                self.set_last(r, "i1");
            },
            Expression::ArithmeticNegation(inner) {
                self.compile_expression(inner);
                let nv = self.last_value;
                let nt = self.last_type;
                let nrty = LLVMIRCodegen.resolve_num_rty(self.expr_rtype(inner), nt, nt);
                let r = self.ir.tmp();
                if (nrty == "f64") {
                    let d = self.as_double(nv, nt);
                    self.ir.emit("  " + r + " = fneg double " + d);
                    self.set_last(r, "double");
                    return;
                }
                let nity = LLVMIRCodegen.rname_prim_ty(nrty);
                let nuns = LLVMIRCodegen.rname_is_unsigned(nrty);
                let na = self.resize_int(nv, nt, nity, !nuns);
                if (self.overflow != "ignore" && !nuns) {
                    # -MIN cannot be represented.
                    let is_min = self.ir.tmp();
                    self.ir.emit(
                        "  "
                            + is_min
                            + " = icmp eq "
                            + nity
                            + " "
                            + na
                            + ", "
                            + LLVMIRCodegen.int_min_signed(LLVMIRCodegen.ty_bits(nity))
                    );
                    self.emit_overflow_diag(
                        is_min,
                        "Arithmetic negation overflow: minimum signed integer cannot be negated",
                        node.span
                    );
                }
                self.ir.emit("  " + r + " = sub " + nity + " 0, " + na);
                self.set_last(r, nity);
            },
            Expression::FunctionCall(call) {
                self.compile_function_call(call);
            },
            Expression::Casting(cast) {
                self.compile_cast(cast, node.span);
            },
            Expression::Alternative(bin) {
                self.compile_short_circuit(bin.left, bin.right, false);
            },
            Expression::Concatenation(bin) {
                self.compile_short_circuit(bin.left, bin.right, true);
            },
            Expression::Vector(elems) {
                self.compile_vector_literal(elems);
            },
            Expression::Index(ix) {
                self.compile_index(ix);
            },
            Expression::FieldAccess(fa) {
                self.compile_field_access(fa);
            },
            Expression::StructLiteral(sl) {
                self.compile_struct_literal(sl);
            },
            Expression::EnumLiteral(el) {
                self.compile_enum_literal(el);
            },
            Expression::MethodCall {}
        }
    }

    fn compile_short_circuit(self, ExpressionNode left, ExpressionNode right, bool is_and): void {
        let prefix = "or";
        if (is_and) {
            prefix = "and";
        }
        let lhs_l = self.ir.label(prefix + ".lhs");
        let rhs_l = self.ir.label(prefix + ".rhs");
        let rhs_end_l = self.ir.label(prefix + ".rhs.end");
        let end_l = self.ir.label(prefix + ".end");

        self.compile_expression(left);
        let lv = self.last_value;
        self.ir.emit("  br label %" + lhs_l);
        self.ir.emit(lhs_l + ":");
        if (is_and) {
            self.ir.emit("  br i1 " + lv + ", label %" + rhs_l + ", label %" + end_l);
        } else {
            self.ir.emit("  br i1 " + lv + ", label %" + end_l + ", label %" + rhs_l);
        }

        self.ir.emit(rhs_l + ":");
        let rhs_temps = self.temps.size();
        self.compile_expression(right);
        let rv = self.last_value;
        self.flush_temps_from(rhs_temps);
        self.ir.emit("  br label %" + rhs_end_l);
        self.ir.emit(rhs_end_l + ":");
        self.ir.emit("  br label %" + end_l);

        self.ir.emit(end_l + ":");
        let r = self.ir.tmp();
        let short_value = "true";
        if (is_and) {
            short_value = "false";
        }
        self.ir.emit(
            "  "
                + r
                + " = phi i1 [ "
                + short_value
                + ", %"
                + lhs_l
                + " ], [ "
                + rv
                + ", %"
                + rhs_end_l
                + " ]"
        );
        self.set_last(r, "i1");
    }
};

# Integer-ish value (any width, ptr, i1) or double -> double.
# integer opcode -> floating point opcode
# Raptor type both operands of a binary operation are computed in ("" = unknown).
# An integer literal adapts to the type of the other operand.
# Final Raptor type of a numeric operation. `hint` comes from the AST; when it is
# missing the operands' LLVM types decide (widest integer, or f64).
# Slot storage (struct/enum payload): preserve f64 bits via bitcast
# Numeric / cmp path: f64 via fptosi
# Compiles `e` so the result is an owned reference (+1) that can be stored in a
# slot: fresh values are moved in, borrowed ones (variable, field, element) are
# retained first.
# By-value argument of a user function: the callee gets its own copy (see
# self.emit_copy_functions). Returns "" when no copy is needed.
# Can every value of the source type be represented by the target type?
# GEP to a plain C string constant.
# Returns the name of the function formatting a vector with this element type,
# generating it the first time.
# "str[]" -> "str_v": names of the generated functions must be plain identifiers.
# ---- Vector: { i64 rc, ptr data, i64 len, i64 cap } size 32 ----
# ---- Struct: n fields as 8-byte slots + trailing rc ----
# ---- Enum: { i64 rc, i64 tag, i64 payload } = 24 bytes ----
# Best-effort static type of an expression, as a Raptor type name: "str", a
# struct name, or "" when unknown. The backend only tracks LLVM types (`ptr`
# for str, vectors, structs, ...), so indexing and field access need this to
# know what a pointer actually points to.
# `index` must be in [0, length): length is strlen() for strings and the length
# slot for vectors. Always fatal, whatever the overflow policy.
