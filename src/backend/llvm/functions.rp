import "../../frontend/parser/ast.rp";
import "./compiler-core.rp";
import "./statements.rp";
import "./ir-builder.rp";
import "./types-ir.rp";


extend LLVMIRCodegen {
    fn mangle_fn_name(str name): str {
        if (name == "main") {
            return "@raptor_main";
        }

        return "@" + name;
    }

    fn param_is_prim_ref(ParameterNode p): bool {
        if (p.value.passed_by matches PassedBy::Reference) {
            let ty = p.value.parameter_type.value.to_llvm();
            if (ty != "ptr" && ty != "void") {
                return true;
            }
        }
        return false;
    }

    fn param_llvm_type(ParameterNode p): str {
        if (LLVMIRCodegen.param_is_prim_ref(p)) {
            return "ptr";
        }
        return p.value.parameter_type.value.to_llvm();
    }

    fn emit_function_signature(FunctionDeclarationNode f): str {
        let ret = f.value.return_type.value.to_llvm();
        let params_ir = "";
        for (let i = 0; i < f.value.parameters.size(); i += 1) {
            if (i > 0) {
                params_ir += ", ";
            }
            let p = f.value.parameters[i];
            params_ir +=
                LLVMIRCodegen.param_llvm_type(p) + " %" + p.value.identifier.value + ".arg";
        }
        return
            "define "
                + ret
                + " "
                + LLVMIRCodegen.mangle_fn_name(f.value.identifier.value)
                + "("
                + params_ir
                + ")";
    }

    fn compile_function_body(self, FunctionDeclarationNode f): void {
        let ret = f.value.return_type.value.to_llvm();
        self.current_ret_ty = ret;
        self.has_terminator = false;
        let compiler_vars: CompilerVar[] = [];
        self.locals = compiler_vars;

        self.ir.emit(LLVMIRCodegen.emit_function_signature(f) + " {");
        self.begin_body();
        self.ir.emit("  br label %allocas");
        self.ir.emit("start:");

        for (let i = 0; i < f.value.parameters.size(); i += 1) {
            let p = f.value.parameters[i];
            let ty = p.value.parameter_type.value.to_llvm();
            if (LLVMIRCodegen.param_is_prim_ref(p)) {
                # The incoming pointer IS the variable's storage: no alloca/copy.
                self.locals.push(
                    CompilerVar {
                        name: p.value.identifier.value,
                        ptr: "%" + p.value.identifier.value + ".arg",
                        ty,
                        rty: p.value.parameter_type.value.llvm_type_rname(),
                        owned: false
                    }
                );
                continue;
            }
            let ptr = self.declare_local(p.value.identifier.value, ty);
            self.set_last_local_rty(p.value.parameter_type.value.llvm_type_rname());
            self.ir.emit("  store " + ty + " %" + p.value.identifier.value + ".arg, ptr " + ptr);
        }

        self.compile_block(f.value.block);

        if (!self.has_terminator) {
            if (ret == "void") {
                self.ir.emit("  ret void");
            } else if (ret == "i32") {
                self.ir.emit("  ret i32 0");
            } else if (ret == "i64") {
                self.ir.emit("  ret i64 0");
            } else if (ret == "ptr") {
                self.ir.emit("  ret ptr null");
            } else {
                self.ir.emit("  ret " + ret + " 0");
            }
        }
        self.end_body();
        self.ir.emit("}");
        self.ir.emit("");
    }

    fn libc_declares(str name): bool {
        let known: str[] = [
            "printf",
            "fflush",
            "snprintf",
            "fprintf",
            "strcmp",
            "strlen",
            "strcpy",
            "strcat",
            "malloc",
            "free",
            "atoll",
            "atof",
            "realloc",
            "memcpy",
            "usleep",
            "exit",
            "fopen",
            "fclose",
            "fread",
            "fwrite",
            "fseek",
            "ftell",
            "remove",
            "access",
            "read",
            "socket",
            "bind",
            "listen",
            "accept",
            "recv",
            "send",
            "close",
            "connect",
            "inet_addr",
            "fgets"
        ];
        for (let i = 0; i < known.size(); i += 1) {
            if (known[i] == name) {
                return true;
            }
        }
        return false;
    }

    fn compile_extern(self, ExternFunctionDeclarationNode e): void {
        let ret = e.value.return_type.value.to_llvm();
        let params_ir = "";
        for (let i = 0; i < e.value.parameters.size(); i += 1) {
            if (i > 0) {
                params_ir += ", ";
            }
            params_ir += e.value.parameters[i].value.parameter_type.value.to_llvm();
        }

        # `extern fn InitWindow(...) as init_window;` links against the C symbol
        # `InitWindow`; the alias is only the name used from Raptor code.
        let link_name = e.value.identifier.value;
        if (LLVMIRCodegen.libc_declares(link_name)) {
            return;
        }
        self.ir.emit("declare " + ret + " @" + link_name + "(" + params_ir + ")");
    }
};

# `&i64 x`, `&bool x`, ... : a by-reference primitive is passed as the address
# of the caller's variable so the callee can modify it. Heap-managed types
# (str, vectors, structs, enums) are already pointers and are unchanged.
# Functions libc-decls.rp already declares: declaring them again is an LLVM error.
