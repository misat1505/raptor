# ============================================================
# Textual LLVM IR builder (selfhost substitute for inkwell).
# ============================================================

struct IrBuilder {
    str[] header,
    str[] lines,
    str[] globals,
    i64 tmp_id,
    i64 str_id,
    i64 label_id

    fn new(): IrBuilder {
        return IrBuilder { header: [], lines: [], globals: [], tmp_id: 0, str_id: 0, label_id: 0 };
    }

    fn emit_header(self, str line): void {
        self.header.push(line);
    }

    fn emit(self, str line): void {
        self.lines.push(line);
    }

    fn emit_global(self, str line): void {
        self.globals.push(line);
    }

    fn tmp(self): str {
        let name = "%t" + self.tmp_id as str;
        self.tmp_id += 1;
        return name;
    }

    fn label(self, str prefix): str {
        let name = prefix + "." + self.label_id as str;
        self.label_id += 1;
        return name;
    }

    fn escape_cstr(str value): str {
        let escaped = "";
        for (let i = 0; i < value.size(); i += 1) {
            let c = value[i];
            if (c == '\\') {
                escaped += "\\\\";
            } else if (c == '\"') {
                escaped += "\\22";
            } else if (c == '\n') {
                escaped += "\\0A";
            } else if (c == '\0') {
                escaped += "\\00";
            } else {
                escaped += c;
            }
        }
        return escaped;
    }

    fn cstr_global(self, str value): str {
        let name = "@.str." + self.str_id as str;
        self.str_id += 1;
        let n = value.size() + 1;
        self.emit_global(
            name
                + " = private unnamed_addr constant ["
                + n as str
                + " x i8] c\""
                + IrBuilder.escape_cstr(value)
                + "\\00\""
        );
        return name;
    }

    fn managed_str_global(self, str value): str {
        let name = "@.mstr." + self.str_id as str;
        self.str_id += 1;
        let n = value.size() + 1;
        self.emit_global(
            name
                + " = private constant { i64, i64, ["
                + n as str
                + " x i8] } { i64 -1, i64 0, ["
                + n as str
                + " x i8] c\""
                + IrBuilder.escape_cstr(value)
                + "\\00\" }"
        );
        return name;
    }

    fn join_lines(&str[] parts): str {
        let cur: str[] = [];
        for (let i = 0; i < parts.size(); i += 1) {
            cur.push(parts[i] + "\n");
        }
        if (cur.size() == 0) {
            return "";
        }
        while (cur.size() > 1) {
            let next: str[] = [];
            let n = cur.size();
            let i = 0;
            while (i < n) {
                if (i + 1 < n) {
                    next.push(cur[i] + cur[i + 1]);
                } else {
                    next.push(cur[i]);
                }
                i += 2;
            }
            cur = next;
        }
        return cur[0];
    }

    fn finish(self): str {
        let parts: str[] = [];
        for (let i = 0; i < self.header.size(); i += 1) {
            parts.push(self.header[i]);
        }
        if (self.header.size() > 0) {
            parts.push("");
        }
        for (let i = 0; i < self.globals.size(); i += 1) {
            parts.push(self.globals[i]);
        }
        if (self.globals.size() > 0) {
            parts.push("");
        }
        for (let i = 0; i < self.lines.size(); i += 1) {
            parts.push(self.lines[i]);
        }
        return IrBuilder.join_lines(&parts);
    }

    fn emit_arc_runtime(self): void {
        let rt: str[] = [
            "; --- ARC runtime ---",
            "; retain/release ignore null and any value below 64 KiB: those are never",
            "; heap pointers, only small integers that the backend typed as `ptr`.",
            "define ptr @rt_alloc(i64 %size, ptr %drop) {",
            "entry:",
            "  %total = add i64 %size, 16",
            "  %raw = call ptr @malloc(i64 %total)",
            "  store i64 1, ptr %raw",
            "  %dp = getelementptr i8, ptr %raw, i64 8",
            "  store ptr %drop, ptr %dp",
            "  %obj = getelementptr i8, ptr %raw, i64 16",
            "  ret ptr %obj",
            "}",
            "",
            "define void @rt_retain(ptr %p) {",
            "entry:",
            "  %addr = ptrtoint ptr %p to i64",
            "  %small = icmp ult i64 %addr, 65536",
            "  br i1 %small, label %done, label %chk",
            "chk:",
            "  %rcp = getelementptr i8, ptr %p, i64 -16",
            "  %rc = load i64, ptr %rcp",
            "  %imm = icmp slt i64 %rc, 0",
            "  br i1 %imm, label %done, label %inc",
            "inc:",
            "  %n = add i64 %rc, 1",
            "  store i64 %n, ptr %rcp",
            "  br label %done",
            "done:",
            "  ret void",
            "}",
            "",
            "define void @rt_release(ptr %p) {",
            "entry:",
            "  %addr = ptrtoint ptr %p to i64",
            "  %small = icmp ult i64 %addr, 65536",
            "  br i1 %small, label %done, label %chk",
            "chk:",
            "  %rcp = getelementptr i8, ptr %p, i64 -16",
            "  %rc = load i64, ptr %rcp",
            "  %imm = icmp slt i64 %rc, 0",
            "  br i1 %imm, label %done, label %dec",
            "dec:",
            "  %n = sub i64 %rc, 1",
            "  store i64 %n, ptr %rcp",
            "  %z = icmp eq i64 %n, 0",
            "  br i1 %z, label %drop, label %done",
            "drop:",
            "  %dpp = getelementptr i8, ptr %p, i64 -8",
            "  %dfn = load ptr, ptr %dpp",
            "  %has = icmp ne ptr %dfn, null",
            "  br i1 %has, label %calldrop, label %dofree",
            "calldrop:",
            "  call void %dfn(ptr %p)",
            "  br label %dofree",
            "dofree:",
            "  call void @free(ptr %rcp)",
            "  br label %done",
            "done:",
            "  ret void",
            "}",
            "",
            "; vector: { i64 elems_are_managed, ptr data, i64 len, i64 cap }",
            "define void @rt_drop_vec(ptr %v) {",
            "entry:",
            "  %flag = load i64, ptr %v",
            "  %dpp = getelementptr i8, ptr %v, i64 8",
            "  %data = load ptr, ptr %dpp",
            "  %lp = getelementptr i8, ptr %v, i64 16",
            "  %len = load i64, ptr %lp",
            "  %idx = alloca i64",
            "  store i64 0, ptr %idx",
            "  %managed = icmp ne i64 %flag, 0",
            "  br i1 %managed, label %cond, label %fin",
            "cond:",
            "  %i = load i64, ptr %idx",
            "  %c = icmp slt i64 %i, %len",
            "  br i1 %c, label %body, label %fin",
            "body:",
            "  %slot = getelementptr ptr, ptr %data, i64 %i",
            "  %el = load ptr, ptr %slot",
            "  call void @rt_release(ptr %el)",
            "  %nx = add i64 %i, 1",
            "  store i64 %nx, ptr %idx",
            "  br label %cond",
            "fin:",
            "  call void @free(ptr %data)",
            "  ret void",
            "}",
            "",
            "; copy of a foreign C string (extern returns, ...) as a managed string",
            "define ptr @rt_adopt_cstr(ptr %s) {",
            "entry:",
            "  %isnull = icmp eq ptr %s, null",
            "  br i1 %isnull, label %nul, label %cp",
            "nul:",
            "  ret ptr null",
            "cp:",
            "  %len = call i64 @strlen(ptr %s)",
            "  %sz = add i64 %len, 1",
            "  %buf = call ptr @rt_alloc(i64 %sz, ptr null)",
            "  %r = call ptr @memcpy(ptr %buf, ptr %s, i64 %sz)",
            "  ret ptr %buf",
            "}",
            ""
        ];
        for (let i = 0; i < rt.size(); i += 1) {
            self.emit(rt[i]);
        }
    }
};
