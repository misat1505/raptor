import "../../frontend/parser/ast.rp";
import "./compiler-core.rp";
import "./expressions.rp";
import "./ir-builder.rp";
import "./types-ir.rp";


extend LLVMIRCodegen {
    fn compile_block(self, BlockNode block): void {
        let marker = self.push_scope_marker();
        for (let i = 0; i < vector_size(&block.value.statements); i += 1) {
            if (self.has_terminator) {
                break;
            }
            self.compile_statement(block.value.statements[i]);
        }
        if (!self.has_terminator) {
            self.emit_release_locals_from(marker);
        }
        self.pop_scope(marker);
    }

    fn double_const(str int_or_float): str {
        let n = str_len(int_or_float);
        for (let i = 0; i < n; i += 1) {
            if (int_or_float[i] == '.') {
                return int_or_float;
            }
        }
        for (let i = 0; i < n; i += 1) {
            let c = int_or_float[i];
            if (c == 'e' || c == 'E') {
                let head = "";
                let tail = "";
                for (let j = 0; j < n; j += 1) {
                    if (j < i) {
                        head += int_or_float[j];
                    } else {
                        tail += int_or_float[j];
                    }
                }
                return head + ".0" + tail;
            }
        }
        return int_or_float + ".0";
    }

    fn store_typed(self, str dst_ptr, str dst_ty, str rval, str rty): void {
        if (dst_ty == "double") {
            if (rty == "double") {
                let v = rval;
                if (str_len(v) > 0 && v[0] != '%') {
                    v = LLVMIRCodegen.double_const(v);
                }
                self.ir.emit("  store double " + v + ", ptr " + dst_ptr);
            } else {
                let as64 = self.as_i64(rval, rty);
                let d = self.ir.tmp();
                self.ir.emit("  " + d + " = sitofp i64 " + as64 + " to double");
                self.ir.emit("  store double " + d + ", ptr " + dst_ptr);
            }
            return;
        }

        if (dst_ty == "ptr") {
            if (rty == "ptr") {
                self.ir.emit("  store ptr " + rval + ", ptr " + dst_ptr);
            } else {
                # non-ptr into ptr slot: store via inttoptr of i64 bits / string path not here
                let as64 = self.as_i64(rval, rty);
                let p = self.ir.tmp();
                self.ir.emit("  " + p + " = inttoptr i64 " + as64 + " to ptr");
                self.ir.emit("  store ptr " + p + ", ptr " + dst_ptr);
            }
            return;
        }

        # integer / i1 destinations: coerce to dst width
        if (rty == dst_ty) {
            let v = rval;
            if (dst_ty == "double" && str_len(v) > 0 && v[0] != '%') {
                v = LLVMIRCodegen.double_const(v);
            }
            self.ir.emit("  store " + dst_ty + " " + v + ", ptr " + dst_ptr);
            return;
        }

        let as64 = self.as_i64(rval, rty);
        if (dst_ty == "i64") {
            self.ir.emit("  store i64 " + as64 + ", ptr " + dst_ptr);
            return;
        }
        if (dst_ty == "i1" || dst_ty == "i8" || dst_ty == "i16" || dst_ty == "i32") {
            let t = self.ir.tmp();
            self.ir.emit("  " + t + " = trunc i64 " + as64 + " to " + dst_ty);
            self.ir.emit("  store " + dst_ty + " " + t + ", ptr " + dst_ptr);
            return;
        }

        self.ir.emit("  store " + rty + " " + rval + ", ptr " + dst_ptr);
    }

    fn compile_declaration(self, DeclarationStatement decl): void {
        self.compile_owned(decl.value);
        let ty = self.last_type;
        let rty = self.expr_rtype(decl.value);
        if (decl.var_type matches OptionTypeNode::Some(tn)) {
            ty = tn.value.to_llvm();
            rty = tn.value.llvm_type_rname();
        }
        let ptr = self.declare_local(decl.identifier.value, ty);
        self.set_last_local_rty(rty);
        self.store_typed(ptr, ty, self.last_value, self.last_type);
        if (ty == "ptr") {
            self.mark_last_owned();
        }
    }

    fn compile_assignment(self, AssignmentStatement assign): void {
        self.compile_owned(assign.value);
        let rval = self.last_value;
        let rty = self.last_type;
        let idx = self.find_local(assign.identifier.value);
        if (idx < 0) {
            self.error("Assign to undeclared '" + assign.identifier.value + "'");
            return;
        }
        let v = self.locals[idx];
        if (vector_size(&assign.accessors) == 0) {
            # The old reference is released after the new one is in place.
            if (self.arc && v.owned && v.ty == "ptr") {
                let old = self.ir.tmp();
                self.ir.emit("  " + old + " = load ptr, ptr " + v.ptr);
                self.store_typed(v.ptr, v.ty, rval, rty);
                self.emit_release(old);
                return;
            }
            self.store_typed(v.ptr, v.ty, rval, rty);
            return;
        }

        let base = self.ir.tmp();
        self.ir.emit("  " + base + " = load " + v.ty + ", ptr " + v.ptr);
        let cur = base;

        # Raptor type name of `cur` as we walk the accessor chain ("" = unknown).
        let cur_rty = v.rty;

        for (let i = 0; i < vector_size(&assign.accessors); i += 1) {
            let is_last = i == vector_size(&assign.accessors) - 1;
            match (assign.accessors[i].value) {
                Accessor::MethodCall {},
                Accessor::Field(field) {
                    let fidx = 0;
                    for (let t = 0; t < vector_size(&self.program.declared_types); t += 1) {
                        if (self.program.declared_types[t].value matches DeclaredType::Struct(s)) {
                            for (let m = 0; m < vector_size(&s.members); m += 1) {
                                if (s.members[m].value.identifier.value == field.value) {
                                    fidx = m;
                                }
                            }
                        }
                    }

                    # Prefer the real layout of the struct we are walking through
                    # when known (by-name lookup is ambiguous across structs).
                    let next_rty = "";
                    if (cur_rty != "") {
                        if (self.lookup_struct(cur_rty) matches OptionStructDeclaration::Some(sd)) {
                            for (let m = 0; m < vector_size(&sd.members); m += 1) {
                                if (sd.members[m].value.identifier.value == field.value) {
                                    fidx = m;
                                    next_rty = sd.members[m].value.member_type.value.llvm_type_rname();
                                }
                            }
                        }
                    }
                    cur_rty = next_rty;
                    let gep = self.ir.tmp();
                    self.ir.emit(
                        "  "
                            + gep
                            + " = getelementptr i8, ptr "
                            + cur
                            + ", i64 "
                            + (fidx * 8) as str
                    );
                    if (is_last) {
                        if (rty == "ptr") {
                            if (self.arc) {
                                let old_f = self.ir.tmp();
                                self.ir.emit("  " + old_f + " = load ptr, ptr " + gep);
                                self.ir.emit("  store ptr " + rval + ", ptr " + gep);
                                self.emit_release(old_f);
                            } else {
                                self.ir.emit("  store ptr " + rval + ", ptr " + gep);
                            }
                        } else {
                            let sv = self.to_slot_i64(rval, rty);
                            self.ir.emit("  store i64 " + sv + ", ptr " + gep);
                        }
                    } else {
                        let n = self.ir.tmp();
                        self.ir.emit("  " + n + " = load ptr, ptr " + gep);
                        cur = n;
                    }
                },
                Accessor::Index(index_expr) {
                    let container_rty = cur_rty;
                    cur_rty = LLVMIRCodegen.llvm_rty_element(container_rty);
                    self.compile_expression(index_expr);
                    let i_val = self.as_i64(self.last_value, self.last_type);
                    if (container_rty == "str" && is_last) {
                        # s[i] = c: overwrite one byte of the (private) string in place.
                        self.emit_bounds_check(cur, i_val, true, index_expr.span);
                        let byte_p = self.ir.tmp();
                        self.ir.emit(
                            "  " + byte_p + " = getelementptr i8, ptr " + cur + ", i64 " + i_val
                        );
                        let byte_v = self.resize_int(rval, rty, "i8", false);
                        self.ir.emit("  store i8 " + byte_v + ", ptr " + byte_p);
                        return;
                    }
                    self.emit_bounds_check(cur, i_val, false, index_expr.span);
                    let data_p = self.ir.tmp();
                    self.ir.emit("  " + data_p + " = getelementptr i8, ptr " + cur + ", i64 8");
                    let data = self.ir.tmp();
                    self.ir.emit("  " + data + " = load ptr, ptr " + data_p);
                    let slot = self.ir.tmp();
                    self.ir.emit(
                        "  " + slot + " = getelementptr ptr, ptr " + data + ", i64 " + i_val
                    );
                    if (is_last) {
                        if (rty == "ptr") {
                            if (self.arc) {
                                let old_e = self.ir.tmp();
                                self.ir.emit("  " + old_e + " = load ptr, ptr " + slot);
                                self.ir.emit("  store ptr " + rval + ", ptr " + slot);
                                self.ir.emit(
                                    "  store i64 1, ptr " + cur
                                );  # elements are managed pointers
                                self.emit_release(old_e);
                            } else {
                                self.ir.emit("  store ptr " + rval + ", ptr " + slot);
                            }
                        } else {
                            let sv = self.to_slot_i64(rval, rty);
                            self.ir.emit("  store i64 " + sv + ", ptr " + slot);
                        }
                    } else {
                        let n = self.ir.tmp();
                        self.ir.emit("  " + n + " = load ptr, ptr " + slot);
                        cur = n;
                    }
                }
            }
        }
    }

    fn compile_if(self, ConditionalStatement stmt): void {
        let cond_temps = vector_size(&self.temps);
        self.compile_expression(stmt.condition);
        let cond = self.last_value;
        if (self.last_type != "i1") {
            let t = self.ir.tmp();
            self.ir.emit("  " + t + " = icmp ne i64 " + cond + ", 0");
            cond = t;
        }
        self.flush_temps_from(cond_temps);
        let then_l = self.ir.label("if.then");
        let else_l = self.ir.label("if.else");
        let end_l = self.ir.label("if.end");
        let has_else = false;
        if (stmt.else_block matches OptionBlockNode::Some) {
            has_else = true;
        }
        if (has_else) {
            self.ir.emit("  br i1 " + cond + ", label %" + then_l + ", label %" + else_l);
        } else {
            self.ir.emit("  br i1 " + cond + ", label %" + then_l + ", label %" + end_l);
        }

        self.ir.emit(then_l + ":");
        self.has_terminator = false;
        self.compile_block(stmt.if_block);
        if (!self.has_terminator) {
            self.ir.emit("  br label %" + end_l);
        }

        if (stmt.else_block matches OptionBlockNode::Some(eb)) {
            self.ir.emit(else_l + ":");
            self.has_terminator = false;
            self.compile_block(eb);
            if (!self.has_terminator) {
                self.ir.emit("  br label %" + end_l);
            }
        }

        self.ir.emit(end_l + ":");
        self.has_terminator = false;
    }

    fn compile_while(self, WhileLoopStatement stmt): void {
        let cond_l = self.ir.label("while.cond");
        let body_l = self.ir.label("while.body");
        let end_l = self.ir.label("while.end");
        self.ir.emit("  br label %" + cond_l);
        self.ir.emit(cond_l + ":");
        self.has_terminator = false;
        let cond_temps = vector_size(&self.temps);
        self.compile_expression(stmt.condition);
        let cond = self.last_value;
        if (self.last_type != "i1") {
            let t = self.ir.tmp();
            self.ir.emit("  " + t + " = icmp ne i64 " + cond + ", 0");
            cond = t;
        }
        self.flush_temps_from(cond_temps);
        self.ir.emit("  br i1 " + cond + ", label %" + body_l + ", label %" + end_l);
        self.ir.emit(body_l + ":");
        self.has_terminator = false;
        vector_push(&self.break_stack, end_l);
        vector_push(&self.continue_stack, cond_l);
        vector_push(&self.loop_marks, vector_size(&self.locals));
        vector_push(&self.loop_temp_marks, vector_size(&self.temps));
        vector_push(&self.cont_marks, vector_size(&self.locals));
        vector_push(&self.cont_temp_marks, vector_size(&self.temps));
        self.compile_block(stmt.block);

        # pop stacks
        let nb: str[] = [];
        for (let i = 0; i < vector_size(&self.break_stack) - 1; i += 1) {
            vector_push(&nb, self.break_stack[i]);
        }
        self.break_stack = nb;
        let nc: str[] = [];
        for (let i = 0; i < vector_size(&self.continue_stack) - 1; i += 1) {
            vector_push(&nc, self.continue_stack[i]);
        }
        self.continue_stack = nc;
        let nm: i64[] = [];
        for (let i = 0; i < vector_size(&self.loop_marks) - 1; i += 1) {
            vector_push(&nm, self.loop_marks[i]);
        }
        self.loop_marks = nm;
        let ntm: i64[] = [];
        for (let i = 0; i < vector_size(&self.loop_temp_marks) - 1; i += 1) {
            vector_push(&ntm, self.loop_temp_marks[i]);
        }
        self.loop_temp_marks = ntm;
        let ncm: i64[] = [];
        let nctm: i64[] = [];
        for (let i = 0; i < vector_size(&self.cont_marks) - 1; i += 1) {
            vector_push(&ncm, self.cont_marks[i]);
            vector_push(&nctm, self.cont_temp_marks[i]);
        }
        self.cont_marks = ncm;
        self.cont_temp_marks = nctm;
        if (!self.has_terminator) {
            self.ir.emit("  br label %" + cond_l);
        }
        self.ir.emit(end_l + ":");
        self.has_terminator = false;
    }

    fn compile_for(self, ForLoopStatement stmt): void {
        let marker = self.push_scope_marker();
        if (stmt.declaration matches OptionStatementNode::Some(d)) {
            self.compile_statement(d);
        }
        let cond_l = self.ir.label("for.cond");
        let body_l = self.ir.label("for.body");
        let step_l = self.ir.label("for.step");
        let end_l = self.ir.label("for.end");
        self.ir.emit("  br label %" + cond_l);
        self.ir.emit(cond_l + ":");
        self.has_terminator = false;
        let cond_temps = vector_size(&self.temps);
        self.compile_expression(stmt.condition);
        let cond = self.last_value;
        if (self.last_type != "i1") {
            let t = self.ir.tmp();
            self.ir.emit("  " + t + " = icmp ne i64 " + cond + ", 0");
            cond = t;
        }
        self.flush_temps_from(cond_temps);
        self.ir.emit("  br i1 " + cond + ", label %" + body_l + ", label %" + end_l);
        self.ir.emit(body_l + ":");
        self.has_terminator = false;
        vector_push(&self.break_stack, end_l);
        vector_push(&self.continue_stack, step_l);
        vector_push(&self.loop_marks, vector_size(&self.locals));
        vector_push(&self.loop_temp_marks, vector_size(&self.temps));
        vector_push(&self.cont_marks, vector_size(&self.locals));
        vector_push(&self.cont_temp_marks, vector_size(&self.temps));
        self.compile_block(stmt.block);
        let nb: str[] = [];
        for (let i = 0; i < vector_size(&self.break_stack) - 1; i += 1) {
            vector_push(&nb, self.break_stack[i]);
        }
        self.break_stack = nb;
        let nc: str[] = [];
        for (let i = 0; i < vector_size(&self.continue_stack) - 1; i += 1) {
            vector_push(&nc, self.continue_stack[i]);
        }
        self.continue_stack = nc;
        let nm: i64[] = [];
        for (let i = 0; i < vector_size(&self.loop_marks) - 1; i += 1) {
            vector_push(&nm, self.loop_marks[i]);
        }
        self.loop_marks = nm;
        let ntm: i64[] = [];
        for (let i = 0; i < vector_size(&self.loop_temp_marks) - 1; i += 1) {
            vector_push(&ntm, self.loop_temp_marks[i]);
        }
        self.loop_temp_marks = ntm;
        let ncm: i64[] = [];
        let nctm: i64[] = [];
        for (let i = 0; i < vector_size(&self.cont_marks) - 1; i += 1) {
            vector_push(&ncm, self.cont_marks[i]);
            vector_push(&nctm, self.cont_temp_marks[i]);
        }
        self.cont_marks = ncm;
        self.cont_temp_marks = nctm;
        if (!self.has_terminator) {
            self.ir.emit("  br label %" + step_l);
        }
        self.ir.emit(step_l + ":");
        self.has_terminator = false;
        if (stmt.assignment matches OptionStatementNode::Some(a)) {
            self.compile_statement(a);
        }
        self.ir.emit("  br label %" + cond_l);
        self.ir.emit(end_l + ":");
        self.has_terminator = false;
        self.emit_release_locals_from(marker);
        self.pop_scope(marker);
    }

    fn compile_match(self, MatchStatement m, Span span): void {
        let outer_marker = self.push_scope_marker();
        self.compile_expression(m.expression);
        let scrut = self.last_value;

        # A fresh subject (e.g. the result of a call) must outlive the arms, whose
        # bindings point into it: park it in a hidden owned local, released when the
        # match ends or on any return / break out of an arm.
        if (self.arc && self.last_type == "ptr" && !LLVMIRCodegen.expr_is_borrowed(m.expression)) {
            let hidden = self.declare_local("$match", "ptr");
            self.ir.emit("  store ptr " + scrut + ", ptr " + hidden);
            self.mark_last_owned();
        }

        # load tag at offset 8
        let tag_p = self.ir.tmp();
        self.ir.emit("  " + tag_p + " = getelementptr i8, ptr " + scrut + ", i64 8");
        let tag = self.ir.tmp();
        self.ir.emit("  " + tag + " = load i64, ptr " + tag_p);
        let pay_p = self.ir.tmp();
        self.ir.emit("  " + pay_p + " = getelementptr i8, ptr " + scrut + ", i64 16");

        let end_l = self.ir.label("match.end");
        let arm_labels: str[] = [];
        for (let i = 0; i < vector_size(&m.match_arms); i += 1) {
            vector_push(&arm_labels, self.ir.label("match.arm"));
        }
        let rest_l = self.ir.label("match.rest");

        # chain of icmp + br
        for (let i = 0; i < vector_size(&m.match_arms); i += 1) {
            let arm = m.match_arms[i];
            let expected = self.enum_variant_tag(
                arm.value.enum_name.value,
                arm.value.variant_name.value
            );
            let cmp = self.ir.tmp();
            self.ir.emit("  " + cmp + " = icmp eq i64 " + tag + ", " + expected as str);
            let next_check = self.ir.label("match.chk");
            self.ir.emit("  br i1 " + cmp + ", label %" + arm_labels[i] + ", label %" + next_check);
            self.ir.emit(next_check + ":");
        }

        # no arm matched -> rest or end
        match (m.rest_arm) {
            OptionBlockNode::Some {
                self.ir.emit("  br label %" + rest_l);
            },
            OptionBlockNode::None {
                self.emit_diag("true", "Non-exhaustive match: no arm matched.", span, true);
                self.ir.emit("  br label %" + end_l);
            }
        }

        for (let i = 0; i < vector_size(&m.match_arms); i += 1) {
            let arm = m.match_arms[i];
            self.ir.emit(arm_labels[i] + ":");
            self.has_terminator = false;
            let marker = self.push_scope_marker();
            if (arm.value.variant_value matches OptionIdentifierNode::Some(bind)) {
                # Bind the payload with the variant's real type. Primitive payloads
                # are stored in the enum as i64 slots (see self.compile_enum_literal),
                # so they must be loaded as i64 and narrowed, not loaded as `ptr`.
                let pay_ty = "ptr";
                let pay_rty = "";
                if (
                    self.lookup_enum(
                        arm.value.enum_name.value
                    ) matches OptionEnumDeclaration::Some(ed)
                ) {
                    for (let mi = 0; mi < vector_size(&ed.members); mi += 1) {
                        if (ed.members[mi].value.identifier.value == arm.value.variant_name.value) {
                            if (
                                ed.members[mi].value.member_type matches OptionTypeNode::Some(ptn)
                            ) {
                                pay_ty = ptn.value.to_llvm();
                                pay_rty = ptn.value.llvm_type_rname();
                            }
                        }
                    }
                }
                let ptr = self.declare_local(bind.value, pay_ty);
                self.set_last_local_rty(pay_rty);
                if (pay_ty == "ptr") {
                    let pay = self.ir.tmp();
                    self.ir.emit("  " + pay + " = load ptr, ptr " + pay_p);

                    # The binding owns a reference of its own: the arm may replace
                    # or mutate the matched value (e.g. `x.f = None;`), which would
                    # otherwise free the payload while the binding is still used.
                    self.emit_retain(pay);
                    self.mark_last_owned();
                    self.ir.emit("  store ptr " + pay + ", ptr " + ptr);
                } else {
                    let raw = self.ir.tmp();
                    self.ir.emit("  " + raw + " = load i64, ptr " + pay_p);
                    if (pay_ty == "i64") {
                        self.ir.emit("  store i64 " + raw + ", ptr " + ptr);
                    } else if (pay_ty == "double") {
                        let d = self.ir.tmp();
                        self.ir.emit("  " + d + " = bitcast i64 " + raw + " to double");
                        self.ir.emit("  store double " + d + ", ptr " + ptr);
                    } else {
                        let nr = self.ir.tmp();
                        self.ir.emit("  " + nr + " = trunc i64 " + raw + " to " + pay_ty);
                        self.ir.emit("  store " + pay_ty + " " + nr + ", ptr " + ptr);
                    }
                }
            }
            self.compile_block(arm.value.block);
            if (!self.has_terminator) {
                self.emit_release_locals_from(marker);
            }
            self.pop_scope(marker);
            if (!self.has_terminator) {
                self.ir.emit("  br label %" + end_l);
            }
        }

        if (m.rest_arm matches OptionBlockNode::Some(b)) {
            self.ir.emit(rest_l + ":");
            self.has_terminator = false;
            self.compile_block(b);
            if (!self.has_terminator) {
                self.ir.emit("  br label %" + end_l);
            }
        }

        self.ir.emit(end_l + ":");
        self.has_terminator = false;
        self.emit_release_locals_from(outer_marker);
        self.pop_scope(outer_marker);
    }

    fn compile_switch(self, SwitchStatement sw): void {
        let marker = self.push_scope_marker();
        for (let i = 0; i < vector_size(&sw.expressions); i += 1) {
            if (sw.expressions[i].value.alias matches OptionIdentifierNode::Some(alias)) {
                let source = sw.expressions[i].value.expression;
                self.compile_owned(source);
                let alias_ty = self.last_type;
                let alias_rty = self.expr_rtype(source);
                let alias_val = self.last_value;
                let slot = self.declare_local(alias.value, alias_ty);
                self.set_last_local_rty(alias_rty);
                self.store_typed(slot, alias_ty, alias_val, alias_ty);
                if (alias_ty == "ptr") {
                    self.mark_last_owned();
                }
            }
        }

        let after_l = self.ir.label("switch.after");
        vector_push(&self.break_stack, after_l);
        vector_push(&self.loop_marks, vector_size(&self.locals));
        vector_push(&self.loop_temp_marks, vector_size(&self.temps));

        let n = vector_size(&sw.cases);
        for (let i = 0; i < n; i += 1) {
            let case_l = self.ir.label("switch.case");
            let next_l = after_l;
            if (i + 1 < n) {
                next_l = self.ir.label("switch.check");
            }
            let cond_temps = vector_size(&self.temps);
            self.compile_expression(sw.cases[i].value.condition);
            let cond = self.last_value;
            if (self.last_type != "i1") {
                let t = self.ir.tmp();
                self.ir.emit("  " + t + " = icmp ne i64 " + cond + ", 0");
                cond = t;
            }
            self.flush_temps_from(cond_temps);
            self.ir.emit("  br i1 " + cond + ", label %" + case_l + ", label %" + next_l);
            self.ir.emit(case_l + ":");
            self.has_terminator = false;
            self.compile_block(sw.cases[i].value.block);
            if (!self.has_terminator) {
                self.ir.emit("  br label %" + next_l);
            }
            if (i + 1 < n) {
                self.ir.emit(next_l + ":");
                self.has_terminator = false;
            }
        }
        if (n == 0) {
            self.ir.emit("  br label %" + after_l);
        }

        let nb: str[] = [];
        let nm: i64[] = [];
        let ntm: i64[] = [];
        for (let i = 0; i < vector_size(&self.break_stack) - 1; i += 1) {
            vector_push(&nb, self.break_stack[i]);
            vector_push(&nm, self.loop_marks[i]);
            vector_push(&ntm, self.loop_temp_marks[i]);
        }
        self.break_stack = nb;
        self.loop_marks = nm;
        self.loop_temp_marks = ntm;

        self.ir.emit(after_l + ":");
        self.has_terminator = false;
        self.emit_release_locals_from(marker);
        self.pop_scope(marker);
    }

    fn compile_statement(self, StatementNode node): void {
        let temps_start = vector_size(&self.temps);
        self.compile_statement_inner(node);
        if (self.has_terminator) {
            # return / break / continue already released what they needed to.
            self.forget_temps_from(temps_start);
        } else {
            self.flush_temps_from(temps_start);
        }
    }

    fn compile_statement_inner(self, StatementNode node): void {
        match (node.value) {
            Statement::Declaration(d) {
                self.compile_declaration(d);
            },
            Statement::Assignment(a) {
                self.compile_assignment(a);
            },
            Statement::Conditional(s) {
                self.compile_if(s);
            },
            Statement::WhileLoop(s) {
                self.compile_while(s);
            },
            Statement::ForLoop(s) {
                self.compile_for(s);
            },
            Statement::Return(opt) {
                match (opt) {
                    OptionExpressionNode::Some(expr) {
                        # The caller receives a +1 reference; all locals die here.
                        self.compile_owned(expr);
                        self.release_temps_from(0);
                        self.emit_release_locals_from(0);
                        if (self.current_ret_ty == "void") {
                            self.ir.emit("  ret void");
                        } else {
                            let v = self.last_value;
                            let from = self.last_type;
                            let to = self.current_ret_ty;
                            if (from != to) {
                                if (from == "ptr" && to == "i64") {
                                    let t = self.ir.tmp();
                                    self.ir.emit("  " + t + " = ptrtoint ptr " + v + " to i64");
                                    v = t;
                                } else if (from == "ptr" && to == "i32") {
                                    let t = self.ir.tmp();
                                    self.ir.emit("  " + t + " = ptrtoint ptr " + v + " to i64");
                                    let t2 = self.ir.tmp();
                                    self.ir.emit("  " + t2 + " = trunc i64 " + t + " to i32");
                                    v = t2;
                                } else if (from == "i64" && to == "ptr") {
                                    let t = self.ir.tmp();
                                    self.ir.emit("  " + t + " = inttoptr i64 " + v + " to ptr");
                                    v = t;
                                } else if (from == "i64" && to == "i32") {
                                    let t = self.ir.tmp();
                                    self.ir.emit("  " + t + " = trunc i64 " + v + " to i32");
                                    v = t;
                                } else if (from == "i32" && to == "i64") {
                                    let t = self.ir.tmp();
                                    self.ir.emit("  " + t + " = sext i32 " + v + " to i64");
                                    v = t;
                                } else if (from == "i1" && to == "i64") {
                                    let t = self.ir.tmp();
                                    self.ir.emit("  " + t + " = zext i1 " + v + " to i64");
                                    v = t;
                                } else if (from == "i1" && to == "i32") {
                                    let t = self.ir.tmp();
                                    self.ir.emit("  " + t + " = zext i1 " + v + " to i32");
                                    v = t;
                                } else {
                                    # last resort: bitcast if same width-ish
                                    let t = self.ir.tmp();
                                    self.ir.emit(
                                        "  " + t + " = bitcast " + from + " " + v + " to " + to
                                    );
                                    v = t;
                                }
                            }
                            self.ir.emit("  ret " + to + " " + v);
                        }
                    },
                    OptionExpressionNode::None {
                        self.release_temps_from(0);
                        self.emit_release_locals_from(0);
                        if (self.current_ret_ty == "void") {
                            self.ir.emit("  ret void");
                        } else if (self.current_ret_ty == "ptr") {
                            self.ir.emit("  ret ptr null");
                        } else {
                            self.ir.emit("  ret " + self.current_ret_ty + " 0");
                        }
                    }
                }
                self.has_terminator = true;
            },
            Statement::Break {
                if (vector_size(&self.break_stack) == 0) {
                    self.error("break outside loop");
                } else {
                    let t = self.break_stack[vector_size(&self.break_stack) - 1];
                    self.release_temps_from(
                        self.loop_temp_marks[vector_size(&self.loop_temp_marks) - 1]
                    );
                    self.emit_release_locals_from(
                        self.loop_marks[vector_size(&self.loop_marks) - 1]
                    );
                    self.ir.emit("  br label %" + t);
                    self.has_terminator = true;
                }
            },
            Statement::Continue {
                if (vector_size(&self.continue_stack) == 0) {
                    self.error("continue outside loop");
                } else {
                    let t = self.continue_stack[vector_size(&self.continue_stack) - 1];
                    self.release_temps_from(
                        self.cont_temp_marks[vector_size(&self.cont_temp_marks) - 1]
                    );
                    self.emit_release_locals_from(
                        self.cont_marks[vector_size(&self.cont_marks) - 1]
                    );
                    self.ir.emit("  br label %" + t);
                    self.has_terminator = true;
                }
            },
            Statement::FunctionCall(call) {
                # Statement form of call - wrap as expression
                self.compile_function_call(call);

                # A discarded result still carries a +1 reference. User functions
                # always return one; builtins only when they return a string/vector.
                if (self.arc && self.last_type == "ptr") {
                    self.emit_release(self.last_value);
                }
            },
            Statement::Match(m) {
                self.compile_match(m, node.span);
            },
            Statement::Switch(sw) {
                self.compile_switch(sw);
            },
            Statement::Expression(expr) {
                self.compile_expression(expr);

                if (self.arc && self.last_type == "ptr") {
                    self.emit_release(self.last_value);
                }
            },
            Statement::Import {}
        }
    }
};

# LLVM requires a '.' in decimal double literals ("1e+20" is rejected).
# Store value of (rval, rty) into alloca/slot of dst_ty.
# Every statement releases the temporaries it created once it is done.
