import "../../frontend/parser/ast.rp";


extend Type {
    fn to_llvm(self): str {
        match (self) {
            Type::Bool {
                return "i1";
            },
            Type::I8 {
                return "i8";
            },
            Type::I16 {
                return "i16";
            },
            Type::I32 {
                return "i32";
            },
            Type::I64 {
                return "i64";
            },
            Type::U8 {
                return "i8";
            },
            Type::U16 {
                return "i16";
            },
            Type::U32 {
                return "i32";
            },
            Type::U64 {
                return "i64";
            },
            Type::F64 {
                return "double";
            },
            Type::Char {
                return "i32";
            },
            Type::Void {
                return "void";
            },
            Type::Str {
                return "ptr";
            },
            Type::Vector {
                return "ptr";
            },
            Type::Unresolved {
                return "ptr";
            }
        }
    }

    fn is_void(self): bool {
        if (self matches Type::Void) {
            return true;
        }
        return false;
    }

    fn default_llvm(self): str {
        match (self) {
            Type::Bool {
                return "0";
            },
            Type::F64 {
                return "0.0";
            },
            Type::Str {
                return "null";
            },
            Type::Vector {
                return "null";
            },
            Type::Unresolved {
                return "null";
            },
            Type::Void {
                return "0";
            },
            rest {
                return "0";
            }
        }
    }

    fn llvm_type_rname(self): str {
        if (self matches Type::Str) {
            return "str";
        }
        if (self matches Type::Char) {
            return "char";
        }
        if (self matches Type::Bool) {
            return "bool";
        }
        if (self matches Type::I8) {
            return "i8";
        }
        if (self matches Type::I16) {
            return "i16";
        }
        if (self matches Type::I32) {
            return "i32";
        }
        if (self matches Type::I64) {
            return "i64";
        }
        if (self matches Type::U8) {
            return "u8";
        }
        if (self matches Type::U16) {
            return "u16";
        }
        if (self matches Type::U32) {
            return "u32";
        }
        if (self matches Type::U64) {
            return "u64";
        }
        if (self matches Type::F64) {
            return "f64";
        }
        if (self matches Type::Unresolved(n)) {
            return n;
        }

        # Vectors are written as "<element>[]", e.g. "str[]", "Token[][]". The
        # element part is empty when the element type is a primitive we do not
        # track ("[]"), which still tells us it IS a vector.
        if (self matches Type::Vector(inner)) {
            return inner.llvm_type_rname() + "[]";
        }
        return "";
    }
};
