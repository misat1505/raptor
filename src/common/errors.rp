import "./span.rp";
import "./position.rp";
import "../../stdlib/string.rp";


enum ErrorSeverity derives Debug {
    HIGH,
    LOW

    fn to_string(self): str {
        match (self) {
            ErrorSeverity::HIGH {
                return console_red() + "error" + console_standard();
            },
            ErrorSeverity::LOW {
                return console_yellow() + "warning" + console_standard();
            }
        }
    }

    fn color(self): str {
        match (self) {
            ErrorSeverity::HIGH {
                return console_red();
            },
            ErrorSeverity::LOW {
                return console_yellow();
            }
        }
    }
};

struct LexerError derives Debug {
    str message,
    ErrorSeverity level,
    Span span

    fn new(ErrorSeverity level, str message, Span span): LexerError {
        return LexerError { message, level, span };
    }

    fn at(ErrorSeverity level, str summary, Span span): LexerError {
        return LexerError { message: summary, level, span };
    }

    fn get_stderr_message(self): str {
        return generic_error_stderr_message(&self.message, &self.level, &self.span);
    }

    fn expected_found(
        ErrorSeverity level,
        str summary,
        str expected,
        str found,
        Span span
    ): LexerError {
        let message = summary + "\n  expected: " + expected + "\n  found:    " + found;

        return LexerError { message, level, span };
    }
};

struct ParserError derives Debug {
    str message,
    ErrorSeverity level,
    Span span

    fn new(ErrorSeverity level, str message, Span span): ParserError {
        return ParserError { message, level, span };
    }

    fn at(ErrorSeverity level, str summary, Span span): ParserError {
        return ParserError { message: summary, level, span };
    }

    fn from_lexer(&LexerError lexer_error): ParserError {
        return ParserError {
            level: lexer_error.level,
            span: lexer_error.span,
            message: lexer_error.message
        };
    }

    fn get_stderr_message(self): str {
        return generic_error_stderr_message(&self.message, &self.level, &self.span);
    }

    fn expected_found(
        ErrorSeverity level,
        str summary,
        str expected,
        str found,
        Span span
    ): ParserError {
        let message = summary + "\n  expected: " + expected + "\n  found:    " + found;

        return ParserError { message, level, span };
    }
};

