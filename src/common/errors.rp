fn generic_error_stderr_message(&str message, &ErrorSeverity level, &Span span): str {
    let text = level.to_string() + ": " + message;

    let filename = "";
    match (span.start.filename) {
        OptionStr::None {
            return text;
        },
        OptionStr::Some(t) {
            filename = t;
        }
    }

    if (!exists_file(filename)) {
        return text;
    }

    let file_content = read_file(filename);
    let lines = file_content.split("\n");
    return generic_error_with_source(text, &level, &span, filename, &lines);
}

# The part of generic_error_stderr_message that needs the source lines, so callers
# that format many diagnostics (the backend's runtime checks) can read the file once.
fn generic_error_with_source(
    str message_text,
    &ErrorSeverity level,
    &Span span,
    str filename,
    &str[] lines
): str {
    let text = message_text;
    let normalized_line = span.start.line - 1;
    if (normalized_line >= lines.size()) {
        return text;
    }

    let line = lines[normalized_line];
    let underline_length = span.end.column - span.start.column;

    let underline_offset = "";
    for (let i = 0; i < span.start.column - 1; i += 1) {
        underline_offset += ' ';
    }

    let underline = level.color();
    for (let i = 0; i < underline_length; i += 1) {
        underline += '^';
    }
    underline += console_standard();

    let line_str = span.start.line as str;
    let spaces_count = 4 - line_str.size();
    if (spaces_count < 1) {
        spaces_count = 1;
    }
    let line_number_prefix = "";
    for (let i = 0; i < spaces_count; i += 1) {
        line_number_prefix += ' ';
    }
    line_number_prefix += line_str + ' ';
    let underline_bar_prefix = "";
    for (let i = 0; i < line_number_prefix.size(); i += 1) {
        underline_bar_prefix += ' ';
    }
    text +=
        "\n  --> "
            + filename
            + ":"
            + span.start.line as str
            + ":"
            + span.start.column as str
            + "\n\n"
            + line_number_prefix
            + "| "
            + line
            + "\n"
            + underline_bar_prefix
            + "| "
            + underline_offset
            + underline;

    return text;
}

fn console_red(): str {
    let bytes = [27, 91, 49, 59, 51, 49, 109];
    let output = "";
    for (let i = 0; i < bytes.size(); i += 1) {
        output += (bytes[i] as u8) as char;
    }
    return output;
}

fn console_yellow(): str {
    let bytes = [27, 91, 49, 59, 51, 51, 109];
    let output = "";
    for (let i = 0; i < bytes.size(); i += 1) {
        output += (bytes[i] as u8) as char;
    }
    return output;
}

fn console_standard(): str {
    let bytes = [27, 91, 48, 109];
    let output = "";
    for (let i = 0; i < bytes.size(); i += 1) {
        output += (bytes[i] as u8) as char;
    }
    return output;
}

fn interpreter_error_new(ErrorSeverity level, str message, Span span): InterpreterError {
    return InterpreterError { message, level, span };
}

fn interpreter_error_at(ErrorSeverity level, str summary, Span span): InterpreterError {
    return InterpreterError { message: summary, level, span };
}

fn interpreter_error_expected_found(
    ErrorSeverity level,
    str summary,
    str expected,
    str found,
    Span span
): InterpreterError {
    let message = summary + "\n  expected: " + expected + "\n  found:    " + found;

    return InterpreterError { message, level, span };
}

