enum OptionStr derives Debug, Clone, Json {
    Some(str),
    None
};

struct Position derives Debug, Clone, Json {
    i64 line,
    i64 column,
    i64 offset,
    OptionStr filename

    fn display(self): str {
        let prefix = "";
        if (self.filename matches OptionStr::Some(path)) {
            prefix = path + ":";
        }
        return prefix + self.line as str + ":" + self.column as str;
    }

    fn new(i64 line, i64 column, i64 offset, OptionStr filename): Position {
        return Position { line, column, offset, filename };
    }

    fn location(self): str {
        let location = "<input>";
        if (self.filename matches OptionStr::Some(path)) {
            location = path;
        }
        return location + ":" + self.line as str + ":" + self.column as str;
    }
};


fn position_display(&Position position): str {
    let prefix = "";
    if (position.filename matches OptionStr::Some(path)) {
        prefix = path + ":";
    }
    return prefix + position.line as str + ":" + position.column as str;
}

fn position_new(i64 line, i64 column, i64 offset, OptionStr filename): Position {
    return Position { line, column, offset, filename };
}

fn position_location(&Position position): str {
    let location = "<input>";
    if (position.filename matches OptionStr::Some(path)) {
        location = path;
    }
    return location + ":" + position.line as str + ":" + position.column as str;
}
