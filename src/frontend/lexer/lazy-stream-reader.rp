import "../../common/position.rp";


enum OptionU8Vec derives Debug {
    Some(u8[]),
    None
};

enum OptionChar derives Debug {
    Some(char),
    None
};

struct LazyStreamReader derives Debug {
    str src,
    i64 src_len,
    i64 read_offset,
    str current_line,
    char current_char,
    OptionU8Vec newline,
    Position current_position,
    OptionStr filename

    fn current(self): char {
        return self.current_char;
    }

    fn next(self): char {
        let new_char = self.read_char();
        self.update_position(self.current_char);
        self.current_char = new_char;
        return self.current_char;
    }

    fn position(self): Position {
        return self.current_position;
    }

    fn new(str src, OptionStr filename): LazyStreamReader {
        return LazyStreamReader {
            src,
            src_len: src.size(),
            read_offset: 0,
            current_line: "",
            current_char: (2 as u8) as char,
            newline: OptionU8Vec::None,
            current_position: Position { line: 0, column: 0, offset: 0, filename },
            filename
        };
    }

    fn read_char(self): char {
        let new_char = '\0';
        match (self.try_handle_newline()) {
            OptionChar::Some(ch) {
                new_char = ch;
            },
            OptionChar::None {
                new_char = self.process_char();
            }
        }
        return new_char;
    }

    fn try_handle_newline(self): OptionChar {
        if (self.read_offset >= self.src_len) {
            return OptionChar::None;
        }

        let first_char = self.src[self.read_offset];
        if (first_char == '\r') {
            let newline_seq = [first_char as u8];
            self.read_offset += 1;
            if (self.read_offset < self.src_len) {
                let second_char = self.src[self.read_offset];
                if (second_char == '\n') {
                    newline_seq.push(second_char as u8);
                    self.read_offset += 1;
                }
            }
            self.newline = OptionU8Vec::Some(newline_seq);
            return OptionChar::Some('\n');
        }

        if (first_char == '\n') {
            self.read_offset += 1;
            self.newline = OptionU8Vec::Some([first_char as u8]);
            return OptionChar::Some('\n');
        }

        return OptionChar::None;
    }

    fn process_char(self): char {
        if (self.read_offset >= self.src_len) {
            return (3 as u8) as char;  # ETX
        }

        let first_byte = self.src[self.read_offset];
        self.read_offset += 1;
        return first_byte;
    }

    fn update_position(self, char read_character): void {
        if (read_character == (2 as u8) as char) {
            self.current_position = Position {
                line: 1,
                column: 1,
                offset: 0,
                filename: self.filename
            };
            return;
        }
        if (read_character == (3 as u8) as char) {
            return;
        }
        if (read_character == '\n') {
            match (self.newline) {
                OptionU8Vec::Some(seq) {
                    self.current_position.offset += seq.size();
                },
                OptionU8Vec::None {
                    self.current_position.offset += 1;
                }
            }
            self.current_position.line += 1;
            self.current_position.column = 1;
            self.current_line = "";
            return;
        }
        self.current_position.offset += 1;
        self.current_position.column += 1;

        self.current_line += read_character;
    }
};
