import "../../common/position.rp";
import "../../common/span.rp";
import "../../common/errors.rp";
import "../tokens.rp";
import "./lazy-stream-reader.rp";
import "../../../stdlib/string.rp";


enum ResultOptionToken derives Debug {
    Ok(OptionToken),
    Err(LexerError)
};

enum OptionToken derives Debug {
    Some(Token),
    None
};

struct LexerOptions derives Debug {
    i64 max_comment_length,
    i64 max_identifier_length
};

enum ResultI64Array derives Debug {
    Ok(i64[]),
    Err(LexerError)
};

enum OptionTokenCategory derives Debug {
    Some(TokenCategory),
    None
};

struct Lexer derives Debug {
    LazyStreamReader src,
    OptionToken current,
    Position position,
    LexerOptions options

    fn new(&LazyStreamReader src, &LexerOptions options): Lexer {
        let position = src.position().clone();
        return Lexer { src, current: OptionToken::None, position, options };
    }

    fn current(self): OptionToken {
        return self.current;
    }

    fn current_span(self): Span {
        let start = self.position.clone();
        let end = self.src.position().clone();
        return Span { start, end };
    }

    fn token_text(&Token token): str {
        match (token.value) {
            TokenValue::F64(value) {
                return value as str;
            },
            TokenValue::I64(value) {
                return value as str;
            },
            TokenValue::String(value) {
                return value;
            },
            TokenValue::Char(value) {
                return value as str;
            },
            TokenValue::Null {
                return token.category.to_string();
            }
        }
    }

    fn create_error(self, str message): LexerError {
        let start = self.position.clone();
        let end = self.src.position().clone();

        let span = Span { start, end };

        return LexerError.at(ErrorSeverity::HIGH, message, span);
    }

    fn next(self): ResultOptionToken {
        return self.generate_token();
    }

    fn generate_token(self): ResultOptionToken {
        self.skip_whitespaces();

        self.position = self.src.position().clone();

        let token = self.try_generating_sign();

        match (token) {
            ResultOptionToken::Err(err) {
                return ResultOptionToken::Err(err);
            },
            ResultOptionToken::Ok(option_token) {
                if (option_token matches OptionToken::Some(value)) {
                    self.current = OptionToken::Some(value);

                    if (value.category matches TokenCategory::ETX) {
                        return ResultOptionToken::Ok(self.current);
                    }
                    if (value.category matches TokenCategory::Comment) {
                        return self.generate_token();
                    }

                    return ResultOptionToken::Ok(self.current);
                }
            }
        }

        token = self.try_generating_operator();

        match (token) {
            ResultOptionToken::Err(err) {
                return ResultOptionToken::Err(err);
            },
            ResultOptionToken::Ok(option_token) {
                if (option_token matches OptionToken::Some(value)) {
                    self.current = OptionToken::Some(value);
                    return ResultOptionToken::Ok(self.current);
                }
            }
        }

        token = self.try_generating_comment();

        match (token) {
            ResultOptionToken::Err(err) {
                return ResultOptionToken::Err(err);
            },
            ResultOptionToken::Ok(option_token) {
                if (option_token matches OptionToken::Some(value)) {
                    if (value.category matches TokenCategory::Comment) {
                        return self.generate_token();
                    }
                    self.current = OptionToken::Some(value);
                    return ResultOptionToken::Ok(self.current);
                }
            }
        }

        token = self.try_generating_string();

        match (token) {
            ResultOptionToken::Err(err) {
                return ResultOptionToken::Err(err);
            },
            ResultOptionToken::Ok(option_token) {
                if (option_token matches OptionToken::Some(value)) {
                    self.current = OptionToken::Some(value);
                    return ResultOptionToken::Ok(self.current);
                }
            }
        }

        token = self.try_generating_char();

        match (token) {
            ResultOptionToken::Err(err) {
                return ResultOptionToken::Err(err);
            },
            ResultOptionToken::Ok(option_token) {
                if (option_token matches OptionToken::Some(value)) {
                    self.current = OptionToken::Some(value);
                    return ResultOptionToken::Ok(self.current);
                }
            }
        }

        token = self.try_generating_number();

        match (token) {
            ResultOptionToken::Err(err) {
                return ResultOptionToken::Err(err);
            },
            ResultOptionToken::Ok(option_token) {
                if (option_token matches OptionToken::Some(value)) {
                    self.current = OptionToken::Some(value);
                    return ResultOptionToken::Ok(self.current);
                }
            }
        }

        token = self.try_creating_identifier_or_keyword();

        match (token) {
            ResultOptionToken::Err(err) {
                return ResultOptionToken::Err(err);
            },
            ResultOptionToken::Ok(option_token) {
                if (option_token matches OptionToken::Some(value)) {
                    self.current = OptionToken::Some(value);
                    return ResultOptionToken::Ok(self.current);
                }
            }
        }

        return ResultOptionToken::Err(self.create_error("Unexpected token"));
    }

    fn skip_whitespaces(self): void {
        while (self.src.current().is_whitespace()) {
            self.src.next();
        }
    }

    fn try_generating_sign(self): ResultOptionToken {
        let current_char = self.src.current();

        if (current_char == '(') {
            return ResultOptionToken::Ok(OptionToken::Some(self.single_char(
                &TokenCategory::ParenOpen
            )));
        } else if (current_char == ')') {
            return ResultOptionToken::Ok(OptionToken::Some(self.single_char(
                &TokenCategory::ParenClose
            )));
        } else if (current_char == '[') {
            return ResultOptionToken::Ok(OptionToken::Some(self.single_char(
                &TokenCategory::BracketOpen
            )));
        } else if (current_char == ']') {
            return ResultOptionToken::Ok(OptionToken::Some(self.single_char(
                &TokenCategory::BracketClose
            )));
        } else if (current_char == '{') {
            return ResultOptionToken::Ok(OptionToken::Some(self.single_char(
                &TokenCategory::BraceOpen
            )));
        } else if (current_char == '}') {
            return ResultOptionToken::Ok(OptionToken::Some(self.single_char(
                &TokenCategory::BraceClose
            )));
        } else if (current_char == ';') {
            return ResultOptionToken::Ok(OptionToken::Some(self.single_char(
                &TokenCategory::Semicolon
            )));
        } else if (current_char == ',') {
            return ResultOptionToken::Ok(OptionToken::Some(self.single_char(
                &TokenCategory::Comma
            )));
        } else if (current_char == (2 as u8) as char) {
            return ResultOptionToken::Ok(OptionToken::Some(self.single_char(&TokenCategory::STX)));
        } else if (current_char == (3 as u8) as char) {
            return ResultOptionToken::Ok(OptionToken::Some(self.single_char(&TokenCategory::ETX)));
        }

        return ResultOptionToken::Ok(OptionToken::None);
    }

    fn try_generating_operator(self): ResultOptionToken {
        let current_char = self.src.current();

        if (current_char == '+') {
            return ResultOptionToken::Ok(OptionToken::Some(self.extend_to_next(
                '=',
                TokenCategory::Plus,
                TokenCategory::PlusEquals
            )));
        } else if (current_char == '-') {
            return ResultOptionToken::Ok(OptionToken::Some(self.extend_minus()));
        } else if (current_char == '*') {
            return ResultOptionToken::Ok(OptionToken::Some(self.extend_to_next(
                '=',
                TokenCategory::Multiply,
                TokenCategory::TimesEquals
            )));
        } else if (current_char == '/') {
            return ResultOptionToken::Ok(OptionToken::Some(self.extend_to_next(
                '=',
                TokenCategory::Divide,
                TokenCategory::DivideEquals
            )));
        } else if (current_char == '%') {
            return ResultOptionToken::Ok(OptionToken::Some(self.extend_to_next(
                '=',
                TokenCategory::Modulo,
                TokenCategory::ModuloEquals
            )));
        } else if (current_char == '<') {
            return ResultOptionToken::Ok(OptionToken::Some(self.extend_to_next(
                '=',
                TokenCategory::Less,
                TokenCategory::LessOrEqual
            )));
        } else if (current_char == '>') {
            return ResultOptionToken::Ok(OptionToken::Some(self.extend_to_next(
                '=',
                TokenCategory::Greater,
                TokenCategory::GreaterOrEqual
            )));
        } else if (current_char == '!') {
            return ResultOptionToken::Ok(OptionToken::Some(self.extend_to_next(
                '=',
                TokenCategory::Negate,
                TokenCategory::NotEqual
            )));
        } else if (current_char == '=') {
            return ResultOptionToken::Ok(OptionToken::Some(self.extend_to_next(
                '=',
                TokenCategory::Assign,
                TokenCategory::Equal
            )));
        } else if (current_char == '&') {
            return ResultOptionToken::Ok(OptionToken::Some(self.extend_to_next(
                '&',
                TokenCategory::Reference,
                TokenCategory::And
            )));
        } else if (current_char == ':') {
            return ResultOptionToken::Ok(OptionToken::Some(self.extend_to_next(
                ':',
                TokenCategory::Colon,
                TokenCategory::DoubleColon
            )));
        } else if (current_char == '|') {
            return ResultOptionToken::Ok(OptionToken::Some(self.extend_to_next_or_warning(
                '|',
                &TokenCategory::Or
            )));
        } else if (current_char == '.') {
            return ResultOptionToken::Ok(OptionToken::Some(self.single_char(&TokenCategory::Dot)));
        }

        return ResultOptionToken::Ok(OptionToken::None);
    }

    fn single_char(self, &TokenCategory category): Token {
        let start = self.position.clone();
        self.src.next();
        let end = self.src.position().clone();
        return Token { category, value: TokenValue::Null, span: Span { start, end } };
    }

    fn extend_to_next(
        self,
        char char_to_search,
        TokenCategory not_found,
        TokenCategory found
    ): Token {
        let start = self.position.clone();

        let next_char = self.src.next();

        if (next_char == char_to_search) {
            self.src.next();

            let end = self.src.position().clone();

            return Token { category: found, value: TokenValue::Null, span: Span { start, end } };
        }

        let end = self.src.position().clone();

        return Token { category: not_found, value: TokenValue::Null, span: Span { start, end } };
    }

    fn extend_to_next_or_warning(self, char char_to_search, &TokenCategory found): Token {
        let start = self.position.clone();

        let next_char = self.src.next();

        if (next_char == char_to_search) {
            self.src.next();
        } else {
            let end = self.src.position().clone();

            let span = Span { start, end };

            let warning = LexerError.at(ErrorSeverity::LOW, "Expected '|'", span);

            println(warning.message);
        }

        let end = self.src.position().clone();

        return Token { category: found, value: TokenValue::Null, span: Span { start, end } };
    }

    fn extend_minus(self): Token {
        let start = self.position.clone();

        let next_char = self.src.next();

        if (next_char == '>') {
            self.src.next();

            let end = self.src.position().clone();

            return Token {
                category: TokenCategory::Arrow,
                value: TokenValue::Null,
                span: Span { start, end }
            };
        }

        if (next_char == '=') {
            self.src.next();

            let end = self.src.position().clone();

            return Token {
                category: TokenCategory::MinusEquals,
                value: TokenValue::Null,
                span: Span { start, end }
            };
        }

        let end = self.src.position().clone();

        return Token {
            category: TokenCategory::Minus,
            value: TokenValue::Null,
            span: Span { start, end }
        };
    }

    fn try_generating_comment(self): ResultOptionToken {
        let current_char = self.src.current();

        if (current_char != '#') {
            return ResultOptionToken::Ok(OptionToken::None);
        }

        let comment = "";

        while (true) {
            let current = self.src.next();

            if (current == '\n' || current == (3 as u8) as char) {
                break;
            }

            if (comment.size() >= self.options.max_comment_length) {
                return ResultOptionToken::Err(self.create_error(
                    "Comment too long. Max comment length: "
                        + self.options.max_comment_length as str
                ));
            }

            comment += current;
        }

        return ResultOptionToken::Ok(OptionToken::Some(Token {
            category: TokenCategory::Comment,
            value: TokenValue::String(comment),
            span: self.current_span()
        }));
    }

    fn try_generating_char(self): ResultOptionToken {
        let start = self.position.clone();

        let current_char = self.src.current();

        if (current_char != (39 as u8) as char) {
            return ResultOptionToken::Ok(OptionToken::None);
        }

        let next_char = self.src.next();

        if (next_char == (39 as u8) as char) {
            return ResultOptionToken::Err(self.create_error("Empty char literal"));
        }

        if (next_char == '\n') {
            return ResultOptionToken::Err(self.create_error("Unexpected newline in char literal"));
        }

        if (next_char == (3 as u8) as char) {
            return ResultOptionToken::Err(self.create_error(
                "Unexpected end of file in char literal"
            ));
        }

        let value = next_char;

        if (next_char == '\\') {
            let escaped_char = self.src.next();
            let escaped = Lexer.escape_char_or_invalid(escaped_char);

            if (escaped == '\0' && escaped_char != '0') {
                return ResultOptionToken::Err(self.create_error(
                    "Invalid escape symbol detected '\\" + escaped_char + "'"
                ));
            }

            value = escaped;
        }

        let closing_char = self.src.next();

        if (closing_char != (39 as u8) as char) {
            return ResultOptionToken::Err(self.create_error(
                "Char literal must contain exactly one character"
            ));
        }

        self.src.next();

        let end = self.src.position().clone();

        return ResultOptionToken::Ok(OptionToken::Some(Token {
            category: TokenCategory::CharValue,
            value: TokenValue::Char(value),
            span: Span { start, end }
        }));
    }

    fn escape_char(char value): char {
        if (value == 'n') {
            return '\n';
        } else if (value == 'r') {
            return '\r';
        } else if (value == 't') {
            return '\t';
        } else if (value == '\"') {
            return '\"';
        } else if (value == '\\') {
            return '\\';
        } else if (value == 'e') {
            return (27 as u8) as char;
        } else if (value == '0') {
            return '\0';
        }

        return value;
    }

    fn try_generating_string(self): ResultOptionToken {
        let start = self.position.clone();

        let current_char = self.src.current();

        if (current_char != '\"') {
            return ResultOptionToken::Ok(OptionToken::None);
        }

        let created_string = "";

        let current = self.src.next();

        while (current != '\"') {
            if (current == '\\') {
                let next_char = self.src.next();

                let escaped = Lexer.escape_char_or_invalid(next_char);

                if (escaped != '\0' || next_char == '0') {
                    created_string += escaped;
                } else {
                    let warning = LexerError.at(
                        ErrorSeverity::LOW,
                        "Invalid escape symbol detected '\\" + next_char + "'",
                        self.current_span()
                    );

                    println(warning.message);

                    created_string += '\\';
                    created_string += next_char;
                }
            } else if (current == '\n') {
                return ResultOptionToken::Err(self.create_error("Unexpected newline in string"));
            } else if (current == (3 as u8) as char) {
                let end = self.src.position().clone();

                let span = Span { start, end };

                let warning = LexerError.at(ErrorSeverity::LOW, "String not closed", span);

                println(warning.message);

                return ResultOptionToken::Ok(OptionToken::Some(Token {
                    category: TokenCategory::StringValue,
                    value: TokenValue::String(created_string),
                    span
                }));
            } else {
                created_string += current;
            }

            current = self.src.next();
        }

        self.src.next();

        let end = self.src.position().clone();

        return ResultOptionToken::Ok(OptionToken::Some(Token {
            category: TokenCategory::StringValue,
            value: TokenValue::String(created_string),
            span: Span { start, end }
        }));
    }

    fn escape_char_or_invalid(char value): char {
        if (value == 'n') {
            return '\n';
        } else if (value == 'r') {
            return '\r';
        } else if (value == 't') {
            return '\t';
        } else if (value == '\"') {
            return '\"';
        } else if (value == '\\') {
            return '\\';
        } else if (value == 'e') {
            return (27 as u8) as char;
        } else if (value == '0') {
            return '\0';
        }

        return '\0';
    }

    fn try_generating_number(self): ResultOptionToken {
        let start = self.position.clone();

        let current_char = self.src.current();

        if (!current_char.is_digit()) {
            return ResultOptionToken::Ok(OptionToken::None);
        }

        let decimal = 0 as i64;

        if (current_char != '0') {
            let parsed = self.parse_integer();

            match (parsed) {
                ResultI64Array::Err(err) {
                    return ResultOptionToken::Err(err);
                },
                ResultI64Array::Ok(values) {
                    decimal = values[0];
                }
            }
        } else {
            let next_char = self.src.next();

            if (next_char.is_digit()) {
                return ResultOptionToken::Err(self.create_error("Cannot prefix number with 0's."));
            }
        }

        let current = self.src.current();

        if (current != '.') {
            let end = self.src.position().clone();

            return ResultOptionToken::Ok(OptionToken::Some(Token {
                category: TokenCategory::I64Value,
                value: TokenValue::I64(decimal),
                span: Span { start, end }
            }));
        }

        self.src.next();

        let fraction = self.parse_integer();

        let fraction_values: i64[] = [];

        match (fraction) {
            ResultI64Array::Err(err) {
                return ResultOptionToken::Err(err);
            },
            ResultI64Array::Ok(values) {
                fraction_values = values;
            }
        }

        let float_value = Lexer.merge_to_float(decimal, fraction_values[0], fraction_values[1]);

        let end = self.src.position().clone();

        return ResultOptionToken::Ok(OptionToken::Some(Token {
            category: TokenCategory::F64Value,
            value: TokenValue::F64(float_value),
            span: Span { start, end }
        }));
    }

    fn parse_integer(self): ResultI64Array {
        let current_char = self.src.current();

        let length = 0 as i64;
        let total = 0 as i64;

        while (true) {
            if (current_char.is_digit()) {
                let digit = (current_char as u8) as i64 - ('0' as u8) as i64;

                if (total > 922337203685477580) {
                    return ResultI64Array::Err(self.create_error(
                        "Overflow occurred while parsing integer"
                    ));
                }

                if (total == 922337203685477580 && digit > 7) {
                    return ResultI64Array::Err(self.create_error(
                        "Overflow occurred while parsing integer"
                    ));
                }

                total = total * 10;
                total += digit;

                length += 1;

                current_char = self.src.next();
            } else if (current_char == (39 as u8) as char) {
                let next_char = self.src.next();

                if (!next_char.is_digit()) {
                    return ResultI64Array::Err(self.create_error(
                        "Digit separator ' must be placed between two digits"
                    ));
                }

                current_char = next_char;
            } else {
                break;
            }
        }

        return ResultI64Array::Ok([total, length]);
    }

    fn merge_to_float(i64 decimal, i64 fraction, i64 fraction_length): f64 {
        let divisor = 10.0;
        let power = 1.0;
        let i = 0;

        while (i < fraction_length) {
            power *= divisor;
            i += 1;
        }

        return decimal as f64 + fraction as f64 / power;
    }

    fn char_is_still_identifier(char current_char): bool {
        return current_char.is_digit() || current_char.is_letter() || current_char == '_';
    }

    fn try_creating_identifier_or_keyword(self): ResultOptionToken {
        let start = self.position.clone();

        let current_char = self.src.current();

        if (!current_char.is_letter()) {
            return ResultOptionToken::Ok(OptionToken::None);
        }

        let created_string = "";

        while (Lexer.char_is_still_identifier(current_char)) {
            if (created_string.size() >= self.options.max_identifier_length) {
                return ResultOptionToken::Err(self.create_error(
                    "Identifier name too long. Max identifier length: "
                        + self.options.max_identifier_length as str
                ));
            }

            created_string += current_char;

            current_char = self.src.next();
        }

        let end = self.src.position().clone();

        let span = Span { start, end };

        let category = Lexer.keyword_category(created_string);

        match (category) {
            OptionTokenCategory::Some(value) {
                return ResultOptionToken::Ok(OptionToken::Some(Token {
                    category: value,
                    value: TokenValue::Null,
                    span
                }));
            },
            OptionTokenCategory::None {
                return ResultOptionToken::Ok(OptionToken::Some(Token {
                    category: TokenCategory::Identifier,
                    value: TokenValue::String(created_string),
                    span
                }));
            }
        }
    }

    fn keyword_category(str value): OptionTokenCategory {
        if (value == "fn") {
            return OptionTokenCategory::Some(TokenCategory::Fn);
        } else if (value == "for") {
            return OptionTokenCategory::Some(TokenCategory::For);
        } else if (value == "while") {
            return OptionTokenCategory::Some(TokenCategory::While);
        } else if (value == "if") {
            return OptionTokenCategory::Some(TokenCategory::If);
        } else if (value == "else") {
            return OptionTokenCategory::Some(TokenCategory::Else);
        } else if (value == "return") {
            return OptionTokenCategory::Some(TokenCategory::Return);
        } else if (value == "i8") {
            return OptionTokenCategory::Some(TokenCategory::I8);
        } else if (value == "i16") {
            return OptionTokenCategory::Some(TokenCategory::I16);
        } else if (value == "i32") {
            return OptionTokenCategory::Some(TokenCategory::I32);
        } else if (value == "i64") {
            return OptionTokenCategory::Some(TokenCategory::I64);
        } else if (value == "u8") {
            return OptionTokenCategory::Some(TokenCategory::U8);
        } else if (value == "u16") {
            return OptionTokenCategory::Some(TokenCategory::U16);
        } else if (value == "u32") {
            return OptionTokenCategory::Some(TokenCategory::U32);
        } else if (value == "u64") {
            return OptionTokenCategory::Some(TokenCategory::U64);
        } else if (value == "f64") {
            return OptionTokenCategory::Some(TokenCategory::F64);
        } else if (value == "str") {
            return OptionTokenCategory::Some(TokenCategory::String);
        } else if (value == "char") {
            return OptionTokenCategory::Some(TokenCategory::Char);
        } else if (value == "void") {
            return OptionTokenCategory::Some(TokenCategory::Void);
        } else if (value == "bool") {
            return OptionTokenCategory::Some(TokenCategory::Bool);
        } else if (value == "true") {
            return OptionTokenCategory::Some(TokenCategory::True);
        } else if (value == "false") {
            return OptionTokenCategory::Some(TokenCategory::False);
        } else if (value == "as") {
            return OptionTokenCategory::Some(TokenCategory::As);
        } else if (value == "switch") {
            return OptionTokenCategory::Some(TokenCategory::Switch);
        } else if (value == "break") {
            return OptionTokenCategory::Some(TokenCategory::Break);
        } else if (value == "continue") {
            return OptionTokenCategory::Some(TokenCategory::Continue);
        } else if (value == "import") {
            return OptionTokenCategory::Some(TokenCategory::Import);
        } else if (value == "extern") {
            return OptionTokenCategory::Some(TokenCategory::Extern);
        } else if (value == "let") {
            return OptionTokenCategory::Some(TokenCategory::Let);
        } else if (value == "struct") {
            return OptionTokenCategory::Some(TokenCategory::Struct);
        } else if (value == "enum") {
            return OptionTokenCategory::Some(TokenCategory::Enum);
        } else if (value == "match") {
            return OptionTokenCategory::Some(TokenCategory::Match);
        } else if (value == "rest") {
            return OptionTokenCategory::Some(TokenCategory::Rest);
        } else if (value == "derives") {
            return OptionTokenCategory::Some(TokenCategory::Derives);
        } else if (value == "matches") {
            return OptionTokenCategory::Some(TokenCategory::Matches);
        } else if (value == "not") {
            return OptionTokenCategory::Some(TokenCategory::Not);
        } else if (value == "extend") {
            return OptionTokenCategory::Some(TokenCategory::Extend);
        } else if (value == "interface") {
            return OptionTokenCategory::Some(TokenCategory::Interface);
        } else if (value == "implements") {
            return OptionTokenCategory::Some(TokenCategory::Implements);
        }

        return OptionTokenCategory::None;
    }
};
