import "../../common/errors.rp";
import "../../common/span.rp";
import "../../common/position.rp";
import "../../../stdlib/string.rp";
import "../lexer/lexer.rp";
import "../tokens.rp";
import "./ast.rp";
import "./parser-results.rp";


struct Parser derives Debug {
    Lexer lexer

    fn new(&Lexer lexer): ResultParser {
        let primed = lexer;

        # The token stream always begins with a synthetic STX token.
        let first_result = primed.next();
        if (first_result matches ResultOptionToken::Err(err)) {
            return ResultParser::Err(ParserError.from_lexer(&err));
        }

        let second_result = primed.next();
        if (second_result matches ResultOptionToken::Err(err)) {
            return ResultParser::Err(ParserError.from_lexer(&err));
        }

        return ResultParser::Ok(Parser { lexer: primed });
    }

    fn next_token(self): ResultOptionToken {
        let result = self.lexer.next();

        match (result) {
            ResultOptionToken::Err(err) {
                return ResultOptionToken::Err(err);
            },
            ResultOptionToken::Ok(option_token) {
                return ResultOptionToken::Ok(option_token);
            }
        }
    }

    fn current_token(self): Token {
        let current = self.lexer.current();

        match (current) {
            OptionToken::Some(token) {
                return token;
            },
            OptionToken::None {
                # Unreachable in practice: `parser_new` always primes the
                # lexer before a `Parser` is handed out.
                return Token {
                    category: TokenCategory::ETX,
                    value: TokenValue::Null,
                    span: Span.default()
                };
            }
        }
    }

    fn consume_must_be(self, &TokenCategory category): ResultToken {
        let current_token = self.current_token();

        # TODO: temporary workaround with debug
        if (current_token.category.debug() == category.debug()) {
            let advance = self.next_token();
            if (advance matches ResultOptionToken::Err(err)) {
                return ResultToken::Err(ParserError.from_lexer(&err));
            }

            return ResultToken::Ok(current_token);
        }

        return ResultToken::Err(ParserError.expected_found(
            ErrorSeverity::HIGH,
            "Unexpected token",
            category.to_string(),
            Parser.token_text(&current_token),
            current_token.span
        ));
    }

    fn consume_if_matches(self, &TokenCategory category): ResultOptionToken {
        let current_token = self.current_token();

        # TODO: temporary workaround with debug
        if (current_token.category.debug() == category.debug()) {
            let advance = self.next_token();
            if (advance matches ResultOptionToken::Err(err)) {
                return ResultOptionToken::Err(err);
            }

            return ResultOptionToken::Ok(OptionToken::Some(current_token));
        }

        return ResultOptionToken::Ok(OptionToken::None);
    }

    fn emit_error(self, str text): ParserError {
        return ParserError.at(ErrorSeverity::HIGH, text, self.current_token().span);
    }

    fn token_text(&Token token): str {
        match (token.value) {
            TokenValue::F64(value) {
                return value as str;
            },
            TokenValue::I64(value) {
                return value as str;
            },
            TokenValue::String(value) {
                return value;
            },
            TokenValue::Char(value) {
                return value as str;
            },
            TokenValue::Null {
                return token.category.to_string();
            }
        }
    }
};

enum ResultParser derives Debug {
    Ok(Parser),
    Err(ParserError)
};
