import "../../../common/span.rp";
import "../../tokens.rp";
import "../ast.rp";
import "../parser-results.rp";
import "../core.rp";
import "./multiplicative-term.rp";


extend Parser {
    fn parse_additive_term(self): ResultOptionExpressionNode {
        # additive_term = multiplicative_term, { ("+" | "-"), multiplicative_term };
        let left_call = self.parse_multiplicative_term();

        let left_side = ExpressionNode {
            value: Expression::Literal(Literal::True),
            span: self.current_token().span
        };
        let found_left = false;

        match (left_call) {
            ResultOptionExpressionNode::Err(err) {
                return ResultOptionExpressionNode::Err(err);
            },
            ResultOptionExpressionNode::Ok(option_left) {
                if (option_left matches OptionExpressionNode::Some(value)) {
                    left_side = value;
                    found_left = true;
                }
            }
        }

        if (!found_left) {
            return ResultOptionExpressionNode::Ok(OptionExpressionNode::None);
        }

        while (true) {
            let current_token = self.current_token();
            if (current_token.category not matches TokenCategory::Plus) {
                if (current_token.category not matches TokenCategory::Minus) {
                    break;
                }
            }

            let is_minus = false;
            if (current_token.category matches TokenCategory::Minus) {
                is_minus = true;
            }

            let advance = self.next_token();
            if (advance matches ResultOptionToken::Err(err)) {
                return ResultOptionExpressionNode::Err(ParserError.from_lexer(&err));
            }

            let found_right = false;
            match (self.parse_multiplicative_term()) {
                ResultOptionExpressionNode::Err(err) {
                    return ResultOptionExpressionNode::Err(err);
                },
                ResultOptionExpressionNode::Ok(option_right) {
                    if (option_right matches OptionExpressionNode::Some(right_side)) {
                        let operands = BinaryExpression { left: left_side, right: right_side };
                        let expression_value = Expression::Addition(operands);
                        if (is_minus) {
                            expression_value = Expression::Subtraction(operands);
                        }

                        left_side = ExpressionNode {
                            value: expression_value,
                            span: Span.new(&left_side.span.start, &right_side.span.end)
                        };
                        found_right = true;
                    }
                }
            }

            if (!found_right) {
                return ResultOptionExpressionNode::Err(self.emit_error(
                    "Couldn't create multiplicative term while parsing additive term."
                ));
            }
        }

        return ResultOptionExpressionNode::Ok(OptionExpressionNode::Some(left_side));
    }
};
