import "../../../common/span.rp";
import "../../tokens.rp";
import "../ast.rp";
import "../parser-results.rp";
import "../core.rp";
import "./expression.rp";


extend Parser {
    fn parse_arguments(self): ResultArgumentNodeVec {
        # arguments = [ argument, {",", argument} ];
        let arguments: ArgumentNode[] = [];

        match (self.parse_argument()) {
            ResultOptionArgumentNode::Err(err) {
                return ResultArgumentNodeVec::Err(err);
            },
            ResultOptionArgumentNode::Ok(option_first) {
                match (option_first) {
                    OptionArgumentNode::None {
                        return ResultArgumentNodeVec::Ok(arguments);
                    },
                    OptionArgumentNode::Some(first_argument) {
                        arguments.push(first_argument);
                    }
                }
            }
        }

        while (true) {
            let has_comma = false;
            match (self.consume_if_matches(&TokenCategory::Comma)) {
                ResultOptionToken::Err(err) {
                    return ResultArgumentNodeVec::Err(parser_error_from_lexer_error(&err));
                },
                ResultOptionToken::Ok(option_comma) {
                    if (option_comma matches OptionToken::Some) {
                        has_comma = true;
                    }
                }
            }

            if (!has_comma) {
                break;
            }

            match (self.parse_argument()) {
                ResultOptionArgumentNode::Err(err) {
                    return ResultArgumentNodeVec::Err(err);
                },
                ResultOptionArgumentNode::Ok(option_next) {
                    match (option_next) {
                        OptionArgumentNode::None {
                            return ResultArgumentNodeVec::Err(self.create_parser_error(
                                "Couldn't create argument while parsing arguments."
                            ));
                        },
                        OptionArgumentNode::Some(next_argument) {
                            arguments.push(next_argument);
                        }
                    }
                }
            }
        }

        return ResultArgumentNodeVec::Ok(arguments);
    }

    fn parse_argument(self): ResultOptionArgumentNode {
        # argument = ["&"], expression;
        let start_position = self.current_token().span.start;

        let passed_by = PassedBy::Value;
        match (self.consume_if_matches(&TokenCategory::Reference)) {
            ResultOptionToken::Err(err) {
                return ResultOptionArgumentNode::Err(parser_error_from_lexer_error(&err));
            },
            ResultOptionToken::Ok(option_reference) {
                if (option_reference matches OptionToken::Some) {
                    passed_by = PassedBy::Reference;
                }
            }
        }

        match (self.parse_expression()) {
            ResultOptionExpressionNode::Err(err) {
                return ResultOptionArgumentNode::Err(err);
            },
            ResultOptionExpressionNode::Ok(option_expression) {
                match (option_expression) {
                    OptionExpressionNode::None {
                        return ResultOptionArgumentNode::Ok(OptionArgumentNode::None);
                    },
                    OptionExpressionNode::Some(expression) {
                        return ResultOptionArgumentNode::Ok(OptionArgumentNode::Some(ArgumentNode {
                            value: Argument { value: expression, passed_by: passed_by },
                            span: Span.new(&start_position, &expression.span.end)
                        }));
                    }
                }
            }
        }
    }
};