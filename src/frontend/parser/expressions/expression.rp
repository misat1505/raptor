import "../../../common/span.rp";
import "../../tokens.rp";
import "../ast.rp";
import "../parser-results.rp";
import "../core.rp";
import "./concatenation-term.rp";


extend Parser {
    fn parse_expression(self): ResultOptionExpressionNode {
        # expression = concatenation_term, { "||", concatenation_term };
        let left_call = self.parse_concatenation_term();

        # Placeholder; overwritten by the `Some(...)` arm below before it is
        # ever read (a `let` always needs an initializer in this language,
        # there is no plain "declare, assign later" form).
        let left_side = ExpressionNode {
            value: Expression::Literal(Literal::True),
            span: self.current_token().span
        };
        let found_left = false;

        match (left_call) {
            ResultOptionExpressionNode::Err(err) {
                return ResultOptionExpressionNode::Err(err);
            },
            ResultOptionExpressionNode::Ok(option_left) {
                if (option_left matches OptionExpressionNode::Some(value)) {
                    left_side = value;
                    found_left = true;
                }
            }
        }

        if (!found_left) {
            return ResultOptionExpressionNode::Ok(OptionExpressionNode::None);
        }

        while (true) {
            if (self.current_token().category matches TokenCategory::Or) {
                let advance = self.next_token();
                if (advance matches ResultOptionToken::Err(err)) {
                    return ResultOptionExpressionNode::Err(parser_error_from_lexer_error(&err));
                }

                let found_right = false;
                match (self.parse_concatenation_term()) {
                    ResultOptionExpressionNode::Err(err) {
                        return ResultOptionExpressionNode::Err(err);
                    },
                    ResultOptionExpressionNode::Ok(option_right) {
                        if (option_right matches OptionExpressionNode::Some(right_side)) {
                            left_side = ExpressionNode {
                                value: Expression::Alternative(BinaryExpression {
                                    left: left_side,
                                    right: right_side
                                }),
                                span: Span.new(&left_side.span.start, &right_side.span.end)
                            };
                            found_right = true;
                        }
                    }
                }

                if (!found_right) {
                    return ResultOptionExpressionNode::Err(self.create_parser_error(
                        "Couldn't create concatenation term while parsing expression."
                    ));
                }
            } else {
                break;
            }
        }

        return ResultOptionExpressionNode::Ok(OptionExpressionNode::Some(left_side));
    }
};
