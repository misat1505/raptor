import "../../../common/span.rp";
import "../../tokens.rp";
import "../ast.rp";
import "../parser-results.rp";
import "../core.rp";
import "../misc/identifier.rp";
import "../expressions/expression.rp";
import "../expressions/arguments.rp";


extend Parser {
    fn parse_identifier_or_call_or_struct_literal_or_enum_literal(
        self
    ): ResultOptionExpressionNode {
        # identifier_or_call_or_struct_literal_or_enum_literal = identifier, ( call_or_index_tail | struct_literal_tail | enum_literal_tail );
        match (self.parse_identifier()) {
            ResultOptionIdentifierNode::Err(err) {
                return ResultOptionExpressionNode::Err(err);
            },
            ResultOptionIdentifierNode::Ok(option_identifier) {
                match (option_identifier) {
                    OptionIdentifierNode::None {
                        return ResultOptionExpressionNode::Ok(OptionExpressionNode::None);
                    },
                    OptionIdentifierNode::Some(identifier) {
                        if (self.current_token().category matches TokenCategory::BraceOpen) {
                            let struct_result = self.parse_struct_literal_tail(&identifier);
                            match (struct_result) {
                                ResultExpressionNode::Err(err) {
                                    return ResultOptionExpressionNode::Err(err);
                                },
                                ResultExpressionNode::Ok(node) {
                                    return ResultOptionExpressionNode::Ok(OptionExpressionNode::Some(node));
                                }
                            }
                        }

                        if (self.current_token().category matches TokenCategory::DoubleColon) {
                            match (self.parse_enum_literal_tail(&identifier)) {
                                ResultExpressionNode::Err(err) {
                                    return ResultOptionExpressionNode::Err(err);
                                },
                                ResultExpressionNode::Ok(node) {
                                    return ResultOptionExpressionNode::Ok(OptionExpressionNode::Some(node));
                                }
                            }
                        }

                        return self.parse_call_or_index_tail(&identifier);
                    }
                }
            }
        }
    }

    fn parse_enum_literal_tail(self, &IdentifierNode enum_name): ResultExpressionNode {
        # enum_literal_tail = "::", identifier, [ "(", expression, ")" ];
        let start_position = enum_name.span.start;

        if (self.consume_must_be(&TokenCategory::DoubleColon) matches ResultToken::Err(err)) {
            return ResultExpressionNode::Err(err);
        }

        let variant_name_call = self.parse_identifier();
        let variant_name = IdentifierNode { value: "", span: self.current_token().span };
        let found_variant_name = false;
        match (variant_name_call) {
            ResultOptionIdentifierNode::Err(err) {
                return ResultExpressionNode::Err(err);
            },
            ResultOptionIdentifierNode::Ok(option_variant_name) {
                if (option_variant_name matches OptionIdentifierNode::Some(name)) {
                    variant_name = name;
                    found_variant_name = true;
                }
            }
        }

        if (!found_variant_name) {
            return ResultExpressionNode::Err(self.create_parser_error(
                "Expected an identifier after '::'."
            ));
        }

        let variant_value = OptionExpressionNode::None;
        let end_position = variant_name.span.end;

        match (self.consume_if_matches(&TokenCategory::ParenOpen)) {
            ResultOptionToken::Err(err) {
                return ResultExpressionNode::Err(parser_error_from_lexer_error(&err));
            },
            ResultOptionToken::Ok(option_paren) {
                if (option_paren matches OptionToken::Some) {
                    match (self.parse_expression()) {
                        ResultOptionExpressionNode::Err(err) {
                            return ResultExpressionNode::Err(err);
                        },
                        ResultOptionExpressionNode::Ok(option_value) {
                            match (option_value) {
                                OptionExpressionNode::None {
                                    return ResultExpressionNode::Err(self.create_parser_error(
                                        "Expected an expression in enum variant value."
                                    ));
                                },
                                OptionExpressionNode::Some(value) {
                                    variant_value = OptionExpressionNode::Some(value);

                                    match (self.consume_must_be(
                                        &TokenCategory::ParenClose
                                    )) {
                                        ResultToken::Err(err) {
                                            return ResultExpressionNode::Err(err);
                                        },
                                        ResultToken::Ok(close_token) {
                                            end_position = close_token.span.end;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        return ResultExpressionNode::Ok(ExpressionNode {
            value: Expression::EnumLiteral(EnumLiteralExpression {
                enum_name: enum_name,
                variant_name: variant_name,
                variant_value: variant_value
            }),
            span: Span.new(&start_position, &end_position)
        });
    }

    fn parse_call_or_index_tail(
        self,
        &IdentifierNode identifier
    ): ResultOptionExpressionNode {
        # call_or_index_tail = [ "(", arguments, ")" ], { access_tail };
        let start_position = identifier.span.start;

        let result = Expression::Variable(identifier.value);
        let end_position = identifier.span.end;

        match (self.consume_if_matches(&TokenCategory::ParenOpen)) {
            ResultOptionToken::Err(err) {
                return ResultOptionExpressionNode::Err(parser_error_from_lexer_error(&err));
            },
            ResultOptionToken::Ok(option_paren) {
                if (option_paren matches OptionToken::Some) {
                    let arguments: ArgumentNode[] = [];
                    match (self.parse_arguments()) {
                        ResultArgumentNodeVec::Err(err) {
                            return ResultOptionExpressionNode::Err(err);
                        },
                        ResultArgumentNodeVec::Ok(parsed_arguments) {
                            arguments = parsed_arguments;
                        }
                    }

                    match (self.consume_must_be(&TokenCategory::ParenClose)) {
                        ResultToken::Err(err) {
                            return ResultOptionExpressionNode::Err(err);
                        },
                        ResultToken::Ok(close_token) {
                            result = Expression::FunctionCall(FunctionCallExpression {
                                identifier: identifier,
                                arguments: arguments
                            });
                            end_position = close_token.span.end;
                        }
                    }
                }
            }
        }

        while (true) {
            let current_category = self.current_token().category;

            if (current_category matches TokenCategory::BracketOpen) {
                if (self.consume_must_be(&TokenCategory::BracketOpen) matches ResultToken::Err(err)) {
                    return ResultOptionExpressionNode::Err(err);
                }

                match (self.parse_expression()) {
                    ResultOptionExpressionNode::Err(err) {
                        return ResultOptionExpressionNode::Err(err);
                    },
                    ResultOptionExpressionNode::Ok(option_index) {
                        match (option_index) {
                            OptionExpressionNode::None {
                                return ResultOptionExpressionNode::Err(self.create_parser_error(
                                    "Expected an expression inside '[]' index."
                                ));
                            },
                            OptionExpressionNode::Some(index_expression) {
                                let close_bracket = self.consume_must_be(
                                    &TokenCategory::BracketClose
                                );
                                match (close_bracket) {
                                    ResultToken::Err(err) {
                                        return ResultOptionExpressionNode::Err(err);
                                    },
                                    ResultToken::Ok(close_bracket_token) {
                                        let collection_node = ExpressionNode {
                                            value: result,
                                            span: Span.new(&start_position, &index_expression.span.start)
                                        };
                                        result = Expression::Index(IndexExpression {
                                            collection: collection_node,
                                            index: index_expression
                                        });
                                        end_position = close_bracket_token.span.end;
                                    }
                                }
                            }
                        }
                    }
                }
            } else if (current_category matches TokenCategory::Dot) {
                if (self.consume_must_be(&TokenCategory::Dot) matches ResultToken::Err(err)) {
                    return ResultOptionExpressionNode::Err(err);
                }

                match (self.parse_identifier()) {
                    ResultOptionIdentifierNode::Err(err) {
                        return ResultOptionExpressionNode::Err(err);
                    },
                    ResultOptionIdentifierNode::Ok(option_field) {
                        match (option_field) {
                            OptionIdentifierNode::None {
                                return ResultOptionExpressionNode::Err(self.create_parser_error(
                                    "Expected an identifier after '.'."
                                ));
                            },
                            OptionIdentifierNode::Some(field) {
                                let current_category = self.current_token().category;
                                let ct_category_debug = current_category.debug();
                                let paren_open_category = TokenCategory::ParenOpen;
                                if (ct_category_debug == paren_open_category.debug()) {
                                    if (self.consume_must_be(&TokenCategory::ParenOpen) matches ResultToken::Err(err)) {
                                        return ResultOptionExpressionNode::Err(err);
                                    }

                                    let arguments: ArgumentNode[] = [];
                                    if (self.parse_arguments() matches ResultArgumentNodeVec::Ok(args)) {
                                        arguments = args;
                                    }

                                    let paren_close_call = self.consume_must_be(&TokenCategory::ParenClose);
                                    if (paren_close_call matches ResultToken::Err(err)) {
                                        return ResultOptionExpressionNode::Err(err);
                                    }
                                    let instance_node = ExpressionNode {
                                        value: result,
                                        span: Span.new(&start_position, &field.span.start)
                                    };
                                    result = Expression::MethodCall(MethodCallExpression {
                                        instance: instance_node,
                                        target: MethodCallTarget::Unresolved,
                                        field: field,
                                        arguments: arguments
                                    });
                                    if (paren_close_call matches ResultToken::Ok(paren_close)) {
                                        end_position = paren_close.span.end;
                                    }
                                } else {
                                    let instance_node = ExpressionNode {
                                        value: result,
                                        span: Span.new(&start_position, &field.span.start)
                                    };
                                    result = Expression::FieldAccess(FieldAccessExpression {
                                        instance: instance_node,
                                        field: field
                                    });
                                    end_position = field.span.end;
                                }
                            }
                        }
                    }
                }
            } else {
                break;
            }
        }

        return ResultOptionExpressionNode::Ok(OptionExpressionNode::Some(ExpressionNode {
            value: result,
            span: Span.new(&start_position, &end_position)
        }));
    }

    fn parse_struct_literal_tail(
        self,
        &IdentifierNode identifier
    ): ResultExpressionNode {
        # struct_literal_tail = "{", [ struct_literal_fields ], "}";
        let start_position = identifier.span.start;

        if (self.consume_must_be(&TokenCategory::BraceOpen) matches ResultToken::Err(err)) {
            return ResultExpressionNode::Err(err);
        }

        let fields: StructLiteralFieldNode[] = [];
        match (self.parse_struct_literal_fields()) {
            ResultStructLiteralFieldNodeVec::Err(err) {
                return ResultExpressionNode::Err(err);
            },
            ResultStructLiteralFieldNodeVec::Ok(parsed_fields) {
                fields = parsed_fields;
            }
        }

        match (self.consume_must_be(&TokenCategory::BraceClose)) {
            ResultToken::Err(err) {
                return ResultExpressionNode::Err(err);
            },
            ResultToken::Ok(close_token) {
                let whole_span = Span.new(&start_position, &close_token.span.end);
                return ResultExpressionNode::Ok(ExpressionNode {
                    value: Expression::StructLiteral(StructLiteralNode {
                        value: StructLiteral { identifier: identifier, fields: fields },
                        span: whole_span
                    }),
                    span: whole_span
                });
            }
        }
    }

    fn parse_struct_literal_fields(self): ResultStructLiteralFieldNodeVec {
        # struct_literal_fields = struct_literal_field, { ",", struct_literal_field };
        let fields: StructLiteralFieldNode[] = [];

        match (self.parse_struct_literal_field()) {
            ResultOptionStructLiteralFieldNode::Err(err) {
                return ResultStructLiteralFieldNodeVec::Err(err);
            },
            ResultOptionStructLiteralFieldNode::Ok(option_first) {
                match (option_first) {
                    OptionStructLiteralFieldNode::None {
                        return ResultStructLiteralFieldNodeVec::Ok(fields);
                    },
                    OptionStructLiteralFieldNode::Some(first_field) {
                        fields.push(first_field);
                    }
                }
            }
        }

        while (true) {
            let has_comma = false;
            match (self.consume_if_matches(&TokenCategory::Comma)) {
                ResultOptionToken::Err(err) {
                    return ResultStructLiteralFieldNodeVec::Err(parser_error_from_lexer_error(&err));
                },
                ResultOptionToken::Ok(option_comma) {
                    if (option_comma matches OptionToken::Some) {
                        has_comma = true;
                    }
                }
            }

            if (!has_comma) {
                break;
            }

            match (self.parse_struct_literal_field()) {
                ResultOptionStructLiteralFieldNode::Err(err) {
                    return ResultStructLiteralFieldNodeVec::Err(err);
                },
                ResultOptionStructLiteralFieldNode::Ok(option_next) {
                    match (option_next) {
                        OptionStructLiteralFieldNode::None {
                            return ResultStructLiteralFieldNodeVec::Err(self.create_parser_error(
                                "Expected struct literal field after comma."
                            ));
                        },
                        OptionStructLiteralFieldNode::Some(next_field) {
                            fields.push(next_field);
                        }
                    }
                }
            }
        }

        return ResultStructLiteralFieldNodeVec::Ok(fields);
    }

    fn parse_struct_literal_field(self): ResultOptionStructLiteralFieldNode {
        # struct_literal_field = identifier, [ ":", expression ];
        match (self.parse_identifier()) {
            ResultOptionIdentifierNode::Err(err) {
                return ResultOptionStructLiteralFieldNode::Err(err);
            },
            ResultOptionIdentifierNode::Ok(option_identifier) {
                match (option_identifier) {
                    OptionIdentifierNode::None {
                        return ResultOptionStructLiteralFieldNode::Ok(OptionStructLiteralFieldNode::None);
                    },
                    OptionIdentifierNode::Some(identifier) {
                        match (self.consume_if_matches(&TokenCategory::Colon)) {
                            ResultOptionToken::Err(err) {
                                return ResultOptionStructLiteralFieldNode::Err(parser_error_from_lexer_error(
                                    &err
                                ));
                            },
                            ResultOptionToken::Ok(option_colon) {
                                if (option_colon matches OptionToken::Some) {
                                    match (self.parse_expression()) {
                                        ResultOptionExpressionNode::Err(err) {
                                            return ResultOptionStructLiteralFieldNode::Err(err);
                                        },
                                        ResultOptionExpressionNode::Ok(option_value) {
                                            match (option_value) {
                                                OptionExpressionNode::None {
                                                    return ResultOptionStructLiteralFieldNode::Err(self.create_parser_error(
                                                        "Expected expression after ':' in struct literal field."
                                                    ));
                                                },
                                                OptionExpressionNode::Some(value) {
                                                    return ResultOptionStructLiteralFieldNode::Ok(OptionStructLiteralFieldNode::Some(StructLiteralFieldNode {
                                                        value: StructLiteralField {
                                                            identifier: identifier,
                                                            value: value
                                                        },
                                                        span: Span.new(
                                                            &identifier.span.start,
                                                            &value.span.end
                                                        )
                                                    }));
                                                }
                                            }
                                        }
                                    }
                                }

                                # No ':' - shorthand `{ x }` field, meaning `{ x: x }`.
                                let shorthand_span = identifier.span;
                                return ResultOptionStructLiteralFieldNode::Ok(OptionStructLiteralFieldNode::Some(StructLiteralFieldNode {
                                    value: StructLiteralField {
                                        identifier: identifier,
                                        value: ExpressionNode {
                                            value: Expression::Variable(identifier.value),
                                            span: shorthand_span
                                        }
                                    },
                                    span: shorthand_span
                                }));
                            }
                        }
                    }
                }
            }
        }
    }
};