import "../../../common/span.rp";
import "../../tokens.rp";
import "../ast.rp";
import "../parser-results.rp";
import "../core.rp";
import "./factor.rp";


extend Parser {
    fn parse_unary_term(self): ResultOptionExpressionNode {
        # unary_term = [ ("-", "!") ], factor;
        let start_position = self.current_token().span.start;

        match (self.consume_if_matches(&TokenCategory::Negate)) {
            ResultOptionToken::Err(err) {
                return ResultOptionExpressionNode::Err(ParserError.from_lexer(&err));
            },
            ResultOptionToken::Ok(has_negate) {
                if (has_negate matches OptionToken::Some) {
                    match (self.parse_factor()) {
                        ResultOptionExpressionNode::Err(err) {
                            return ResultOptionExpressionNode::Err(err);
                        },
                        ResultOptionExpressionNode::Ok(option_factor) {
                            match (option_factor) {
                                OptionExpressionNode::None {
                                    return ResultOptionExpressionNode::Err(self.emit_error(
                                        "Couldn't create factor while parsing unary term."
                                    ));
                                },
                                OptionExpressionNode::Some(factor_node) {
                                    return ResultOptionExpressionNode::Ok(OptionExpressionNode::Some(ExpressionNode {
                                        value: Expression::BooleanNegation(factor_node),
                                        span: Span.new(&start_position, &factor_node.span.end)
                                    }));
                                }
                            }
                        }
                    }
                }
            }
        }

        match (self.consume_if_matches(&TokenCategory::Minus)) {
            ResultOptionToken::Err(err) {
                return ResultOptionExpressionNode::Err(ParserError.from_lexer(&err));
            },
            ResultOptionToken::Ok(has_minus) {
                if (has_minus matches OptionToken::Some) {
                    match (self.parse_factor()) {
                        ResultOptionExpressionNode::Err(err) {
                            return ResultOptionExpressionNode::Err(err);
                        },
                        ResultOptionExpressionNode::Ok(option_factor) {
                            match (option_factor) {
                                OptionExpressionNode::None {
                                    return ResultOptionExpressionNode::Err(self.emit_error(
                                        "Couldn't create factor while parsing unary term."
                                    ));
                                },
                                OptionExpressionNode::Some(factor_node) {
                                    return ResultOptionExpressionNode::Ok(OptionExpressionNode::Some(ExpressionNode {
                                        value: Expression::ArithmeticNegation(factor_node),
                                        span: Span.new(&start_position, &factor_node.span.end)
                                    }));
                                }
                            }
                        }
                    }
                }
            }
        }

        return self.parse_factor();
    }
};
