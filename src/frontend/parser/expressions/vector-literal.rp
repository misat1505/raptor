import "../../../common/span.rp";
import "../../tokens.rp";
import "../ast.rp";
import "../parser-results.rp";
import "../core.rp";
import "./expression.rp";


extend Parser {
    fn parse_vector_literal(self): ResultOptionExpressionNode {
        # vector_literal = "[", [ expression, { ",", expression } ], "]";
        let open_bracket_consumed = self.consume_if_matches(&TokenCategory::BracketOpen);

        let open_bracket_token = self.current_token();
        let has_open_bracket = false;
        match (open_bracket_consumed) {
            ResultOptionToken::Err(err) {
                return ResultOptionExpressionNode::Err(parser_error_from_lexer_error(&err));
            },
            ResultOptionToken::Ok(option_bracket) {
                if (option_bracket matches OptionToken::Some(token)) {
                    open_bracket_token = token;
                    has_open_bracket = true;
                }
            }
        }

        if (!has_open_bracket) {
            return ResultOptionExpressionNode::Ok(OptionExpressionNode::None);
        }

        let expressions: ExpressionNode[] = [];
        match (self.parse_expression()) {
            ResultOptionExpressionNode::Err(err) {
                return ResultOptionExpressionNode::Err(err);
            },
            ResultOptionExpressionNode::Ok(option_expression) {
                if (option_expression matches OptionExpressionNode::Some(first_expression)) {
                    expressions.push(first_expression);

                    while (self.current_token().category matches TokenCategory::Comma) {
                        let comma_consumed = self.consume_must_be(&TokenCategory::Comma);
                        if (comma_consumed matches ResultToken::Err(err)) {
                            return ResultOptionExpressionNode::Err(err);
                        }

                        match (self.parse_expression()) {
                            ResultOptionExpressionNode::Err(err) {
                                return ResultOptionExpressionNode::Err(err);
                            },
                            ResultOptionExpressionNode::Ok(next_option_expression) {
                                match (next_option_expression) {
                                    OptionExpressionNode::None {
                                        return ResultOptionExpressionNode::Err(self.create_parser_error(
                                            "Couldn't create expression while parsing vector literal."
                                        ));
                                    },
                                    OptionExpressionNode::Some(next_expression) {
                                        expressions.push(next_expression);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        match (self.consume_must_be(&TokenCategory::BracketClose)) {
            ResultToken::Err(err) {
                return ResultOptionExpressionNode::Err(err);
            },
            ResultToken::Ok(close_bracket_token) {
                return ResultOptionExpressionNode::Ok(OptionExpressionNode::Some(ExpressionNode {
                    value: Expression::Vector(expressions),
                    span: Span.new(&open_bracket_token.span.start, &close_bracket_token.span.end)
                }));
            }
        }
    }
};
