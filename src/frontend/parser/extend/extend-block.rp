import "../../../semantic-checker/semantic-helpers.rp";


enum OptionExtendBlock {
    Some(ExtendBlock),
    None
};

enum ResultOptionExtendBlock {
    Ok(OptionExtendBlock),
    Err(ParserError)
};


extend Parser {
    fn parse_extend_block(self): ResultOptionExtendBlock {
        let extend_consumed = self.consume_if_matches(&TokenCategory::Extend);

        let has_extend = false;
        match (extend_consumed) {
            ResultOptionToken::Err(err) {
                return ResultOptionExtendBlock::Err(parser_error_from_lexer_error(&err));
            },
            ResultOptionToken::Ok(option_extend) {
                if (option_extend matches OptionToken::Some) {
                    has_extend = true;
                }
            }
        }

        if (!has_extend) {
            return ResultOptionExtendBlock::Ok(OptionExtendBlock::None);
        }

        let type_call = self.parse_type();
        let type_node = TypeNode { value: Type::Void, span: self.current_token().span };
        let found_type = false;
        match (type_call) {
            ResultOptionTypeNode::Err(err) {
                return ResultOptionExtendBlock::Err(err);
            },
            ResultOptionTypeNode::Ok(option_type) {
                if (option_type matches OptionTypeNode::Some(i)) {
                    type_node = i;
                    found_type = true;
                }
            }
        }

        if (!found_type) {
            return ResultOptionExtendBlock::Err(self.create_parser_error(
                "Couldn't create type while parsing extend block declaration."
            ));
        }

        let brace_open = self.consume_must_be(&TokenCategory::BraceOpen);
        if (brace_open matches ResultToken::Err(err)) {
            return ResultOptionExtendBlock::Err(err);
        }

        let methods: TypeMethodNode[] = [];
        while (true) {
            match (self.parse_type_method()) {
                ResultOptionTypeMethodNode::Err(err) {
                    return ResultOptionExtendBlock::Err(err);
                },
                ResultOptionTypeMethodNode::Ok(option_type_method) {
                    match (option_type_method) {
                        OptionTypeMethodNode::Some(type_method_node) {
                            for (let i = 0; i < methods.size(); i += 1) {
                                let method_name = methods[i].value.identifier.value;
                                if (method_name == type_method_node.value.identifier.value) {
                                    return ResultOptionExtendBlock::Err(parser_error_at(
                                        ErrorSeverity::HIGH,
                                        "Redeclaration of method '"
                                            + method_name
                                            + "' on type '"
                                            + type_to_string(type_node.value)
                                            + "'.",
                                        methods[i].value.identifier.span
                                    ));
                                }
                            }
                            methods.push(type_method_node);
                        },
                        OptionTypeMethodNode::None {
                            break;
                        }
                    }
                }
            }
        }

        let brace_close = self.consume_must_be(&TokenCategory::BraceClose);
        if (brace_close matches ResultToken::Err(err)) {
            return ResultOptionExtendBlock::Err(err);
        }

        let semicolon = self.consume_must_be(&TokenCategory::Semicolon);
        if (semicolon matches ResultToken::Err(err)) {
            return ResultOptionExtendBlock::Err(err);
        }

        let extend_block = ExtendBlock { type: type_node, methods };

        return ResultOptionExtendBlock::Ok(OptionExtendBlock::Some(extend_block));
    }
};
