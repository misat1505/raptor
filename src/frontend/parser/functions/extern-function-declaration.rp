import "../../../common/span.rp";
import "../../tokens.rp";
import "../ast.rp";
import "../parser-results.rp";
import "../core.rp";


extend Parser {
    fn parse_extern_function_declaration(self): ResultOptionExternFunctionDeclarationNode {
        # extern_function_declaration = "extern", "fn", identifier, "(", parameters, ")", ":", type | "void", [ "as", identifier ] ";";
        let extern_consumed = self.consume_if_matches(&TokenCategory::Extern);
        let extern_token = self.current_token();

        let has_extern = false;
        match (extern_consumed) {
            ResultOptionToken::Err(err) {
                return ResultOptionExternFunctionDeclarationNode::Err(parser_error_from_lexer_error(
                    &err
                ));
            },
            ResultOptionToken::Ok(option_extern) {
                if (option_extern matches OptionToken::Some(token)) {
                    extern_token = token;
                    has_extern = true;
                }
            }
        }

        if (!has_extern) {
            return ResultOptionExternFunctionDeclarationNode::Ok(OptionExternFunctionDeclarationNode::None);
        }

        if (self.consume_must_be(&TokenCategory::Fn) matches ResultToken::Err(err)) {
            return ResultOptionExternFunctionDeclarationNode::Err(err);
        }

        let identifier_call = self.parse_identifier();
        let identifier = IdentifierNode { value: "", span: self.current_token().span };
        let found_identifier = false;
        match (identifier_call) {
            ResultOptionIdentifierNode::Err(err) {
                return ResultOptionExternFunctionDeclarationNode::Err(err);
            },
            ResultOptionIdentifierNode::Ok(option_identifier) {
                if (option_identifier matches OptionIdentifierNode::Some(i)) {
                    identifier = i;
                    found_identifier = true;
                }
            }
        }

        if (!found_identifier) {
            return ResultOptionExternFunctionDeclarationNode::Err(self.create_parser_error(
                "Couldn't create identifier while parsing extern function declaration."
            ));
        }

        if (self.consume_must_be(&TokenCategory::ParenOpen) matches ResultToken::Err(err)) {
            return ResultOptionExternFunctionDeclarationNode::Err(err);
        }

        let parameters: ParameterNode[] = [];
        match (self.parse_parameters()) {
            ResultParameterNodeVec::Err(err) {
                return ResultOptionExternFunctionDeclarationNode::Err(err);
            },
            ResultParameterNodeVec::Ok(parsed) {
                parameters = parsed;
            }
        }

        let paren_close = self.consume_must_be(&TokenCategory::ParenClose);
        if (paren_close matches ResultToken::Err(err)) {
            return ResultOptionExternFunctionDeclarationNode::Err(err);
        }

        let colon_consumed = self.consume_must_be(&TokenCategory::Colon);
        if (colon_consumed matches ResultToken::Err(err)) {
            return ResultOptionExternFunctionDeclarationNode::Err(err);
        }

        let return_type_call = self.parse_return_type();
        let return_type = TypeNode { value: Type::Void, span: self.current_token().span };
        match (return_type_call) {
            ResultTypeNode::Err(err) {
                return ResultOptionExternFunctionDeclarationNode::Err(err);
            },
            ResultTypeNode::Ok(t) {
                return_type = t;
            }
        }

        let alias = OptionIdentifierNode::None;
        match (self.consume_if_matches(&TokenCategory::As)) {
            ResultOptionToken::Err(err) {
                return ResultOptionExternFunctionDeclarationNode::Err(parser_error_from_lexer_error(
                    &err
                ));
            },
            ResultOptionToken::Ok(option_as) {
                if (option_as matches OptionToken::Some) {
                    match (self.parse_identifier()) {
                        ResultOptionIdentifierNode::Err(err) {
                            return ResultOptionExternFunctionDeclarationNode::Err(err);
                        },
                        ResultOptionIdentifierNode::Ok(option_alias) {
                            match (option_alias) {
                                OptionIdentifierNode::None {
                                    return ResultOptionExternFunctionDeclarationNode::Err(self.create_parser_error(
                                        "Expected identifier after 'as' in extern function declaration."
                                    ));
                                },
                                OptionIdentifierNode::Some(alias_identifier) {
                                    alias = OptionIdentifierNode::Some(alias_identifier);
                                }
                            }
                        }
                    }
                }
            }
        }

        match (self.consume_must_be(&TokenCategory::Semicolon)) {
            ResultToken::Err(err) {
                return ResultOptionExternFunctionDeclarationNode::Err(err);
            },
            ResultToken::Ok(semicolon_token) {
                return ResultOptionExternFunctionDeclarationNode::Ok(OptionExternFunctionDeclarationNode::Some(ExternFunctionDeclarationNode {
                    value: ExternFunctionDeclaration { identifier, alias, parameters, return_type },
                    span: Span.new(&extern_token.span.start, &semicolon_token.span.end)
                }));
            }
        }
    }
};
