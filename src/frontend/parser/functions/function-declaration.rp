import "../../../common/span.rp";
import "../../tokens.rp";
import "../ast.rp";
import "../parser-results.rp";
import "../core.rp";


extend Parser {
    fn parse_return_type(self): ResultTypeNode {
        if (self.parse_type() matches ResultOptionTypeNode::Ok(option_type)) {
            if (option_type matches OptionTypeNode::Some(t)) {
                return ResultTypeNode::Ok(t);
            }
        }

        return self.void_type_or_error();
    }

    fn parse_function_declaration(self): ResultOptionFunctionDeclarationNode {
        # function_declaration = "fn", identifier, "(", parameters, ")", ":", type | "void", statement_block;
        let fn_consumed = self.consume_if_matches(&TokenCategory::Fn);

        let fn_token = self.current_token();
        let has_fn = false;
        match (fn_consumed) {
            ResultOptionToken::Err(err) {
                return ResultOptionFunctionDeclarationNode::Err(ParserError.from_lexer(&err));
            },
            ResultOptionToken::Ok(option_fn) {
                if (option_fn matches OptionToken::Some(token)) {
                    fn_token = token;
                    has_fn = true;
                }
            }
        }

        if (!has_fn) {
            return ResultOptionFunctionDeclarationNode::Ok(OptionFunctionDeclarationNode::None);
        }

        let identifier_call = self.parse_identifier();
        let identifier = IdentifierNode { value: "", span: self.current_token().span };
        let found_identifier = false;
        match (identifier_call) {
            ResultOptionIdentifierNode::Err(err) {
                return ResultOptionFunctionDeclarationNode::Err(err);
            },
            ResultOptionIdentifierNode::Ok(option_identifier) {
                if (option_identifier matches OptionIdentifierNode::Some(i)) {
                    identifier = i;
                    found_identifier = true;
                }
            }
        }

        if (!found_identifier) {
            return ResultOptionFunctionDeclarationNode::Err(self.emit_error(
                "Couldn't create identifier while parsing function declaration."
            ));
        }

        if (self.consume_must_be(&TokenCategory::ParenOpen) matches ResultToken::Err(err)) {
            return ResultOptionFunctionDeclarationNode::Err(err);
        }

        let parameters: ParameterNode[] = [];
        match (self.parse_parameters()) {
            ResultParameterNodeVec::Err(err) {
                return ResultOptionFunctionDeclarationNode::Err(err);
            },
            ResultParameterNodeVec::Ok(parsed) {
                parameters = parsed;
            }
        }

        if (self.consume_must_be(&TokenCategory::ParenClose) matches ResultToken::Err(err)) {
            return ResultOptionFunctionDeclarationNode::Err(err);
        }

        if (self.consume_must_be(&TokenCategory::Colon) matches ResultToken::Err(err)) {
            return ResultOptionFunctionDeclarationNode::Err(err);
        }

        let return_type_call = self.parse_return_type();
        let return_type = TypeNode { value: Type::Void, span: self.current_token().span };
        match (return_type_call) {
            ResultTypeNode::Err(err) {
                return ResultOptionFunctionDeclarationNode::Err(err);
            },
            ResultTypeNode::Ok(t) {
                return_type = t;
            }
        }

        match (self.parse_statement_block()) {
            ResultOptionBlockNode::Err(err) {
                return ResultOptionFunctionDeclarationNode::Err(err);
            },
            ResultOptionBlockNode::Ok(option_block) {
                match (option_block) {
                    OptionBlockNode::None {
                        return ResultOptionFunctionDeclarationNode::Err(self.emit_error(
                            "Couldn't create statement block while parsing function declaration."
                        ));
                    },
                    OptionBlockNode::Some(block) {
                        return ResultOptionFunctionDeclarationNode::Ok(OptionFunctionDeclarationNode::Some(FunctionDeclarationNode {
                            value: FunctionDeclaration {
                                identifier,
                                parameters,
                                return_type,
                                block
                            },
                            span: Span.new(&fn_token.span.start, &block.span.end)
                        }));
                    }
                }
            }
        }
    }
};

# Shared by `parse_function_declaration` and
# `parse_extern_function_declaration`: mirrors Rust's
# `match self.parse_type() { Ok(Some(t)) => t, _ => self.void_type_or_error()? }`
# - note that this deliberately swallows any `Err` from `parse_type` too
# (the `_` arm), falling back to `void_type_or_error` (which produces its
# own, more specific error) instead of propagating it.
