import "../../../common/span.rp";
import "../../tokens.rp";
import "../ast.rp";
import "../parser-results.rp";
import "../core.rp";


extend Parser {
    fn parse_parameters(self): ResultParameterNodeVec {
        # parameters = [ parameter, { ",", parameter } ];
        let parameters: ParameterNode[] = [];

        match (self.parse_parameter()) {
            ResultOptionParameterNode::Err(err) {
                return ResultParameterNodeVec::Err(err);
            },
            ResultOptionParameterNode::Ok(option_first) {
                match (option_first) {
                    OptionParameterNode::None {
                        return ResultParameterNodeVec::Ok(parameters);
                    },
                    OptionParameterNode::Some(first) {
                        parameters.push(first);
                    }
                }
            }
        }

        while (true) {
            let has_comma = false;
            match (self.consume_if_matches(&TokenCategory::Comma)) {
                ResultOptionToken::Err(err) {
                    return ResultParameterNodeVec::Err(parser_error_from_lexer_error(&err));
                },
                ResultOptionToken::Ok(option_comma) {
                    if (option_comma matches OptionToken::Some) {
                        has_comma = true;
                    }
                }
            }

            if (!has_comma) {
                break;
            }

            match (self.parse_parameter()) {
                ResultOptionParameterNode::Err(err) {
                    return ResultParameterNodeVec::Err(err);
                },
                ResultOptionParameterNode::Ok(option_next) {
                    match (option_next) {
                        OptionParameterNode::None {
                            return ResultParameterNodeVec::Err(self.create_parser_error(
                                "Couldn't create parameter while parsing parameters."
                            ));
                        },
                        OptionParameterNode::Some(next) {
                            parameters.push(next);
                        }
                    }
                }
            }
        }

        return ResultParameterNodeVec::Ok(parameters);
    }

    fn parse_parameter(self): ResultOptionParameterNode {
        # parameter = ["&"], type, identifier;
        let start_position = self.current_token().span.start;

        let passed_by = PassedBy::Value;
        match (self.consume_if_matches(&TokenCategory::Reference)) {
            ResultOptionToken::Err(err) {
                return ResultOptionParameterNode::Err(parser_error_from_lexer_error(&err));
            },
            ResultOptionToken::Ok(option_reference) {
                if (option_reference matches OptionToken::Some) {
                    passed_by = PassedBy::Reference;
                }
            }
        }

        let type_call = self.parse_type();
        let parameter_type = TypeNode { value: Type::Void, span: self.current_token().span };
        let found_type = false;
        match (type_call) {
            ResultOptionTypeNode::Err(err) {
                return ResultOptionParameterNode::Err(err);
            },
            ResultOptionTypeNode::Ok(option_type) {
                if (option_type matches OptionTypeNode::Some(t)) {
                    parameter_type = t;
                    found_type = true;
                }
            }
        }

        if (!found_type) {
            return ResultOptionParameterNode::Ok(OptionParameterNode::None);
        }

        match (self.parse_identifier()) {
            ResultOptionIdentifierNode::Err(err) {
                return ResultOptionParameterNode::Err(err);
            },
            ResultOptionIdentifierNode::Ok(option_identifier) {
                match (option_identifier) {
                    OptionIdentifierNode::None {
                        return ResultOptionParameterNode::Err(self.create_parser_error(
                            "Couldn't create identifier while parsing parameter."
                        ));
                    },
                    OptionIdentifierNode::Some(identifier) {
                        return ResultOptionParameterNode::Ok(OptionParameterNode::Some(ParameterNode {
                            value: Parameter { passed_by, parameter_type, identifier },
                            span: Span.new(&start_position, &identifier.span.end)
                        }));
                    }
                }
            }
        }
    }
};
