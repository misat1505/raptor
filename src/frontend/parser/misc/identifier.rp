import "../../../common/errors.rp";
import "../../tokens.rp";
import "../ast.rp";
import "../parser-results.rp";
import "../core.rp";


extend Parser {
    fn parse_identifier(self): ResultOptionIdentifierNode {
        let consumed = self.consume_must_be(&TokenCategory::Identifier);

        let token = Token {
            category: TokenCategory::Identifier,
            value: TokenValue::Null,
            span: self.current_token().span
        };
        match (consumed) {
            ResultToken::Err {
                return ResultOptionIdentifierNode::Ok(OptionIdentifierNode::None);
            },
            ResultToken::Ok(t) {
                token = t;
            }
        }

        if (token.value matches TokenValue::String(name)) {
            return ResultOptionIdentifierNode::Ok(OptionIdentifierNode::Some(IdentifierNode {
                value: name,
                span: token.span
            }));
        }

        return ResultOptionIdentifierNode::Err(ParserError.expected_found(
            ErrorSeverity::HIGH,
            "Wrong token value type",
            "str",
            token.category.to_string(),
            token.span
        ));
    }
};
