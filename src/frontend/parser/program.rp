import "../../common/span.rp";
import "../../common/errors.rp";
import "../tokens.rp";
import "./ast.rp";
import "./parser-results.rp";
import "./core.rp";


extend Parser {
    fn parse_statement(self): ResultOptionStatementNode {
        match (self.parse_assign_or_call()) {
            ResultOptionStatementNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionStatementNode::Ok(option_statement) {
                if (option_statement matches OptionStatementNode::Some) {
                    return ResultOptionStatementNode::Ok(option_statement);
                }
            }
        }

        match (self.parse_if_statement()) {
            ResultOptionStatementNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionStatementNode::Ok(option_statement) {
                if (option_statement matches OptionStatementNode::Some) {
                    return ResultOptionStatementNode::Ok(option_statement);
                }
            }
        }

        match (self.parse_for_statement()) {
            ResultOptionStatementNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionStatementNode::Ok(option_statement) {
                if (option_statement matches OptionStatementNode::Some) {
                    return ResultOptionStatementNode::Ok(option_statement);
                }
            }
        }

        match (self.parse_while_statement()) {
            ResultOptionStatementNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionStatementNode::Ok(option_statement) {
                if (option_statement matches OptionStatementNode::Some) {
                    return ResultOptionStatementNode::Ok(option_statement);
                }
            }
        }

        match (self.parse_switch_statement()) {
            ResultOptionStatementNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionStatementNode::Ok(option_statement) {
                if (option_statement matches OptionStatementNode::Some) {
                    return ResultOptionStatementNode::Ok(option_statement);
                }
            }
        }

        match (self.parse_return_statement()) {
            ResultOptionStatementNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionStatementNode::Ok(option_statement) {
                if (option_statement matches OptionStatementNode::Some) {
                    return ResultOptionStatementNode::Ok(option_statement);
                }
            }
        }

        match (self.parse_break_statement()) {
            ResultOptionStatementNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionStatementNode::Ok(option_statement) {
                if (option_statement matches OptionStatementNode::Some) {
                    return ResultOptionStatementNode::Ok(option_statement);
                }
            }
        }

        match (self.parse_continue_statement()) {
            ResultOptionStatementNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionStatementNode::Ok(option_statement) {
                if (option_statement matches OptionStatementNode::Some) {
                    return ResultOptionStatementNode::Ok(option_statement);
                }
            }
        }

        match (self.parse_let_variable_declaration()) {
            ResultOptionStatementNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionStatementNode::Ok(option_statement) {
                if (option_statement matches OptionStatementNode::Some) {
                    return ResultOptionStatementNode::Ok(option_statement);
                }
            }
        }

        return self.parse_match_statement();
    }

    fn parse_program_statement(self): ResultOptionStatementNode {
        # program_statement = import_declaration | assign_or_call | if_statement | for_statement | while_statement
        #                    | switch_statement | (declaration, ";") | let_declaration | match_statement;
        match (self.parse_assign_or_call()) {
            ResultOptionStatementNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionStatementNode::Ok(option_statement) {
                if (option_statement matches OptionStatementNode::Some) {
                    return ResultOptionStatementNode::Ok(option_statement);
                }
            }
        }

        match (self.parse_if_statement()) {
            ResultOptionStatementNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionStatementNode::Ok(option_statement) {
                if (option_statement matches OptionStatementNode::Some) {
                    return ResultOptionStatementNode::Ok(option_statement);
                }
            }
        }

        match (self.parse_for_statement()) {
            ResultOptionStatementNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionStatementNode::Ok(option_statement) {
                if (option_statement matches OptionStatementNode::Some) {
                    return ResultOptionStatementNode::Ok(option_statement);
                }
            }
        }

        match (self.parse_while_statement()) {
            ResultOptionStatementNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionStatementNode::Ok(option_statement) {
                if (option_statement matches OptionStatementNode::Some) {
                    return ResultOptionStatementNode::Ok(option_statement);
                }
            }
        }

        match (self.parse_switch_statement()) {
            ResultOptionStatementNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionStatementNode::Ok(option_statement) {
                if (option_statement matches OptionStatementNode::Some) {
                    return ResultOptionStatementNode::Ok(option_statement);
                }
            }
        }

        match (self.parse_let_variable_declaration()) {
            ResultOptionStatementNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionStatementNode::Ok(option_statement) {
                if (option_statement matches OptionStatementNode::Some) {
                    return ResultOptionStatementNode::Ok(option_statement);
                }
            }
        }

        match (self.parse_import_declaration()) {
            ResultOptionStatementNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionStatementNode::Ok(option_statement) {
                if (option_statement matches OptionStatementNode::Some) {
                    return ResultOptionStatementNode::Ok(option_statement);
                }
            }
        }

        return self.parse_match_statement();
    }

    fn check_name_collision(
        str name,
        &Span span,
        &FunctionDeclarationNode[] functions,
        &ExternFunctionDeclarationNode[] extern_functions,
        &DeclaredTypeNode[] declared_types
    ): ResultUnit {
        for (let i = 0; i < functions.size(); i += 1) {
            if (functions[i].value.identifier.value == name) {
                return ResultUnit::Err(ParserError.new(
                    ErrorSeverity::HIGH,
                    "Redeclaration of '" + name + "'.",
                    span
                ));
            }
        }

        for (let i = 0; i < extern_functions.size(); i += 1) {
            let declaration = extern_functions[i];
            let effective_name = declaration.value.identifier.value;
            if (declaration.value.alias matches OptionIdentifierNode::Some(alias)) {
                effective_name = alias.value;
            }

            if (effective_name == name) {
                return ResultUnit::Err(ParserError.new(
                    ErrorSeverity::HIGH,
                    "Redeclaration of '" + name + "'.",
                    span
                ));
            }
        }

        for (let i = 0; i < declared_types.size(); i += 1) {
            let declared_name = "";
            match (declared_types[i].value) {
                DeclaredType::Struct(struct_declaration) {
                    declared_name = struct_declaration.identifier.value;
                },
                DeclaredType::Enum(enum_declaration) {
                    declared_name = enum_declaration.identifier.value;
                }
            }

            if (declared_name == name) {
                return ResultUnit::Err(ParserError.new(
                    ErrorSeverity::HIGH,
                    "Redeclaration of '" + name + "'.",
                    span
                ));
            }
        }

        return ResultUnit::Ok;
    }

    fn parse_program(self): ResultProgram {
        # program = { import_declaration | struct_declaration | enum_declaration | function_declaration | extern_function_declaration
        #           | assign_or_call | if_statement | for_statement | while_statement | switch_statement
        #           | declaration, ";" };
        let statements: StatementNode[] = [];
        let functions: FunctionDeclarationNode[] = [];
        let extern_functions: ExternFunctionDeclarationNode[] = [];
        let declared_types: DeclaredTypeNode[] = [];
        let extend_blocks: ExtendBlock[] = [];
        let interfaces: InterfaceDeclarationNode[] = [];

        while (true) {
            match (self.parse_interface_declaration()) {
                ResultOptionInterfaceDeclaration::Err(err) {
                    return ResultProgram::Err(err);
                },
                ResultOptionInterfaceDeclaration::Ok(option_interface_declaration) {
                    if (
                        option_interface_declaration matches OptionInterfaceDeclaration::Some(interface_declaration)
                    ) {
                        interfaces.push(interface_declaration);
                        continue;
                    }
                }
            }

            match (self.parse_extend_block()) {
                ResultOptionExtendBlock::Err(err) {
                    return ResultProgram::Err(err);
                },
                ResultOptionExtendBlock::Ok(option_extend_block) {
                    if (option_extend_block matches OptionExtendBlock::Some(extend_block)) {
                        extend_blocks.push(extend_block);
                        continue;
                    }
                }
            }

            match (self.parse_struct_declaration()) {
                ResultOptionStructDeclarationNode::Err(err) {
                    return ResultProgram::Err(err);
                },
                ResultOptionStructDeclarationNode::Ok(option_struct) {
                    if (
                        option_struct matches OptionStructDeclarationNode::Some(struct_declaration)
                    ) {
                        let type_name = struct_declaration.value.identifier.value;

                        let collision = Parser.check_name_collision(
                            type_name,
                            &struct_declaration.span,
                            &functions,
                            &extern_functions,
                            &declared_types
                        );
                        if (collision matches ResultUnit::Err(err)) {
                            return ResultProgram::Err(err);
                        }

                        declared_types.push(
                            DeclaredTypeNode {
                                value: DeclaredType::Struct(struct_declaration.value),
                                span: struct_declaration.span
                            }
                        );

                        continue;
                    }
                }
            }

            match (self.parse_enum_declaration()) {
                ResultOptionEnumDeclarationNode::Err(err) {
                    return ResultProgram::Err(err);
                },
                ResultOptionEnumDeclarationNode::Ok(option_enum) {
                    if (option_enum matches OptionEnumDeclarationNode::Some(enum_declaration)) {
                        let type_name = enum_declaration.value.identifier.value;

                        let collision = Parser.check_name_collision(
                            type_name,
                            &enum_declaration.span,
                            &functions,
                            &extern_functions,
                            &declared_types
                        );
                        if (collision matches ResultUnit::Err(err)) {
                            return ResultProgram::Err(err);
                        }

                        declared_types.push(
                            DeclaredTypeNode {
                                value: DeclaredType::Enum(enum_declaration.value),
                                span: enum_declaration.span
                            }
                        );

                        continue;
                    }
                }
            }

            match (self.parse_program_statement()) {
                ResultOptionStatementNode::Err(err) {
                    return ResultProgram::Err(err);
                },
                ResultOptionStatementNode::Ok(option_statement) {
                    if (option_statement matches OptionStatementNode::Some(statement)) {
                        statements.push(statement);
                        continue;
                    }
                }
            }

            match (self.parse_function_declaration()) {
                ResultOptionFunctionDeclarationNode::Err(err) {
                    return ResultProgram::Err(err);
                },
                ResultOptionFunctionDeclarationNode::Ok(option_function) {
                    if (
                        option_function matches OptionFunctionDeclarationNode::Some(function_declaration)
                    ) {
                        let function_name = function_declaration.value.identifier.value;

                        let collision = Parser.check_name_collision(
                            function_name,
                            &function_declaration.span,
                            &functions,
                            &extern_functions,
                            &declared_types
                        );
                        if (collision matches ResultUnit::Err(err)) {
                            return ResultProgram::Err(err);
                        }

                        functions.push(function_declaration);

                        continue;
                    }
                }
            }

            match (self.parse_extern_function_declaration()) {
                ResultOptionExternFunctionDeclarationNode::Err(err) {
                    return ResultProgram::Err(err);
                },
                ResultOptionExternFunctionDeclarationNode::Ok(option_extern_function) {
                    if (
                        option_extern_function matches OptionExternFunctionDeclarationNode::Some(extern_function_declaration)
                    ) {
                        let function_name = extern_function_declaration.value.identifier.value;
                        if (
                            extern_function_declaration.value.alias matches OptionIdentifierNode::Some(alias)
                        ) {
                            function_name = alias.value;
                        }

                        let collision = Parser.check_name_collision(
                            function_name,
                            &extern_function_declaration.span,
                            &functions,
                            &extern_functions,
                            &declared_types
                        );
                        if (collision matches ResultUnit::Err(err)) {
                            return ResultProgram::Err(err);
                        }

                        extern_functions.push(extern_function_declaration);

                        continue;
                    }
                }
            }

            break;
        }

        let etx_consumed = self.consume_must_be(&TokenCategory::ETX);
        if (etx_consumed matches ResultToken::Err(err)) {
            return ResultProgram::Err(err);
        }

        return ResultProgram::Ok(Program {
            statements,
            functions,
            extern_functions,
            declared_types,
            extend_blocks,
            interfaces
        });
    }

    fn parse(self): ResultProgram {
        return self.parse_program();
    }
};
