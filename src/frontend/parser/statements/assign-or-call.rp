import "../../../common/span.rp";
import "../../tokens.rp";
import "../ast.rp";
import "../parser-results.rp";
import "../core.rp";


extend Parser {
    fn build_access_expression(
        &IdentifierNode identifier,
        &AccessorNode[] accessors
    ): ExpressionNode {
        let result = ExpressionNode {
            value: Expression::Variable(identifier.value),
            span: identifier.span
        };

        for (let i = 0; i < accessors.size(); i += 1) {
            let accessor = accessors[i];
            let accessor_span = Span.new(&result.span.start, &accessor.span.end);

            match (accessor.value) {
                Accessor::Index(index) {
                    result = ExpressionNode {
                        value: Expression::Index(IndexExpression { collection: result, index }),
                        span: accessor_span
                    };
                },
                Accessor::Field(field) {
                    result = ExpressionNode {
                        value: Expression::FieldAccess(FieldAccessExpression {
                            instance: result,
                            field
                        }),
                        span: accessor_span
                    };
                },
                Accessor::MethodCall(method_node) {
                    let method = method_node.value;
                    result = ExpressionNode {
                        value: Expression::MethodCall(MethodCallExpression {
                            instance: result,
                            target: method.target,
                            field: method.field,
                            arguments: method.arguments
                        }),
                        span: accessor_span
                    };
                }
            }
        }

        return result;
    }

    fn parse_assign_or_call(self): ResultOptionStatementNode {
        # assign_or_call = identifier, ( { access_tail }, ("=" | "+=" | "-=" | "*=" | "/=" | "%="), expression | "(", arguments, ")"), ";";
        match (self.parse_assign_or_call_without_semicolon()) {
            ResultOptionStatementNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionStatementNode::Ok(option_node) {
                match (option_node) {
                    OptionStatementNode::None {
                        return ResultOptionStatementNode::Ok(OptionStatementNode::None);
                    },
                    OptionStatementNode::Some(n) {
                        let semicolon_consumed = self.consume_must_be(&TokenCategory::Semicolon);
                        match (semicolon_consumed) {
                            ResultToken::Err(err) {
                                return ResultOptionStatementNode::Err(err);
                            },
                            ResultToken::Ok(semicolon_token) {
                                return ResultOptionStatementNode::Ok(OptionStatementNode::Some(StatementNode {
                                    value: n.value,
                                    span: Span.new(&n.span.start, &semicolon_token.span.end)
                                }));
                            }
                        }
                    }
                }
            }
        }
    }

    fn parse_assign_or_call_without_semicolon(self): ResultOptionStatementNode {
        # assign_or_call = identifier, ( { access_tail }, ("=" | "+=" | "-=" | "*=" | "/=" | "%="), expression | "(", arguments, ")");
        match (self.parse_identifier()) {
            ResultOptionIdentifierNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionIdentifierNode::Ok(option_identifier) {
                match (option_identifier) {
                    OptionIdentifierNode::None {
                        return ResultOptionStatementNode::Ok(OptionStatementNode::None);
                    },
                    OptionIdentifierNode::Some(identifier) {
                        let identifier_start = identifier.span.start;
                        let accessors: AccessorNode[] = [];
                        let is_expression_like = false;

                        while (true) {
                            let current_category = self.current_token().category;

                            if (current_category matches TokenCategory::BracketOpen) {
                                let bracket_open_consumed = self.consume_must_be(
                                    &TokenCategory::BracketOpen
                                );
                                let bracket_open_token = self.current_token();
                                match (bracket_open_consumed) {
                                    ResultToken::Err(err) {
                                        return ResultOptionStatementNode::Err(err);
                                    },
                                    ResultToken::Ok(token) {
                                        bracket_open_token = token;
                                    }
                                }

                                match (self.parse_expression()) {
                                    ResultOptionExpressionNode::Err(err) {
                                        return ResultOptionStatementNode::Err(err);
                                    },
                                    ResultOptionExpressionNode::Ok(option_index) {
                                        match (option_index) {
                                            OptionExpressionNode::None {
                                                return ResultOptionStatementNode::Err(self.emit_error(
                                                    "Expected an expression inside '[]' index."
                                                ));
                                            },
                                            OptionExpressionNode::Some(index_expression) {
                                                let bracket_close_consumed = self.consume_must_be(
                                                    &TokenCategory::BracketClose
                                                );
                                                match (bracket_close_consumed) {
                                                    ResultToken::Err(err) {
                                                        return ResultOptionStatementNode::Err(err);
                                                    },
                                                    ResultToken::Ok(bracket_close_token) {
                                                        accessors.push(
                                                            AccessorNode {
                                                                value: Accessor::Index(index_expression),
                                                                span: Span.new(
                                                                    &bracket_open_token.span.start,
                                                                    &bracket_close_token.span.end
                                                                )
                                                            }
                                                        );
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            } else if (current_category matches TokenCategory::Dot) {
                                let dot_consumed = self.consume_must_be(&TokenCategory::Dot);
                                let dot_token = self.current_token();
                                match (dot_consumed) {
                                    ResultToken::Err(err) {
                                        return ResultOptionStatementNode::Err(err);
                                    },
                                    ResultToken::Ok(token) {
                                        dot_token = token;
                                    }
                                }

                                match (self.parse_identifier()) {
                                    ResultOptionIdentifierNode::Err(err) {
                                        return ResultOptionStatementNode::Err(err);
                                    },
                                    ResultOptionIdentifierNode::Ok(option_field) {
                                        match (option_field) {
                                            OptionIdentifierNode::None {
                                                return ResultOptionStatementNode::Err(self.emit_error(
                                                    "Expected an identifier after '.'."
                                                ));
                                            },
                                            OptionIdentifierNode::Some(field) {
                                                current_category = self.current_token().category;
                                                if (
                                                    current_category matches TokenCategory::ParenOpen
                                                ) {
                                                    self.consume_must_be(&TokenCategory::ParenOpen);
                                                    match (self.parse_arguments()) {
                                                        ResultArgumentNodeVec::Err(err) {
                                                            return ResultOptionStatementNode::Err(err);
                                                        },
                                                        ResultArgumentNodeVec::Ok(args) {
                                                            is_expression_like = true;
                                                            let end_pos = field.span.end;
                                                            match (
                                                                self.consume_must_be(
                                                                    &TokenCategory::ParenClose
                                                                )
                                                            ) {
                                                                ResultToken::Err(err) {
                                                                    return ResultOptionStatementNode::Err(err);
                                                                },
                                                                ResultToken::Ok(paren_close_token) {
                                                                    end_pos =
                                                                        paren_close_token.span.end;
                                                                }
                                                            }

                                                            let method_call = MethodCallAccessor {
                                                                instance: ExpressionNode {
                                                                    value: Expression::Variable(""),
                                                                    span: field.span
                                                                },
                                                                target: MethodCallTarget::Unresolved,
                                                                field,
                                                                arguments: args
                                                            };

                                                            let node = MethodCallAccessorNode {
                                                                value: method_call,
                                                                span: Span.new(
                                                                    &dot_token.span.start,
                                                                    &end_pos
                                                                )
                                                            };

                                                            accessors.push(
                                                                AccessorNode {
                                                                    value: Accessor::MethodCall(node),
                                                                    span: Span.new(
                                                                        &dot_token.span.start,
                                                                        &end_pos
                                                                    )
                                                                }
                                                            );
                                                        }
                                                    }
                                                } else {
                                                    accessors.push(
                                                        AccessorNode {
                                                            value: Accessor::Field(field),
                                                            span: span_new(
                                                                dot_token.span.start,
                                                                field.span.end
                                                            )
                                                        }
                                                    );
                                                }
                                            }
                                        }
                                    }
                                }
                            } else {
                                break;
                            }
                        }

                        # "=" - plain assignment.
                        match (self.consume_if_matches(&TokenCategory::Assign)) {
                            ResultOptionToken::Err(err) {
                                return ResultOptionStatementNode::Err(ParserError.from_lexer(&err));
                            },
                            ResultOptionToken::Ok(option_assign) {
                                if (option_assign matches OptionToken::Some) {
                                    if (is_expression_like) {
                                        return ResultOptionStatementNode::Err(self.emit_error(
                                            "Cannot assign a value to expression like statement."
                                        ));
                                    }
                                    match (self.parse_expression()) {
                                        ResultOptionExpressionNode::Err(err) {
                                            return ResultOptionStatementNode::Err(err);
                                        },
                                        ResultOptionExpressionNode::Ok(option_expr) {
                                            match (option_expr) {
                                                OptionExpressionNode::None {
                                                    return ResultOptionStatementNode::Err(self.emit_error(
                                                        "Couldn't create expression while parsing assignment."
                                                    ));
                                                },
                                                OptionExpressionNode::Some(expr) {
                                                    return ResultOptionStatementNode::Ok(OptionStatementNode::Some(StatementNode {
                                                        value: Statement::Assignment(AssignmentStatement {
                                                            identifier,
                                                            accessors,
                                                            value: expr
                                                        }),
                                                        span: Span.new(
                                                            &identifier_start,
                                                            &expr.span.end
                                                        )
                                                    }));
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        # "+=" | "-=" | "*=" | "/=" | "%=" - compound assignment.
                        let compound_category = TokenCategory::Assign;
                        let has_compound = false;

                        if (self.current_token().category matches TokenCategory::PlusEquals) {
                            compound_category = TokenCategory::PlusEquals;
                            has_compound = true;
                        } else if (
                            self.current_token().category matches TokenCategory::MinusEquals
                        ) {
                            compound_category = TokenCategory::MinusEquals;
                            has_compound = true;
                        } else if (
                            self.current_token().category matches TokenCategory::TimesEquals
                        ) {
                            compound_category = TokenCategory::TimesEquals;
                            has_compound = true;
                        } else if (
                            self.current_token().category matches TokenCategory::DivideEquals
                        ) {
                            compound_category = TokenCategory::DivideEquals;
                            has_compound = true;
                        } else if (
                            self.current_token().category matches TokenCategory::ModuloEquals
                        ) {
                            compound_category = TokenCategory::ModuloEquals;
                            has_compound = true;
                        }

                        if (has_compound) {
                            if (is_expression_like) {
                                return ResultOptionStatementNode::Err(self.emit_error(
                                    "Cannot assign a value to expression like statement."
                                ));
                            }
                            let operator_consumed = self.consume_must_be(&compound_category);
                            if (operator_consumed matches ResultToken::Err(err)) {
                                return ResultOptionStatementNode::Err(err);
                            }

                            match (self.parse_expression()) {
                                ResultOptionExpressionNode::Err(err) {
                                    return ResultOptionStatementNode::Err(err);
                                },
                                ResultOptionExpressionNode::Ok(option_rhs) {
                                    match (option_rhs) {
                                        OptionExpressionNode::None {
                                            return ResultOptionStatementNode::Err(self.emit_error(
                                                "Couldn't create expression while parsing assignment."
                                            ));
                                        },
                                        OptionExpressionNode::Some(rhs) {
                                            let left = Parser.build_access_expression(
                                                &identifier,
                                                &accessors
                                            );
                                            let operands = BinaryExpression { left, right: rhs };

                                            let combined_value = Expression::Addition(operands);
                                            match (compound_category) {
                                                TokenCategory::PlusEquals {
                                                    combined_value = Expression::Addition(operands);
                                                },
                                                TokenCategory::MinusEquals {
                                                    combined_value = Expression::Subtraction(operands);
                                                },
                                                TokenCategory::TimesEquals {
                                                    combined_value = Expression::Multiplication(operands);
                                                },
                                                TokenCategory::DivideEquals {
                                                    combined_value = Expression::Division(operands);
                                                },
                                                TokenCategory::ModuloEquals {
                                                    combined_value = Expression::Modulo(operands);
                                                },
                                                rest {}
                                            }

                                            let combined_node = ExpressionNode {
                                                value: combined_value,
                                                span: Span.new(&left.span.start, &rhs.span.end)
                                            };

                                            return ResultOptionStatementNode::Ok(OptionStatementNode::Some(StatementNode {
                                                value: Statement::Assignment(AssignmentStatement {
                                                    identifier,
                                                    accessors,
                                                    value: combined_node
                                                }),
                                                span: Span.new(
                                                    &identifier_start,
                                                    &combined_node.span.end
                                                )
                                            }));
                                        }
                                    }
                                }
                            }
                        }

                        if (is_expression_like) {
                            let expr = Parser.build_access_expression(&identifier, &accessors);
                            return ResultOptionStatementNode::Ok(OptionStatementNode::Some(StatementNode {
                                value: Statement::Expression(expr),
                                span: Span.new(&identifier_start, &expr.span.end)
                            }));
                        }

                        # "(" arguments ")" - function call.
                        match (self.consume_if_matches(&TokenCategory::ParenOpen)) {
                            ResultOptionToken::Err(err) {
                                return ResultOptionStatementNode::Err(ParserError.from_lexer(&err));
                            },
                            ResultOptionToken::Ok(option_paren) {
                                if (option_paren matches OptionToken::Some) {
                                    if (accessors.size() > 0) {
                                        return ResultOptionStatementNode::Err(self.emit_error(
                                            "Can't parse method call as statement."
                                        ));
                                    }
                                    let arguments: ArgumentNode[] = [];
                                    match (self.parse_arguments()) {
                                        ResultArgumentNodeVec::Err(err) {
                                            return ResultOptionStatementNode::Err(err);
                                        },
                                        ResultArgumentNodeVec::Ok(parsed_arguments) {
                                            arguments = parsed_arguments;
                                        }
                                    }

                                    match (self.consume_must_be(&TokenCategory::ParenClose)) {
                                        ResultToken::Err(err) {
                                            return ResultOptionStatementNode::Err(err);
                                        },
                                        ResultToken::Ok(close_token) {
                                            return ResultOptionStatementNode::Ok(OptionStatementNode::Some(StatementNode {
                                                value: Statement::FunctionCall(FunctionCallExpression {
                                                    identifier,
                                                    arguments
                                                }),
                                                span: Span.new(
                                                    &identifier_start,
                                                    &close_token.span.end
                                                )
                                            }));
                                        }
                                    }
                                }
                            }
                        }

                        return ResultOptionStatementNode::Err(self.emit_error(
                            "Couldn't create assignment or call."
                        ));
                    }
                }
            }
        }
    }
};
