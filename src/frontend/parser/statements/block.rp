import "../../../common/span.rp";
import "../../tokens.rp";
import "../ast.rp";
import "../parser-results.rp";
import "../core.rp";


extend Parser {
    fn parse_statement_block(self): ResultOptionBlockNode {
        # statement_block = ("{", {statement}, "}") | statement;

        match (self.parse_statement()) {
            ResultOptionStatementNode::Err(err) {
                return ResultOptionBlockNode::Err(err);
            },
            ResultOptionStatementNode::Ok(option_statement) {
                if (option_statement matches OptionStatementNode::Some(single_statement)) {
                    return ResultOptionBlockNode::Ok(OptionBlockNode::Some(BlockNode {
                        value: Block { statements: [single_statement] },
                        span: single_statement.span
                    }));
                }
            }
        }

        let open_brace_consumed = self.consume_if_matches(&TokenCategory::BraceOpen);
        let open_brace_token = self.current_token();
        let has_open_brace = false;
        match (open_brace_consumed) {
            ResultOptionToken::Err(err) {
                return ResultOptionBlockNode::Err(ParserError.from_lexer(&err));
            },
            ResultOptionToken::Ok(option_brace) {
                if (option_brace matches OptionToken::Some(token)) {
                    open_brace_token = token;
                    has_open_brace = true;
                }
            }
        }

        if (!has_open_brace) {
            return ResultOptionBlockNode::Ok(OptionBlockNode::None);
        }

        let statements: StatementNode[] = [];
        let closing_brace_token = open_brace_token;

        while (true) {
            let closed = false;
            match (self.consume_if_matches(&TokenCategory::BraceClose)) {
                ResultOptionToken::Err(err) {
                    return ResultOptionBlockNode::Err(ParserError.from_lexer(&err));
                },
                ResultOptionToken::Ok(option_close) {
                    if (option_close matches OptionToken::Some(close_token)) {
                        closing_brace_token = close_token;
                        closed = true;
                    }
                }
            }

            if (closed) {
                break;
            }

            match (self.parse_statement()) {
                ResultOptionStatementNode::Err(err) {
                    return ResultOptionBlockNode::Err(err);
                },
                ResultOptionStatementNode::Ok(option_statement) {
                    match (option_statement) {
                        OptionStatementNode::None {
                            return ResultOptionBlockNode::Err(self.emit_error(
                                "Couldn't create statement while parsing statement block."
                            ));
                        },
                        OptionStatementNode::Some(statement) {
                            statements.push(statement);
                        }
                    }
                }
            }
        }

        return ResultOptionBlockNode::Ok(OptionBlockNode::Some(BlockNode {
            value: Block { statements },
            span: Span.new(&open_brace_token.span.start, &closing_brace_token.span.end)
        }));
    }
};
