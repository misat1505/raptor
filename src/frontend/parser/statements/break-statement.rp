import "../../../common/span.rp";
import "../../tokens.rp";
import "../ast.rp";
import "../parser-results.rp";
import "../core.rp";


extend Parser {
    fn parse_break_statement(self): ResultOptionStatementNode {
        # break_statement = "break", ";";
        let break_consumed = self.consume_if_matches(&TokenCategory::Break);

        let break_token = self.current_token();
        let has_break = false;
        match (break_consumed) {
            ResultOptionToken::Err(err) {
                return ResultOptionStatementNode::Err(ParserError.from_lexer(&err));
            },
            ResultOptionToken::Ok(option_break) {
                if (option_break matches OptionToken::Some(token)) {
                    break_token = token;
                    has_break = true;
                }
            }
        }

        if (!has_break) {
            return ResultOptionStatementNode::Ok(OptionStatementNode::None);
        }

        match (self.consume_must_be(&TokenCategory::Semicolon)) {
            ResultToken::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultToken::Ok(semicolon_token) {
                return ResultOptionStatementNode::Ok(OptionStatementNode::Some(StatementNode {
                    value: Statement::Break,
                    span: Span.new(&break_token.span.start, &semicolon_token.span.end)
                }));
            }
        }
    }
};
