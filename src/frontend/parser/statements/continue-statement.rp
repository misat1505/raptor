import "../../../common/span.rp";
import "../../tokens.rp";
import "../ast.rp";
import "../parser-results.rp";
import "../core.rp";


extend Parser {
    fn parse_continue_statement(self): ResultOptionStatementNode {
        # continue_statement = "continue", ";";
        let continue_consumed = self.consume_if_matches(&TokenCategory::Continue);

        let continue_token = self.current_token();
        let has_continue = false;
        match (continue_consumed) {
            ResultOptionToken::Err(err) {
                return ResultOptionStatementNode::Err(ParserError.from_lexer(&err));
            },
            ResultOptionToken::Ok(option_continue) {
                if (option_continue matches OptionToken::Some(token)) {
                    continue_token = token;
                    has_continue = true;
                }
            }
        }

        if (!has_continue) {
            return ResultOptionStatementNode::Ok(OptionStatementNode::None);
        }

        match (self.consume_must_be(&TokenCategory::Semicolon)) {
            ResultToken::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultToken::Ok(semicolon_token) {
                return ResultOptionStatementNode::Ok(OptionStatementNode::Some(StatementNode {
                    value: Statement::Continue,
                    span: Span.new(&continue_token.span.start, &semicolon_token.span.end)
                }));
            }
        }
    }
};
