import "../../../common/span.rp";
import "../../tokens.rp";
import "../ast.rp";
import "../parser-results.rp";
import "../core.rp";


extend Parser {
    fn parse_let_declaration(self): ResultOptionStatementNode {
        # let_declaration = let, identifier, [ ":", type ], "=", expression;
        let let_consumed = self.consume_if_matches(&TokenCategory::Let);

        let let_token = self.current_token();
        let has_let = false;
        match (let_consumed) {
            ResultOptionToken::Err(err) {
                return ResultOptionStatementNode::Err(ParserError.from_lexer(&err));
            },
            ResultOptionToken::Ok(option_let) {
                if (option_let matches OptionToken::Some(token)) {
                    let_token = token;
                    has_let = true;
                }
            }
        }

        if (!has_let) {
            return ResultOptionStatementNode::Ok(OptionStatementNode::None);
        }

        let identifier_call = self.parse_identifier();
        let identifier = IdentifierNode { value: "", span: self.current_token().span };
        let found_identifier = false;
        match (identifier_call) {
            ResultOptionIdentifierNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionIdentifierNode::Ok(option_identifier) {
                if (option_identifier matches OptionIdentifierNode::Some(i)) {
                    identifier = i;
                    found_identifier = true;
                }
            }
        }

        if (!found_identifier) {
            return ResultOptionStatementNode::Err(self.emit_error(
                "Couldn't create identifier while parsing variable declaration."
            ));
        }

        let var_type = OptionTypeNode::None;

        if (self.current_token().category matches TokenCategory::Colon) {
            if (self.consume_must_be(&TokenCategory::Colon) matches ResultToken::Err(err)) {
                return ResultOptionStatementNode::Err(err);
            }

            match (self.parse_type()) {
                ResultOptionTypeNode::Err(err) {
                    return ResultOptionStatementNode::Err(err);
                },
                ResultOptionTypeNode::Ok(option_type) {
                    match (option_type) {
                        OptionTypeNode::None {
                            return ResultOptionStatementNode::Err(self.emit_error(
                                "Couldn't create type while parsing let declaration."
                            ));
                        },
                        OptionTypeNode::Some(t) {
                            var_type = OptionTypeNode::Some(t);
                        }
                    }
                }
            }
        }

        if (self.consume_must_be(&TokenCategory::Assign) matches ResultToken::Err(err)) {
            return ResultOptionStatementNode::Err(err);
        }

        match (self.parse_expression()) {
            ResultOptionExpressionNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionExpressionNode::Ok(option_expr) {
                match (option_expr) {
                    OptionExpressionNode::None {
                        return ResultOptionStatementNode::Err(self.emit_error(
                            "Couldn't parse expression while parsing variable declaration."
                        ));
                    },
                    OptionExpressionNode::Some(value) {
                        return ResultOptionStatementNode::Ok(OptionStatementNode::Some(StatementNode {
                            value: Statement::Declaration(DeclarationStatement {
                                identifier,
                                var_type,
                                value
                            }),
                            span: Span.new(&let_token.span.start, &value.span.end)
                        }));
                    }
                }
            }
        }
    }

    fn parse_let_variable_declaration(self): ResultOptionStatementNode {
        # let_variable_declaration = let, identifier, [ ":", type ], "=", expression, ";";
        match (self.parse_let_declaration()) {
            ResultOptionStatementNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionStatementNode::Ok(option_declaration) {
                match (option_declaration) {
                    OptionStatementNode::None {
                        return ResultOptionStatementNode::Ok(OptionStatementNode::None);
                    },
                    OptionStatementNode::Some(declaration) {
                        match (self.consume_must_be(&TokenCategory::Semicolon)) {
                            ResultToken::Err(err) {
                                return ResultOptionStatementNode::Err(err);
                            },
                            ResultToken::Ok(semicolon_token) {
                                return ResultOptionStatementNode::Ok(OptionStatementNode::Some(StatementNode {
                                    value: declaration.value,
                                    span: Span.new(
                                        &declaration.span.start,
                                        &semicolon_token.span.end
                                    )
                                }));
                            }
                        }
                    }
                }
            }
        }
    }
};
