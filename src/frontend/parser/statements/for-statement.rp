import "../../../common/span.rp";
import "../../tokens.rp";
import "../ast.rp";
import "../parser-results.rp";
import "../core.rp";


extend Parser {
    fn parse_for_statement(self): ResultOptionStatementNode {
        # for_statement = "for", "(", [ declaration | let_declaration ], ";", expression, ";", [ identifier, "=", expression ], ")", statement_block;
        let for_consumed = self.consume_if_matches(&TokenCategory::For);

        let for_token = self.current_token();
        let has_for = false;
        match (for_consumed) {
            ResultOptionToken::Err(err) {
                return ResultOptionStatementNode::Err(parser_error_from_lexer_error(&err));
            },
            ResultOptionToken::Ok(option_for) {
                if (option_for matches OptionToken::Some(token)) {
                    for_token = token;
                    has_for = true;
                }
            }
        }

        if (!has_for) {
            return ResultOptionStatementNode::Ok(OptionStatementNode::None);
        }

        if (self.consume_must_be(&TokenCategory::ParenOpen) matches ResultToken::Err(err)) {
            return ResultOptionStatementNode::Err(err);
        }

        let declaration = OptionStatementNode::None;
        if (self.current_token().category matches TokenCategory::Let) {
            match (self.parse_let_declaration()) {
                ResultOptionStatementNode::Err(err) {
                    return ResultOptionStatementNode::Err(err);
                },
                ResultOptionStatementNode::Ok(option_decl) {
                    declaration = option_decl;
                }
            }
        }

        if (self.consume_must_be(&TokenCategory::Semicolon) matches ResultToken::Err(err)) {
            return ResultOptionStatementNode::Err(err);
        }

        let condition_call = self.parse_expression();
        let condition = ExpressionNode {
            value: Expression::Literal(Literal::True),
            span: self.current_token().span
        };
        let found_condition = false;
        match (condition_call) {
            ResultOptionExpressionNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionExpressionNode::Ok(option_condition) {
                if (option_condition matches OptionExpressionNode::Some(expr)) {
                    condition = expr;
                    found_condition = true;
                }
            }
        }

        if (!found_condition) {
            return ResultOptionStatementNode::Err(self.create_parser_error(
                "Couldn't create expression while parsing for statement."
            ));
        }

        if (self.consume_must_be(&TokenCategory::Semicolon) matches ResultToken::Err(err)) {
            return ResultOptionStatementNode::Err(err);
        }

        let assignment = OptionStatementNode::None;
        if (self.current_token().category matches TokenCategory::Identifier) {
            match (self.parse_assign_or_call_without_semicolon()) {
                ResultOptionStatementNode::Err(err) {
                    return ResultOptionStatementNode::Err(err);
                },
                ResultOptionStatementNode::Ok(option_assignment) {
                    match (option_assignment) {
                        OptionStatementNode::None {
                            return ResultOptionStatementNode::Err(self.create_parser_error(
                                "Couldn't create assignment or call while parsing for statement."
                            ));
                        },
                        OptionStatementNode::Some(assignment_statement) {
                            assignment = OptionStatementNode::Some(assignment_statement);
                        }
                    }
                }
            }
        }

        if (self.consume_must_be(&TokenCategory::ParenClose) matches ResultToken::Err(err)) {
            return ResultOptionStatementNode::Err(err);
        }

        match (self.parse_statement_block()) {
            ResultOptionBlockNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionBlockNode::Ok(option_block) {
                match (option_block) {
                    OptionBlockNode::None {
                        return ResultOptionStatementNode::Err(self.create_parser_error(
                            "Couldn't create statement block while parsing for statement."
                        ));
                    },
                    OptionBlockNode::Some(block) {
                        return ResultOptionStatementNode::Ok(OptionStatementNode::Some(StatementNode {
                            value: Statement::ForLoop(ForLoopStatement {
                                declaration: declaration,
                                condition: condition,
                                assignment: assignment,
                                block: block
                            }),
                            span: Span.new(&for_token.span.start, &block.span.end)
                        }));
                    }
                }
            }
        }
    }
};
