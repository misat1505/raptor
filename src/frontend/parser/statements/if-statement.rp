import "../../../common/span.rp";
import "../../../common/position.rp";
import "../../../common/errors.rp";
import "../../tokens.rp";
import "../ast.rp";
import "../parser-results.rp";
import "../core.rp";


extend Parser {
    fn parse_if_statement(self): ResultOptionStatementNode {
        # if_statement = "if", "(", expression,
        #      ( ( ")", statement_block ) |
        #      ( [ "not" ], "matches", match_arm_without_block, ")", statement_block ) ),
        # [ "else", statement_block ];
        let if_consumed = self.consume_if_matches(&TokenCategory::If);

        let if_token = self.current_token();
        let has_if = false;
        match (if_consumed) {
            ResultOptionToken::Err(err) {
                return ResultOptionStatementNode::Err(parser_error_from_lexer_error(&err));
            },
            ResultOptionToken::Ok(option_if) {
                if (option_if matches OptionToken::Some(token)) {
                    if_token = token;
                    has_if = true;
                }
            }
        }

        if (!has_if) {
            return ResultOptionStatementNode::Ok(OptionStatementNode::None);
        }

        if (self.consume_must_be(&TokenCategory::ParenOpen) matches ResultToken::Err(err)) {
            return ResultOptionStatementNode::Err(err);
        }

        let condition_call = self.parse_expression();
        let condition = ExpressionNode {
            value: Expression::Literal(Literal::True),
            span: self.current_token().span
        };
        let found_condition = false;
        match (condition_call) {
            ResultOptionExpressionNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionExpressionNode::Ok(option_condition) {
                if (option_condition matches OptionExpressionNode::Some(expr)) {
                    condition = expr;
                    found_condition = true;
                }
            }
        }

        if (!found_condition) {
            return ResultOptionStatementNode::Err(self.create_parser_error(
                "Couldn't create expression while parsing if statement."
            ));
        }

        match (self.consume_if_matches(&TokenCategory::ParenClose)) {
            ResultOptionToken::Err(err) {
                return ResultOptionStatementNode::Err(parser_error_from_lexer_error(&err));
            },
            ResultOptionToken::Ok(option_close) {
                if (option_close matches OptionToken::None) {
                    return self.finish_if_matches_statement(&condition, &if_token.span.start);
                }
            }
        }

        let true_block_call = self.parse_statement_block();
        let true_block = Parser.while_synthetic_break_block(condition.span);
        let found_true_block = false;
        match (true_block_call) {
            ResultOptionBlockNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionBlockNode::Ok(option_true_block) {
                if (option_true_block matches OptionBlockNode::Some(block)) {
                    true_block = block;
                    found_true_block = true;
                }
            }
        }

        if (!found_true_block) {
            return ResultOptionStatementNode::Err(self.create_parser_error(
                "Couldn't create statement block while parsing if statement."
            ));
        }

        let false_block = OptionBlockNode::None;
        match (self.consume_if_matches(&TokenCategory::Else)) {
            ResultOptionToken::Err(err) {
                return ResultOptionStatementNode::Err(parser_error_from_lexer_error(&err));
            },
            ResultOptionToken::Ok(option_else) {
                if (option_else matches OptionToken::Some) {
                    match (self.parse_statement_block()) {
                        ResultOptionBlockNode::Err(err) {
                            return ResultOptionStatementNode::Err(err);
                        },
                        ResultOptionBlockNode::Ok(option_false_block) {
                            false_block = option_false_block;
                        }
                    }
                }
            }
        }

        let end_position = true_block.span.end;
        if (false_block matches OptionBlockNode::Some(block)) {
            end_position = block.span.end;
        }

        return ResultOptionStatementNode::Ok(OptionStatementNode::Some(StatementNode {
            value: Statement::Conditional(ConditionalStatement {
                condition: condition,
                if_block: true_block,
                else_block: false_block
            }),
            span: Span.new(&if_token.span.start, &end_position)
        }));
    }

    fn finish_if_matches_statement(
        self,
        &ExpressionNode condition,
        &Position start_position
    ): ResultOptionStatementNode {
        let is_negating = false;
        match (self.consume_if_matches(&TokenCategory::Not)) {
            ResultOptionToken::Err(err) {
                return ResultOptionStatementNode::Err(parser_error_from_lexer_error(&err));
            },
            ResultOptionToken::Ok(option_not) {
                if (option_not matches OptionToken::Some) {
                    is_negating = true;
                }
            }
        }

        if (self.consume_must_be(&TokenCategory::Matches) matches ResultToken::Err(err)) {
            return ResultOptionStatementNode::Err(err);
        }

        let arm_call = self.parse_match_arm_without_block();
        let arm = MatchArmNode {
            value: MatchArm {
                enum_name: IdentifierNode { value: "", span: condition.span },
                variant_name: IdentifierNode { value: "", span: condition.span },
                variant_value: OptionIdentifierNode::None,
                block: Parser.while_synthetic_break_block(condition.span)
            },
            span: condition.span
        };
        let found_arm = false;
        match (arm_call) {
            ResultOptionMatchArmNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionMatchArmNode::Ok(option_arm) {
                if (option_arm matches OptionMatchArmNode::Some(parsed_arm)) {
                    arm = parsed_arm;
                    found_arm = true;
                }
            }
        }

        if (!found_arm) {
            return ResultOptionStatementNode::Err(self.create_parser_error(
                "Couldn't create match arm while parsing if-matches statement."
            ));
        }

        if (self.consume_must_be(&TokenCategory::ParenClose) matches ResultToken::Err(err)) {
            return ResultOptionStatementNode::Err(err);
        }

        let match_block_call = self.parse_statement_block();
        let match_block = Parser.while_synthetic_break_block(condition.span);
        let found_match_block = false;
        match (match_block_call) {
            ResultOptionBlockNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionBlockNode::Ok(option_match_block) {
                if (option_match_block matches OptionBlockNode::Some(block)) {
                    match_block = block;
                    found_match_block = true;
                }
            }
        }

        if (!found_match_block) {
            return ResultOptionStatementNode::Err(self.create_parser_error(
                "Couldn't create statement block while parsing if-matches statement."
            ));
        }

        let has_else = false;
        match (self.consume_if_matches(&TokenCategory::Else)) {
            ResultOptionToken::Err(err) {
                return ResultOptionStatementNode::Err(parser_error_from_lexer_error(&err));
            },
            ResultOptionToken::Ok(option_else) {
                if (option_else matches OptionToken::Some) {
                    has_else = true;
                }
            }
        }

        let rest_block = BlockNode {
            value: Block { statements: [] },
            span: Span.new(&match_block.span.end, &match_block.span.end)
        };

        if (has_else) {
            let found_rest_block = false;
            match (self.parse_statement_block()) {
                ResultOptionBlockNode::Err(err) {
                    return ResultOptionStatementNode::Err(err);
                },
                ResultOptionBlockNode::Ok(option_rest_block) {
                    if (option_rest_block matches OptionBlockNode::Some(block)) {
                        rest_block = block;
                        found_rest_block = true;
                    }
                }
            }

            if (!found_rest_block) {
                return ResultOptionStatementNode::Err(self.create_parser_error(
                    "Couldn't create statement block while parsing if-matches else statement."
                ));
            }
        }

        if (is_negating) {
            arm.value.block = rest_block;

            if (arm.value.variant_value matches OptionIdentifierNode::Some(var_val)) {
                return ResultOptionStatementNode::Err(parser_error_at(
                    ErrorSeverity::HIGH,
                    "Cannot take the inner value of enum variant in if-not-matches statement.",
                    var_val.span
                ));
            }

            return ResultOptionStatementNode::Ok(OptionStatementNode::Some(StatementNode {
                value: Statement::Match(MatchStatement {
                    expression: condition,
                    match_arms: [arm],
                    rest_arm: OptionBlockNode::Some(match_block)
                }),
                span: Span.new(&start_position, &rest_block.span.end)
            }));
        }

        arm.value.block = match_block;

        return ResultOptionStatementNode::Ok(OptionStatementNode::Some(StatementNode {
            value: Statement::Match(MatchStatement {
                expression: condition,
                match_arms: [arm],
                rest_arm: OptionBlockNode::Some(rest_block)
            }),
            span: Span.new(&start_position, &rest_block.span.end)
        }));
    }
};
