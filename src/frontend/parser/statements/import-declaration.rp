import "../../../common/span.rp";
import "../../tokens.rp";
import "../ast.rp";
import "../parser-results.rp";
import "../core.rp";


extend Parser {
    fn parse_import_declaration(self): ResultOptionStatementNode {
        # import_declaration = "import", literal, ";";
        let import_consumed = self.consume_if_matches(&TokenCategory::Import);

        let import_token = self.current_token();
        let has_import = false;
        match (import_consumed) {
            ResultOptionToken::Err(err) {
                return ResultOptionStatementNode::Err(parser_error_from_lexer_error(&err));
            },
            ResultOptionToken::Ok(option_import) {
                if (option_import matches OptionToken::Some(token)) {
                    import_token = token;
                    has_import = true;
                }
            }
        }

        if (!has_import) {
            return ResultOptionStatementNode::Ok(OptionStatementNode::None);
        }

        let literal_call = self.parse_literal();
        let import_literal = LiteralNode {
            value: Literal::True,
            span: self.current_token().span
        };
        let found_literal = false;
        match (literal_call) {
            ResultOptionLiteralNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionLiteralNode::Ok(option_literal) {
                if (option_literal matches OptionLiteralNode::Some(literal)) {
                    import_literal = literal;
                    found_literal = true;
                }
            }
        }

        if (!found_literal) {
            return ResultOptionStatementNode::Err(self.create_parser_error(
                "Couldn't create literal while parsing import declaration."
            ));
        }

        let import_path = "";
        if (import_literal.value matches Literal::String(path)) {
            import_path = path;
        } else {
            return ResultOptionStatementNode::Err(self.create_parser_error(
                "Import path must be a string literal."
            ));
        }

        match (self.consume_must_be(&TokenCategory::Semicolon)) {
            ResultToken::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultToken::Ok(semicolon_token) {
                return ResultOptionStatementNode::Ok(OptionStatementNode::Some(StatementNode {
                    value: Statement::Import(IdentifierNode {
                        value: import_path,
                        span: import_literal.span
                    }),
                    span: Span.new(&import_token.span.start, &semicolon_token.span.end)
                }));
            }
        }
    }
};
