import "../../../common/span.rp";
import "../../tokens.rp";
import "../ast.rp";
import "../parser-results.rp";
import "../core.rp";


extend Parser {
    fn parse_match_statement(self): ResultOptionStatementNode {
        # match_statement = "match", "(", expression, ")", "{", match_arms, [ ",", rest_arm ], "}";
        let match_consumed = self.consume_if_matches(&TokenCategory::Match);

        let match_token = self.current_token();
        let has_match = false;
        match (match_consumed) {
            ResultOptionToken::Err(err) {
                return ResultOptionStatementNode::Err(parser_error_from_lexer_error(&err));
            },
            ResultOptionToken::Ok(option_match) {
                if (option_match matches OptionToken::Some(token)) {
                    match_token = token;
                    has_match = true;
                }
            }
        }

        if (!has_match) {
            return ResultOptionStatementNode::Ok(OptionStatementNode::None);
        }

        if (self.consume_must_be(&TokenCategory::ParenOpen) matches ResultToken::Err(err)) {
            return ResultOptionStatementNode::Err(err);
        }

        let expression_call = self.parse_expression();
        let expression = ExpressionNode {
            value: Expression::Literal(Literal::True),
            span: self.current_token().span
        };
        let found_expression = false;
        match (expression_call) {
            ResultOptionExpressionNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionExpressionNode::Ok(option_expression) {
                if (option_expression matches OptionExpressionNode::Some(expr)) {
                    expression = expr;
                    found_expression = true;
                }
            }
        }

        if (!found_expression) {
            return ResultOptionStatementNode::Err(self.create_parser_error(
                "Expected an expression after 'match ('."
            ));
        }

        let paren_close = self.consume_must_be(&TokenCategory::ParenClose);
        if (paren_close matches ResultToken::Err(err)) {
            return ResultOptionStatementNode::Err(err);
        }

        let brace_open = self.consume_must_be(&TokenCategory::BraceOpen);
        if (brace_open matches ResultToken::Err(err)) {
            return ResultOptionStatementNode::Err(err);
        }

        let match_arms: MatchArmNode[] = [];
        match (self.parse_match_arms()) {
            ResultMatchArmNodeVec::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultMatchArmNodeVec::Ok(arms) {
                match_arms = arms;
            }
        }

        let rest_arm = OptionBlockNode::None;
        if (self.current_token().category matches TokenCategory::Rest) {
            match (self.parse_rest_arm_block()) {
                ResultOptionBlockNode::Err(err) {
                    return ResultOptionStatementNode::Err(err);
                },
                ResultOptionBlockNode::Ok(option_rest) {
                    match (option_rest) {
                        OptionBlockNode::None {
                            return ResultOptionStatementNode::Err(self.create_parser_error(
                                "Expected a block after 'rest'."
                            ));
                        },
                        OptionBlockNode::Some(rest_block) {
                            rest_arm = OptionBlockNode::Some(rest_block);
                        }
                    }
                }
            }
        }

        match (self.consume_must_be(&TokenCategory::BraceClose)) {
            ResultToken::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultToken::Ok(close_token) {
                return ResultOptionStatementNode::Ok(OptionStatementNode::Some(StatementNode {
                    value: Statement::Match(MatchStatement { expression, match_arms, rest_arm }),
                    span: Span.new(&match_token.span.start, &close_token.span.end)
                }));
            }
        }
    }

    fn parse_match_arms(self): ResultMatchArmNodeVec {
        # match_arms = [ match_arm, { ",", match_arm } ];
        let match_arms: MatchArmNode[] = [];

        if (self.current_token().category matches TokenCategory::BraceClose) {
            return ResultMatchArmNodeVec::Ok(match_arms);
        }
        if (self.current_token().category matches TokenCategory::Rest) {
            return ResultMatchArmNodeVec::Ok(match_arms);
        }

        match (self.parse_match_arm()) {
            ResultOptionMatchArmNode::Err(err) {
                return ResultMatchArmNodeVec::Err(err);
            },
            ResultOptionMatchArmNode::Ok(option_first) {
                match (option_first) {
                    OptionMatchArmNode::None {
                        return ResultMatchArmNodeVec::Err(self.create_parser_error(
                            "Expected a match arm."
                        ));
                    },
                    OptionMatchArmNode::Some(first_arm) {
                        match_arms.push(first_arm);
                    }
                }
            }
        }

        while (true) {
            if (self.current_token().category matches TokenCategory::BraceClose) {
                break;
            }

            let comma_consumed = self.consume_must_be(&TokenCategory::Comma);
            if (comma_consumed matches ResultToken::Err(err)) {
                return ResultMatchArmNodeVec::Err(err);
            }

            if (self.current_token().category matches TokenCategory::Rest) {
                break;
            }

            match (self.parse_match_arm()) {
                ResultOptionMatchArmNode::Err(err) {
                    return ResultMatchArmNodeVec::Err(err);
                },
                ResultOptionMatchArmNode::Ok(option_next) {
                    match (option_next) {
                        OptionMatchArmNode::None {
                            return ResultMatchArmNodeVec::Err(self.create_parser_error(
                                "Expected a match arm after ','."
                            ));
                        },
                        OptionMatchArmNode::Some(next_arm) {
                            match_arms.push(next_arm);
                        }
                    }
                }
            }
        }

        return ResultMatchArmNodeVec::Ok(match_arms);
    }

    fn parse_match_arm(self): ResultOptionMatchArmNode {
        # match_arm = identifier, "::", identifier, [ "(", identifier, ")" ], statement_block;
        let start_position = self.current_token().span.start;

        let enum_name_call = self.parse_identifier();
        let enum_name = IdentifierNode { value: "", span: self.current_token().span };
        let found_enum_name = false;
        match (enum_name_call) {
            ResultOptionIdentifierNode::Err(err) {
                return ResultOptionMatchArmNode::Err(err);
            },
            ResultOptionIdentifierNode::Ok(option_name) {
                if (option_name matches OptionIdentifierNode::Some(name)) {
                    enum_name = name;
                    found_enum_name = true;
                }
            }
        }

        if (!found_enum_name) {
            return ResultOptionMatchArmNode::Ok(OptionMatchArmNode::None);
        }

        if (self.consume_must_be(&TokenCategory::DoubleColon) matches ResultToken::Err(err)) {
            return ResultOptionMatchArmNode::Err(err);
        }

        let variant_name_call = self.parse_identifier();
        let variant_name = IdentifierNode { value: "", span: self.current_token().span };
        let found_variant_name = false;
        match (variant_name_call) {
            ResultOptionIdentifierNode::Err(err) {
                return ResultOptionMatchArmNode::Err(err);
            },
            ResultOptionIdentifierNode::Ok(option_name) {
                if (option_name matches OptionIdentifierNode::Some(name)) {
                    variant_name = name;
                    found_variant_name = true;
                }
            }
        }

        if (!found_variant_name) {
            return ResultOptionMatchArmNode::Err(self.create_parser_error(
                "Expected an enum variant name in match arm."
            ));
        }

        let variant_value = OptionIdentifierNode::None;

        match (self.consume_if_matches(&TokenCategory::ParenOpen)) {
            ResultOptionToken::Err(err) {
                return ResultOptionMatchArmNode::Err(parser_error_from_lexer_error(&err));
            },
            ResultOptionToken::Ok(option_paren) {
                if (option_paren matches OptionToken::Some) {
                    match (self.parse_identifier()) {
                        ResultOptionIdentifierNode::Err(err) {
                            return ResultOptionMatchArmNode::Err(err);
                        },
                        ResultOptionIdentifierNode::Ok(option_value) {
                            match (option_value) {
                                OptionIdentifierNode::None {
                                    return ResultOptionMatchArmNode::Err(self.create_parser_error(
                                        "Expected an identifier inside match arm."
                                    ));
                                },
                                OptionIdentifierNode::Some(value) {
                                    variant_value = OptionIdentifierNode::Some(value);
                                }
                            }
                        }
                    }

                    if (
                        self.consume_must_be(
                            &TokenCategory::ParenClose
                        ) matches ResultToken::Err(err)
                    ) {
                        return ResultOptionMatchArmNode::Err(err);
                    }
                }
            }
        }

        match (self.parse_statement_block()) {
            ResultOptionBlockNode::Err(err) {
                return ResultOptionMatchArmNode::Err(err);
            },
            ResultOptionBlockNode::Ok(option_block) {
                match (option_block) {
                    OptionBlockNode::None {
                        return ResultOptionMatchArmNode::Err(self.create_parser_error(
                            "Expected a block after match arm."
                        ));
                    },
                    OptionBlockNode::Some(block) {
                        return ResultOptionMatchArmNode::Ok(OptionMatchArmNode::Some(MatchArmNode {
                            value: MatchArm { enum_name, variant_name, variant_value, block },
                            span: Span.new(&start_position, &block.span.end)
                        }));
                    }
                }
            }
        }
    }

    fn parse_match_arm_without_block(self): ResultOptionMatchArmNode {
        # match_arm = identifier, "::", identifier, [ "(", identifier, ")" ];
        let start_position = self.current_token().span.start;

        let enum_name_call = self.parse_identifier();
        let enum_name = IdentifierNode { value: "", span: self.current_token().span };
        let found_enum_name = false;
        match (enum_name_call) {
            ResultOptionIdentifierNode::Err(err) {
                return ResultOptionMatchArmNode::Err(err);
            },
            ResultOptionIdentifierNode::Ok(option_name) {
                if (option_name matches OptionIdentifierNode::Some(name)) {
                    enum_name = name;
                    found_enum_name = true;
                }
            }
        }

        if (!found_enum_name) {
            return ResultOptionMatchArmNode::Ok(OptionMatchArmNode::None);
        }

        if (self.consume_must_be(&TokenCategory::DoubleColon) matches ResultToken::Err(err)) {
            return ResultOptionMatchArmNode::Err(err);
        }

        let variant_name_call = self.parse_identifier();
        let variant_name = IdentifierNode { value: "", span: self.current_token().span };
        let found_variant_name = false;
        match (variant_name_call) {
            ResultOptionIdentifierNode::Err(err) {
                return ResultOptionMatchArmNode::Err(err);
            },
            ResultOptionIdentifierNode::Ok(option_name) {
                if (option_name matches OptionIdentifierNode::Some(name)) {
                    variant_name = name;
                    found_variant_name = true;
                }
            }
        }

        if (!found_variant_name) {
            return ResultOptionMatchArmNode::Err(self.create_parser_error(
                "Expected an enum variant name in match arm."
            ));
        }

        let variant_value = OptionIdentifierNode::None;
        let end_position = variant_name.span.end;

        match (self.consume_if_matches(&TokenCategory::ParenOpen)) {
            ResultOptionToken::Err(err) {
                return ResultOptionMatchArmNode::Err(parser_error_from_lexer_error(&err));
            },
            ResultOptionToken::Ok(option_paren) {
                if (option_paren matches OptionToken::Some) {
                    match (self.parse_identifier()) {
                        ResultOptionIdentifierNode::Err(err) {
                            return ResultOptionMatchArmNode::Err(err);
                        },
                        ResultOptionIdentifierNode::Ok(option_value) {
                            match (option_value) {
                                OptionIdentifierNode::None {
                                    return ResultOptionMatchArmNode::Err(self.create_parser_error(
                                        "Expected an identifier inside match arm."
                                    ));
                                },
                                OptionIdentifierNode::Some(value) {
                                    variant_value = OptionIdentifierNode::Some(value);
                                }
                            }
                        }
                    }

                    match (self.consume_must_be(&TokenCategory::ParenClose)) {
                        ResultToken::Err(err) {
                            return ResultOptionMatchArmNode::Err(err);
                        },
                        ResultToken::Ok(close_token) {
                            end_position = close_token.span.end;
                        }
                    }
                }
            }
        }

        let whole_span = Span.new(&start_position, &end_position);

        return ResultOptionMatchArmNode::Ok(OptionMatchArmNode::Some(MatchArmNode {
            value: MatchArm {
                enum_name,
                variant_name,
                variant_value,
                block: BlockNode { value: Block { statements: [] }, span: whole_span }
            },
            span: whole_span
        }));
    }

    fn parse_rest_arm_block(self): ResultOptionBlockNode {
        # rest_arm = "rest", statement_block;
        if (self.consume_must_be(&TokenCategory::Rest) matches ResultToken::Err(err)) {
            return ResultOptionBlockNode::Err(err);
        }

        return self.parse_statement_block();
    }
};

# Used by if/while "matches" sugar - a match arm whose block is still empty
# (filled in by the caller afterwards).
