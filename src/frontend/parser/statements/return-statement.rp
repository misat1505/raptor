import "../../../common/span.rp";
import "../../tokens.rp";
import "../ast.rp";
import "../parser-results.rp";
import "../core.rp";


extend Parser {
    fn parse_return_statement(self): ResultOptionStatementNode {
        # return_statement = "return", [ expression ], ";";
        let return_consumed = self.consume_if_matches(&TokenCategory::Return);

        let return_token = self.current_token();
        let has_return = false;
        match (return_consumed) {
            ResultOptionToken::Err(err) {
                return ResultOptionStatementNode::Err(ParserError.from_lexer(&err));
            },
            ResultOptionToken::Ok(option_return) {
                if (option_return matches OptionToken::Some(token)) {
                    return_token = token;
                    has_return = true;
                }
            }
        }

        if (!has_return) {
            return ResultOptionStatementNode::Ok(OptionStatementNode::None);
        }

        let returned_value = OptionExpressionNode::None;
        match (self.parse_expression()) {
            ResultOptionExpressionNode::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultOptionExpressionNode::Ok(option_expr) {
                returned_value = option_expr;
            }
        }

        match (self.consume_must_be(&TokenCategory::Semicolon)) {
            ResultToken::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultToken::Ok(semicolon_token) {
                return ResultOptionStatementNode::Ok(OptionStatementNode::Some(StatementNode {
                    value: Statement::Return(returned_value),
                    span: Span.new(&return_token.span.start, &semicolon_token.span.end)
                }));
            }
        }
    }
};
