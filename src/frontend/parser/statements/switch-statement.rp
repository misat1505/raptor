import "../../../common/span.rp";
import "../../tokens.rp";
import "../ast.rp";
import "../parser-results.rp";
import "../core.rp";
import "../expressions/expression.rp";
import "../misc/identifier.rp";
import "./block.rp";


extend Parser {
    fn parse_switch_statement(self): ResultOptionStatementNode {
        # switch_statement = "switch", "(", switch_expressions, ")", "{", {switch_case}, "}";
        let switch_consumed = self.consume_if_matches(&TokenCategory::Switch);

        let switch_token = self.current_token();
        let has_switch = false;
        match (switch_consumed) {
            ResultOptionToken::Err(err) {
                return ResultOptionStatementNode::Err(parser_error_from_lexer_error(&err));
            },
            ResultOptionToken::Ok(option_switch) {
                if (option_switch matches OptionToken::Some(token)) {
                    switch_token = token;
                    has_switch = true;
                }
            }
        }

        if (!has_switch) {
            return ResultOptionStatementNode::Ok(OptionStatementNode::None);
        }

        if (self.consume_must_be(&TokenCategory::ParenOpen) matches ResultToken::Err(err)) {
            return ResultOptionStatementNode::Err(err);
        }

        let switch_expressions: SwitchExpressionNode[] = [];
        match (self.parse_switch_expressions()) {
            ResultSwitchExpressionNodeVec::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultSwitchExpressionNodeVec::Ok(parsed) {
                switch_expressions = parsed;
            }
        }

        if (self.consume_must_be(&TokenCategory::ParenClose) matches ResultToken::Err(err)) {
            return ResultOptionStatementNode::Err(err);
        }

        if (self.consume_must_be(&TokenCategory::BraceOpen) matches ResultToken::Err(err)) {
            return ResultOptionStatementNode::Err(err);
        }

        let switch_cases: SwitchCaseNode[] = [];

        while (self.current_token().category not matches TokenCategory::BraceClose) {
            match (self.parse_switch_case()) {
                ResultOptionSwitchCaseNode::Err(err) {
                    return ResultOptionStatementNode::Err(err);
                },
                ResultOptionSwitchCaseNode::Ok(option_case) {
                    match (option_case) {
                        OptionSwitchCaseNode::None {
                            return ResultOptionStatementNode::Err(self.create_parser_error(
                                "Couldn't create switch case while parsing switch statement."
                            ));
                        },
                        OptionSwitchCaseNode::Some(switch_case) {
                            switch_cases.push(switch_case);
                        }
                    }
                }
            }
        }

        match (self.consume_must_be(&TokenCategory::BraceClose)) {
            ResultToken::Err(err) {
                return ResultOptionStatementNode::Err(err);
            },
            ResultToken::Ok(close_token) {
                return ResultOptionStatementNode::Ok(OptionStatementNode::Some(StatementNode {
                    value: Statement::Switch(SwitchStatement {
                        expressions: switch_expressions,
                        cases: switch_cases
                    }),
                    span: Span.new(&switch_token.span.start, &close_token.span.end)
                }));
            }
        }
    }

    fn parse_switch_expressions(self): ResultSwitchExpressionNodeVec {
        # switch_expressions = switch_expression, { ",", switch_expression };
        let switch_expressions: SwitchExpressionNode[] = [];

        match (self.parse_switch_expression()) {
            ResultOptionSwitchExpressionNode::Err(err) {
                return ResultSwitchExpressionNodeVec::Err(err);
            },
            ResultOptionSwitchExpressionNode::Ok(option_first) {
                match (option_first) {
                    OptionSwitchExpressionNode::None {
                        return ResultSwitchExpressionNodeVec::Ok(switch_expressions);
                    },
                    OptionSwitchExpressionNode::Some(first) {
                        switch_expressions.push(first);
                    }
                }
            }
        }

        while (true) {
            let has_comma = false;
            match (self.consume_if_matches(&TokenCategory::Comma)) {
                ResultOptionToken::Err(err) {
                    return ResultSwitchExpressionNodeVec::Err(parser_error_from_lexer_error(&err));
                },
                ResultOptionToken::Ok(option_comma) {
                    if (option_comma matches OptionToken::Some) {
                        has_comma = true;
                    }
                }
            }

            if (!has_comma) {
                break;
            }

            match (self.parse_switch_expression()) {
                ResultOptionSwitchExpressionNode::Err(err) {
                    return ResultSwitchExpressionNodeVec::Err(err);
                },
                ResultOptionSwitchExpressionNode::Ok(option_next) {
                    match (option_next) {
                        OptionSwitchExpressionNode::None {
                            return ResultSwitchExpressionNodeVec::Err(self.create_parser_error(
                                "Couldn't create switch expression while parsing switch expressions."
                            ));
                        },
                        OptionSwitchExpressionNode::Some(next) {
                            switch_expressions.push(next);
                        }
                    }
                }
            }
        }

        return ResultSwitchExpressionNodeVec::Ok(switch_expressions);
    }

    fn parse_switch_expression(self): ResultOptionSwitchExpressionNode {
        # switch_expression = expression, [ ":", identifier ];
        let expression_call = self.parse_expression();

        let expression = ExpressionNode {
            value: Expression::Literal(Literal::True),
            span: self.current_token().span
        };
        let found_expression = false;
        match (expression_call) {
            ResultOptionExpressionNode::Err(err) {
                return ResultOptionSwitchExpressionNode::Err(err);
            },
            ResultOptionExpressionNode::Ok(option_expression) {
                if (option_expression matches OptionExpressionNode::Some(expr)) {
                    expression = expr;
                    found_expression = true;
                }
            }
        }

        if (!found_expression) {
            return ResultOptionSwitchExpressionNode::Ok(OptionSwitchExpressionNode::None);
        }

        let start_position = expression.span.start;
        let alias = OptionIdentifierNode::None;
        let end_position = expression.span.end;

        match (self.consume_if_matches(&TokenCategory::Colon)) {
            ResultOptionToken::Err(err) {
                return ResultOptionSwitchExpressionNode::Err(parser_error_from_lexer_error(&err));
            },
            ResultOptionToken::Ok(option_colon) {
                if (option_colon matches OptionToken::Some) {
                    match (self.parse_identifier()) {
                        ResultOptionIdentifierNode::Err(err) {
                            return ResultOptionSwitchExpressionNode::Err(err);
                        },
                        ResultOptionIdentifierNode::Ok(option_alias) {
                            if (option_alias matches OptionIdentifierNode::Some(alias_identifier)) {
                                alias = OptionIdentifierNode::Some(alias_identifier);
                                end_position = alias_identifier.span.end;
                            }
                        }
                    }
                }
            }
        }

        return ResultOptionSwitchExpressionNode::Ok(OptionSwitchExpressionNode::Some(SwitchExpressionNode {
            value: SwitchExpression { expression, alias },
            span: Span.new(&start_position, &end_position)
        }));
    }

    fn parse_switch_case(self): ResultOptionSwitchCaseNode {
        # switch_case = "(", expression, ")", "->", statement_block;
        let paren_open_consumed = self.consume_if_matches(&TokenCategory::ParenOpen);

        let paren_open_token = self.current_token();
        let has_paren_open = false;
        match (paren_open_consumed) {
            ResultOptionToken::Err(err) {
                return ResultOptionSwitchCaseNode::Err(parser_error_from_lexer_error(&err));
            },
            ResultOptionToken::Ok(option_paren) {
                if (option_paren matches OptionToken::Some(token)) {
                    paren_open_token = token;
                    has_paren_open = true;
                }
            }
        }

        if (!has_paren_open) {
            return ResultOptionSwitchCaseNode::Ok(OptionSwitchCaseNode::None);
        }

        let condition_call = self.parse_expression();
        let condition = ExpressionNode {
            value: Expression::Literal(Literal::True),
            span: self.current_token().span
        };
        let found_condition = false;
        match (condition_call) {
            ResultOptionExpressionNode::Err(err) {
                return ResultOptionSwitchCaseNode::Err(err);
            },
            ResultOptionExpressionNode::Ok(option_condition) {
                if (option_condition matches OptionExpressionNode::Some(expr)) {
                    condition = expr;
                    found_condition = true;
                }
            }
        }

        if (!found_condition) {
            return ResultOptionSwitchCaseNode::Err(self.create_parser_error(
                "Couldn't create expression while parsing switch case."
            ));
        }

        if (self.consume_must_be(&TokenCategory::ParenClose) matches ResultToken::Err(err)) {
            return ResultOptionSwitchCaseNode::Err(err);
        }

        if (self.consume_must_be(&TokenCategory::Arrow) matches ResultToken::Err(err)) {
            return ResultOptionSwitchCaseNode::Err(err);
        }

        match (self.parse_statement_block()) {
            ResultOptionBlockNode::Err(err) {
                return ResultOptionSwitchCaseNode::Err(err);
            },
            ResultOptionBlockNode::Ok(option_block) {
                match (option_block) {
                    OptionBlockNode::None {
                        return ResultOptionSwitchCaseNode::Err(self.create_parser_error(
                            "Couldn't create statement block while parsing switch case."
                        ));
                    },
                    OptionBlockNode::Some(block) {
                        return ResultOptionSwitchCaseNode::Ok(OptionSwitchCaseNode::Some(SwitchCaseNode {
                            value: SwitchCase { condition, block },
                            span: Span.new(&paren_open_token.span.start, &block.span.end)
                        }));
                    }
                }
            }
        }
    }
};
