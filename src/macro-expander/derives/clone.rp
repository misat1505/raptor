import "../../common/errors.rp";
import "../../common/span.rp";
import "../../../stdlib/string.rp";
import "../../frontend/parser/ast.rp";
import "../macro-expander.rp";


enum OptionFunctionDeclaration {
    Some(FunctionDeclaration),
    None
};

struct CloneExpressionResult {
    StatementNode[] statements,
    Expression expression
};


extend MacroExpander {
    fn derive_clone(self, &Program program, &DeclaredType declared_type, Span derive_span): void {
        match (declared_type) {
            DeclaredType::Struct(struct_declaration) {
                let opt_function_based = self.generate_struct_clone(
                    &program,
                    struct_declaration,
                    derive_span,
                    ExpansionStrategy::FunctionBased
                );
                if (opt_function_based matches OptionFunctionDeclaration::Some(function)) {
                    self.insert_function(&program, &function, &derive_span);
                }

                let opt_method_based = self.generate_struct_clone(
                    &program,
                    struct_declaration,
                    derive_span,
                    ExpansionStrategy::MethodBased
                );
                if (opt_method_based matches OptionFunctionDeclaration::Some(function)) {
                    let clone_method = TypeMethod {
                        identifier: MacroExpander.ident("clone"),
                        self_identifier: OptionIdentifierNode::Some(IdentifierNode {
                            value: "self",
                            span: Span.default()
                        }),
                        parameters: [],
                        return_type: function.return_type,
                        block: function.block
                    };

                    self.insert_method(&declared_type, &clone_method, &derive_span);
                }
            },
            DeclaredType::Enum(enum_declaration) {
                let opt_function_based = self.generate_enum_clone(
                    &program,
                    enum_declaration,
                    derive_span,
                    ExpansionStrategy::FunctionBased
                );
                if (opt_function_based matches OptionFunctionDeclaration::Some(function)) {
                    self.insert_function(&program, &function, &derive_span);
                }

                let opt_method_based = self.generate_enum_clone(
                    &program,
                    enum_declaration,
                    derive_span,
                    ExpansionStrategy::MethodBased
                );
                if (opt_method_based matches OptionFunctionDeclaration::Some(function)) {
                    let clone_method = TypeMethod {
                        identifier: MacroExpander.ident("clone"),
                        self_identifier: OptionIdentifierNode::Some(IdentifierNode {
                            value: "self",
                            span: Span.default()
                        }),
                        parameters: [],
                        return_type: function.return_type,
                        block: function.block
                    };

                    self.insert_method(&declared_type, &clone_method, &derive_span);
                }
            }
        }
    }

    fn can_clone_type(self, &Program program, Type ty, str parent_type, Span derive_span): bool {
        match (ty) {
            Type::Vector(inner) {
                return self.can_clone_type(&program, inner, parent_type, derive_span);
            },
            Type::Unresolved(dependency_type) {
                if (dependency_type == parent_type) {
                    return true;
                }

                if (MacroExpander.type_has_derive(&program, dependency_type, "Clone")) {
                    return true;
                }

                let clone_fn = to_snake_case(dependency_type) + "_clone";

                if (MacroExpander.function_exists(&program, clone_fn)) {
                    return true;
                }

                for (let i = 0; i < program.declared_types.size(); i += 1) {
                    let type = program.declared_types[i].value;

                    let methods: TypeMethodNode[] = [];

                    match (type) {
                        DeclaredType::Struct(struct_declaration) {
                            if (struct_declaration.identifier.value != dependency_type) {
                                continue;
                            }

                            methods = struct_declaration.methods;
                        },
                        DeclaredType::Enum(enum_declaration) {
                            if (enum_declaration.identifier.value != dependency_type) {
                                continue;
                            }

                            methods = enum_declaration.methods;
                        }
                    }

                    for (let j = 0; j < methods.size(); j += 1) {
                        if (methods[j].value.identifier.value == "clone") {
                            return true;
                        }
                    }
                }

                self.errors.push(
                    macro_expander_error_at(
                        ErrorSeverity::HIGH,
                        "Type '"
                            + dependency_type
                            + "' used by '"
                            + parent_type
                            + "' cannot be cloned. Hint: add 'Clone' to the derives of '"
                            + dependency_type
                            + "', or implement 'fn "
                            + clone_fn
                            + "(&"
                            + dependency_type
                            + " value): "
                            + dependency_type
                            + "', or implement the method 'fn clone(self): "
                            + dependency_type
                            + "'.",
                        derive_span
                    )
                );

                return false;
            },
            Type::Void {
                self.errors.push(
                    macro_expander_error_at(
                        ErrorSeverity::HIGH,
                        "Void type cannot be cloned (used by '" + parent_type + "').",
                        derive_span
                    )
                );

                return false;
            },
            rest {
                return true;
            }
        }
    }

    fn generate_struct_clone(
        self,
        &Program program,
        StructDeclaration declaration,
        Span derive_span,
        ExpansionStrategy expansion_strategy
    ): OptionFunctionDeclaration {
        let type_name = declaration.identifier.value;
        let variable_name = "self";

        for (let i = 0; i < declaration.members.size(); i += 1) {
            if (
                !self.can_clone_type(
                    &program,
                    declaration.members[i].value.member_type.value,
                    type_name,
                    derive_span
                )
            ) {
                return OptionFunctionDeclaration::None;
            }
        }

        let stmts: StatementNode[] = [];
        let fields: StructLiteralFieldNode[] = [];
        let counter = 0;

        for (let i = 0; i < declaration.members.size(); i += 1) {
            let member = declaration.members[i];
            let field_name = member.value.identifier.value;
            let field_expression = MacroExpander.field_access(variable_name, field_name);

            let clone_result = self.clone_expression(
                field_expression,
                member.value.member_type.value,
                type_name,
                derive_span,
                &counter,
                expansion_strategy
            );

            for (let j = 0; j < clone_result.statements.size(); j += 1) {
                stmts.push(clone_result.statements[j]);
            }

            fields.push(
                StructLiteralFieldNode {
                    value: StructLiteralField {
                        identifier: MacroExpander.ident(field_name),
                        value: MacroExpander.expr(clone_result.expression)
                    },
                    span: Span.default()
                }
            );
        }

        let struct_literal = Expression::StructLiteral(StructLiteralNode {
            value: StructLiteral { identifier: MacroExpander.ident(type_name), fields },
            span: Span.default()
        });
        stmts.push(MacroExpander.stmt(MacroExpander.return_expr(struct_literal)));

        let params: ParameterNode[] = [];
        params.push(MacroExpander.param_ref(type_name, variable_name));

        return OptionFunctionDeclaration::Some(FunctionDeclaration {
            identifier: MacroExpander.ident(to_snake_case(type_name) + "_clone"),
            parameters: params,
            return_type: MacroExpander.type(Type::Unresolved(type_name)),
            block: MacroExpander.block(stmts)
        });
    }

    fn generate_enum_clone(
        self,
        &Program program,
        EnumDeclaration declaration,
        Span derive_span,
        ExpansionStrategy expansion_strategy
    ): OptionFunctionDeclaration {
        let enum_name = declaration.identifier.value;
        let variable_name = "self";

        for (let i = 0; i < declaration.members.size(); i += 1) {
            if (declaration.members[i].value.member_type matches OptionTypeNode::Some(t)) {
                if (!self.can_clone_type(&program, t.value, enum_name, derive_span)) {
                    return OptionFunctionDeclaration::None;
                }
            }
        }

        let match_arms: MatchArmNode[] = [];
        let counter = 0;

        for (let i = 0; i < declaration.members.size(); i += 1) {
            let member = declaration.members[i];
            let variant_name = member.value.identifier.value;

            match (member.value.member_type) {
                OptionTypeNode::None {
                    let arm_stmts: StatementNode[] = [];
                    arm_stmts.push(
                        MacroExpander.stmt(
                            MacroExpander.return_expr(
                                Expression::EnumLiteral(EnumLiteralExpression {
                                    enum_name: MacroExpander.ident(enum_name),
                                    variant_name: MacroExpander.ident(variant_name),
                                    variant_value: OptionExpressionNode::None
                                })
                            )
                        )
                    );
                    match_arms.push(
                        MatchArmNode {
                            value: MatchArm {
                                enum_name: MacroExpander.ident(enum_name),
                                variant_name: MacroExpander.ident(variant_name),
                                variant_value: OptionIdentifierNode::None,
                                block: MacroExpander.block(arm_stmts)
                            },
                            span: Span.default()
                        }
                    );
                },
                OptionTypeNode::Some(type_node) {
                    let payload_var = MacroExpander.debug_variable_name(type_node.value);
                    let clone_result = self.clone_expression(
                        MacroExpander.var(payload_var),
                        type_node.value,
                        enum_name,
                        derive_span,
                        &counter,
                        expansion_strategy
                    );
                    let arm_stmts: StatementNode[] = [];
                    for (let j = 0; j < clone_result.statements.size(); j += 1) {
                        arm_stmts.push(clone_result.statements[j]);
                    }
                    arm_stmts.push(
                        MacroExpander.stmt(
                            MacroExpander.return_expr(
                                Expression::EnumLiteral(EnumLiteralExpression {
                                    enum_name: MacroExpander.ident(enum_name),
                                    variant_name: MacroExpander.ident(variant_name),
                                    variant_value: OptionExpressionNode::Some(MacroExpander.expr(
                                        clone_result.expression
                                    ))
                                })
                            )
                        )
                    );
                    match_arms.push(
                        MatchArmNode {
                            value: MatchArm {
                                enum_name: MacroExpander.ident(enum_name),
                                variant_name: MacroExpander.ident(variant_name),
                                variant_value: OptionIdentifierNode::Some(MacroExpander.ident(
                                    payload_var
                                )),
                                block: MacroExpander.block(arm_stmts)
                            },
                            span: Span.default()
                        }
                    );
                }
            }
        }

        let stmts: StatementNode[] = [];
        stmts.push(
            MacroExpander.stmt(
                Statement::Match(MatchStatement {
                    expression: MacroExpander.expr(MacroExpander.var(variable_name)),
                    match_arms,
                    rest_arm: OptionBlockNode::None
                })
            )
        );

        let params: ParameterNode[] = [];
        params.push(MacroExpander.param_ref(enum_name, variable_name));

        return OptionFunctionDeclaration::Some(FunctionDeclaration {
            identifier: MacroExpander.ident(to_snake_case(enum_name) + "_clone"),
            parameters: params,
            return_type: MacroExpander.type(Type::Unresolved(enum_name)),
            block: MacroExpander.block(stmts)
        });
    }

    fn clone_expression(
        self,
        Expression expression,
        Type ty,
        str parent_type,
        Span derive_span,
        &i64 counter,
        ExpansionStrategy expansion_strategy
    ): CloneExpressionResult {
        match (ty) {
            Type::Vector(inner) {
                return self.clone_vector(
                    expression,
                    inner,
                    parent_type,
                    derive_span,
                    &counter,
                    expansion_strategy
                );
            },
            Type::Unresolved(identifier) {
                let empty: StatementNode[] = [];
                match (expansion_strategy) {
                    ExpansionStrategy::FunctionBased {
                        return CloneExpressionResult {
                            statements: empty,
                            expression: MacroExpander.call_ref(
                                to_snake_case(identifier) + "_clone",
                                expression
                            )
                        };
                    },
                    ExpansionStrategy::MethodBased {
                        return CloneExpressionResult {
                            statements: empty,
                            expression: MacroExpander.method_call_ref(&expression, "clone")
                        };
                    }
                }
            },
            Type::Str {
                # By-value string is deep-copied by language semantics when assigned;
                # explicit identity is fine for generated clones of owned fields.
                let empty: StatementNode[] = [];
                return CloneExpressionResult { statements: empty, expression };
            },
            rest {
                let empty: StatementNode[] = [];
                return CloneExpressionResult { statements: empty, expression };
            }
        }
    }

    fn clone_vector(
        self,
        Expression expression,
        Type inner,
        str parent_type,
        Span derive_span,
        &i64 counter,
        ExpansionStrategy expansion_strategy
    ): CloneExpressionResult {
        let n = counter;
        counter = n + 1;
        let suffix = n as str;

        let src = "src_vec_" + suffix;
        let dst = "dst_vec_" + suffix;
        let index = "i_" + suffix;
        let stmts: StatementNode[] = [];

        stmts.push(MacroExpander.stmt(MacroExpander.let_(src, expression, OptionTypeNode::None)));
        stmts.push(
            MacroExpander.stmt(
                MacroExpander.let_(
                    dst,
                    Expression::Vector([]),
                    OptionTypeNode::Some(TypeNode {
                        value: Type::Vector(inner),
                        span: Span.default()
                    })
                )
            )
        );
        stmts.push(
            MacroExpander.stmt(
                MacroExpander.let_(index, MacroExpander.i64_lit(0), OptionTypeNode::None)
            )
        );

        let loop_body: StatementNode[] = [];
        let elem = MacroExpander.index(src, index);
        let cloned = self.clone_expression(
            elem,
            inner,
            parent_type,
            derive_span,
            &counter,
            expansion_strategy
        );

        for (let j = 0; j < cloned.statements.size(); j += 1) {
            loop_body.push(cloned.statements[j]);
        }

        let push_args: ArgumentNode[] = [];
        push_args.push(
            ArgumentNode {
                value: Argument {
                    value: MacroExpander.expr(MacroExpander.var(dst)),
                    passed_by: PassedBy::Reference
                },
                span: Span.default()
            }
        );
        push_args.push(
            ArgumentNode {
                value: Argument {
                    value: MacroExpander.expr(cloned.expression),
                    passed_by: PassedBy::Value
                },
                span: Span.default()
            }
        );
        loop_body.push(
            MacroExpander.stmt(
                Statement::FunctionCall(FunctionCallExpression {
                    identifier: MacroExpander.ident("vector_push"),
                    arguments: push_args
                })
            )
        );
        loop_body.push(
            MacroExpander.stmt(
                MacroExpander.assign(
                    index,
                    MacroExpander.addition(MacroExpander.var(index), MacroExpander.i64_lit(1))
                )
            )
        );

        stmts.push(
            MacroExpander.stmt(
                Statement::WhileLoop(WhileLoopStatement {
                    condition: MacroExpander.expr(
                        MacroExpander.less(
                            MacroExpander.var(index),
                            MacroExpander.call_ref("vector_size", MacroExpander.var(src))
                        )
                    ),
                    block: MacroExpander.block(loop_body)
                })
            )
        );

        return CloneExpressionResult { statements: stmts, expression: MacroExpander.var(dst) };
    }
};
