import "../frontend/parser/ast.rp";


struct NameMangler {
    Program program

    fn new(&Program program): NameMangler {
        return NameMangler { program };
    }

    fn mangle_method_name(str target_name, str method_name): str {
        if (target_name.ends_with("[]")) {
            if (method_name == "push") {
                return "vector_push";
            } else if (method_name == "size") {
                return "vector_size";
            } else if (method_name == "ext") {
                return "vector_extend";
            }
        }
        if (target_name == "str") {
            if (method_name == "size") {
                return "str_len";
            }
        }
        let safe_target_name = target_name.replace_all("[]", "_vector");
        return safe_target_name + "__" + method_name + "__mangled";
    }

    fn mangle_program(self): void {
        for (let i = 0; i < self.program.declared_types.size(); i += 1) {
            self.mangle_type(&self.program.declared_types[i].value);
        }

        for (let i = 0; i < self.program.extend_blocks.size(); i += 1) {
            let block_type = self.program.extend_blocks[i].type.value;
            if (block_type matches Type::Unresolved) {
                continue;
            }
            for (let j = 0; j < self.program.extend_blocks[i].methods.size(); j += 1) {
                self.mangle_method(
                    block_type.to_string(),
                    block_type,
                    &self.program.extend_blocks[i].methods[j]
                );
            }
        }

        for (let i = 0; i < self.program.statements.size(); i += 1) {
            NameMangler.process_statement(&self.program.statements[i]);
        }
        for (let i = 0; i < self.program.functions.size(); i += 1) {
            NameMangler.process_block(&self.program.functions[i].value.block);
        }
    }

    fn mangle_type(self, &DeclaredType declared_type): void {
        match (declared_type) {
            DeclaredType::Struct(struct_declaration) {
                for (let i = 0; i < struct_declaration.methods.size(); i += 1) {
                    self.mangle_method(
                        struct_declaration.identifier.value,
                        Type::Unresolved(struct_declaration.identifier.value),
                        &struct_declaration.methods[i]
                    );
                }
            },
            DeclaredType::Enum(enum_declaration) {
                for (let i = 0; i < enum_declaration.methods.size(); i += 1) {
                    self.mangle_method(
                        enum_declaration.identifier.value,
                        Type::Unresolved(enum_declaration.identifier.value),
                        &enum_declaration.methods[i]
                    );
                }
            }
        }
    }

    fn mangle_method(self, str type_name, Type self_type, &TypeMethodNode method): void {
        let parameters: ParameterNode[] = [];

        if (method.value.self_identifier matches OptionIdentifierNode::Some(ident_node)) {
            let param = Parameter {
                passed_by: PassedBy::Reference,
                parameter_type: TypeNode { value: self_type, span: Span.default() },
                identifier: ident_node
            };
            let param_node = ParameterNode { value: param, span: ident_node.span };
            parameters.push(param_node);
        }

        for (let j = 0; j < method.value.parameters.size(); j += 1) {
            parameters.push(method.value.parameters[j]);
        }

        let mangled_name = NameMangler.mangle_method_name(type_name, method.value.identifier.value);

        let function_declaration = FunctionDeclaration {
            identifier: IdentifierNode { value: mangled_name, span: Span.default() },
            parameters,
            return_type: method.value.return_type,
            block: method.value.block
        };

        let node = FunctionDeclarationNode { value: function_declaration, span: method.span };

        self.program.functions.push(node);
    }

    fn process_block(&BlockNode block): void {
        for (let i = 0; i < block.value.statements.size(); i += 1) {
            NameMangler.process_statement(&block.value.statements[i]);
        }
    }

    fn process_optional_block(&OptionBlockNode block): void {
        if (block matches OptionBlockNode::Some(b)) {
            NameMangler.process_block(&b);
        }
    }

    fn process_optional_expression(&OptionExpressionNode expr): void {
        if (expr matches OptionExpressionNode::Some(e)) {
            NameMangler.process_expression(&e);
        }
    }

    fn process_optional_statement(&OptionStatementNode stmt): void {
        if (stmt matches OptionStatementNode::Some(s)) {
            NameMangler.process_statement(&s);
        }
    }

    fn process_arguments(&ArgumentNode[] arguments): void {
        for (let i = 0; i < arguments.size(); i += 1) {
            NameMangler.process_expression(&arguments[i].value.value);
        }
    }

    fn process_statement(&StatementNode stmt): void {
        match (stmt.value) {
            Statement::FunctionCall(call) {
                NameMangler.process_arguments(&call.arguments);
            },
            Statement::Declaration(decl) {
                NameMangler.process_expression(&decl.value);
            },
            Statement::Assignment(assignment) {
                for (let i = 0; i < assignment.accessors.size(); i += 1) {
                    if (assignment.accessors[i].value matches Accessor::Index(index_expr)) {
                        NameMangler.process_expression(&index_expr);
                    }
                }
                NameMangler.process_expression(&assignment.value);
            },
            Statement::Conditional(cond) {
                NameMangler.process_expression(&cond.condition);
                NameMangler.process_block(&cond.if_block);
                NameMangler.process_optional_block(&cond.else_block);
            },
            Statement::WhileLoop(loop) {
                NameMangler.process_expression(&loop.condition);
                NameMangler.process_block(&loop.block);
            },
            Statement::ForLoop(loop) {
                NameMangler.process_optional_statement(&loop.declaration);
                NameMangler.process_expression(&loop.condition);
                NameMangler.process_optional_statement(&loop.assignment);
                NameMangler.process_block(&loop.block);
            },
            Statement::Switch(sw) {
                for (let i = 0; i < sw.expressions.size(); i += 1) {
                    NameMangler.process_expression(&sw.expressions[i].value.expression);
                }
                for (let i = 0; i < sw.cases.size(); i += 1) {
                    NameMangler.process_expression(&sw.cases[i].value.condition);
                    NameMangler.process_block(&sw.cases[i].value.block);
                }
            },
            Statement::Return(value) {
                NameMangler.process_optional_expression(&value);
            },
            Statement::Match(m) {
                NameMangler.process_expression(&m.expression);
                for (let i = 0; i < m.match_arms.size(); i += 1) {
                    NameMangler.process_block(&m.match_arms[i].value.block);
                }
                NameMangler.process_optional_block(&m.rest_arm);
            },
            Statement::Expression(expr) {
                NameMangler.process_expression(&expr);
            },
            Statement::Break {},
            Statement::Continue {},
            Statement::Import {}
        }
    }

    fn process_binary(&BinaryExpression b): void {
        NameMangler.process_expression(&b.left);
        NameMangler.process_expression(&b.right);
    }

    fn process_expression(&ExpressionNode expr): void {
        match (expr.value) {
            Expression::Alternative(b) {
                NameMangler.process_binary(&b);
            },
            Expression::Concatenation(b) {
                NameMangler.process_binary(&b);
            },
            Expression::Greater(b) {
                NameMangler.process_binary(&b);
            },
            Expression::GreaterEqual(b) {
                NameMangler.process_binary(&b);
            },
            Expression::Less(b) {
                NameMangler.process_binary(&b);
            },
            Expression::LessEqual(b) {
                NameMangler.process_binary(&b);
            },
            Expression::Equal(b) {
                NameMangler.process_binary(&b);
            },
            Expression::NotEqual(b) {
                NameMangler.process_binary(&b);
            },
            Expression::Addition(b) {
                NameMangler.process_binary(&b);
            },
            Expression::Subtraction(b) {
                NameMangler.process_binary(&b);
            },
            Expression::Multiplication(b) {
                NameMangler.process_binary(&b);
            },
            Expression::Division(b) {
                NameMangler.process_binary(&b);
            },
            Expression::Modulo(b) {
                NameMangler.process_binary(&b);
            },
            Expression::BooleanNegation(inner) {
                NameMangler.process_expression(&inner);
            },
            Expression::ArithmeticNegation(inner) {
                NameMangler.process_expression(&inner);
            },
            Expression::Casting(c) {
                NameMangler.process_expression(&c.value);
            },
            Expression::Literal {},
            Expression::Vector(items) {
                for (let i = 0; i < items.size(); i += 1) {
                    NameMangler.process_expression(&items[i]);
                }
            },
            Expression::Index(ix) {
                NameMangler.process_expression(&ix.collection);
                NameMangler.process_expression(&ix.index);
            },
            Expression::FieldAccess(fa) {
                NameMangler.process_expression(&fa.instance);
            },
            Expression::Variable {},
            Expression::FunctionCall(call) {
                NameMangler.process_arguments(&call.arguments);
            },
            Expression::StructLiteral(sl) {
                for (let i = 0; i < sl.value.fields.size(); i += 1) {
                    NameMangler.process_expression(&sl.value.fields[i].value.value);
                }
            },
            Expression::EnumLiteral(el) {
                NameMangler.process_optional_expression(&el.variant_value);
            },
            Expression::MethodCall(call) {
                NameMangler.process_expression(&call.instance);
                NameMangler.process_arguments(&call.arguments);

                let instance = call.instance;
                let field = call.field;
                let old_arguments = call.arguments;

                match (call.target) {
                    MethodCallTarget::Instance(type_name) {
                        let args: ArgumentNode[] = [];
                        let self_arg = ArgumentNode {
                            value: Argument { value: instance, passed_by: PassedBy::Reference },
                            span: instance.span
                        };
                        args.push(self_arg);
                        for (let i = 0; i < old_arguments.size(); i += 1) {
                            args.push(old_arguments[i]);
                        }

                        expr.value = Expression::FunctionCall(FunctionCallExpression {
                            identifier: IdentifierNode {
                                value: NameMangler.mangle_method_name(type_name, field.value),
                                span: field.span
                            },
                            arguments: args
                        });
                    },
                    MethodCallTarget::Type(type_name) {
                        expr.value = Expression::FunctionCall(FunctionCallExpression {
                            identifier: IdentifierNode {
                                value: NameMangler.mangle_method_name(type_name, field.value),
                                span: field.span
                            },
                            arguments: old_arguments
                        });
                    },
                    MethodCallTarget::Unresolved {}
                }
            }
        }
    }
};
