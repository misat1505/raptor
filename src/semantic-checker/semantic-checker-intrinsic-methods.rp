enum CheckForIntrinsicMethodCallData {
    Ok,
    ErrorInCall(str),
    NoTypeMatch,
    NoMethodMatchInType
};


extend SemanticChecker {
    fn check_for_intrinsic_method_call(
        self,
        &Program program,
        &Type type,
        &MethodCallExpression mc
    ): CheckForIntrinsicMethodCallData {
        match (type) {
            Type::Vector(vector_inner_type) {
                if (mc.field.value == "push") {
                    if (mc.arguments.size() != 1) {
                        return CheckForIntrinsicMethodCallData::ErrorInCall("Method 'push' expects exactly 1 argument, but "
                            + mc.arguments.size() as str
                            + " were provided.");
                    }

                    let argument = mc.arguments[0];

                    if (argument.value.passed_by matches PassedBy::Reference) {
                        return CheckForIntrinsicMethodCallData::ErrorInCall("Argument of method 'push' must be passed by value.");
                    }

                    self.visit_expression(&program, argument.value.value);

                    if (self.read_last(argument.span) matches ResultType::Ok(arg_type)) {
                        if (arg_type.debug() != vector_inner_type.debug()) {
                            return CheckForIntrinsicMethodCallData::ErrorInCall("Method 'push' expects an argument of type '"
                                + vector_inner_type.to_string()
                                + "', but '"
                                + arg_type.to_string()
                                + "' was provided.");
                        }

                        self.set_last(Type::Void);
                        return CheckForIntrinsicMethodCallData::Ok;
                    } else {
                        return CheckForIntrinsicMethodCallData::ErrorInCall("Failed to resolve the type of the argument passed to method 'push'.");
                    }
                } else if (mc.field.value == "ext") {
                    if (mc.arguments.size() != 1) {
                        return CheckForIntrinsicMethodCallData::ErrorInCall("Method 'ext' expects exactly 1 argument, but "
                            + mc.arguments.size() as str
                            + " were provided.");
                    }

                    let argument = mc.arguments[0];

                    if (argument.value.passed_by matches PassedBy::Value) {
                        return CheckForIntrinsicMethodCallData::ErrorInCall("Argument of method 'ext' must be passed by reference.");
                    }

                    self.visit_expression(&program, argument.value.value);

                    if (self.read_last(argument.span) matches ResultType::Ok(arg_type)) {
                        if (arg_type.debug() != type.debug()) {
                            return CheckForIntrinsicMethodCallData::ErrorInCall("Method 'ext' expects an argument of type '"
                                + type.to_string()
                                + "', but '"
                                + arg_type.to_string()
                                + "' was provided.");
                        }

                        self.set_last(Type::Void);
                        return CheckForIntrinsicMethodCallData::Ok;
                    } else {
                        return CheckForIntrinsicMethodCallData::ErrorInCall("Failed to resolve the type of the argument passed to method 'ext'.");
                    }
                } else if (mc.field.value == "size") {
                    if (mc.arguments.size() != 0) {
                        return CheckForIntrinsicMethodCallData::ErrorInCall("Method 'size' expects no arguments, but "
                            + mc.arguments.size() as str
                            + " were provided.");
                    }

                    self.set_last(Type::I64);
                    return CheckForIntrinsicMethodCallData::Ok;
                }

                return CheckForIntrinsicMethodCallData::NoMethodMatchInType;
            },
            Type::Str {
                if (mc.field.value == "size") {
                    if (mc.arguments.size() != 0) {
                        return CheckForIntrinsicMethodCallData::ErrorInCall("Method 'size' expects no arguments, but "
                            + mc.arguments.size() as str
                            + " were provided.");
                    }

                    self.set_last(Type::I64);
                    return CheckForIntrinsicMethodCallData::Ok;
                }

                return CheckForIntrinsicMethodCallData::NoMethodMatchInType;
            },
            rest {}
        }

        return CheckForIntrinsicMethodCallData::NoTypeMatch;
    }
};
