
enum CheckForIntrinsicMethodCallData {
    Ok,
    ErrorInCall(str),
    NoTypeMatch,
    NoMethodMatchInType
};


fn semantic_checker_check_for_intrinsic_method_call(
    &SemanticChecker sc,
    &Program program,
    &Type type,
    &MethodCallExpression mc
): CheckForIntrinsicMethodCallData {
    match (type) {
        Type::Vector(vector_inner_type) {
            if (mc.field.value == "push") {
                if (vector_size(&mc.arguments) != 1) {
                    return CheckForIntrinsicMethodCallData::ErrorInCall(
                        "Method 'push' expects exactly 1 argument, but "
                            + vector_size(&mc.arguments) as str
                            + " were provided."
                    );
                }

                let argument = mc.arguments[0];

                if (argument.value.passed_by matches PassedBy::Reference) {
                    return CheckForIntrinsicMethodCallData::ErrorInCall(
                        "Argument of method 'push' must be passed by value."
                    );
                }

                semantic_checker_visit_expression(&sc, &program, argument.value.value);

                if (semantic_checker_read_last(&sc, argument.span) matches ResultType::Ok(arg_type)) {
                    if (type_debug(&arg_type) != type_debug(&vector_inner_type)) {
                        return CheckForIntrinsicMethodCallData::ErrorInCall(
                            "Method 'push' expects an argument of type '"
                                + type_to_string(vector_inner_type)
                                + "', but '"
                                + type_to_string(arg_type)
                                + "' was provided."
                        );
                    }

                    semantic_checker_set_last(&sc, Type::Void);
                    return CheckForIntrinsicMethodCallData::Ok;
                } else {
                    return CheckForIntrinsicMethodCallData::ErrorInCall(
                        "Failed to resolve the type of the argument passed to method 'push'."
                    );
                }
            } else if (mc.field.value == "extend") {
                if (vector_size(&mc.arguments) != 1) {
                    return CheckForIntrinsicMethodCallData::ErrorInCall(
                        "Method 'extend' expects exactly 1 argument, but "
                            + vector_size(&mc.arguments) as str
                            + " were provided."
                    );
                }

                let argument = mc.arguments[0];

                if (argument.value.passed_by matches PassedBy::Value) {
                    return CheckForIntrinsicMethodCallData::ErrorInCall(
                        "Argument of method 'extend' must be passed by reference."
                    );
                }

                semantic_checker_visit_expression(&sc, &program, argument.value.value);

                if (semantic_checker_read_last(&sc, argument.span) matches ResultType::Ok(arg_type)) {
                    if (type_debug(&arg_type) != type_debug(&type)) {
                        return CheckForIntrinsicMethodCallData::ErrorInCall(
                            "Method 'extend' expects an argument of type '"
                                + type_to_string(type)
                                + "', but '"
                                + type_to_string(arg_type)
                                + "' was provided."
                        );
                    }

                    semantic_checker_set_last(&sc, Type::Void);
                    return CheckForIntrinsicMethodCallData::Ok;
                } else {
                    return CheckForIntrinsicMethodCallData::ErrorInCall(
                        "Failed to resolve the type of the argument passed to method 'extend'."
                    );
                }
            } else if (mc.field.value == "size") {
                if (vector_size(&mc.arguments) != 0) {
                    return CheckForIntrinsicMethodCallData::ErrorInCall(
                        "Method 'size' expects no arguments, but "
                            + vector_size(&mc.arguments) as str
                            + " were provided."
                    );
                }

                semantic_checker_set_last(&sc, Type::I64);
                return CheckForIntrinsicMethodCallData::Ok;
            }

            return CheckForIntrinsicMethodCallData::NoMethodMatchInType;
        },
        Type::Str {
            if (mc.field.value == "size") {
                if (vector_size(&mc.arguments) != 0) {
                    return CheckForIntrinsicMethodCallData::ErrorInCall(
                        "Method 'size' expects no arguments, but "
                            + vector_size(&mc.arguments) as str
                            + " were provided."
                    );
                }

                semantic_checker_set_last(&sc, Type::I64);
                return CheckForIntrinsicMethodCallData::Ok;
            }

            return CheckForIntrinsicMethodCallData::NoMethodMatchInType;
        },
        rest {}
    }

    return CheckForIntrinsicMethodCallData::NoTypeMatch;
}
