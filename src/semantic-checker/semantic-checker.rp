import "../common/errors.rp";
import "../common/span.rp";
import "../../stdlib/string.rp";
import "../frontend/parser/ast.rp";
import "../frontend/parser/parser-results.rp";
import "./semantic-helpers.rp";
import "../std-functions/std-function.rp";
import "../std-functions/check-std-call.rp";
import "./stack/stack.rp";
import "./type-alu/type-alu.rp";


struct HoverInfo derives Json {
    Span span,
    str contents
};

struct DefinitionInfo derives Json {
    Span use_span,
    Span def_span
};

enum OptionStructDeclaration {
    Some(StructDeclaration),
    None
};

enum OptionEnumDeclaration {
    Some(EnumDeclaration),
    None
};

struct SemanticChecker {
    StaticCheckerStack stack,
    OptionType last_result,
    SemanticCheckerError[] errors,
    OptionFunctionDeclaration current_function,
    HoverInfo[] hovers,
    DefinitionInfo[] definitions,
    StdFunctionRegistry std_function_registry

    fn new(): SemanticChecker {
        return SemanticChecker {
            stack: StaticCheckerStack.new(),
            last_result: OptionType::None,
            errors: [],
            current_function: OptionFunctionDeclaration::None,
            hovers: [],
            definitions: [],
            std_function_registry: StdFunctionRegistry.new()
        };
    }

    fn check(self, &Program program): void {
        self.visit_program(&program);
    }

    fn push_error(self, SemanticCheckerError err): void {
        self.errors.push(err);
    }

    fn read_last(self, Span span): ResultType {
        match (self.last_result) {
            OptionType::Some(t) {
                self.last_result = OptionType::None;
                return ResultType::Ok(t);
            },
            OptionType::None {
                let err = SemanticCheckerError.at(
                    ErrorSeverity::HIGH,
                    "Expected a type, but none was produced.",
                    span
                );
                return ResultType::Err(err);
            }
        }
    }

    fn set_last(self, Type t): void {
        self.last_result = OptionType::Some(t);
    }

    fn type_prefix(Type data_type): str {
        if (data_type matches Type::Unresolved) {
            # User types are either struct or enum; callers often know which.
            # Prefix is filled in by more specific hover helpers when needed.
            return "";
        }
        return "";
    }

    fn identifier_hover(self, Type data_type, IdentifierNode identifier): void {
        let contents =
            "```raptor\n"
                + SemanticChecker.type_prefix(data_type)
                + data_type.to_string()
                + " "
                + identifier.value
                + "\n```";
        self.hovers.push(HoverInfo { span: identifier.span, contents });
    }

    fn type_hover(self, Type data_type, Span span): void {
        let contents =
            "```raptor\n"
                + SemanticChecker.type_prefix(data_type)
                + data_type.to_string()
                + "\n```";
        self.hovers.push(HoverInfo { span, contents });
    }

    fn push_definition(self, Span use_span, Span def_span): void {
        self.definitions.push(DefinitionInfo { use_span, def_span });
    }

    fn struct_hover(self, str name, Span span): void {
        let contents = "```raptor\nstruct " + name + "\n```";
        self.hovers.push(HoverInfo { span, contents });
    }

    fn enum_hover(self, str name, Span span): void {
        let contents = "```raptor\nenum " + name + "\n```";
        self.hovers.push(HoverInfo { span, contents });
    }

    fn function_hover(self, str name, ParameterNode[] params, Type ret, Span span): void {
        let sig = "fn " + name + "(";
        for (let i = 0; i < params.size(); i += 1) {
            if (i > 0) {
                sig = sig + ", ";
            }
            let p = params[i].value;
            if (p.passed_by matches PassedBy::Reference) {
                sig = sig + "&";
            }
            sig = sig + p.parameter_type.value.to_string() + " " + p.identifier.value;
        }
        sig = sig + "): " + ret.to_string();
        let contents = "```raptor\n" + sig + "\n```";
        self.hovers.push(HoverInfo { span, contents });
    }

    fn method_call_hover(self, str instance, &TypeMethod tm, Span span): void {
        let sig = "fn " + instance + '.' + tm.identifier.value + "(";
        if (tm.self_identifier matches OptionIdentifierNode::Some) {
            sig += "self";
            if (tm.parameters.size() > 0) {
                sig += ", ";
            }
        }
        for (let i = 0; i < tm.parameters.size(); i += 1) {
            if (i > 0) {
                sig = sig + ", ";
            }
            let p = tm.parameters[i].value;
            if (p.passed_by matches PassedBy::Reference) {
                sig = sig + "&";
            }
            sig = sig + p.parameter_type.value.to_string() + " " + p.identifier.value;
        }
        sig = sig + "): " + tm.return_type.value.to_string();
        let contents = "```raptor\n" + sig + "\n```";
        self.hovers.push(HoverInfo { span, contents });
    }

    fn derive_hover(self, str identifier_name, IdentifierNode derive): void {
        let snake = to_snake_case(identifier_name);

        if (derive.value == "Debug") {
            let contents =
                "Generates functionality for formatting `"
                    + identifier_name
                    + "` as a human-readable string.\n\n"
                    + "```raptor\n"
                    + "fn "
                    + snake
                    + "_debug(&"
                    + identifier_name
                    + " value): str\n"
                    + "```\n\n"
                    + "```raptor\n"
                    + "fn "
                    + identifier_name
                    + ".debug(self): str\n"
                    + "```";
            self.hovers.push(HoverInfo { span: derive.span, contents });
        } else if (derive.value == "Json") {
            let contents =
                "Generates functionality for serializing `"
                    + identifier_name
                    + "` into a JSON string.\n\n"
                    + "```raptor\n"
                    + "fn "
                    + snake
                    + "_json_encode(&"
                    + identifier_name
                    + " value): str\n"
                    + "```\n\n"
                    + "```raptor\n"
                    + "fn "
                    + identifier_name
                    + ".json_encode(self): str\n"
                    + "```";
            self.hovers.push(HoverInfo { span: derive.span, contents });
        } else if (derive.value == "Clone") {
            let contents =
                "Generates functionality for recursively cloning `"
                    + identifier_name
                    + "` and its fields.\n\n"
                    + "```raptor\n"
                    + "fn "
                    + snake
                    + "_clone(&"
                    + identifier_name
                    + " value): "
                    + identifier_name
                    + "\n"
                    + "```\n\n"
                    + "```raptor\n"
                    + "fn "
                    + identifier_name
                    + ".clone(self): "
                    + identifier_name
                    + "\n"
                    + "```";
            self.hovers.push(HoverInfo { span: derive.span, contents });
        }
    }

    fn resolve_type(self, &Program program, Type ty, Span span): ResultType {
        match (ty) {
            Type::Unresolved(name) {
                for (let i = 0; i < program.declared_types.size(); i += 1) {
                    let dt = program.declared_types[i].value;
                    let n = "";
                    match (dt) {
                        DeclaredType::Struct(s) {
                            n = s.identifier.value;
                        },
                        DeclaredType::Enum(e) {
                            n = e.identifier.value;
                        }
                    }
                    if (n == name) {
                        self.push_definition(span, program.declared_types[i].span);
                        match (dt) {
                            DeclaredType::Struct {
                                self.struct_hover(name, span);
                            },
                            DeclaredType::Enum {
                                self.enum_hover(name, span);
                            }
                        }
                        return ResultType::Ok(Type::Unresolved(name));
                    }
                }

                let err = SemanticCheckerError.at(
                    ErrorSeverity::HIGH,
                    "Unknown type `" + name + "`.",
                    span
                );
                self.push_error(err);
                return ResultType::Err(err);
            },
            Type::Vector(inner) {
                match (self.resolve_type(&program, inner, span)) {
                    ResultType::Err(e) {
                        return ResultType::Err(e);
                    },
                    ResultType::Ok(ri) {
                        return ResultType::Ok(Type::Vector(ri));
                    }
                }
            },
            rest {
                return ResultType::Ok(ty);
            }
        }
    }

    fn lookup_struct(&Program program, str name): OptionStructDeclaration {
        for (let i = 0; i < program.declared_types.size(); i += 1) {
            if (program.declared_types[i].value matches DeclaredType::Struct(s)) {
                if (s.identifier.value == name) {
                    return OptionStructDeclaration::Some(s);
                }
            }
        }
        return OptionStructDeclaration::None;
    }

    fn lookup_enum(&Program program, str name): OptionEnumDeclaration {
        for (let i = 0; i < program.declared_types.size(); i += 1) {
            if (program.declared_types[i].value matches DeclaredType::Enum(e)) {
                if (e.identifier.value == name) {
                    return OptionEnumDeclaration::Some(e);
                }
            }
        }
        return OptionEnumDeclaration::None;
    }

    fn is_builtin_derive(str name): bool {
        return name == "Debug" || name == "Json" || name == "Clone";
    }

    fn find_interface(&Program program, str name): i64 {
        for (let i = 0; i < program.interfaces.size(); i += 1) {
            if (program.interfaces[i].value.identifier.value == name) {
                return i;
            }
        }
        return -1;
    }

    fn interface_hover(self, str name, Span span): void {
        let contents = "```raptor\ninterface " + name + "\n```";
        self.hovers.push(HoverInfo { span, contents });
    }

    fn param_to_string(PassedBy passed_by, Type parameter_type): str {
        if (passed_by matches PassedBy::Reference) {
            return "&" + parameter_type.to_string();
        }
        return parameter_type.to_string();
    }

    fn interface_signature_to_string(MethodSignature sig): str {
        let text = "fn " + sig.identifier.value + "(";
        let first = true;
        if (sig.self_identifier matches OptionIdentifierNode::Some) {
            text += "self";
            first = false;
        }
        for (let i = 0; i < sig.parameters.size(); i += 1) {
            if (!first) {
                text += ", ";
            }
            first = false;
            let p = sig.parameters[i].value;
            text += SemanticChecker.param_to_string(p.passed_by, p.parameter_type.value);
        }
        return text + "): " + sig.return_type.value.to_string();
    }

    fn method_signature_to_string(TypeMethod method): str {
        let text = "fn " + method.identifier.value + "(";
        let first = true;
        if (method.self_identifier matches OptionIdentifierNode::Some) {
            text += "self";
            first = false;
        }
        for (let i = 0; i < method.parameters.size(); i += 1) {
            if (!first) {
                text += ", ";
            }
            first = false;
            let p = method.parameters[i].value;
            text += SemanticChecker.param_to_string(p.passed_by, p.parameter_type.value);
        }
        return text + "): " + method.return_type.value.to_string();
    }

    fn signature_matches(MethodSignature sig, TypeMethod method): bool {
        let sig_has_self = false;
        if (sig.self_identifier matches OptionIdentifierNode::Some) {
            sig_has_self = true;
        }
        let method_has_self = false;
        if (method.self_identifier matches OptionIdentifierNode::Some) {
            method_has_self = true;
        }
        if (sig_has_self != method_has_self) {
            return false;
        }
        if (sig.parameters.size() != method.parameters.size()) {
            return false;
        }
        for (let i = 0; i < sig.parameters.size(); i += 1) {
            let expected = sig.parameters[i].value;
            let actual = method.parameters[i].value;
            let expected_by_ref = false;
            if (expected.passed_by matches PassedBy::Reference) {
                expected_by_ref = true;
            }
            let actual_by_ref = false;
            if (actual.passed_by matches PassedBy::Reference) {
                actual_by_ref = true;
            }
            if (expected_by_ref != actual_by_ref) {
                return false;
            }
            if (!expected.parameter_type.value.eq(actual.parameter_type.value)) {
                return false;
            }
        }
        return sig.return_type.value.eq(method.return_type.value);
    }

    fn check_interface_declarations(self, &Program program): void {
        for (let i = 0; i < program.interfaces.size(); i += 1) {
            let decl = program.interfaces[i].value;
            self.interface_hover(decl.identifier.value, decl.identifier.span);

            if (SemanticChecker.is_builtin_derive(decl.identifier.value)) {
                self.push_error(
                    SemanticCheckerError.at(
                        ErrorSeverity::HIGH,
                        "Interface name '"
                            + decl.identifier.value
                            + "' conflicts with the built-in derive macro of the same name.",
                        decl.identifier.span
                    )
                );
            }

            for (let m = 0; m < decl.methods_signatures.size(); m += 1) {
                let sig = decl.methods_signatures[m].value;

                # `self.resolve_type` reports unknown types itself and records
                # hovers / definitions for the ones that exist.
                for (let p = 0; p < sig.parameters.size(); p += 1) {
                    let param_type = sig.parameters[p].value.parameter_type;
                    self.resolve_type(&program, param_type.value, param_type.span);
                }
                self.resolve_type(&program, sig.return_type.value, sig.return_type.span);
            }
        }
    }

    fn check_type_interfaces(
        self,
        &Program program,
        str type_name,
        IdentifierNode[] type_derives,
        IdentifierNode[] type_implementations,
        &TypeMethodNode[] methods
    ): void {
        # Interfaces the type implements: index into program.interfaces + the reference that named it.
        let implemented: i64[] = [];
        let references: IdentifierNode[] = [];

        for (let pass = 0; pass < 2; pass += 1) {
            let names: IdentifierNode[] = type_derives;
            if (pass == 1) {
                names = type_implementations;
            }

            for (let n = 0; n < names.size(); n += 1) {
                let reference = names[n];

                if (pass == 0 && SemanticChecker.is_builtin_derive(reference.value)) {
                    continue;
                }

                let index = SemanticChecker.find_interface(&program, reference.value);
                if (index < 0) {
                    if (pass == 0) {
                        self.push_error(
                            SemanticCheckerError.at(
                                ErrorSeverity::HIGH,
                                "Unknown derive '"
                                    + reference.value
                                    + "' on type '"
                                    + type_name
                                    + "': there is neither a built-in derive macro (Debug, Json, Clone) nor an interface with that name.",
                                reference.span
                            )
                        );
                    } else {
                        self.push_error(
                            SemanticCheckerError.at(
                                ErrorSeverity::HIGH,
                                "Type '"
                                    + type_name
                                    + "' implements unknown interface '"
                                    + reference.value
                                    + "'.",
                                reference.span
                            )
                        );
                    }
                    continue;
                }

                self.interface_hover(reference.value, reference.span);
                self.push_definition(reference.span, program.interfaces[index].span);

                let already = false;
                for (let k = 0; k < implemented.size(); k += 1) {
                    if (implemented[k] == index) {
                        already = true;
                    }
                }
                if (already) {
                    self.push_error(
                        SemanticCheckerError.at(
                            ErrorSeverity::HIGH,
                            "Type '"
                                + type_name
                                + "' already implements interface '"
                                + reference.value
                                + "'.",
                            reference.span
                        )
                    );
                    continue;
                }

                implemented.push(index);
                references.push(reference);
            }
        }

        for (let a = 0; a < implemented.size(); a += 1) {
            let interface_decl = program.interfaces[implemented[a]].value;
            let interface_name = interface_decl.identifier.value;

            # The same method name coming from two interfaces is ambiguous, even when both
            # signatures are identical.
            for (let b = 0; b < a; b += 1) {
                let other = program.interfaces[implemented[b]].value;
                for (let m = 0; m < interface_decl.methods_signatures.size(); m += 1) {
                    let method_name = interface_decl.methods_signatures[m].value.identifier.value;
                    for (let o = 0; o < other.methods_signatures.size(); o += 1) {
                        if (other.methods_signatures[o].value.identifier.value == method_name) {
                            self.push_error(
                                SemanticCheckerError.at(
                                    ErrorSeverity::HIGH,
                                    "Method '"
                                        + method_name
                                        + "' is declared by both interface '"
                                        + other.identifier.value
                                        + "' and interface '"
                                        + interface_name
                                        + "', which type '"
                                        + type_name
                                        + "' implements.",
                                    references[a].span
                                )
                            );
                        }
                    }
                }
            }

            for (let m = 0; m < interface_decl.methods_signatures.size(); m += 1) {
                let sig = interface_decl.methods_signatures[m].value;
                let expected = SemanticChecker.interface_signature_to_string(sig);

                let found = false;
                for (let t = 0; t < methods.size(); t += 1) {
                    let method = methods[t].value;
                    if (method.identifier.value != sig.identifier.value) {
                        continue;
                    }
                    found = true;

                    if (!SemanticChecker.signature_matches(sig, method)) {
                        # Derive-generated methods carry a synthetic span without a file.
                        let at = references[a].span;
                        if (method.identifier.span.start.filename matches OptionStr::Some) {
                            at = method.identifier.span;
                        }
                        self.push_error(
                            SemanticCheckerError.at(
                                ErrorSeverity::HIGH,
                                "Method '"
                                    + sig.identifier.value
                                    + "' of type '"
                                    + type_name
                                    + "' does not match interface '"
                                    + interface_name
                                    + "'. Expected '"
                                    + expected
                                    + "', found '"
                                    + SemanticChecker.method_signature_to_string(method)
                                    + "'.",
                                at
                            )
                        );
                    }
                }

                if (!found) {
                    self.push_error(
                        SemanticCheckerError.at(
                            ErrorSeverity::HIGH,
                            "Type '"
                                + type_name
                                + "' does not implement method '"
                                + expected
                                + "' required by interface '"
                                + interface_name
                                + "'.",
                            references[a].span
                        )
                    );
                }
            }
        }
    }

    fn visit_program(self, &Program program): void {
        for (let i = 0; i < program.declared_types.size(); i += 1) {
            match (program.declared_types[i].value) {
                DeclaredType::Struct(s) {
                    for (let d = 0; d < s.struct_derives.size(); d += 1) {
                        self.derive_hover(s.identifier.value, s.struct_derives[d]);
                    }
                },
                DeclaredType::Enum(e) {
                    for (let d = 0; d < e.enum_derives.size(); d += 1) {
                        self.derive_hover(e.identifier.value, e.enum_derives[d]);
                    }
                }
            }
        }

        for (let i = 0; i < program.extend_blocks.size(); i += 1) {
            if (program.extend_blocks[i].type.value matches Type::Unresolved(custom_type_name)) {
                for (let j = 0; j < program.declared_types.size(); j += 1) {
                    match (program.declared_types[j].value) {
                        DeclaredType::Struct(s) {
                            if (s.identifier.value != custom_type_name) {
                                continue;
                            }

                            self.struct_hover(custom_type_name, program.extend_blocks[i].type.span);
                            self.push_definition(
                                program.extend_blocks[i].type.span,
                                program.declared_types[j].span
                            );
                        },
                        DeclaredType::Enum(e) {
                            if (e.identifier.value != custom_type_name) {
                                continue;
                            }
                            self.enum_hover(custom_type_name, program.extend_blocks[i].type.span);
                            self.push_definition(
                                program.extend_blocks[i].type.span,
                                program.declared_types[j].span
                            );
                        }
                    }
                }
            }
        }

        for (let i = 0; i < program.statements.size(); i += 1) {
            self.visit_statement(&program, program.statements[i]);
        }
        self.unused_warn();

        for (let i = 0; i < program.functions.size(); i += 1) {
            let function = program.functions[i];
            self.stack.push_frame();

            if (
                self.resolve_type(
                    &program,
                    function.value.return_type.value,
                    function.value.return_type.span
                ) matches ResultType::Ok(rt)
            ) {
                # rewrite not persisted; track current function for return checks
                let fd = function.value;
                fd.return_type = TypeNode { value: rt, span: function.value.return_type.span };
                self.current_function = OptionFunctionDeclaration::Some(fd);
            }

            for (let p = 0; p < function.value.parameters.size(); p += 1) {
                let param = function.value.parameters[p];
                if (
                    self.resolve_type(
                        &program,
                        param.value.parameter_type.value,
                        param.value.parameter_type.span
                    ) matches ResultType::Ok(t)
                ) {
                    if (
                        self.stack.declare_variable(
                            param.value.identifier.value,
                            t,
                            param.value.identifier.span
                        ) matches ResultSem::Err(err)
                    ) {
                        self.push_error(err);
                    } else {
                        self.identifier_hover(t, param.value.identifier);
                    }
                }
            }

            self.visit_block(&program, function.value.block);
            self.unused_warn();
            self.current_function = OptionFunctionDeclaration::None;
            self.stack.pop_frame();
        }

        self.check_interface_declarations(&program);

        # Validate declared types' member type references.
        for (let i = 0; i < program.declared_types.size(); i += 1) {
            match (program.declared_types[i].value) {
                DeclaredType::Struct(s) {
                    for (let m = 0; m < s.members.size(); m += 1) {
                        self.resolve_type(
                            &program,
                            s.members[m].value.member_type.value,
                            s.members[m].value.member_type.span
                        );
                    }
                    self.check_type_methods(
                        &program,
                        &s.methods,
                        Type::Unresolved(s.identifier.value),
                        s.identifier.span
                    );
                    self.check_type_interfaces(
                        &program,
                        s.identifier.value,
                        s.struct_derives,
                        s.implementations,
                        &s.methods
                    );
                },
                DeclaredType::Enum(e) {
                    for (let m = 0; m < e.members.size(); m += 1) {
                        if (e.members[m].value.member_type matches OptionTypeNode::Some(tn)) {
                            self.resolve_type(&program, tn.value, tn.span);
                        }
                    }
                    self.check_type_methods(
                        &program,
                        &e.methods,
                        Type::Unresolved(e.identifier.value),
                        e.identifier.span
                    );
                    self.check_type_interfaces(
                        &program,
                        e.identifier.value,
                        e.enum_derives,
                        e.implementations,
                        &e.methods
                    );
                }
            }
        }

        # Extend blocks on built-in types (user types were merged into their declarations).
        for (let i = 0; i < program.extend_blocks.size(); i += 1) {
            let block_type = program.extend_blocks[i].type;
            if (block_type.value matches Type::Unresolved) {
                continue;
            }
            self.check_type_methods(
                &program,
                &program.extend_blocks[i].methods,
                block_type.value,
                block_type.span
            );
        }
    }

    fn check_type_methods(
        self,
        &Program program,
        &TypeMethodNode[] methods,
        Type self_type,
        Span self_span
    ): void {
        for (let i = 0; i < methods.size(); i += 1) {
            let method = methods[i];
            self.stack.push_frame();

            match (
                self.resolve_type(
                    &program,
                    method.value.return_type.value,
                    method.value.return_type.span
                )
            ) {
                ResultType::Err(e) {
                    self.push_error(e);
                },
                ResultType::Ok(rt) {
                    let fd = FunctionDeclaration {
                        identifier: method.value.identifier,
                        parameters: method.value.parameters,
                        return_type: TypeNode { value: rt, span: method.value.return_type.span },
                        block: method.value.block
                    };

                    self.current_function = OptionFunctionDeclaration::Some(fd);
                }
            }

            if (method.value.self_identifier matches OptionIdentifierNode::Some(self_node)) {
                match (self.resolve_type(&program, self_type, self_span)) {
                    ResultType::Err(e) {
                        self.push_error(e);
                    },
                    ResultType::Ok(t) {
                        if (
                            self.stack.declare_variable(
                                self_node.value,
                                t,
                                self_node.span
                            ) matches ResultSem::Err(err)
                        ) {
                            self.push_error(err);
                        } else {
                            self.identifier_hover(t, self_node);
                        }
                    }
                }
            }

            for (let p = 0; p < method.value.parameters.size(); p += 1) {
                let param = method.value.parameters[p];

                match (
                    self.resolve_type(
                        &program,
                        param.value.parameter_type.value,
                        param.value.parameter_type.span
                    )
                ) {
                    ResultType::Err(e) {
                        self.push_error(e);
                    },
                    ResultType::Ok(t) {
                        if (
                            self.stack.declare_variable(
                                param.value.identifier.value,
                                t,
                                param.value.identifier.span
                            ) matches ResultSem::Err(err)
                        ) {
                            self.push_error(err);
                        } else {
                            self.identifier_hover(t, param.value.identifier);
                        }
                    }
                }
            }

            self.visit_block(&program, method.value.block);

            self.unused_warn();
            self.current_function = OptionFunctionDeclaration::None;
            self.stack.pop_frame();
        }
    }

    fn unused_warn(self): void {
        let unused = self.stack.unused_in_last_scope();
        for (let i = 0; i < unused.size(); i += 1) {
            self.push_error(
                SemanticCheckerError.at(
                    ErrorSeverity::LOW,
                    "Unused variable '" + unused[i].name + "'.",
                    unused[i].span
                )
            );
        }
    }

    fn visit_block(self, &Program program, BlockNode block): void {
        self.stack.push_scope();
        for (let i = 0; i < block.value.statements.size(); i += 1) {
            self.visit_statement(&program, block.value.statements[i]);
        }
        self.unused_warn();
        self.stack.pop_scope();
    }

    fn visit_statement(self, &Program program, StatementNode statement): void {
        match (statement.value) {
            Statement::Declaration(decl) {
                self.check_declaration(&program, decl, statement.span);
            },
            Statement::Assignment(assign) {
                self.check_assignment(&program, assign, statement.span);
            },
            Statement::Conditional(cond) {
                self.check_if(&program, cond);
            },
            Statement::WhileLoop(w) {
                self.check_while(&program, w);
            },
            Statement::ForLoop(f) {
                self.check_for(&program, f);
            },
            Statement::Return(opt_expr) {
                self.check_return(&program, opt_expr, statement.span);
            },
            Statement::Break {
                if (!self.stack.can_break()) {
                    self.push_error(
                        SemanticCheckerError.at(
                            ErrorSeverity::HIGH,
                            "Break outside of a loop or switch.",
                            statement.span
                        )
                    );
                }
            },
            Statement::Continue {
                if (!self.stack.can_continue()) {
                    self.push_error(
                        SemanticCheckerError.at(
                            ErrorSeverity::HIGH,
                            "Continue outside of a loop.",
                            statement.span
                        )
                    );
                }
            },
            Statement::FunctionCall(call) {
                self.check_function_call(&program, call, statement.span);
            },
            Statement::Switch(sw) {
                self.check_switch(&program, sw);
            },
            Statement::Match(m) {
                self.check_match(&program, m);
            },
            Statement::Expression(expr) {
                self.visit_expression(&program, expr);
            },
            Statement::Import {}
        }
    }

    fn check_declaration(self, &Program program, DeclarationStatement decl, Span span): void {
        self.visit_expression(&program, decl.value);
        match (self.read_last(decl.value.span)) {
            ResultType::Err(e) {
                self.push_error(e);
            },
            ResultType::Ok(value_ty) {
                let final_ty = value_ty;
                if (decl.var_type matches OptionTypeNode::Some(tn)) {
                    match (self.resolve_type(&program, tn.value, tn.span)) {
                        ResultType::Err(e) {
                            self.push_error(e);
                        },
                        ResultType::Ok(ann) {
                            if (!ann.compatible(value_ty)) {
                                self.push_error(
                                    SemanticCheckerError.expected_found(
                                        ErrorSeverity::HIGH,
                                        "Type annotation does not match initializer.",
                                        ann.to_string(),
                                        value_ty.to_string(),
                                        span
                                    )
                                );
                            }
                            final_ty = ann;
                        }
                    }
                } else if (value_ty matches Type::Vector(inner)) {
                    if (inner matches Type::Void) {
                        self.push_error(
                            SemanticCheckerError.at(
                                ErrorSeverity::HIGH,
                                "Cannot create variable of type '"
                                    + value_ty.to_string()
                                    + "'. Add a type specifier e.g. let "
                                    + decl.identifier.value
                                    + ": i64[] = <expr>",
                                span
                            )
                        );
                    }
                }
                if (
                    self.stack.declare_variable(
                        decl.identifier.value,
                        final_ty,
                        decl.identifier.span
                    ) matches ResultSem::Err(e)
                ) {
                    self.push_error(e);
                } else {
                    self.identifier_hover(final_ty, decl.identifier);
                }
            }
        }
    }

    fn check_assignment(self, &Program program, AssignmentStatement assign, Span span): void {
        match (self.stack.get_variable(assign.identifier.value)) {
            OptionType::None {
                self.push_error(
                    SemanticCheckerError.at(
                        ErrorSeverity::HIGH,
                        "Variable '" + assign.identifier.value + "' not declared.",
                        assign.identifier.span
                    )
                );
                return;
            },
            OptionType::Some(base_ty) {
                let current = base_ty;
                for (let i = 0; i < assign.accessors.size(); i += 1) {
                    self.stack.mark_used(assign.identifier.value);
                    match (assign.accessors[i].value) {
                        Accessor::MethodCall {},
                        Accessor::Index(index_expr) {
                            self.visit_expression(&program, index_expr);
                            match (self.read_last(index_expr.span)) {
                                ResultType::Err(e) {
                                    self.push_error(e);
                                    return;
                                },
                                ResultType::Ok(idx_t) {
                                    if (idx_t not matches Type::I64) {
                                        self.push_error(
                                            SemanticCheckerError.at(
                                                ErrorSeverity::HIGH,
                                                "Array index must be of type `i64`.",
                                                index_expr.span
                                            )
                                        );
                                        return;
                                    }
                                }
                            }
                            match (current) {
                                Type::Vector(inner) {
                                    current = inner;
                                },
                                Type::Str {
                                    current = Type::Char;
                                },
                                rest {
                                    self.push_error(
                                        SemanticCheckerError.at(
                                            ErrorSeverity::HIGH,
                                            "Cannot index type '" + current.to_string() + "'.",
                                            assign.accessors[i].span
                                        )
                                    );
                                    return;
                                }
                            }
                        },
                        Accessor::Field(field) {
                            if (current matches Type::Unresolved(struct_name)) {
                                match (SemanticChecker.lookup_struct(&program, struct_name)) {
                                    OptionStructDeclaration::None {
                                        self.push_error(
                                            SemanticCheckerError.at(
                                                ErrorSeverity::HIGH,
                                                "Unknown struct '" + struct_name + "'.",
                                                field.span
                                            )
                                        );
                                        return;
                                    },
                                    OptionStructDeclaration::Some(s) {
                                        let found = false;
                                        for (let m = 0; m < s.members.size(); m += 1) {
                                            if (
                                                s.members[m].value.identifier.value == field.value
                                            ) {
                                                current = s.members[m].value.member_type.value;
                                                found = true;
                                            }
                                        }
                                        if (!found) {
                                            self.push_error(
                                                SemanticCheckerError.at(
                                                    ErrorSeverity::HIGH,
                                                    "Struct '"
                                                        + struct_name
                                                        + "' has no field '"
                                                        + field.value
                                                        + "'.",
                                                    field.span
                                                )
                                            );
                                            return;
                                        }
                                    }
                                }
                            } else {
                                self.push_error(
                                    SemanticCheckerError.at(
                                        ErrorSeverity::HIGH,
                                        "Cannot access field on type '"
                                            + current.to_string()
                                            + "'.",
                                        field.span
                                    )
                                );
                                return;
                            }
                        }
                    }
                }

                self.visit_expression(&program, assign.value);
                match (self.read_last(assign.value.span)) {
                    ResultType::Err(e) {
                        self.push_error(e);
                    },
                    ResultType::Ok(value_ty) {
                        if (assign.accessors.size() == 0) {
                            if (
                                self.stack.assign_variable(
                                    assign.identifier.value,
                                    value_ty,
                                    span
                                ) matches ResultSem::Err(e)
                            ) {
                                self.push_error(e);
                            }
                        } else if (!current.compatible(value_ty)) {
                            self.push_error(
                                SemanticCheckerError.expected_found(
                                    ErrorSeverity::HIGH,
                                    "Cannot assign incompatible type through accessors.",
                                    current.to_string(),
                                    value_ty.to_string(),
                                    span
                                )
                            );
                        }
                    }
                }
            }
        }
    }

    fn check_if(self, &Program program, ConditionalStatement cond): void {
        self.visit_expression(&program, cond.condition);
        match (self.read_last(cond.condition.span)) {
            ResultType::Err(e) {
                self.push_error(e);
            },
            ResultType::Ok(t) {
                if (t not matches Type::Bool) {
                    self.push_error(
                        SemanticCheckerError.at(
                            ErrorSeverity::HIGH,
                            "If condition must be bool, got '" + t.to_string() + "'.",
                            cond.condition.span
                        )
                    );
                }
            }
        }
        self.visit_block(&program, cond.if_block);
        if (cond.else_block matches OptionBlockNode::Some(b)) {
            self.visit_block(&program, b);
        }
    }

    fn check_while(self, &Program program, WhileLoopStatement w): void {
        self.visit_expression(&program, w.condition);
        match (self.read_last(w.condition.span)) {
            ResultType::Err(e) {
                self.push_error(e);
            },
            ResultType::Ok(t) {
                if (t not matches Type::Bool) {
                    self.push_error(
                        SemanticCheckerError.at(
                            ErrorSeverity::HIGH,
                            "While condition must be bool, got '" + t.to_string() + "'.",
                            w.condition.span
                        )
                    );
                }
            }
        }
        self.stack.enter_breakable();
        self.stack.enter_continuable();
        self.visit_block(&program, w.block);
        self.stack.leave_continuable();
        self.stack.leave_breakable();
    }

    fn check_for(self, &Program program, ForLoopStatement f): void {
        self.stack.push_scope();
        if (f.declaration matches OptionStatementNode::Some(st)) {
            self.visit_statement(&program, st);
        }
        self.visit_expression(&program, f.condition);
        match (self.read_last(f.condition.span)) {
            ResultType::Err(e) {
                self.push_error(e);
            },
            ResultType::Ok(t) {
                if (t not matches Type::Bool) {
                    self.push_error(
                        SemanticCheckerError.at(
                            ErrorSeverity::HIGH,
                            "For condition must be bool, got '" + t.to_string() + "'.",
                            f.condition.span
                        )
                    );
                }
            }
        }
        if (f.assignment matches OptionStatementNode::Some(st)) {
            self.visit_statement(&program, st);
        }
        self.stack.enter_breakable();
        self.stack.enter_continuable();
        self.visit_block(&program, f.block);
        self.stack.leave_continuable();
        self.stack.leave_breakable();
        self.stack.pop_scope();
    }

    fn check_return(self, &Program program, OptionExpressionNode opt_expr, Span span): void {
        let expected = Type::Void;
        match (self.current_function) {
            OptionFunctionDeclaration::Some(fd) {
                expected = fd.return_type.value;
            },
            OptionFunctionDeclaration::None {
                self.push_error(
                    SemanticCheckerError.at(
                        ErrorSeverity::HIGH,
                        "Return outside of a function.",
                        span
                    )
                );
                return;
            }
        }

        match (opt_expr) {
            OptionExpressionNode::None {
                if (expected not matches Type::Void) {
                    self.push_error(
                        SemanticCheckerError.at(
                            ErrorSeverity::HIGH,
                            "Function must return '" + expected.to_string() + "', got void.",
                            span
                        )
                    );
                }
            },
            OptionExpressionNode::Some(expr) {
                self.visit_expression(&program, expr);
                match (self.read_last(expr.span)) {
                    ResultType::Err(e) {
                        self.push_error(e);
                    },
                    ResultType::Ok(actual) {
                        if (!expected.compatible(actual)) {
                            self.push_error(
                                SemanticCheckerError.expected_found(
                                    ErrorSeverity::HIGH,
                                    "Return type mismatch.",
                                    expected.to_string(),
                                    actual.to_string(),
                                    span
                                )
                            );
                        }
                    }
                }
            }
        }
    }

    fn check_switch(self, &Program program, SwitchStatement sw): void {
        for (let i = 0; i < sw.expressions.size(); i += 1) {
            self.visit_expression(&program, sw.expressions[i].value.expression);
            match (self.read_last(sw.expressions[i].value.expression.span)) {
                ResultType::Err(e) {
                    self.push_error(e);
                },
                ResultType::Ok(alias_type) {
                    # `switch (expr: name)` declares `name` for the cases.
                    if (sw.expressions[i].value.alias matches OptionIdentifierNode::Some(alias)) {
                        if (
                            self.stack.declare_variable(
                                alias.value,
                                alias_type,
                                alias.span
                            ) matches ResultSem::Err(err)
                        ) {
                            self.push_error(
                                SemanticCheckerError.at(
                                    ErrorSeverity::HIGH,
                                    err.message,
                                    sw.expressions[i].span
                                )
                            );
                        }
                    }
                }
            }
        }
        self.stack.enter_breakable();
        for (let i = 0; i < sw.cases.size(); i += 1) {
            self.visit_expression(&program, sw.cases[i].value.condition);
            match (self.read_last(sw.cases[i].value.condition.span)) {
                ResultType::Err(e) {
                    self.push_error(e);
                },
                ResultType::Ok(t) {
                    if (t not matches Type::Bool) {
                        self.push_error(
                            SemanticCheckerError.at(
                                ErrorSeverity::HIGH,
                                "Switch case condition must be bool.",
                                sw.cases[i].value.condition.span
                            )
                        );
                    }
                }
            }
            self.visit_block(&program, sw.cases[i].value.block);
        }
        self.stack.leave_breakable();
    }

    fn check_match(self, &Program program, MatchStatement m): void {
        self.visit_expression(&program, m.expression);
        match (self.read_last(m.expression.span)) {
            ResultType::Err(e) {
                self.push_error(e);
            },
            ResultType::Ok(scrutinee) {
                if (scrutinee matches Type::Unresolved(enum_name)) {
                    match (SemanticChecker.lookup_enum(&program, enum_name)) {
                        OptionEnumDeclaration::None {
                            self.push_error(
                                SemanticCheckerError.at(
                                    ErrorSeverity::HIGH,
                                    "Match scrutinee type '" + enum_name + "' is not an enum.",
                                    m.expression.span
                                )
                            );
                        },
                        OptionEnumDeclaration::Some(ed) {
                            for (let i = 0; i < m.match_arms.size(); i += 1) {
                                let arm = m.match_arms[i];
                                if (arm.value.enum_name.value != enum_name) {
                                    self.push_error(
                                        SemanticCheckerError.at(
                                            ErrorSeverity::HIGH,
                                            "Match arm enum '"
                                                + arm.value.enum_name.value
                                                + "' does not match scrutinee '"
                                                + enum_name
                                                + "'.",
                                            arm.span
                                        )
                                    );
                                }
                                self.stack.push_scope();

                                for (let di = 0; di < program.declared_types.size(); di += 1) {
                                    if (
                                        program.declared_types[di].value matches DeclaredType::Enum(ee)
                                    ) {
                                        if (ee.identifier.value == arm.value.enum_name.value) {
                                            self.push_definition(
                                                arm.value.enum_name.span,
                                                program.declared_types[di].span
                                            );
                                            self.enum_hover(
                                                arm.value.enum_name.value,
                                                arm.value.enum_name.span
                                            );
                                        }
                                    }
                                }
                                for (let vv = 0; vv < ed.members.size(); vv += 1) {
                                    if (
                                        ed.members[vv].value.identifier.value
                                            == arm.value.variant_name.value
                                    ) {
                                        self.push_definition(
                                            arm.value.variant_name.span,
                                            ed.members[vv].span
                                        );
                                        let payload_txt = "";
                                        if (
                                            ed.members[vv].value.member_type matches OptionTypeNode::Some(ptn)
                                        ) {
                                            payload_txt = "(" + ptn.value.to_string() + ")";
                                        }
                                        let contents =
                                            "```raptor\nenum "
                                                + arm.value.enum_name.value
                                                + "::"
                                                + arm.value.variant_name.value
                                                + payload_txt
                                                + "\n```";
                                        self.hovers.push(
                                            HoverInfo {
                                                span: arm.value.variant_name.span,
                                                contents
                                            }
                                        );
                                    }
                                }

                                # bind payload if present
                                if (
                                    arm.value.variant_value matches OptionIdentifierNode::Some(bind)
                                ) {
                                    let payload_ty = Type::Void;
                                    let found_variant = false;
                                    for (let v = 0; v < ed.members.size(); v += 1) {
                                        if (
                                            ed.members[v].value.identifier.value
                                                == arm.value.variant_name.value
                                        ) {
                                            found_variant = true;
                                            match (ed.members[v].value.member_type) {
                                                OptionTypeNode::Some(tn) {
                                                    payload_ty = tn.value;
                                                },
                                                OptionTypeNode::None {
                                                    self.push_error(
                                                        SemanticCheckerError.at(
                                                            ErrorSeverity::HIGH,
                                                            "Variant '"
                                                                + arm.value.variant_name.value
                                                                + "' has no payload to bind.",
                                                            arm.span
                                                        )
                                                    );
                                                }
                                            }
                                        }
                                    }
                                    if (!found_variant) {
                                        self.push_error(
                                            SemanticCheckerError.at(
                                                ErrorSeverity::HIGH,
                                                "Unknown variant '"
                                                    + arm.value.variant_name.value
                                                    + "' on enum '"
                                                    + enum_name
                                                    + "'.",
                                                arm.value.variant_name.span
                                            )
                                        );
                                    } else if (
                                        self.stack.declare_variable(
                                            bind.value,
                                            payload_ty,
                                            bind.span
                                        ) matches ResultSem::Err(e)
                                    ) {
                                        self.push_error(e);
                                    }
                                }
                                self.visit_block(&program, arm.value.block);
                                self.unused_warn();
                                self.stack.pop_scope();
                            }

                            let has_rest = false;
                            if (m.rest_arm matches OptionBlockNode::Some) {
                                has_rest = true;
                            }
                            if (!has_rest) {
                                let missing = "";
                                let missing_count = 0;
                                for (let v = 0; v < ed.members.size(); v += 1) {
                                    let variant_name = ed.members[v].value.identifier.value;
                                    let covered = false;
                                    for (let a = 0; a < m.match_arms.size(); a += 1) {
                                        let arm = m.match_arms[a];
                                        if (
                                            arm.value.enum_name.value == enum_name
                                                && arm.value.variant_name.value == variant_name
                                        ) {
                                            covered = true;
                                        }
                                    }
                                    if (!covered) {
                                        if (missing_count > 0) {
                                            missing = missing + ", ";
                                        }
                                        missing = missing + enum_name + "::" + variant_name;
                                        missing_count += 1;
                                    }
                                }
                                if (missing_count > 0) {
                                    self.push_error(
                                        SemanticCheckerError.at(
                                            ErrorSeverity::HIGH,
                                            "Match is non-exhaustive: missing " + missing + ".",
                                            m.expression.span
                                        )
                                    );
                                }
                            }
                        }
                    }
                } else {
                    self.push_error(
                        SemanticCheckerError.at(
                            ErrorSeverity::HIGH,
                            "Match requires an enum scrutinee, got '"
                                + scrutinee.to_string()
                                + "'.",
                            m.expression.span
                        )
                    );
                }
            }
        }
        if (m.rest_arm matches OptionBlockNode::Some(b)) {
            self.visit_block(&program, b);
        }
    }

    fn visit_expression(self, &Program program, ExpressionNode expression): void {
        match (expression.value) {
            Expression::Literal(lit) {
                self.visit_literal(lit);
            },
            Expression::Variable(name) {
                self.visit_variable(name, expression.span);
            },
            Expression::Addition(bin) {
                self.binary(&program, bin, "add", expression.span);
            },
            Expression::Subtraction(bin) {
                self.binary(&program, bin, "sub", expression.span);
            },
            Expression::Multiplication(bin) {
                self.binary(&program, bin, "mul", expression.span);
            },
            Expression::Division(bin) {
                self.binary(&program, bin, "div", expression.span);
            },
            Expression::Modulo(bin) {
                self.binary(&program, bin, "mod", expression.span);
            },
            Expression::Equal(bin) {
                self.binary(&program, bin, "cmp", expression.span);
            },
            Expression::NotEqual(bin) {
                self.binary(&program, bin, "cmp", expression.span);
            },
            Expression::Greater(bin) {
                self.binary(&program, bin, "cmp", expression.span);
            },
            Expression::GreaterEqual(bin) {
                self.binary(&program, bin, "cmp", expression.span);
            },
            Expression::Less(bin) {
                self.binary(&program, bin, "cmp", expression.span);
            },
            Expression::LessEqual(bin) {
                self.binary(&program, bin, "cmp", expression.span);
            },
            Expression::Alternative(bin) {
                self.binary(&program, bin, "logic", expression.span);
            },
            Expression::Concatenation(bin) {
                self.binary(&program, bin, "logic", expression.span);
            },
            Expression::BooleanNegation(inner) {
                self.visit_expression(&program, inner);
                match (self.read_last(inner.span)) {
                    ResultType::Err(e) {
                        self.push_error(e);
                    },
                    ResultType::Ok(t) {
                        match (TypeALU.boolean_negation(t, expression.span)) {
                            ResultType::Err(e) {
                                self.push_error(e);
                            },
                            ResultType::Ok(r) {
                                self.set_last(r);
                            }
                        }
                    }
                }
            },
            Expression::ArithmeticNegation(inner) {
                self.visit_expression(&program, inner);
                match (self.read_last(inner.span)) {
                    ResultType::Err(e) {
                        self.push_error(e);
                    },
                    ResultType::Ok(t) {
                        match (TypeALU.arithmetic_negation(t, expression.span)) {
                            ResultType::Err(e) {
                                self.push_error(e);
                            },
                            ResultType::Ok(r) {
                                self.set_last(r);
                            }
                        }
                    }
                }
            },
            Expression::Casting(c) {
                self.visit_expression(&program, c.value);
                match (self.read_last(c.value.span)) {
                    ResultType::Err(e) {
                        self.push_error(e);
                    },
                    ResultType::Ok(from_ty) {
                        match (self.resolve_type(&program, c.to_type.value, c.to_type.span)) {
                            ResultType::Err(e) {
                                self.push_error(e);
                            },
                            ResultType::Ok(to_ty) {
                                match (TypeALU.cast(from_ty, to_ty, expression.span)) {
                                    ResultType::Err(e) {
                                        self.push_error(e);
                                    },
                                    ResultType::Ok(r) {
                                        self.set_last(r);
                                    }
                                }
                            }
                        }
                    }
                }
            },
            Expression::FunctionCall(call) {
                self.check_function_call(&program, call, expression.span);
            },
            Expression::FieldAccess(fa) {
                self.check_field_access(&program, fa, expression.span);
            },
            Expression::Index(idx) {
                self.check_index(&program, idx, expression.span);
            },
            Expression::Vector(elements) {
                self.check_vector_literal(&program, elements);
            },
            Expression::StructLiteral(sl) {
                self.check_struct_literal(&program, sl);
            },
            Expression::EnumLiteral(el) {
                self.check_enum_literal(&program, el, expression.span);
            },
            Expression::MethodCall(mc) {
                self.check_method_call(&program, &mc, &expression.span);
            }
        }
    }

    fn is_method_static(&Program program, &MethodCallExpression mc): OptionStr {
        if (mc.instance.value matches Expression::Variable(text)) {
            for (let i = 0; i < program.declared_types.size(); i += 1) {
                match (program.declared_types[i].value) {
                    DeclaredType::Struct(struct_declaration) {
                        if (text == struct_declaration.identifier.value) {
                            return OptionStr::Some(text);
                        }
                    },
                    DeclaredType::Enum(enum_declaration) {
                        if (text == enum_declaration.identifier.value) {
                            return OptionStr::Some(text);
                        }
                    }
                }
            }
        }

        return OptionStr::None;
    }

    fn find_extend_method(&Program program, &Type type, str method_name): OptionTypeMethodNode {
        let wanted = type.debug();
        for (let i = 0; i < program.extend_blocks.size(); i += 1) {
            let block_type = program.extend_blocks[i].type.value;
            if (block_type matches Type::Unresolved) {
                continue;
            }
            if (block_type.debug() != wanted) {
                continue;
            }
            for (let j = 0; j < program.extend_blocks[i].methods.size(); j += 1) {
                if (program.extend_blocks[i].methods[j].value.identifier.value == method_name) {
                    return OptionTypeMethodNode::Some(program.extend_blocks[i].methods[j]);
                }
            }
        }
        return OptionTypeMethodNode::None;
    }

    fn check_extend_method_call(
        self,
        &Program program,
        &Type type,
        &MethodCallExpression mc,
        &Span span
    ): bool {
        let found = SemanticChecker.find_extend_method(&program, &type, mc.field.value);
        if (found matches OptionTypeMethodNode::Some(method_node)) {
            let method = method_node.value;
            let type_name = type.to_string();

            if (method.self_identifier matches OptionIdentifierNode::None) {
                self.push_error(
                    SemanticCheckerError.at(
                        ErrorSeverity::HIGH,
                        "Method '"
                            + mc.field.value
                            + "' on type '"
                            + type_name
                            + "' is a static method",
                        span
                    )
                );
            }

            self.check_arguments(
                &program,
                mc.arguments,
                method.parameters,
                method.identifier.value,
                span
            );

            mc.target = MethodCallTarget::Instance(type_name);

            self.method_call_hover(type_name, &method, mc.field.span);
            self.push_definition(mc.field.span, method_node.span);

            match (self.resolve_type(&program, method.return_type.value, span)) {
                ResultType::Ok(return_type) {
                    self.set_last(return_type);
                },
                ResultType::Err(err) {
                    self.push_error(err);
                }
            }
            return true;
        }
        return false;
    }

    fn check_method_call(self, &Program program, &MethodCallExpression mc, &Span span): void {
        if (
            SemanticChecker.is_method_static(&program, &mc) matches OptionStr::Some(instance_name)
        ) {
            for (let i = 0; i < program.declared_types.size(); i += 1) {
                match (program.declared_types[i].value) {
                    DeclaredType::Struct(struct_declaration) {
                        if (struct_declaration.identifier.value != instance_name) {
                            continue;
                        }
                        let method_found = false;
                        for (let j = 0; j < struct_declaration.methods.size(); j += 1) {
                            let method = struct_declaration.methods[j].value;
                            let method_definition_span = struct_declaration.methods[j].span;
                            if (method.identifier.value == mc.field.value) {
                                method_found = true;
                            } else {
                                continue;
                            }

                            if (method.self_identifier matches OptionIdentifierNode::Some) {
                                self.push_error(
                                    SemanticCheckerError.at(
                                        ErrorSeverity::HIGH,
                                        "Method '"
                                            + mc.field.value
                                            + "' on type '"
                                            + instance_name
                                            + "' is not a static method",
                                        span
                                    )
                                );
                            }

                            self.check_arguments(
                                &program,
                                mc.arguments,
                                method.parameters,
                                method.identifier.value,
                                span
                            );

                            mc.target = MethodCallTarget::Type(instance_name);

                            self.method_call_hover(instance_name, &method, mc.field.span);
                            self.push_definition(mc.field.span, method_definition_span);

                            if (
                                self.resolve_type(
                                    &program,
                                    method.return_type.value,
                                    span
                                ) matches ResultType::Ok(return_type)
                            ) {
                                self.set_last(return_type);
                                return;
                            }
                        }
                        if (!method_found) {
                            self.push_error(
                                SemanticCheckerError.at(
                                    ErrorSeverity::HIGH,
                                    "Method '"
                                        + mc.field.value
                                        + "' doesn't exist on type '"
                                        + instance_name
                                        + "'.",
                                    span
                                )
                            );
                        }
                    },
                    DeclaredType::Enum(enum_declaration) {
                        if (enum_declaration.identifier.value != instance_name) {
                            continue;
                        }
                        let method_found = false;
                        for (let j = 0; j < enum_declaration.methods.size(); j += 1) {
                            let method = enum_declaration.methods[j].value;
                            let method_definition_span = enum_declaration.methods[j].span;
                            if (method.identifier.value == mc.field.value) {
                                method_found = true;
                            } else {
                                continue;
                            }

                            if (method.self_identifier matches OptionIdentifierNode::Some) {
                                self.push_error(
                                    SemanticCheckerError.at(
                                        ErrorSeverity::HIGH,
                                        "Method '"
                                            + mc.field.value
                                            + "' on type '"
                                            + instance_name
                                            + "' is not a static method",
                                        span
                                    )
                                );
                            }

                            self.check_arguments(
                                &program,
                                mc.arguments,
                                method.parameters,
                                method.identifier.value,
                                span
                            );

                            mc.target = MethodCallTarget::Type(instance_name);

                            self.method_call_hover(instance_name, &method, mc.field.span);
                            self.push_definition(mc.field.span, method_definition_span);

                            if (
                                self.resolve_type(
                                    &program,
                                    method.return_type.value,
                                    span
                                ) matches ResultType::Ok(return_type)
                            ) {
                                self.set_last(return_type);
                                return;
                            }
                        }
                        if (!method_found) {
                            self.push_error(
                                SemanticCheckerError.at(
                                    ErrorSeverity::HIGH,
                                    "Method '"
                                        + mc.field.value
                                        + "' doesn't exist on type '"
                                        + instance_name
                                        + "'.",
                                    span
                                )
                            );
                        }
                    }
                }
            }

            return;
        }

        self.visit_expression(&program, mc.instance);
        let result_type = self.read_last(span);
        if (result_type matches ResultType::Err(err)) {
            self.push_error(err);
        } else if (result_type matches ResultType::Ok(type)) {
            if (type matches Type::Unresolved(instance_name)) {
                for (let i = 0; i < program.declared_types.size(); i += 1) {
                    match (program.declared_types[i].value) {
                        DeclaredType::Struct(struct_declaration) {
                            if (struct_declaration.identifier.value != instance_name) {
                                continue;
                            }
                            let method_found = false;
                            for (let j = 0; j < struct_declaration.methods.size(); j += 1) {
                                let method = struct_declaration.methods[j].value;
                                let method_definition_span = struct_declaration.methods[j].span;
                                if (method.identifier.value == mc.field.value) {
                                    method_found = true;
                                } else {
                                    continue;
                                }

                                if (method.self_identifier matches OptionIdentifierNode::None) {
                                    self.push_error(
                                        SemanticCheckerError.at(
                                            ErrorSeverity::HIGH,
                                            "Method '"
                                                + mc.field.value
                                                + "' on type '"
                                                + instance_name
                                                + "' is a static method",
                                            span
                                        )
                                    );
                                }

                                self.check_arguments(
                                    &program,
                                    mc.arguments,
                                    method.parameters,
                                    method.identifier.value,
                                    span
                                );

                                mc.target = MethodCallTarget::Instance(instance_name);

                                self.method_call_hover(instance_name, &method, mc.field.span);
                                self.push_definition(mc.field.span, method_definition_span);

                                if (
                                    self.resolve_type(
                                        &program,
                                        method.return_type.value,
                                        span
                                    ) matches ResultType::Ok(return_type)
                                ) {
                                    self.set_last(return_type);
                                    return;
                                }
                            }
                            if (!method_found) {
                                self.push_error(
                                    SemanticCheckerError.at(
                                        ErrorSeverity::HIGH,
                                        "Method '"
                                            + mc.field.value
                                            + "' doesn't exist on type '"
                                            + instance_name
                                            + "'.",
                                        span
                                    )
                                );
                            }
                        },
                        DeclaredType::Enum(enum_declaration) {
                            if (enum_declaration.identifier.value != instance_name) {
                                continue;
                            }
                            let method_found = false;
                            for (let j = 0; j < enum_declaration.methods.size(); j += 1) {
                                let method = enum_declaration.methods[j].value;
                                let method_definition_span = enum_declaration.methods[j].span;
                                if (method.identifier.value == mc.field.value) {
                                    method_found = true;
                                } else {
                                    continue;
                                }

                                if (method.self_identifier matches OptionIdentifierNode::None) {
                                    self.push_error(
                                        SemanticCheckerError.at(
                                            ErrorSeverity::HIGH,
                                            "Method '"
                                                + mc.field.value
                                                + "' on type '"
                                                + instance_name
                                                + "' is a static method",
                                            span
                                        )
                                    );
                                }

                                mc.target = MethodCallTarget::Instance(instance_name);

                                self.method_call_hover(instance_name, &method, mc.field.span);
                                self.push_definition(mc.field.span, method_definition_span);

                                self.check_arguments(
                                    &program,
                                    mc.arguments,
                                    method.parameters,
                                    method.identifier.value,
                                    span
                                );

                                if (
                                    self.resolve_type(
                                        &program,
                                        method.return_type.value,
                                        span
                                    ) matches ResultType::Ok(return_type)
                                ) {
                                    self.set_last(return_type);
                                    return;
                                }
                            }
                            if (!method_found) {
                                self.push_error(
                                    SemanticCheckerError.at(
                                        ErrorSeverity::HIGH,
                                        "Method '"
                                            + mc.field.value
                                            + "' doesn't exist on type '"
                                            + instance_name
                                            + "'.",
                                        span
                                    )
                                );
                            }
                        }
                    }
                }
            } else {
                let imc = self.check_for_intrinsic_method_call(&program, &type, &mc);

                match (imc) {
                    CheckForIntrinsicMethodCallData::ErrorInCall(message) {
                        self.push_error(
                            SemanticCheckerError.at(ErrorSeverity::HIGH, message, span)
                        );
                    },
                    CheckForIntrinsicMethodCallData::NoTypeMatch {
                        if (self.check_extend_method_call(&program, &type, &mc, &span)) {
                            return;
                        }
                        self.push_error(
                            SemanticCheckerError.at(
                                ErrorSeverity::HIGH,
                                "Cannot call methods on type '" + type.to_string() + "'.",
                                span
                            )
                        );
                    },
                    CheckForIntrinsicMethodCallData::NoMethodMatchInType {
                        if (self.check_extend_method_call(&program, &type, &mc, &span)) {
                            return;
                        }
                        self.push_error(
                            SemanticCheckerError.at(
                                ErrorSeverity::HIGH,
                                "Method '"
                                    + mc.field.value
                                    + "' not found on type '"
                                    + type.to_string()
                                    + "'.",
                                span
                            )
                        );
                    },
                    CheckForIntrinsicMethodCallData::Ok {
                        mc.target = MethodCallTarget::Instance(type.to_string());
                    }
                }
            }
        }
    }

    fn visit_literal(self, Literal lit): void {
        match (lit) {
            Literal::True {
                self.set_last(Type::Bool);
            },
            Literal::False {
                self.set_last(Type::Bool);
            },
            Literal::String {
                self.set_last(Type::Str);
            },
            Literal::Char {
                self.set_last(Type::Char);
            },
            Literal::I64 {
                self.set_last(Type::I64);
            },
            Literal::F64 {
                self.set_last(Type::F64);
            }
        }
    }

    fn visit_variable(self, str name, Span span): void {
        match (self.stack.get_variable(name)) {
            OptionType::None {
                self.push_error(
                    SemanticCheckerError.at(
                        ErrorSeverity::HIGH,
                        "Variable '" + name + "' not declared.",
                        span
                    )
                );
            },
            OptionType::Some(t) {
                self.stack.mark_used(name);
                self.identifier_hover(t, IdentifierNode { value: name, span });
                if (
                    self.stack.get_variable_declaration_span(
                        name
                    ) matches OptionSpan::Some(def_span)
                ) {
                    self.push_definition(span, def_span);
                }
                self.set_last(t);
            }
        }
    }

    fn binary(self, &Program program, BinaryExpression bin, str kind, Span span): void {
        self.visit_expression(&program, bin.left);
        match (self.read_last(bin.left.span)) {
            ResultType::Err(e) {
                self.push_error(e);
                return;
            },
            ResultType::Ok(left) {
                self.visit_expression(&program, bin.right);
                match (self.read_last(bin.right.span)) {
                    ResultType::Err(e) {
                        self.push_error(e);
                        return;
                    },
                    ResultType::Ok(right) {
                        let result = ResultType::Err(SemanticCheckerError.at(
                            ErrorSeverity::HIGH,
                            "internal",
                            span
                        ));
                        if (kind == "add") {
                            result = TypeALU.add(left, right, span);
                        } else if (kind == "sub") {
                            result = TypeALU.subtract(left, right, span);
                        } else if (kind == "mul") {
                            result = TypeALU.multiply(left, right, span);
                        } else if (kind == "div") {
                            result = TypeALU.divide(left, right, span);
                        } else if (kind == "mod") {
                            result = TypeALU.modulo(left, right, span);
                        } else if (kind == "cmp") {
                            result = TypeALU.compare(left, right, span);
                        } else if (kind == "logic") {
                            result = TypeALU.logical(left, right, span);
                        }

                        match (result) {
                            ResultType::Err(e) {
                                self.push_error(e);
                            },
                            ResultType::Ok(t) {
                                self.set_last(t);
                            }
                        }
                    }
                }
            }
        }
    }

    fn check_field_access(self, &Program program, FieldAccessExpression fa, Span span): void {
        self.visit_expression(&program, fa.instance);
        match (self.read_last(fa.instance.span)) {
            ResultType::Err(e) {
                self.push_error(e);
            },
            ResultType::Ok(inst_ty) {
                if (inst_ty matches Type::Unresolved(struct_name)) {
                    match (SemanticChecker.lookup_struct(&program, struct_name)) {
                        OptionStructDeclaration::None {
                            self.push_error(
                                SemanticCheckerError.at(
                                    ErrorSeverity::HIGH,
                                    "Unknown struct '" + struct_name + "'.",
                                    span
                                )
                            );
                        },
                        OptionStructDeclaration::Some(s) {
                            let found = false;
                            for (let m = 0; m < s.members.size(); m += 1) {
                                if (s.members[m].value.identifier.value == fa.field.value) {
                                    found = true;
                                    match (
                                        self.resolve_type(
                                            &program,
                                            s.members[m].value.member_type.value,
                                            fa.field.span
                                        )
                                    ) {
                                        ResultType::Err(e) {
                                            self.push_error(e);
                                        },
                                        ResultType::Ok(ft) {
                                            self.identifier_hover(ft, fa.field);
                                            self.push_definition(
                                                fa.field.span,
                                                s.members[m].value.identifier.span
                                            );
                                            self.set_last(ft);
                                        }
                                    }
                                }
                            }
                            if (!found) {
                                self.push_error(
                                    SemanticCheckerError.at(
                                        ErrorSeverity::HIGH,
                                        "Struct '"
                                            + struct_name
                                            + "' has no field '"
                                            + fa.field.value
                                            + "'.",
                                        fa.field.span
                                    )
                                );
                            }
                        }
                    }
                } else {
                    self.push_error(
                        SemanticCheckerError.at(
                            ErrorSeverity::HIGH,
                            "Cannot access field on type '" + inst_ty.to_string() + "'.",
                            span
                        )
                    );
                }
            }
        }
    }

    fn check_index(self, &Program program, IndexExpression idx, Span span): void {
        self.visit_expression(&program, idx.collection);
        match (self.read_last(idx.collection.span)) {
            ResultType::Err(e) {
                self.push_error(e);
            },
            ResultType::Ok(col_ty) {
                self.visit_expression(&program, idx.index);
                match (self.read_last(idx.index.span)) {
                    ResultType::Err(e) {
                        self.push_error(e);
                    },
                    ResultType::Ok(idx_ty) {
                        if (idx_ty not matches Type::I64) {
                            self.push_error(
                                SemanticCheckerError.at(
                                    ErrorSeverity::HIGH,
                                    "Array index must be of type `i64`.",
                                    idx.index.span
                                )
                            );
                        }
                        match (col_ty) {
                            Type::Vector(inner) {
                                self.set_last(inner);
                            },
                            Type::Str {
                                self.set_last(Type::Char);
                            },
                            rest {
                                self.push_error(
                                    SemanticCheckerError.at(
                                        ErrorSeverity::HIGH,
                                        "Cannot index type '" + col_ty.to_string() + "'.",
                                        span
                                    )
                                );
                            }
                        }
                    }
                }
            }
        }
    }

    fn check_vector_literal(self, &Program program, ExpressionNode[] elements): void {
        if (elements.size() == 0) {
            self.set_last(Type::Vector(Type::Void));
            return;
        }
        self.visit_expression(&program, elements[0]);
        match (self.read_last(elements[0].span)) {
            ResultType::Err(e) {
                self.push_error(e);
            },
            ResultType::Ok(elem_ty) {
                for (let i = 1; i < elements.size(); i += 1) {
                    self.visit_expression(&program, elements[i]);
                    match (self.read_last(elements[i].span)) {
                        ResultType::Err(e) {
                            self.push_error(e);
                        },
                        ResultType::Ok(t) {
                            if (!elem_ty.eq(t)) {
                                self.push_error(
                                    SemanticCheckerError.expected_found(
                                        ErrorSeverity::HIGH,
                                        "Vector literal elements must have the same type.",
                                        elem_ty.to_string(),
                                        t.to_string(),
                                        elements[i].span
                                    )
                                );
                            }
                        }
                    }
                }
                self.set_last(Type::Vector(elem_ty));
            }
        }
    }

    fn check_struct_literal(self, &Program program, StructLiteralNode node): void {
        let struct_name = node.value.identifier.value;
        match (SemanticChecker.lookup_struct(&program, struct_name)) {
            OptionStructDeclaration::None {
                self.push_error(
                    SemanticCheckerError.at(
                        ErrorSeverity::HIGH,
                        "Unknown struct '" + struct_name + "'.",
                        node.span
                    )
                );
            },
            OptionStructDeclaration::Some(s) {
                for (let di = 0; di < program.declared_types.size(); di += 1) {
                    if (program.declared_types[di].value matches DeclaredType::Struct(ss)) {
                        if (ss.identifier.value == struct_name) {
                            self.push_definition(
                                node.value.identifier.span,
                                program.declared_types[di].span
                            );
                            self.struct_hover(struct_name, node.value.identifier.span);
                        }
                    }
                }
                let seen: str[] = [];
                for (let i = 0; i < node.value.fields.size(); i += 1) {
                    let field = node.value.fields[i];
                    let field_name = field.value.identifier.value;
                    for (let j = 0; j < seen.size(); j += 1) {
                        if (seen[j] == field_name) {
                            self.push_error(
                                SemanticCheckerError.at(
                                    ErrorSeverity::HIGH,
                                    "Field `" + field_name + "` is specified more than once.",
                                    field.value.identifier.span
                                )
                            );
                        }
                    }
                    seen.push(field_name);

                    let expected = Type::Void;
                    let found_field = false;
                    for (let m = 0; m < s.members.size(); m += 1) {
                        if (s.members[m].value.identifier.value == field_name) {
                            found_field = true;
                            expected = s.members[m].value.member_type.value;
                        }
                    }
                    if (!found_field) {
                        self.push_error(
                            SemanticCheckerError.at(
                                ErrorSeverity::HIGH,
                                "Struct '" + struct_name + "' has no field '" + field_name + "'.",
                                field.value.identifier.span
                            )
                        );
                    } else {
                        self.visit_expression(&program, field.value.value);
                        match (self.read_last(field.value.value.span)) {
                            ResultType::Err(e) {
                                self.push_error(e);
                            },
                            ResultType::Ok(actual) {
                                match (self.resolve_type(&program, expected, field.span)) {
                                    ResultType::Err(e) {
                                        self.push_error(e);
                                    },
                                    ResultType::Ok(exp) {
                                        if (!exp.compatible(actual)) {
                                            self.push_error(
                                                SemanticCheckerError.expected_found(
                                                    ErrorSeverity::HIGH,
                                                    "Cannot assign a value of type `"
                                                        + actual.to_string()
                                                        + "` to field `"
                                                        + field_name
                                                        + "` of struct `"
                                                        + struct_name
                                                        + "`.",
                                                    exp.to_string(),
                                                    actual.to_string(),
                                                    field.span
                                                )
                                            );
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                for (let m = 0; m < s.members.size(); m += 1) {
                    let expected_name = s.members[m].value.identifier.value;
                    let present = false;
                    for (let j = 0; j < seen.size(); j += 1) {
                        if (seen[j] == expected_name) {
                            present = true;
                        }
                    }
                    if (!present) {
                        self.push_error(
                            SemanticCheckerError.at(
                                ErrorSeverity::HIGH,
                                "Missing field `"
                                    + expected_name
                                    + "` in initializer of struct `"
                                    + struct_name
                                    + "`.",
                                node.span
                            )
                        );
                    }
                }
                self.set_last(Type::Unresolved(struct_name));
            }
        }
    }

    fn check_enum_literal(self, &Program program, EnumLiteralExpression el, Span span): void {
        let enum_name = el.enum_name.value;
        match (SemanticChecker.lookup_enum(&program, enum_name)) {
            OptionEnumDeclaration::None {
                self.push_error(
                    SemanticCheckerError.at(
                        ErrorSeverity::HIGH,
                        "Unknown enum '" + enum_name + "'.",
                        el.enum_name.span
                    )
                );
            },
            OptionEnumDeclaration::Some(ed) {
                let found = false;
                let expected_payload = OptionTypeNode::None;
                for (let i = 0; i < ed.members.size(); i += 1) {
                    if (ed.members[i].value.identifier.value == el.variant_name.value) {
                        found = true;
                        expected_payload = ed.members[i].value.member_type;
                    }
                }
                if (!found) {
                    self.push_error(
                        SemanticCheckerError.at(
                            ErrorSeverity::HIGH,
                            "Unknown variant '"
                                + el.variant_name.value
                                + "' on enum '"
                                + enum_name
                                + "'.",
                            el.variant_name.span
                        )
                    );
                    return;
                }

                for (let di = 0; di < program.declared_types.size(); di += 1) {
                    if (program.declared_types[di].value matches DeclaredType::Enum(ee)) {
                        if (ee.identifier.value == enum_name) {
                            self.push_definition(
                                el.enum_name.span,
                                program.declared_types[di].span
                            );
                            self.enum_hover(enum_name, el.enum_name.span);
                        }
                    }
                }
                for (let mi = 0; mi < ed.members.size(); mi += 1) {
                    if (ed.members[mi].value.identifier.value == el.variant_name.value) {
                        self.push_definition(el.variant_name.span, ed.members[mi].span);
                        let payload_txt = "";
                        if (ed.members[mi].value.member_type matches OptionTypeNode::Some(ptn)) {
                            payload_txt = "(" + ptn.value.to_string() + ")";
                        }
                        let contents =
                            "```raptor\nenum "
                                + enum_name
                                + "::"
                                + el.variant_name.value
                                + payload_txt
                                + "\n```";
                        self.hovers.push(HoverInfo { span: el.variant_name.span, contents });
                    }
                }

                match (expected_payload) {
                    OptionTypeNode::Some(tn) {
                        match (el.variant_value) {
                            OptionExpressionNode::None {
                                self.push_error(
                                    SemanticCheckerError.at(
                                        ErrorSeverity::HIGH,
                                        "Enum '"
                                            + enum_name
                                            + "' variant '"
                                            + el.variant_name.value
                                            + "' expected value of type '"
                                            + tn.value.to_string()
                                            + "'.",
                                        span
                                    )
                                );
                            },
                            OptionExpressionNode::Some(expr) {
                                self.visit_expression(&program, expr);
                                match (self.read_last(expr.span)) {
                                    ResultType::Err(e) {
                                        self.push_error(e);
                                    },
                                    ResultType::Ok(actual) {
                                        match (self.resolve_type(&program, tn.value, expr.span)) {
                                            ResultType::Err(e) {
                                                self.push_error(e);
                                            },
                                            ResultType::Ok(exp) {
                                                if (!exp.compatible(actual)) {
                                                    self.push_error(
                                                        SemanticCheckerError.at(
                                                            ErrorSeverity::HIGH,
                                                            "Enum '"
                                                                + enum_name
                                                                + "' variant '"
                                                                + el.variant_name.value
                                                                + "' expects value of type '"
                                                                + exp.to_string()
                                                                + "', found '"
                                                                + actual.to_string()
                                                                + "'.",
                                                            expr.span
                                                        )
                                                    );
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    OptionTypeNode::None {
                        if (el.variant_value matches OptionExpressionNode::Some(expr)) {
                            self.visit_expression(&program, expr);
                            match (self.read_last(expr.span)) {
                                ResultType::Err(e) {
                                    self.push_error(e);
                                },
                                ResultType::Ok(actual) {
                                    self.push_error(
                                        SemanticCheckerError.at(
                                            ErrorSeverity::HIGH,
                                            "Enum '"
                                                + enum_name
                                                + "' variant '"
                                                + el.variant_name.value
                                                + "' doesn't expect any value. Provided '"
                                                + actual.to_string()
                                                + "'.",
                                            el.enum_name.span
                                        )
                                    );
                                }
                            }
                        }
                    }
                }
                self.set_last(Type::Unresolved(enum_name));
            }
        }
    }

    fn check_function_call(self, &Program program, FunctionCallExpression call, Span span): void {
        let name = call.identifier.value;

        # User functions
        let found_fn = OptionFunctionDeclaration::None;
        for (let i = 0; i < program.functions.size(); i += 1) {
            if (program.functions[i].value.identifier.value == name) {
                found_fn = OptionFunctionDeclaration::Some(program.functions[i].value);
            }
        }

        # Externs
        let found_extern = false;
        let extern_ret = Type::Void;
        for (let i = 0; i < program.extern_functions.size(); i += 1) {
            let ef = program.extern_functions[i].value;
            let effective = ef.identifier.value;
            if (ef.alias matches OptionIdentifierNode::Some(a)) {
                effective = a.value;
            }
            if (effective == name) {
                found_extern = true;
                extern_ret = ef.return_type.value;
            }
        }

        if (found_fn matches OptionFunctionDeclaration::Some(fd)) {
            self.function_hover(name, fd.parameters, fd.return_type.value, call.identifier.span);
            for (let fi = 0; fi < program.functions.size(); fi += 1) {
                if (program.functions[fi].value.identifier.value == name) {
                    self.push_definition(
                        call.identifier.span,
                        program.functions[fi].value.identifier.span
                    );
                }
            }
            self.check_arguments(&program, call.arguments, fd.parameters, name, span);
            match (self.resolve_type(&program, fd.return_type.value, fd.return_type.span)) {
                ResultType::Err(e) {
                    self.push_error(e);
                },
                ResultType::Ok(rt) {
                    self.set_last(rt);
                }
            }
            return;
        }

        if (found_extern) {
            for (let ei = 0; ei < program.extern_functions.size(); ei += 1) {
                let ef = program.extern_functions[ei].value;
                let effective = ef.identifier.value;
                if (ef.alias matches OptionIdentifierNode::Some(a)) {
                    effective = a.value;
                }
                if (effective == name) {
                    self.function_hover(
                        name,
                        ef.parameters,
                        ef.return_type.value,
                        call.identifier.span
                    );
                    self.push_definition(call.identifier.span, ef.identifier.span);
                }
            }
            for (let i = 0; i < call.arguments.size(); i += 1) {
                self.visit_expression(&program, call.arguments[i].value.value);
                if (self.read_last(call.arguments[i].value.value.span) matches ResultType::Err(e)) {
                    self.push_error(e);
                }
            }
            match (self.resolve_type(&program, extern_ret, span)) {
                ResultType::Err(e) {
                    self.push_error(e);
                },
                ResultType::Ok(rt) {
                    self.set_last(rt);
                }
            }
            return;
        }

        # Built-in std functions
        if (self.std_function_registry.lookup(name) matches OptionStdFunction::Some(std_fn)) {
            let collected: Type[] = [];
            let arg_exprs: Expression[] = [];
            let arg_spans: Span[] = [];

            for (let i = 0; i < call.arguments.size(); i += 1) {
                self.visit_expression(&program, call.arguments[i].value.value);
                match (self.read_last(call.arguments[i].value.value.span)) {
                    ResultType::Err(e) {
                        self.push_error(e);
                    },
                    ResultType::Ok(t) {
                        let argument_passed_by = call.arguments[i].value.passed_by.debug();
                        let parameter_passed_by = std_fn.passed_by[i].debug();

                        if (argument_passed_by != parameter_passed_by) {
                            self.push_error(
                                SemanticCheckerError.at(
                                    ErrorSeverity::HIGH,
                                    "Argument passing mode mismatch in call to '"
                                        + name
                                        + "': expected "
                                        + parameter_passed_by
                                        + ", got "
                                        + argument_passed_by
                                        + ".",
                                    call.arguments[i].span
                                )
                            );
                        }
                        collected.push(t);
                    }
                }
                arg_exprs.push(call.arguments[i].value.value.value);
                arg_spans.push(call.arguments[i].span);
            }

            if (collected.size() == call.arguments.size()) {
                match (
                    SemanticChecker.check_std_call(collected, arg_exprs, arg_spans, std_fn, span)
                ) {
                    ResultType::Ok(rt) {
                        self.set_last(rt);
                    },
                    ResultType::Err(e) {
                        self.push_error(e);
                    }
                }
            }
            return;
        }

        # Truly unknown
        for (let i = 0; i < call.arguments.size(); i += 1) {
            self.visit_expression(&program, call.arguments[i].value.value);
            if (self.read_last(call.arguments[i].value.value.span) matches ResultType::Err(e)) {
                self.push_error(e);
            }
        }
        self.push_error(
            SemanticCheckerError.at(ErrorSeverity::HIGH, "Unknown function '" + name + "'.", span)
        );
    }

    fn check_arguments(
        self,
        &Program program,
        ArgumentNode[] arguments,
        ParameterNode[] parameters,
        str name,
        Span span
    ): void {
        if (arguments.size() != parameters.size()) {
            self.push_error(
                SemanticCheckerError.at(
                    ErrorSeverity::HIGH,
                    "Function '"
                        + name
                        + "' expects "
                        + parameters.size() as str
                        + " argument(s), got "
                        + arguments.size() as str
                        + ".",
                    span
                )
            );
        }

        let n = arguments.size();
        if (parameters.size() < n) {
            n = parameters.size();
        }

        for (let i = 0; i < n; i += 1) {
            self.visit_expression(&program, arguments[i].value.value);

            match (self.read_last(arguments[i].value.value.span)) {
                ResultType::Err(e) {
                    self.push_error(e);
                },
                ResultType::Ok(actual) {
                    match (
                        self.resolve_type(
                            &program,
                            parameters[i].value.parameter_type.value,
                            parameters[i].span
                        )
                    ) {
                        ResultType::Err(e) {
                            self.push_error(e);
                        },
                        ResultType::Ok(expected) {
                            if (!expected.compatible(actual)) {
                                self.push_error(
                                    SemanticCheckerError.expected_found(
                                        ErrorSeverity::HIGH,
                                        "Argument type mismatch in call to '" + name + "'.",
                                        expected.to_string(),
                                        actual.to_string(),
                                        arguments[i].span
                                    )
                                );
                            }

                            let argument_passed_by = arguments[i].value.passed_by.debug();
                            let parameter_passed_by = parameters[i].value.passed_by.debug();

                            if (argument_passed_by != parameter_passed_by) {
                                self.push_error(
                                    SemanticCheckerError.at(
                                        ErrorSeverity::HIGH,
                                        "Argument passing mode mismatch in call to '"
                                            + name
                                            + "': expected "
                                            + parameter_passed_by
                                            + ", got "
                                            + argument_passed_by
                                            + ".",
                                        arguments[i].span
                                    )
                                );
                            }
                        }
                    }
                }
            }
        }
    }
};
