import "../../common/errors.rp";
import "../../common/span.rp";
import "../../frontend/parser/ast.rp";
import "../semantic-helpers.rp";


struct VariableInfo {
    str name,
    Type ty,
    Span span,
    bool used
};

struct Scope {
    VariableInfo[] variables
};

enum OptionSpan {
    Some(Span),
    None
};

struct StackFrame {
    Scope[] scopes,
    i64 breakable_count,
    i64 continuable_count

    fn new(): StackFrame {
        let scopes: Scope[] = [];
        scopes.push(Scope { variables: [] });
        return StackFrame { scopes, breakable_count: 0, continuable_count: 0 };
    }
};

struct StaticCheckerStack {
    StackFrame[] frames

    fn new(): StaticCheckerStack {
        let frames: StackFrame[] = [];
        let frame = StackFrame.new();
        frames.push(frame);
        return StaticCheckerStack { frames };
    }

    fn push_frame(self): void {
        self.frames.push(StackFrame.new());
    }

    fn pop_frame(self): void {
        if (self.frames.size() == 0) {
            return;
        }
        let new_frames: StackFrame[] = [];
        for (let i = 0; i < self.frames.size() - 1; i += 1) {
            new_frames.push(self.frames[i]);
        }
        self.frames = new_frames;
    }

    fn current_frame(self): StackFrame {
        return self.frames[self.frames.size() - 1];
    }

    fn set_current_frame(self, StackFrame frame): void {
        self.frames[self.frames.size() - 1] = frame;
    }

    fn push_scope(self): void {
        let frame = self.current_frame();
        frame.scopes.push(Scope { variables: [] });
        self.set_current_frame(frame);
    }

    fn pop_scope(self): VariableInfo[] {
        let frame = self.current_frame();
        if (frame.scopes.size() == 0) {
            let empty: VariableInfo[] = [];
            return empty;
        }
        let last = frame.scopes[frame.scopes.size() - 1];
        let new_scopes: Scope[] = [];
        for (let i = 0; i < frame.scopes.size() - 1; i += 1) {
            new_scopes.push(frame.scopes[i]);
        }
        frame.scopes = new_scopes;
        self.set_current_frame(frame);
        return last.variables;
    }

    fn enter_breakable(self): void {
        let frame = self.current_frame();
        frame.breakable_count += 1;
        self.set_current_frame(frame);
    }

    fn leave_breakable(self): void {
        let frame = self.current_frame();
        if (frame.breakable_count > 0) {
            frame.breakable_count -= 1;
        }
        self.set_current_frame(frame);
    }

    fn enter_continuable(self): void {
        let frame = self.current_frame();
        frame.continuable_count += 1;
        self.set_current_frame(frame);
    }

    fn leave_continuable(self): void {
        let frame = self.current_frame();
        if (frame.continuable_count > 0) {
            frame.continuable_count -= 1;
        }
        self.set_current_frame(frame);
    }

    fn can_break(self): bool {
        return self.current_frame().breakable_count > 0;
    }

    fn can_continue(self): bool {
        return self.current_frame().continuable_count > 0;
    }

    fn declare_variable(self, str name, Type ty, Span span): ResultSem {
        let frame = self.current_frame();
        let scope_idx = frame.scopes.size() - 1;
        let scope = frame.scopes[scope_idx];

        for (let i = 0; i < scope.variables.size(); i += 1) {
            if (scope.variables[i].name == name) {
                return ResultSem::Err(SemanticCheckerError.new(
                    ErrorSeverity::HIGH,
                    "Cannot redeclare variable '" + name + "'.",
                    span
                ));
            }
        }

        scope.variables.push(VariableInfo { name, ty, span, used: false });
        frame.scopes[scope_idx] = scope;
        self.set_current_frame(frame);
        return ResultSem::Ok;
    }

    fn get_variable_declaration_span(self, str name): OptionSpan {
        let frame = self.current_frame();
        for (let s = frame.scopes.size(); s > 0; s -= 1) {
            let scope = frame.scopes[s - 1];
            for (let i = 0; i < scope.variables.size(); i += 1) {
                if (scope.variables[i].name == name) {
                    return OptionSpan::Some(scope.variables[i].span);
                }
            }
        }
        return OptionSpan::None;
    }

    fn get_variable(self, str name): OptionType {
        let frame = self.current_frame();

        # innermost scope first
        for (let s = frame.scopes.size(); s > 0; s -= 1) {
            let scope = frame.scopes[s - 1];
            for (let i = 0; i < scope.variables.size(); i += 1) {
                if (scope.variables[i].name == name) {
                    return OptionType::Some(scope.variables[i].ty);
                }
            }
        }
        return OptionType::None;
    }

    fn mark_used(self, str name): void {
        let frame = self.current_frame();
        for (let s = frame.scopes.size(); s > 0; s -= 1) {
            let scope = frame.scopes[s - 1];
            for (let i = 0; i < scope.variables.size(); i += 1) {
                if (scope.variables[i].name == name) {
                    scope.variables[i].used = true;
                    frame.scopes[s - 1] = scope;
                    self.set_current_frame(frame);
                    return;
                }
            }
        }
    }

    fn assign_variable(self, str name, Type value, Span span): ResultSem {
        let frame = self.current_frame();
        for (let s = frame.scopes.size(); s > 0; s -= 1) {
            let scope = frame.scopes[s - 1];
            for (let i = 0; i < scope.variables.size(); i += 1) {
                if (scope.variables[i].name == name) {
                    let prev = scope.variables[i].ty;
                    if (prev.eq(value)) {
                        return ResultSem::Ok;
                    }
                    return ResultSem::Err(SemanticCheckerError.new(
                        ErrorSeverity::HIGH,
                        "Cannot assign '"
                            + value.to_string()
                            + "' to variable '"
                            + name
                            + "' which was previously declared as '"
                            + prev.to_string()
                            + "'.",
                        span
                    ));
                }
            }
        }
        return ResultSem::Err(SemanticCheckerError.new(
            ErrorSeverity::HIGH,
            "Variable '" + name + "' not declared.",
            span
        ));
    }

    fn unused_in_last_scope(self): VariableInfo[] {
        let frame = self.current_frame();
        let unused: VariableInfo[] = [];
        if (frame.scopes.size() == 0) {
            return unused;
        }
        let scope = frame.scopes[frame.scopes.size() - 1];
        for (let i = 0; i < scope.variables.size(); i += 1) {
            if (!scope.variables[i].used) {
                unused.push(scope.variables[i]);
            }
        }
        return unused;
    }
};
