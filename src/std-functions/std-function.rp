import "../frontend/parser/ast.rp";
import "../common/errors.rp";
import "../common/span.rp";
import "../semantic-checker/semantic-helpers.rp";


enum StdTypeCheckKind {
    None,
    VectorPush,
    VectorSize,
    VectorStringify,
    VectorExtend,
    StrToCharVector,
    CharVectorToStr
};

struct StdFunction {
    str name,
    Type[] params,
    PassedBy[] passed_by,
    Type return_type,
    StdTypeCheckKind type_check_kind

    fn new(
        str name,
        Type[] params,
        PassedBy[] passed_by,
        Type return_type,
        StdTypeCheckKind type_check_kind
    ): StdFunction {
        return StdFunction { name, params, passed_by, return_type, type_check_kind };
    }
};
