extend i64[] {
    fn sum(self): i64 {
        let result = 0;

        for (let i = 0; i < self.size(); i += 1) {
            result += self[i];
        }

        return result;
    }
};

extend i64[][] {
    fn total(self): i64 {
        let result = 0;

        for (let i = 0; i < self.size(); i += 1) {
            result += self[i].sum();
        }

        return result;
    }
};


let matrix = [[1, 2], [3, 4]];
println(matrix.total() as str);
println(matrix[1].sum() as str);
