struct Point {
    i64 x,
    i64 y

    fn sum(self): i64 {
        return self.x + self.y;
    }
};


extend Point {
    fn double_x(self): i64 {
        return self.x * 2;
    }
};

extend Point {
    fn double_y(self): i64 {
        return self.y * 2;
    }
};

extend Point {
    fn origin(): Point {
        return Point { x: 0, y: 0 };
    }
};


let p = Point { x: 3, y: 4 };
println(p.sum() as str);
println(p.double_x() as str);
println(p.double_y() as str);
println(Point.origin().sum() as str);
