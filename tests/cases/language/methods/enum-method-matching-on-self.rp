enum Color {
    Red,
    Green

    fn label(self): str {
        match (self) {
            Color::Red {
                return "red";
            },
            Color::Green {
                return "green";
            }
        }
        return "?";
    }
};

let c = Color::Green;
let r = Color::Red;
println(c.label());
println(r.label());
