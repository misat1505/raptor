import "../../../stdlib/vector.rp";

fn showb(&bool[] v): str {
    let out = "[";
    for (let i = 0; i < v.size(); i += 1) {
        if (i > 0) {
            out += ",";
        }
        out += v[i] as str;
    }
    return out + "]";
}

let bs = [true, false, true];
let bt = [true, true];
let be: bool[] = [];
println((bs.contains(false)) as str);
println((bt.contains(false)) as str);
println((be.contains(true)) as str);
println((bt.all(true)) as str);
println((bs.all(true)) as str);
println((be.all(true)) as str);
println((bs.any(false)) as str);
println((bt.any(false)) as str);
println((be.any(true)) as str);
println((bs.count(true)) as str);
println((bs.count(false)) as str);
println((be.count(true)) as str);
println(showb(&bs.negate()));
println(showb(&be.negate()));
println(showb(&bs));
