import "../../../stdlib/vector.rp";

fn show(&i64[] v): str {
    let out = "[";
    for (let i = 0; i < v.size(); i += 1) {
        if (i > 0) {
            out += ",";
        }
        out += v[i] as str;
    }
    return out + "]";
}

let v = [3, 1, 2, 3];
let e: i64[] = [];
let one = [7];

println((e.is_empty()) as str);
println((v.is_empty()) as str);
println((v.contains(2)) as str);
println((v.contains(9)) as str);
println((e.contains(1)) as str);
println((v.index_of(3)) as str);
println((v.index_of(9)) as str);
println((v.last_index_of(3)) as str);
println((v.last_index_of(9)) as str);
println((v.first()) as str);
println((v.last()) as str);
println((one.first()) as str);
println((one.last()) as str);
println((v.sum()) as str);
println((e.sum()) as str);
println((v.min()) as str);
println((v.max()) as str);
println((e.min()) as str);
println((e.max()) as str);
println(v.average() as str);
println(e.average() as str);
println(show(&v.reverse()));
println(show(&v.copy()));
println(show(&v.remove_at(1)));
println(show(&v.remove_at(99)));
println(show(&v.remove_at(-1)));
println(show(&v.remove_value(3)));
println(show(&v.remove_value(9)));
println((v.count(3)) as str);
println((v.count(9)) as str);
println(show(&v.distinct()));

let w = [8, 9];
println(show(&v.concat(&w)));
println(show(&e.concat(&w)));
println(show(&v.take(2)));
println(show(&v.take(0)));
println(show(&v.take(99)));
println(show(&v.skip(2)));
println(show(&v.skip(0)));
println(show(&v.skip(99)));
println(show(&v.slice(1, 3)));
println(show(&v.slice(2, 2)));
println(show(&v.sort()));
println(show(&v.sort_desc()));
println(show(&e.sort()));

let unsorted = [5, -2, 9, 0, -2];
println(show(&unsorted.sort()));
println(show(&unsorted));

let r = [1, 2, 3, 4];
r.reverse_in_place();
println(show(&r));
r.swap(0, 3);
println(show(&r));
r.swap(-1, 2);
r.swap(0, 99);
println(show(&r));

let one_r = [5];
one_r.reverse_in_place();

let empty_r: i64[] = [];
empty_r.reverse_in_place();

println(show(&one_r));
println(show(&empty_r));