import "../../../stdlib/vector.rp";

fn show(&str[] v): str {
    let out = "[";
    for (let i = 0; i < v.size(); i += 1) {
        if (i > 0) {
            out += ",";
        }
        out += v[i];
    }
    return out + "]";
}

let v = ["b", "a", "c", "a"];
let e: str[] = [];
let w = ["x", "y"];

println((e.is_empty()) as str);
println((v.is_empty()) as str);
println((v.contains("c")) as str);
println((v.contains("z")) as str);
println((e.contains("a")) as str);
println((v.index_of("a")) as str);
println((v.index_of("z")) as str);
println((v.last_index_of("a")) as str);
println((v.last_index_of("z")) as str);
println(v.first());
println(v.last());
println((e.first() == "") as str);
println((e.last() == "") as str);
println(show(&v.reverse()));
println(show(&v.copy()));
println(show(&v.remove_at(0)));
println(show(&v.remove_at(9)));
println(show(&v.insert_at(1, "Z")));
println(show(&v.insert_at(0, "Z")));
println(show(&v.insert_at(99, "Z")));
println(show(&e.insert_at(0, "Z")));
println(show(&v.concat(&w)));
println(show(&v.take(2)));
println(show(&v.take(99)));
println(show(&v.skip(3)));
println(show(&v.skip(99)));
println(show(&v.slice(1, 3)));
println(v.join("-"));
println(e.join("-"));
println(w.join(", "));
println((v.count("a")) as str);
println((v.count("z")) as str);
println(show(&v.remove_value("a")));
println(show(&v.distinct()));
println(v.concat_all());
println(e.concat_all());