import "../../../stdlib/string.rp";

let c0 = '0';
let c9 = '9';
let ca = 'a';
let cz = 'z';
let cA = 'A';
let cZ = 'Z';
let slash = '/';
let colon = ':';
let dash = '-';
let space = ' ';
let tab = '\t';
let newline = '\n';
let f = 'f';
let F = 'F';
let g = 'g';
let G = 'G';
let five = '5';
let eight = '8';

println((c0.is_digit()) as str);
println((c9.is_digit()) as str);
println((ca.is_digit()) as str);
println((slash.is_digit()) as str);
println((colon.is_digit()) as str);

println((ca.is_lower()) as str);
println((ca.is_upper()) as str);
println((ca.is_letter()) as str);
println((ca.is_alphanumeric()) as str);
println((cz.is_lower()) as str);
println((cz.is_upper()) as str);
println((cz.is_letter()) as str);
println((cz.is_alphanumeric()) as str);
println((cA.is_lower()) as str);
println((cA.is_upper()) as str);
println((cA.is_letter()) as str);
println((cA.is_alphanumeric()) as str);
println((cZ.is_lower()) as str);
println((cZ.is_upper()) as str);
println((cZ.is_letter()) as str);
println((cZ.is_alphanumeric()) as str);
println((c0.is_lower()) as str);
println((c0.is_upper()) as str);
println((c0.is_letter()) as str);
println((c0.is_alphanumeric()) as str);
println((dash.is_lower()) as str);
println((dash.is_upper()) as str);
println((dash.is_letter()) as str);
println((dash.is_alphanumeric()) as str);

println((space.is_whitespace()) as str);
println((tab.is_whitespace()) as str);
println((newline.is_whitespace()) as str);
println((ca.is_whitespace()) as str);

println((c0.is_hex_digit()) as str);
println((c9.is_hex_digit()) as str);
println((ca.is_hex_digit()) as str);
println((f.is_hex_digit()) as str);
println((cA.is_hex_digit()) as str);
println((F.is_hex_digit()) as str);
println((g.is_hex_digit()) as str);
println((G.is_hex_digit()) as str);

println(cA.to_lower() as str);
println(cz.to_lower() as str);
println(five.to_lower() as str);
println(ca.to_upper() as str);
println(cZ.to_upper() as str);
println(dash.to_upper() as str);
