import "../../../stdlib/string.rp";

let banana = "banana";
let aaaa = "aaaa";
let abc = "abc";
let a = 'a';
let z = 'z';
let an = "an";
let aa = "aa";
let whitespace = " a b\tc\n";
let foobar = "foobar";
let foo = "foo";
let bar = "bar";

println((banana.count_char(a)) as str);
println((banana.count_char(z)) as str);
println((banana.count(an)) as str);
println((aaaa.count(aa)) as str);
println((abc.count(z as str)) as str);
println(whitespace.remove_whitespace());
println(foobar.remove_prefix(foo));
println(foobar.remove_prefix(bar));
println(foobar.remove_suffix(bar));
println(foobar.remove_suffix(foo));