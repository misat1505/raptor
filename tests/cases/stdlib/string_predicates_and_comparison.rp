import "../../../stdlib/string.rp";

let hello = "hello";
let xyz = "xyz";
let h = 'h';
let z = 'z';
let abc = "abc";
let ab = "ab";
let bc = "bc";
let a = "a";
let empty = "";
let heLLo = "HeLLo";
let hello_lower = "hello";
let b = "b";
let abcd = "abcd";
let spaces = "  \t";
let surrounded = " a ";

println((hello.contains("ell")) as str);
println((hello.contains(xyz)) as str);
println((hello.contains_char(h)) as str);
println((hello.contains_char(z)) as str);
println((abc.starts_with(ab)) as str);
println((abc.starts_with(bc)) as str);
println((a.starts_with(ab)) as str);
println((abc.starts_with(empty)) as str);
println((abc.ends_with(bc)) as str);
println((abc.ends_with(ab)) as str);
println((a.ends_with(bc)) as str);
println((abc.ends_with(empty)) as str);
println((a.equals(a)) as str);
println((a.equals(b)) as str);
println((a.equals("ab")) as str);
println((heLLo.equals_ignore_case(hello_lower)) as str);
println((a.equals_ignore_case(b)) as str);
println((abc.equals_ignore_case(abcd)) as str);
println((empty.is_blank()) as str);
println((spaces.is_blank()) as str);
println((surrounded.is_blank()) as str);