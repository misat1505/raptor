import "../../../stdlib/string.rp";

let s1 = "a-a-a";
let s2 = "abc";
let s3 = "aaa";
let s4 = "hello";
let s5 = "";
let s6 = "ab";
let s7 = "7";
let s8 = "1234";
let s9 = "abcdef";

let a = "a";
let z = "z";
let x = "X";
let aa = "aa";
let b = "b";
let empty = "";
let l = "l";
let xyz = "xyz";
let ab = "ab";

let zero = '0';
let dot = '.';

println(s1.replace_first(a, x));
println(s2.replace_first(z, x));
println(s1.replace_all(a, x));
println(s3.replace_all(aa, b));
println(s2.replace_all(z, x));
println(s4.replace_all(l, empty));
println(s2.replace_all(b, xyz));
println(s2.reverse());
println(s5.reverse());
println(a.reverse());
println(ab.repeat(3));
println(ab.repeat(0));
println(s5.repeat(5));
println(s7.pad_left(3, zero));
println(s8.pad_left(3, zero));
println(s6.pad_right(5, dot));
println(s9.pad_right(3, dot));