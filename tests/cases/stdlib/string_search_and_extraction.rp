import "../../../stdlib/string.rp";

let abc = "abc";
let empty = "";
let a = "a";
let hello = "hello";
let hello_world = "hello world";
let ab = "ab";
let aaa = "aaa";
let abcabc = "abcabc";

let l = 'l';
let z = 'z';
let c = 'c';
let o = 'o';
let w = 'w';

println((empty.is_empty()) as str);
println((a.is_empty()) as str);
println((abc.first()) as str);
println((empty.first() == '\0') as str);
println((abc.last()) as str);
println((empty.last() == '\0') as str);
println((abc.char_at(1)) as str);
println((abc.char_at(-1) == '\0') as str);
println((abc.char_at(3) == '\0') as str);

let s1 = "hello";
let s2 = "hello";
let s3 = "hello";
let s4 = "hello";
let s5 = "";
println(s1.substring(1, 3));
println(s2.substring(-5, 2));
println(s3.substring(3, 100));
println(s4.substring(3, 3));
println(s4.substring(4, 2));
println(s5.substring(0, 5));

println((hello.index_of_char(l)) as str);
println((hello.index_of_char(z)) as str);
println((empty.index_of_char('a')) as str);
println((hello.last_index_of_char(l)) as str);
println((hello.last_index_of_char(z)) as str);

println((hello_world.index_of("o w")) as str);
println((abc.index_of(empty)) as str);
println((ab.index_of("abc")) as str);
println((aaa.index_of("aa")) as str);
println((abc.index_of("c")) as str);

println((abcabc.last_index_of("bc")) as str);
println((abc.last_index_of(z as str)) as str);
println((aaa.last_index_of("aa")) as str);