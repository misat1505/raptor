import "../../../stdlib/string.rp";

println((str_is_empty("")) as str);
println((str_is_empty("a")) as str);
println((str_first("abc")) as str);
println((str_first("") == '\0') as str);
println((str_last("abc")) as str);
println((str_last("") == '\0') as str);
println((str_char_at("abc", 1)) as str);
println((str_char_at("abc", -1) == '\0') as str);
println((str_char_at("abc", 3) == '\0') as str);
println(str_substring("hello", 1, 3));
println(str_substring("hello", -5, 2));
println(str_substring("hello", 3, 100));
println(str_substring("hello", 3, 3));
println(str_substring("hello", 4, 2));
println(str_substring("", 0, 5));
println((str_index_of_char("hello", 'l')) as str);
println((str_index_of_char("hello", 'z')) as str);
println((str_index_of_char("", 'a')) as str);
println((str_last_index_of_char("hello", 'l')) as str);
println((str_last_index_of_char("hello", 'z')) as str);
println((str_index_of_str("hello world", "o w")) as str);
println((str_index_of_str("abc", "")) as str);
println((str_index_of_str("ab", "abc")) as str);
println((str_index_of_str("aaa", "aa")) as str);
println((str_index_of_str("abc", "c")) as str);
println((str_last_index_of_str("abcabc", "bc")) as str);
println((str_last_index_of_str("abc", "z")) as str);
println((str_last_index_of_str("aaa", "aa")) as str);
