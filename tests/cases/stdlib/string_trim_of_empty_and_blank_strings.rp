import "../../../stdlib/string.rp";

let s1 = "";
let s2 = "   ";
let s3 = "\t\n ";

println("[" + s1.trim_left() + "]");
println("[" + s2.trim_left() + "]");
println("[" + s3.trim_left() + "]");
println("[" + s1.trim_right() + "]");
println("[" + s2.trim_right() + "]");
println("[" + s3.trim_right() + "]");
println("[" + s1.trim() + "]");
println("[" + s2.trim() + "]");
println("[" + s3.trim() + "]");