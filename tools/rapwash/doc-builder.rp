import "../../src/semantic-checker/semantic-helpers.rp";
import "doc.rp";


struct SourceComment derives Debug {
    i64 line,
    i64 column,
    str text,
    bool trailing,
    bool used

    fn comment_text(self): str {
        return "#" + self.text;
    }

    fn extract_source_comments(str src): SourceComment[] {
        let comments: SourceComment[] = [];
        let line = 1;
        let column = 1;
        let i = 0;
        let line_has_code = false;
        let in_string = false;
        let in_char = false;
        let escape = false;

        while (i < src.size()) {
            let ch = src[i];

            if (in_string) {
                if (escape) {
                    escape = false;
                } else if (ch == '\\') {
                    escape = true;
                } else if (ch == '\"') {
                    in_string = false;
                }

                if (ch == '\n') {
                    line += 1;
                    column = 1;
                    line_has_code = false;
                    escape = false;
                } else {
                    column += 1;
                }
                i += 1;
                continue;
            }

            if (in_char) {
                if (escape) {
                    escape = false;
                } else if (ch == '\\') {
                    escape = true;
                } else if (ch == (39 as u8) as char) {
                    in_char = false;
                }

                if (ch == '\n') {
                    line += 1;
                    column = 1;
                    line_has_code = false;
                    escape = false;
                    in_char = false;
                } else {
                    column += 1;
                }
                i += 1;
                continue;
            }

            if (ch == '\"') {
                in_string = true;
                line_has_code = true;
                column += 1;
                i += 1;
                continue;
            }

            if (ch == (39 as u8) as char) {
                in_char = true;
                line_has_code = true;
                column += 1;
                i += 1;
                continue;
            }

            if (ch == '#') {
                let text = "";
                let comment_column = column;
                i += 1;
                while (i < src.size() && src[i] != '\n' && src[i] != '\r') {
                    text += src[i];
                    i += 1;
                }
                comments.push(
                    SourceComment {
                        line,
                        column: comment_column,
                        text,
                        trailing: line_has_code,
                        used: false
                    }
                );
                continue;
            }

            if (ch == '\n') {
                line += 1;
                column = 1;
                line_has_code = false;
                i += 1;
                continue;
            }

            if (ch == '\r') {
                i += 1;
                continue;
            }

            if (ch != ' ' && ch != '\t') {
                line_has_code = true;
            }
            column += 1;
            i += 1;
        }

        return comments;
    }
};

struct DocBuilder derives Debug {
    Program ast,
    SourceComment[] comments

    fn take_leading_comments(self, i64 after_line, i64 before_line): Doc {
        let parts: Doc[] = [];
        let first = true;
        let prev_comment_line = after_line;

        for (let i = 0; i < self.comments.size(); i += 1) {
            let comment = self.comments[i];
            if (comment.used) {
                continue;
            }
            if (comment.trailing) {
                continue;
            }
            if (comment.line <= after_line) {
                continue;
            }
            if (comment.line >= before_line) {
                break;
            }

            if (!first) {
                parts.push(Doc::HardLine);

                # Preserve a single blank line between comment groups when the
                # source had one or more empty lines between them.
                if (comment.line - prev_comment_line > 1) {
                    parts.push(Doc::HardLine);
                }
            }
            parts.push(Doc::Text(comment.comment_text()));
            self.comments[i].used = true;
            prev_comment_line = comment.line;
            first = false;
        }

        if (first) {
            return Doc::Text("");
        }

        # If the source had a blank line (or more) between the last leading
        # comment and the following item, keep exactly one blank line.
        if (before_line - prev_comment_line > 1) {
            parts.push(Doc::HardLine);
        }

        return Doc::Concat(parts);
    }

    fn take_trailing_comment(self, i64 line): Doc {
        for (let i = 0; i < self.comments.size(); i += 1) {
            let comment = self.comments[i];
            if (comment.used) {
                continue;
            }
            if (!comment.trailing) {
                continue;
            }
            if (comment.line != line) {
                continue;
            }
            self.comments[i].used = true;
            return Doc::Text("  " + comment.comment_text());
        }
        return Doc::Text("");
    }

    fn with_comments(self, i64 after_line, i64 start_line, i64 end_line, Doc item): Doc {
        let leading = self.take_leading_comments(after_line, start_line);
        let trailing = self.take_trailing_comment(end_line);

        let has_leading = !leading.is_empty_text();
        let has_trailing = !trailing.is_empty_text();

        if (!has_leading && !has_trailing) {
            return item;
        }

        let parts: Doc[] = [];
        if (has_leading) {
            parts.push(leading);
            parts.push(Doc::HardLine);
        }
        parts.push(item);
        if (has_trailing) {
            parts.push(trailing);
        }
        return Doc::Concat(parts);
    }

    fn build(self): Doc {
        let sections: Doc[] = [];

        let hard = Doc::HardLine;
        let blank_line = Doc::Concat([Doc::HardLine, Doc::HardLine]);
        let blank_lines = Doc::Concat([Doc::HardLine, Doc::HardLine, Doc::HardLine]);

        let imports = self.build_imports();
        DocBuilder.push_section(&sections, &imports, &hard);

        let interfaces = self.build_interface_declarations();
        DocBuilder.push_section(&sections, &interfaces, &blank_line);

        let types = self.build_type_declarations();
        DocBuilder.push_section(&sections, &types, &blank_line);

        let extend_blocks = self.build_extend_blocks();
        DocBuilder.push_section(&sections, &extend_blocks, &blank_line);

        let extern_functions = self.build_extern_function_declarations();
        DocBuilder.push_section(&sections, &extern_functions, &hard);

        let functions = self.build_function_declarations();
        DocBuilder.push_section(&sections, &functions, &blank_line);

        let statements = self.build_statements();
        DocBuilder.push_section(&sections, &statements, &hard);

        let body = Doc::Concat([Doc.join(&sections, &blank_lines), Doc::HardLine]);

        # Preserve any leftover full-line comments (e.g. at end of file).
        let leftover_parts: Doc[] = [];
        for (let i = 0; i < self.comments.size(); i += 1) {
            let comment = self.comments[i];
            if (comment.used || comment.trailing) {
                continue;
            }
            leftover_parts.push(Doc::HardLine);
            leftover_parts.push(Doc::Text(comment.comment_text()));
            self.comments[i].used = true;
        }

        if (leftover_parts.size() == 0) {
            return body;
        }
        return Doc::Concat([body, Doc::Concat(leftover_parts), Doc::HardLine]);
    }

    fn push_section(&Doc[] sections, &Doc[] items, &Doc separator): void {
        if (items.size() == 0) {
            return;
        }
        sections.push(Doc.join(&items, &separator));
    }

    fn build_imports(self): Doc[] {
        let imports: Doc[] = [];
        let previous_end_line = 0;

        for (let i = 0; i < self.ast.statements.size(); i += 1) {
            let node = self.ast.statements[i];
            let stmt = node.value;
            if (stmt matches Statement::Import(path)) {
                let item = Doc::Concat([
                    Doc::Text("import \""),
                    Doc::Text(path.value),
                    Doc::Text("\";")
                ]);
                item = self.with_comments(
                    previous_end_line,
                    node.span.start.line,
                    node.span.end.line,
                    item
                );
                imports.push(item);
                previous_end_line = node.span.end.line;
            }
        }

        return imports;
    }

    fn build_statements(self): Doc[] {
        let result: Doc[] = [];

        let has_any = false;
        for (let i = 0; i < self.ast.statements.size(); i += 1) {
            let stmt = self.ast.statements[i].value;
            if (stmt not matches Statement::Import) {
                has_any = true;
            }
        }

        if (has_any) {
            result.push(self.statements(&self.ast.statements, 0));
        }

        return result;
    }

    fn last_item_end_before(self, i64 line): i64 {
        let last = 0;

        for (let i = 0; i < self.ast.statements.size(); i += 1) {
            let end_line = self.ast.statements[i].span.end.line;
            if (end_line < line && end_line > last) {
                last = end_line;
            }
        }
        for (let i = 0; i < self.ast.functions.size(); i += 1) {
            let end_line = self.ast.functions[i].span.end.line;
            if (end_line < line && end_line > last) {
                last = end_line;
            }
        }
        for (let i = 0; i < self.ast.extern_functions.size(); i += 1) {
            let end_line = self.ast.extern_functions[i].span.end.line;
            if (end_line < line && end_line > last) {
                last = end_line;
            }
        }
        for (let i = 0; i < self.ast.declared_types.size(); i += 1) {
            let end_line = self.ast.declared_types[i].span.end.line;
            if (end_line < line && end_line > last) {
                last = end_line;
            }
        }
        for (let i = 0; i < self.ast.interfaces.size(); i += 1) {
            let end_line = self.ast.interfaces[i].span.end.line;
            if (end_line < line && end_line > last) {
                last = end_line;
            }
        }
        for (let i = 0; i < self.ast.extend_blocks.size(); i += 1) {
            let block = self.ast.extend_blocks[i];
            let end_line = block.type.span.start.line;
            if (block.methods.size() > 0) {
                end_line = block.methods[block.methods.size() - 1].span.end.line + 1;
            }
            if (end_line < line && end_line > last) {
                last = end_line;
            }
        }

        return last;
    }

    fn build_interface_declarations(self): Doc[] {
        let declarations: Doc[] = [];

        for (let i = 0; i < self.ast.interfaces.size(); i += 1) {
            let node = self.ast.interfaces[i];
            let interface_decl = node.value;

            let methods: Doc[] = [];
            for (let j = 0; j < interface_decl.methods_signatures.size(); j += 1) {
                methods.push(
                    DocBuilder.method_signature_doc(&interface_decl.methods_signatures[j].value)
                );
            }

            let parts: Doc[] = [Doc::Text("interface " + interface_decl.identifier.value)];
            if (methods.size() == 0) {
                parts.push(Doc::Text(" {}"));
            } else {
                let method_sep = Doc::HardLine;
                parts.push(Doc::Text(" {"));
                parts.push(Doc::Indent([Doc::HardLine, Doc.join(&methods, &method_sep)]));
                parts.push(Doc::HardLine);
                parts.push(Doc::Text("}"));
            }
            parts.push(Doc::Text(";"));

            declarations.push(
                self.with_comments(
                    self.last_item_end_before(node.span.start.line),
                    node.span.start.line,
                    node.span.end.line,
                    Doc::Concat(parts)
                )
            );
        }

        return declarations;
    }

    fn method_signature_doc(&MethodSignature signature): Doc {
        let parameters: Doc[] = [];

        if (signature.self_identifier matches OptionIdentifierNode::Some(self_ident)) {
            parameters.push(Doc::Text(self_ident.value));
        }

        for (let j = 0; j < signature.parameters.size(); j += 1) {
            let parameter = signature.parameters[j].value;

            let parameter_decl = "";
            if (parameter.passed_by matches PassedBy::Reference) {
                parameter_decl += "&";
            }
            parameter_decl += parameter.parameter_type.value.to_string();

            parameters.push(Doc::Text(parameter_decl));
        }

        let list = DocBuilder.list(
            "fn " + signature.identifier.value + "(",
            ")",
            &parameters,
            false
        );
        return Doc::Concat([list, Doc::Text(": " + signature.return_type.value.to_string())]);
    }

    fn build_type_declarations(self): Doc[] {
        let declarations: Doc[] = [];
        let previous_end_line = 0;

        for (let i = 0; i < self.ast.declared_types.size(); i += 1) {
            let node = self.ast.declared_types[i];
            let type_decl = node.value;
            let item = Doc::Text("");

            match (type_decl) {
                DeclaredType::Struct(struct_decl) {
                    let type_derives: Doc[] = [];
                    for (let j = 0; j < struct_decl.struct_derives.size(); j += 1) {
                        type_derives.push(Doc::Text(struct_decl.struct_derives[j].value));
                    }

                    let members: Doc[] = [];
                    for (let j = 0; j < struct_decl.members.size(); j += 1) {
                        let member = struct_decl.members[j].value;

                        members.push(
                            Doc::Concat([
                                Doc::Text(member.member_type.value.to_string()),
                                Doc::Text(" "),
                                Doc::Text(member.identifier.value)
                            ])
                        );
                    }

                    let methods: Doc[] = [];
                    for (let j = 0; j < struct_decl.methods.size(); j += 1) {
                        methods.push(self.type_method_doc(&struct_decl.methods[j].value));
                    }

                    let type_implementations: Doc[] = [];
                    for (let j = 0; j < struct_decl.implementations.size(); j += 1) {
                        type_implementations.push(Doc::Text(struct_decl.implementations[j].value));
                    }

                    item = DocBuilder.type_decl_doc(
                        "struct",
                        struct_decl.identifier.value,
                        &type_derives,
                        &type_implementations,
                        &members,
                        &methods
                    );
                },
                DeclaredType::Enum(enum_decl) {
                    let type_derives: Doc[] = [];
                    for (let j = 0; j < enum_decl.enum_derives.size(); j += 1) {
                        type_derives.push(Doc::Text(enum_decl.enum_derives[j].value));
                    }

                    let members: Doc[] = [];
                    for (let j = 0; j < enum_decl.members.size(); j += 1) {
                        let member = enum_decl.members[j].value;
                        let variant = Doc::Text(member.identifier.value);
                        if (member.member_type matches OptionTypeNode::Some(t)) {
                            variant = Doc::Concat([
                                variant,
                                Doc::Text("(" + t.value.to_string() + ")")
                            ]);
                        }
                        members.push(variant);
                    }

                    let methods: Doc[] = [];
                    for (let j = 0; j < enum_decl.methods.size(); j += 1) {
                        methods.push(self.type_method_doc(&enum_decl.methods[j].value));
                    }

                    let type_implementations: Doc[] = [];
                    for (let j = 0; j < enum_decl.implementations.size(); j += 1) {
                        type_implementations.push(Doc::Text(enum_decl.implementations[j].value));
                    }

                    item = DocBuilder.type_decl_doc(
                        "enum",
                        enum_decl.identifier.value,
                        &type_derives,
                        &type_implementations,
                        &members,
                        &methods
                    );
                }
            }

            declarations.push(
                self.with_comments(
                    previous_end_line,
                    node.span.start.line,
                    node.span.end.line,
                    item
                )
            );
            previous_end_line = node.span.end.line;
        }

        return declarations;
    }

    fn build_extend_blocks(self): Doc[] {
        let blocks: Doc[] = [];
        let previous_end_line = 0;

        for (let i = 0; i < self.ast.extend_blocks.size(); i += 1) {
            let block = self.ast.extend_blocks[i];
            let start_line = block.type.span.start.line;

            # ExtendBlock has no span of its own: the block ends one line after its last
            # method (the closing `};`), or on the type line when it has no methods.
            let end_line = start_line;
            if (block.methods.size() > 0) {
                end_line = block.methods[block.methods.size() - 1].span.end.line + 1;
            }

            # Comments before this block that already belong to a type declaration are used
            # up by now, so start looking right after the last type declared above the block.
            let after_line = previous_end_line;
            for (let j = 0; j < self.ast.declared_types.size(); j += 1) {
                let type_end_line = self.ast.declared_types[j].span.end.line;
                if (type_end_line < start_line && type_end_line > after_line) {
                    after_line = type_end_line;
                }
            }

            let methods: Doc[] = [];
            for (let j = 0; j < block.methods.size(); j += 1) {
                methods.push(self.type_method_doc(&block.methods[j].value));
            }

            let parts: Doc[] = [Doc::Text("extend " + block.type.value.to_string())];
            if (methods.size() == 0) {
                parts.push(Doc::Text(" {}"));
            } else {
                let method_sep = Doc::Concat([Doc::HardLine, Doc::HardLine]);
                parts.push(Doc::Text(" {"));
                parts.push(Doc::Indent([Doc::HardLine, Doc.join(&methods, &method_sep)]));
                parts.push(Doc::HardLine);
                parts.push(Doc::Text("}"));
            }
            parts.push(Doc::Text(";"));

            blocks.push(self.with_comments(after_line, start_line, end_line, Doc::Concat(parts)));
            previous_end_line = end_line;
        }

        return blocks;
    }

    fn type_method_doc(self, &TypeMethod method): Doc {
        let parameters: Doc[] = [];

        if (method.self_identifier matches OptionIdentifierNode::Some(self_ident)) {
            parameters.push(Doc::Text(self_ident.value));
        }

        for (let j = 0; j < method.parameters.size(); j += 1) {
            let parameter = method.parameters[j].value;

            let parameter_decl = "";
            if (parameter.passed_by matches PassedBy::Reference) {
                parameter_decl += "&";
            }
            parameter_decl += parameter.parameter_type.value.to_string();
            parameter_decl += " ";
            parameter_decl += parameter.identifier.value;

            parameters.push(Doc::Text(parameter_decl));
        }

        let signature = DocBuilder.list(
            "fn " + method.identifier.value + "(",
            ")",
            &parameters,
            false
        );
        let return_type = Doc::Text(": " + method.return_type.value.to_string() + " ");
        let block = self.build_block(&method.block);
        return Doc::Concat([signature, return_type, block]);
    }

    fn type_decl_doc(
        str keyword,
        str name,
        &Doc[] type_derives,
        &Doc[] type_implementations,
        &Doc[] members,
        &Doc[] methods
    ): Doc {
        let parts: Doc[] = [Doc::Text(keyword + " " + name)];

        if (type_derives.size() > 0) {
            let comma = Doc::Text(", ");
            parts.push(Doc::Text(" derives "));
            parts.push(Doc.join(&type_derives, &comma));
        }

        if (type_implementations.size() > 0) {
            let comma = Doc::Text(", ");
            parts.push(Doc::Text(" implements "));
            parts.push(Doc.join(&type_implementations, &comma));
        }

        if (members.size() == 0 && methods.size() == 0) {
            parts.push(Doc::Text(" {}"));
        } else {
            parts.push(Doc::Text(" {"));

            let body_parts: Doc[] = [];

            if (members.size() > 0) {
                let separator = Doc::Concat([Doc::Text(","), Doc::HardLine]);
                body_parts.push(Doc.join(&members, &separator));
            }

            if (methods.size() > 0) {
                if (members.size() > 0) {
                    # Blank line between fields/variants and methods.
                    body_parts.push(Doc::HardLine);
                    body_parts.push(Doc::HardLine);
                }
                let method_sep = Doc::Concat([Doc::HardLine, Doc::HardLine]);
                body_parts.push(Doc.join(&methods, &method_sep));
            }

            parts.push(Doc::Indent([Doc::HardLine, Doc::Concat(body_parts)]));
            parts.push(Doc::HardLine);
            parts.push(Doc::Text("}"));
        }

        parts.push(Doc::Text(";"));
        return Doc::Concat(parts);
    }

    fn build_function_declarations(self): Doc[] {
        let function_declarations: Doc[] = [];
        let previous_end_line = 0;

        for (let i = 0; i < self.ast.functions.size(); i += 1) {
            let node = self.ast.functions[i];
            let function = node.value;

            let parameters: Doc[] = [];
            for (let j = 0; j < function.parameters.size(); j += 1) {
                let parameter = function.parameters[j].value;

                let parameter_decl = "";
                if (parameter.passed_by matches PassedBy::Reference) {
                    parameter_decl += "&";
                }
                parameter_decl += parameter.parameter_type.value.to_string();
                parameter_decl += " ";
                parameter_decl += parameter.identifier.value;

                parameters.push(Doc::Text(parameter_decl));
            }

            let signature = DocBuilder.list(
                "fn " + function.identifier.value + "(",
                ")",
                &parameters,
                false
            );
            let return_type = Doc::Text(": " + function.return_type.value.to_string() + " ");

            # Take leading comments above `fn` before formatting the body,
            # so the first statement inside cannot claim them.
            let leading = self.take_leading_comments(previous_end_line, node.span.start.line);
            let trailing = self.take_trailing_comment(node.span.end.line);

            let block = self.build_block(&function.block);
            let item = Doc::Concat([signature, return_type, block]);

            let has_leading = !leading.is_empty_text();
            let has_trailing = !trailing.is_empty_text();
            if (has_leading || has_trailing) {
                let parts: Doc[] = [];
                if (has_leading) {
                    parts.push(leading);
                    parts.push(Doc::HardLine);
                }
                parts.push(item);
                if (has_trailing) {
                    parts.push(trailing);
                }
                item = Doc::Concat(parts);
            }

            function_declarations.push(item);
            previous_end_line = node.span.end.line;
        }

        return function_declarations;
    }

    fn build_extern_function_declarations(self): Doc[] {
        let function_declarations: Doc[] = [];
        let previous_end_line = 0;

        for (let i = 0; i < self.ast.extern_functions.size(); i += 1) {
            let node = self.ast.extern_functions[i];
            let function = node.value;

            let parameters: Doc[] = [];
            for (let j = 0; j < function.parameters.size(); j += 1) {
                let parameter = function.parameters[j].value;

                let parameter_decl = "";
                if (parameter.passed_by matches PassedBy::Reference) {
                    parameter_decl += "&";
                }
                parameter_decl += parameter.parameter_type.value.to_string();
                parameter_decl += " ";
                parameter_decl += parameter.identifier.value;

                parameters.push(Doc::Text(parameter_decl));
            }

            let signature = DocBuilder.list(
                "extern fn " + function.identifier.value + "(",
                ")",
                &parameters,
                false
            );
            let return_type = Doc::Text(": " + function.return_type.value.to_string());

            let segments = [signature, return_type];
            if (function.alias matches OptionIdentifierNode::Some(ident)) {
                let alias_text = Doc::Text(" as " + ident.value);
                segments.push(alias_text);
            }
            segments.push(Doc::Text(";"));
            let item = Doc::Concat(segments);
            function_declarations.push(
                self.with_comments(
                    previous_end_line,
                    node.span.start.line,
                    node.span.end.line,
                    item
                )
            );
            previous_end_line = node.span.end.line;
        }

        return function_declarations;
    }

    fn build_block(self, &BlockNode block_node): Doc {
        let block = block_node.value;

        if (block.statements.size() == 0) {
            return Doc::Text("{}");
        }

        # Only attach comments that fall inside this block, so leading comments
        # above `fn` / `if` / `while` stay on the declaration, not the first body stmt.
        return Doc::Concat([
            Doc::Text("{"),
            Doc::Indent([
                Doc::HardLine,
                self.statements(&block.statements, block_node.span.start.line)
            ]),
            Doc::HardLine,
            Doc::Text("}")
        ]);
    }

    fn statements(self, &StatementNode[] nodes, i64 previous_end_line): Doc {
        let parts: Doc[] = [];
        let has_previous = false;

        for (let i = 0; i < nodes.size(); i += 1) {
            let node = nodes[i];
            if (node.value matches Statement::Import) {
                continue;
            }

            let leading = self.take_leading_comments(previous_end_line, node.span.start.line);
            let has_leading = !leading.is_empty_text();

            if (has_previous) {
                parts.push(Doc::HardLine);
                if (node.span.start.line - previous_end_line > 1 || has_leading) {
                    parts.push(Doc::HardLine);
                }
            }

            if (has_leading) {
                parts.push(leading);
                parts.push(Doc::HardLine);
            }

            let stmt_doc = self.stmt(&node.value);
            let trailing = self.take_trailing_comment(node.span.end.line);
            if (!trailing.is_empty_text()) {
                parts.push(Doc::Concat([stmt_doc, trailing]));
            } else {
                parts.push(stmt_doc);
            }

            previous_end_line = node.span.end.line;
            has_previous = true;
        }

        return Doc::Concat(parts);
    }

    fn stmt(self, &Statement stmt): Doc {
        let result = Doc::Text("");

        match (stmt) {
            Statement::FunctionCall(func_call) {
                result = Doc::Concat([
                    self.call_doc(&func_call.identifier.value, &func_call.arguments),
                    Doc::Text(";")
                ]);
            },
            Statement::Declaration {
                result = Doc::Concat([self.decl_doc(&stmt), Doc::Text(";")]);
            },
            Statement::ForLoop(for_loop_stmt) {
                let declaration = Doc::Text("");
                if (for_loop_stmt.declaration matches OptionStatementNode::Some(stmt_node)) {
                    declaration = self.decl_doc(&stmt_node.value);
                }

                let assignment = Doc::Text("");
                if (for_loop_stmt.assignment matches OptionStatementNode::Some(stmt_node)) {
                    if (stmt_node.value matches Statement::Assignment(assignment_stmt)) {
                        assignment = self.assignment_doc(&assignment_stmt);
                    }
                }

                let header = Doc::Group([
                    Doc::Text("for ("),
                    Doc::Indent([
                        Doc::SoftLine,
                        declaration,
                        Doc::Text(";"),
                        Doc::Line,
                        self.expr(&for_loop_stmt.condition.value),
                        Doc::Text(";"),
                        Doc::Line,
                        assignment
                    ]),
                    Doc::SoftLine,
                    Doc::Text(")")
                ]);

                result = Doc::Concat([
                    header,
                    Doc::Text(" "),
                    self.build_block(&for_loop_stmt.block)
                ]);
            },
            Statement::Conditional(if_stmt) {
                result = self.conditional_doc(&if_stmt);
            },
            Statement::Assignment(assignment_stmt) {
                result = Doc::Concat([self.assignment_doc(&assignment_stmt), Doc::Text(";")]);
            },
            Statement::Return(return_expr) {
                if (return_expr matches OptionExpressionNode::Some(expr_node)) {
                    result = Doc::Concat([
                        self.assign_like(Doc::Text("return"), &expr_node.value),
                        Doc::Text(";")
                    ]);
                } else {
                    result = Doc::Text("return;");
                }
            },
            Statement::WhileLoop(while_loop) {
                let is_while_matches = false;

                if (while_loop.condition.value matches Expression::Literal(inner)) {
                    if (inner matches Literal::True) {
                        if (while_loop.block.value.statements.size() == 1) {
                            let inner = while_loop.block.value.statements[0].value;

                            if (inner matches Statement::Match(match_stmt)) {
                                if (match_stmt.match_arms.size() == 1) {
                                    if (
                                        match_stmt.rest_arm matches OptionBlockNode::Some(rest_block)
                                    ) {
                                        let arm = match_stmt.match_arms[0].value;

                                        let arm_is_break = DocBuilder.is_synthetic_break(
                                            &arm.block
                                        );
                                        let rest_is_break = DocBuilder.is_synthetic_break(
                                            &rest_block
                                        );

                                        if (arm_is_break != rest_is_break) {
                                            let pattern =
                                                arm.enum_name.value + "::" + arm.variant_name.value;
                                            if (
                                                arm.variant_value matches OptionIdentifierNode::Some(ident)
                                            ) {
                                                pattern += "(" + ident.value + ")";
                                            }

                                            let subject = self.expr(&match_stmt.expression.value);

                                            if (rest_is_break) {
                                                let header = DocBuilder.header(
                                                    "while",
                                                    Doc::Concat([
                                                        subject,
                                                        Doc::Text(" matches " + pattern)
                                                    ])
                                                );

                                                result = Doc::Concat([
                                                    header,
                                                    Doc::Text(" "),
                                                    self.build_block(&arm.block)
                                                ]);
                                            } else {
                                                let header = DocBuilder.header(
                                                    "while",
                                                    Doc::Concat([
                                                        subject,
                                                        Doc::Text(" not matches " + pattern)
                                                    ])
                                                );

                                                result = Doc::Concat([
                                                    header,
                                                    Doc::Text(" "),
                                                    self.build_block(&rest_block)
                                                ]);
                                            }

                                            is_while_matches = true;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if (!is_while_matches) {
                    result = Doc::Concat([
                        DocBuilder.header("while", self.expr(&while_loop.condition.value)),
                        Doc::Text(" "),
                        self.build_block(&while_loop.block)
                    ]);
                }
            },
            Statement::Match(match_stmt) {
                result = self.match_doc(&match_stmt);
            },
            Statement::Break {
                result = Doc::Text("break;");
            },
            Statement::Continue {
                result = Doc::Text("continue;");
            },
            Statement::Expression(expr_node) {
                result = Doc::Concat([self.expr(&expr_node.value), Doc::Text(";")]);
            },
            Statement::Import {},
            Statement::Switch(switch_stmt) {
                let expressions: Doc[] = [];
                for (let i = 0; i < switch_stmt.expressions.size(); i += 1) {
                    let switch_expr = switch_stmt.expressions[i].value;
                    let item = self.expr(&switch_expr.expression.value);
                    if (switch_expr.alias matches OptionIdentifierNode::Some(ident)) {
                        item = Doc::Concat([item, Doc::Text(": " + ident.value)]);
                    }
                    expressions.push(item);
                }
                let header = DocBuilder.list("switch (", ")", &expressions, false);

                let cases: Doc[] = [];
                for (let i = 0; i < switch_stmt.cases.size(); i += 1) {
                    let case = switch_stmt.cases[i].value;

                    cases.push(
                        Doc::Concat([
                            Doc::Text("("),
                            self.expr(&case.condition.value),
                            Doc::Text(") -> "),
                            self.build_block(&case.block)
                        ])
                    );
                }

                if (cases.size() == 0) {
                    result = Doc::Concat([header, Doc::Text(" {}")]);
                } else {
                    let hard = Doc::HardLine;
                    result = Doc::Concat([
                        header,
                        Doc::Text(" {"),
                        Doc::Indent([Doc::HardLine, Doc.join(&cases, &hard)]),
                        Doc::HardLine,
                        Doc::Text("}")
                    ]);
                }
            }
        }

        return result;
    }

    fn header(str keyword, Doc inner): Doc {
        return Doc::Group([
            Doc::Text(keyword + " ("),
            Doc::Indent([Doc::SoftLine, inner]),
            Doc::SoftLine,
            Doc::Text(")")
        ]);
    }

    fn decl_doc(self, &Statement stmt): Doc {
        let result = Doc::Text("");

        if (stmt matches Statement::Declaration(declaration)) {
            let var_name = declaration.identifier.value;
            let head = "let " + var_name;
            if (declaration.var_type matches OptionTypeNode::Some(type_node)) {
                head += ": " + type_node.value.to_string();
            }
            result = self.assign_like(Doc::Text(head + " ="), &declaration.value.value);
        }

        return result;
    }

    fn assignment_doc(self, &AssignmentStatement assignment): Doc {
        let lhs_parts: Doc[] = [Doc::Text(assignment.identifier.value)];
        for (let i = 0; i < assignment.accessors.size(); i += 1) {
            let accessor = assignment.accessors[i].value;
            match (accessor) {
                Accessor::Index(index) {
                    lhs_parts.push(
                        Doc::Concat([Doc::Text("["), self.expr(&index.value), Doc::Text("]")])
                    );
                },
                Accessor::Field(ident) {
                    lhs_parts.push(Doc::Text("." + ident.value));
                },
                Accessor::MethodCall(method_call_node) {
                    let mc = method_call_node.value;
                    let items: Doc[] = [];
                    for (let j = 0; j < mc.arguments.size(); j += 1) {
                        let argument = mc.arguments[j].value;
                        let item = self.expr(&argument.value.value);
                        if (argument.passed_by matches PassedBy::Reference) {
                            item = Doc::Concat([Doc::Text("&"), item]);
                        }
                        items.push(item);
                    }
                    lhs_parts.push(
                        Doc::Concat([
                            Doc::Text("."),
                            DocBuilder.list(mc.field.value + "(", ")", &items, false)
                        ])
                    );
                }
            }
        }
        let lhs = Doc::Concat(lhs_parts);

        let is_compound =
            assignment.value.span.start.offset == assignment.identifier.span.start.offset;
        if (is_compound) {
            match (assignment.value.value) {
                Expression::Addition(operands) {
                    return self.assign_like(
                        Doc::Concat([lhs, Doc::Text(" +=")]),
                        &operands.right.value
                    );
                },
                Expression::Subtraction(operands) {
                    return self.assign_like(
                        Doc::Concat([lhs, Doc::Text(" -=")]),
                        &operands.right.value
                    );
                },
                Expression::Multiplication(operands) {
                    return self.assign_like(
                        Doc::Concat([lhs, Doc::Text(" *=")]),
                        &operands.right.value
                    );
                },
                Expression::Division(operands) {
                    return self.assign_like(
                        Doc::Concat([lhs, Doc::Text(" /=")]),
                        &operands.right.value
                    );
                },
                Expression::Modulo(operands) {
                    return self.assign_like(
                        Doc::Concat([lhs, Doc::Text(" %=")]),
                        &operands.right.value
                    );
                },
                rest {}
            }
        }

        return self.assign_like(Doc::Concat([lhs, Doc::Text(" =")]), &assignment.value.value);
    }

    fn assign_like(self, Doc head, &Expression rhs): Doc {
        let rhs_doc = self.expr(&rhs);

        if (DocBuilder.is_self_bracketed(&rhs)) {
            return Doc::Concat([head, Doc::Text(" "), rhs_doc]);
        }

        return Doc::Group([head, Doc::Indent([Doc::Line, rhs_doc])]);
    }

    fn is_self_bracketed(&Expression expr): bool {
        let result = false;

        match (expr) {
            Expression::FunctionCall {
                result = true;
            },
            Expression::Vector {
                result = true;
            },
            Expression::StructLiteral {
                result = true;
            },
            Expression::EnumLiteral {
                result = true;
            },
            Expression::MethodCall {
                result = true;
            },
            rest {}
        }

        return result;
    }

    fn conditional_doc(self, &ConditionalStatement if_stmt): Doc {
        let parts: Doc[] = [
            DocBuilder.header("if", self.expr(&if_stmt.condition.value)),
            Doc::Text(" "),
            self.build_block(&if_stmt.if_block)
        ];

        if (if_stmt.else_block matches OptionBlockNode::Some(else_block)) {
            parts.push(Doc::Text(" else "));
            parts.push(self.else_branch(&else_block));
        }

        return Doc::Concat(parts);
    }

    fn else_branch(self, &BlockNode block_node): Doc {
        let block = block_node.value;

        if (block.statements.size() == 1) {
            let inner = block.statements[0].value;

            if (inner matches Statement::Conditional(inner_if)) {
                return self.conditional_doc(&inner_if);
            }

            if (inner matches Statement::Match(inner_match)) {
                if (DocBuilder.is_if_matches(&inner_match)) {
                    return self.if_matches_doc(&inner_match);
                }
            }
        }

        return self.build_block(&block_node);
    }

    fn is_if_matches(&MatchStatement match_stmt): bool {
        if (match_stmt.match_arms.size() != 1) {
            return false;
        }
        if (match_stmt.rest_arm matches OptionBlockNode::Some) {
            return true;
        }
        return false;
    }

    fn is_synthetic_empty(&BlockNode block): bool {
        if (block.value.statements.size() != 0) {
            return false;
        }
        return block.span.start.offset == block.span.end.offset;
    }

    fn is_synthetic_break(&BlockNode block): bool {
        if (block.value.statements.size() != 1) {
            return false;
        }

        if (block.value.statements[0].value matches Statement::Break) {
            return true;
        }

        return false;
    }

    fn if_matches_doc(self, &MatchStatement match_stmt): Doc {
        let result = Doc::Text("");

        if (match_stmt.rest_arm matches OptionBlockNode::Some(rest_block)) {
            let arm = match_stmt.match_arms[0].value;

            let pattern = arm.enum_name.value + "::" + arm.variant_name.value;
            if (arm.variant_value matches OptionIdentifierNode::Some(ident)) {
                pattern += "(" + ident.value + ")";
            }

            let subject = self.expr(&match_stmt.expression.value);

            if (DocBuilder.is_synthetic_empty(&arm.block)) {
                let header = DocBuilder.header(
                    "if",
                    Doc::Concat([subject, Doc::Text(" not matches " + pattern)])
                );
                result = Doc::Concat([header, Doc::Text(" "), self.build_block(&rest_block)]);
            } else {
                let header = DocBuilder.header(
                    "if",
                    Doc::Concat([subject, Doc::Text(" matches " + pattern)])
                );
                let parts: Doc[] = [header, Doc::Text(" "), self.build_block(&arm.block)];
                if (rest_block.value.statements.size() > 0) {
                    parts.push(Doc::Text(" else "));
                    parts.push(self.else_branch(&rest_block));
                }
                result = Doc::Concat(parts);
            }
        }

        return result;
    }

    fn match_doc(self, &MatchStatement match_stmt): Doc {
        if (DocBuilder.is_if_matches(&match_stmt)) {
            return self.if_matches_doc(&match_stmt);
        }

        let arms: Doc[] = [];
        for (let i = 0; i < match_stmt.match_arms.size(); i += 1) {
            let arm = match_stmt.match_arms[i].value;

            let head = arm.enum_name.value + "::" + arm.variant_name.value;
            if (arm.variant_value matches OptionIdentifierNode::Some(ident)) {
                head += "(" + ident.value + ")";
            }

            arms.push(Doc::Concat([Doc::Text(head + " "), self.build_block(&arm.block)]));
        }

        if (match_stmt.rest_arm matches OptionBlockNode::Some(rest_block)) {
            arms.push(Doc::Concat([Doc::Text("rest "), self.build_block(&rest_block)]));
        }

        let header = DocBuilder.header("match", self.expr(&match_stmt.expression.value));
        if (arms.size() == 0) {
            return Doc::Concat([header, Doc::Text(" {}")]);
        }

        let separator = Doc::Concat([Doc::Text(","), Doc::HardLine]);
        return Doc::Concat([
            header,
            Doc::Text(" {"),
            Doc::Indent([Doc::HardLine, Doc.join(&arms, &separator)]),
            Doc::HardLine,
            Doc::Text("}")
        ]);
    }

    fn list(str open, str close, &Doc[] items, bool padded): Doc {
        if (items.size() == 0) {
            return Doc::Text(open + close);
        }

        let edge = Doc::SoftLine;
        if (padded) {
            edge = Doc::Line;
        }

        let separator = Doc::Concat([Doc::Text(","), Doc::Line]);

        return Doc::Group([
            Doc::Text(open),
            Doc::Indent([edge, Doc.join(&items, &separator)]),
            edge,
            Doc::Text(close)
        ]);
    }

    fn call_doc(self, &str identifier, &ArgumentNode[] args): Doc {
        let items: Doc[] = [];

        for (let i = 0; i < args.size(); i += 1) {
            let argument = args[i].value;
            let item = self.expr(&argument.value.value);
            if (argument.passed_by matches PassedBy::Reference) {
                item = Doc::Concat([Doc::Text("&"), item]);
            }
            items.push(item);
        }

        return DocBuilder.list(identifier + "(", ")", &items, false);
    }

    fn precedence(&Expression expr): i64 {
        let prec = 8;

        match (expr) {
            Expression::Alternative {
                prec = 1;
            },
            Expression::Concatenation {
                prec = 2;
            },
            Expression::Equal {
                prec = 3;
            },
            Expression::NotEqual {
                prec = 3;
            },
            Expression::Less {
                prec = 3;
            },
            Expression::LessEqual {
                prec = 3;
            },
            Expression::Greater {
                prec = 3;
            },
            Expression::GreaterEqual {
                prec = 3;
            },
            Expression::Addition {
                prec = 4;
            },
            Expression::Subtraction {
                prec = 4;
            },
            Expression::Multiplication {
                prec = 5;
            },
            Expression::Division {
                prec = 5;
            },
            Expression::Modulo {
                prec = 5;
            },
            Expression::Casting {
                prec = 6;
            },
            Expression::BooleanNegation {
                prec = 7;
            },
            Expression::ArithmeticNegation {
                prec = 7;
            },
            rest {}
        }

        return prec;
    }

    fn parens(Doc doc): Doc {
        return Doc::Concat([Doc::Text("("), doc, Doc::Text(")")]);
    }

    fn expr_min_prec(self, &Expression expr, i64 min_prec): Doc {
        let doc = self.expr(&expr);
        if (DocBuilder.precedence(&expr) < min_prec) {
            return DocBuilder.parens(doc);
        }
        return doc;
    }

    fn operand(self, &Expression child, i64 parent_prec, bool is_right): Doc {
        let doc = self.expr(&child);
        let child_prec = DocBuilder.precedence(&child);

        let needs_parens = child_prec < parent_prec;
        if (child_prec == parent_prec) {
            if (is_right || parent_prec == 3) {
                needs_parens = true;
            }
        }

        if (needs_parens) {
            return DocBuilder.parens(doc);
        }
        return doc;
    }

    fn binary_doc(self, &Expression expr): Doc {
        let operands: Doc[] = [];
        let operators: str[] = [];
        self.collect_chain(&expr, &operands, &operators);

        let tail: Doc[] = [];
        for (let i = 0; i < operators.size(); i += 1) {
            tail.push(Doc::Line);
            tail.push(Doc::Text(operators[i] + " "));
            tail.push(operands[i + 1]);
        }

        return Doc::Group([operands[0], Doc::Indent(tail)]);
    }

    fn chain_step(
        self,
        &BinaryExpression op,
        str operator,
        i64 prec,
        &Doc[] operands,
        &str[] operators
    ): void {
        if (prec != 3 && DocBuilder.precedence(&op.left.value) == prec) {
            self.collect_chain(&op.left.value, &operands, &operators);
        } else {
            operands.push(self.operand(&op.left.value, prec, false));
        }

        operators.push(operator);
        operands.push(self.operand(&op.right.value, prec, true));
    }

    fn collect_chain(self, &Expression expr, &Doc[] operands, &str[] operators): void {
        match (expr) {
            Expression::Alternative(op) {
                self.chain_step(&op, "||", 1, &operands, &operators);
            },
            Expression::Concatenation(op) {
                self.chain_step(&op, "&&", 2, &operands, &operators);
            },
            Expression::Equal(op) {
                self.chain_step(&op, "==", 3, &operands, &operators);
            },
            Expression::NotEqual(op) {
                self.chain_step(&op, "!=", 3, &operands, &operators);
            },
            Expression::Less(op) {
                self.chain_step(&op, "<", 3, &operands, &operators);
            },
            Expression::LessEqual(op) {
                self.chain_step(&op, "<=", 3, &operands, &operators);
            },
            Expression::Greater(op) {
                self.chain_step(&op, ">", 3, &operands, &operators);
            },
            Expression::GreaterEqual(op) {
                self.chain_step(&op, ">=", 3, &operands, &operators);
            },
            Expression::Addition(op) {
                self.chain_step(&op, "+", 4, &operands, &operators);
            },
            Expression::Subtraction(op) {
                self.chain_step(&op, "-", 4, &operands, &operators);
            },
            Expression::Multiplication(op) {
                self.chain_step(&op, "*", 5, &operands, &operators);
            },
            Expression::Division(op) {
                self.chain_step(&op, "/", 5, &operands, &operators);
            },
            Expression::Modulo(op) {
                self.chain_step(&op, "%", 5, &operands, &operators);
            },
            rest {}
        }
    }

    fn f64_literal_text(f64 v): str {
        if (v < 0.0) {
            return "-" + DocBuilder.f64_literal_text(0.0 - v);
        }

        let whole = v as i64;
        let frac = v - whole as f64;

        # 15 digits + 1 extra for rounding (f64 ~15 decimal digits).
        let frac_digits = "";
        for (let i = 0; i < 16; i += 1) {
            frac = frac * 10.0;
            let d = frac as i64;
            if (d < 0) {
                d = 0;
            }
            if (d > 9) {
                d = 9;
            }
            frac_digits += d as str;
            frac = frac - d as f64;
        }

        # Round using the 16th digit, then keep at most 15.
        let digits = frac_digits;
        if (digits.size() == 16) {
            let round_up = digits[15] as u8 >= '5' as u8;
            digits = digits.substring(0, 15);

            if (round_up) {
                let carried = true;
                let out = "";
                for (let i = 14; i >= 0; i -= 1) {
                    let d = (digits[i] as u8 - '0' as u8) as i64;
                    if (carried) {
                        d += 1;
                        if (d == 10) {
                            d = 0;
                        } else {
                            carried = false;
                        }
                    }
                    out = d as str + out;
                }
                if (carried) {
                    whole += 1;
                    digits = "0";
                } else {
                    digits = out;
                }
            }
        }

        let last_nonzero = 0 as i64;
        for (let i = 0; i < digits.size(); i += 1) {
            if (digits[i] != '0') {
                last_nonzero = i + 1;
            }
        }

        if (last_nonzero == 0) {
            return whole as str + ".0";
        }

        return whole as str + "." + digits.substring(0, last_nonzero);
    }

    fn expr(self, &Expression expr): Doc {
        if (DocBuilder.precedence(&expr) <= 5) {
            return self.binary_doc(&expr);
        }

        let result = Doc::Text("");

        match (expr) {
            Expression::Variable(variable) {
                result = Doc::Text(variable);
            },
            Expression::Literal(literal) {
                match (literal) {
                    Literal::True {
                        result = Doc::Text("true");
                    },
                    Literal::False {
                        result = Doc::Text("false");
                    },
                    Literal::String(text) {
                        result = Doc::Text("\"" + DocBuilder.escape(&text) + "\"");
                    },
                    Literal::Char(ch) {
                        result = Doc::Text("'" + DocBuilder.escape_char(ch) + "'");
                    },
                    Literal::I64(num) {
                        result = Doc::Text(num as str);
                    },
                    Literal::F64(num) {
                        result = Doc::Text(DocBuilder.f64_literal_text(num));
                    }
                }
            },
            Expression::Casting(casting) {
                result = Doc::Concat([
                    self.expr_min_prec(&casting.value.value, 7),
                    Doc::Text(" as " + casting.to_type.value.to_string())
                ]);
            },
            Expression::FieldAccess(field_access) {
                result = Doc::Concat([
                    self.expr_min_prec(&field_access.instance.value, 8),
                    Doc::Text("." + field_access.field.value)
                ]);
            },
            Expression::Index(index_expr) {
                result = Doc::Concat([
                    self.expr_min_prec(&index_expr.collection.value, 8),
                    Doc::Text("["),
                    self.expr(&index_expr.index.value),
                    Doc::Text("]")
                ]);
            },
            Expression::FunctionCall(func_call) {
                result = self.call_doc(&func_call.identifier.value, &func_call.arguments);
            },
            Expression::MethodCall(method_call) {
                let items: Doc[] = [];
                for (let i = 0; i < method_call.arguments.size(); i += 1) {
                    let argument = method_call.arguments[i].value;
                    let item = self.expr(&argument.value.value);
                    if (argument.passed_by matches PassedBy::Reference) {
                        item = Doc::Concat([Doc::Text("&"), item]);
                    }
                    items.push(item);
                }
                result = Doc::Concat([
                    self.expr_min_prec(&method_call.instance.value, 8),
                    Doc::Text("."),
                    DocBuilder.list(method_call.field.value + "(", ")", &items, false)
                ]);
            },
            Expression::BooleanNegation(expr_node) {
                result = Doc::Concat([Doc::Text("!"), self.expr_min_prec(&expr_node.value, 8)]);
            },
            Expression::ArithmeticNegation(expr_node) {
                result = Doc::Concat([Doc::Text("-"), self.expr_min_prec(&expr_node.value, 8)]);
            },
            Expression::Vector(exprs) {
                let items: Doc[] = [];
                for (let i = 0; i < exprs.size(); i += 1) {
                    items.push(self.expr(&exprs[i].value));
                }
                result = DocBuilder.list("[", "]", &items, false);
            },
            Expression::EnumLiteral(enum_literal) {
                let name = enum_literal.enum_name.value + "::" + enum_literal.variant_name.value;
                if (enum_literal.variant_value matches OptionExpressionNode::Some(enum_expr)) {
                    result = Doc::Concat([
                        Doc::Text(name + "("),
                        self.expr(&enum_expr.value),
                        Doc::Text(")")
                    ]);
                } else {
                    result = Doc::Text(name);
                }
            },
            Expression::StructLiteral(struct_literal_node) {
                let struct_literal = struct_literal_node.value;
                let fields: Doc[] = [];
                for (let i = 0; i < struct_literal.fields.size(); i += 1) {
                    let field = struct_literal.fields[i].value;

                    # JS-style shorthand: `{ source }` instead of `{ source: source }`
                    # when the field value is a bare variable with the same name.
                    if (field.value.value matches Expression::Variable(var_name)) {
                        if (var_name == field.identifier.value) {
                            fields.push(Doc::Text(field.identifier.value));
                            continue;
                        }
                    }
                    fields.push(
                        Doc::Concat([
                            Doc::Text(field.identifier.value + ": "),
                            self.expr(&field.value.value)
                        ])
                    );
                }
                result = DocBuilder.list(
                    struct_literal.identifier.value + " {",
                    "}",
                    &fields,
                    true
                );
            },
            rest {}
        }

        return result;
    }

    fn escape_char(char ch): str {
        let byte = ch as u8;

        if (byte == 0 as u8) {
            return "\\0";
        } else if (byte == 10 as u8) {
            return "\\n";
        } else if (byte == 13 as u8) {
            return "\\r";
        } else if (byte == 9 as u8) {
            return "\\t";
        } else if (byte == 27 as u8) {
            return "\\e";
        } else if (byte == 92 as u8) {
            return "\\\\";
        } else if (byte == 39 as u8) {
            # Lexer currently rejects \', but emit it so the literal is at least visible.
            return "\\'";
        } else if (byte == 34 as u8) {
            return "\\\"";
        }

        return ch as str;
    }

    fn escape(&str text): str {
        let bytes: u8[] = [];

        for (let i = 0; i < text.size(); i += 1) {
            let byte = text[i] as u8;
            if (byte == 0 as u8) {
                bytes.push(92 as u8);
                bytes.push(48 as u8);
            } else if (byte == 10 as u8) {
                bytes.push(92 as u8);
                bytes.push(110 as u8);
            } else if (byte == 13 as u8) {
                bytes.push(92 as u8);
                bytes.push(114 as u8);
            } else if (byte == 9 as u8) {
                bytes.push(92 as u8);
                bytes.push(116 as u8);
            } else if (byte == 27 as u8) {
                bytes.push(92 as u8);
                bytes.push(101 as u8);
            } else if (byte == 92 as u8) {
                bytes.push(92 as u8);
                bytes.push(92 as u8);
            } else if (byte == 34 as u8) {
                bytes.push(92 as u8);
                bytes.push(34 as u8);
            } else {
                bytes.push(byte);
            }
        }

        let result = "";
        for (let i = 0; i < bytes.size(); i += 1) {
            result += bytes[i] as char;
        }

        return result;
    }
};
