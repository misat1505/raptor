import "../../selfhost/semantic-checker/semantic-helpers.rp";

struct FormatterOptions derives Debug {
    str ident,
    i64 max_line_size
};

struct Formatter derives Debug {
    Program program,
    str output,
    i64 indent_level,
    FormatterOptions options
};


fn formatter_format(&Formatter formatter): void {
    formatter_format_imports(&formatter);
    formatter_format_type_declarations(&formatter);
    formatter_format_function_declarations(&formatter);

    for (let i = 0; i < vector_size(&formatter.program.statements); i += 1) {
        let stmt = formatter.program.statements[i].value;
        formatter_format_statement(&formatter, &stmt);
        formatter.output += "\n";
    }

    formatter.output = str_trim_right(formatter.output);
    formatter.output += "\n";
}


fn formatter_format_type_declarations(&Formatter formatter): void {
    let declared_types_count = vector_size(&formatter.program.declared_types);
    for (let i = 0; i < declared_types_count; i += 1) {
        let type_decl = formatter.program.declared_types[i].value;
        match (type_decl) {
            DeclaredType::Struct(struct_decl) {
                formatter.output += "struct ";
                formatter.output += struct_decl.identifier.value;
                let derives_count = vector_size(&struct_decl.struct_derives);
                if (derives_count > 0) formatter.output += " derives ";
                for (let j = 0; j < derives_count; j += 1) {
                    if (j != 0) formatter.output += ", ";
                    formatter.output += struct_decl.struct_derives[j].value;
                }
                formatter.output += " {\n";
                formatter.indent_level += 1;
                let members_count = vector_size(&struct_decl.members);
                for (let j = 0; j < members_count; j += 1) {
                    let member = struct_decl.members[j].value;
                    formatter.output += formatter_get_identation(&formatter);
                    formatter.output += type_to_string(member.member_type.value);
                    formatter.output += " ";
                    formatter.output += member.identifier.value;
                    if (j + 1 != members_count) formatter.output += ",";
                    formatter.output += "\n";
                }
                formatter.indent_level -= 1;
                formatter.output += "};\n\n";
            },
            DeclaredType::Enum(enum_decl) {
                formatter.output += "enum ";
                formatter.output += enum_decl.identifier.value;
                let derives_count = vector_size(&enum_decl.enum_derives);
                if (derives_count > 0) formatter.output += " derives ";
                for (let j = 0; j < derives_count; j += 1) {
                    if (j != 0) formatter.output += ", ";
                    formatter.output += enum_decl.enum_derives[j].value;
                }
                formatter.output += " {\n";
                formatter.indent_level += 1;
                let members_count = vector_size(&enum_decl.members);
                for (let j = 0; j < members_count; j += 1) {
                    let member = enum_decl.members[j].value;
                    formatter.output += formatter_get_identation(&formatter);
                    formatter.output += member.identifier.value;
                    if (member.member_type matches OptionTypeNode::Some(t)) {
                        formatter.output += "(";
                        formatter.output += type_to_string(t.value);
                        formatter.output += ")";
                    }
                    if (j + 1 != members_count) formatter.output += ",";
                    formatter.output += "\n";
                }
                formatter.indent_level -= 1;
                formatter.output += "};\n\n";
            }
        }

        if (i + 1 == declared_types_count) formatter.output += "\n";
    }
}


fn formatter_format_imports(&Formatter formatter): void {
    let has_any_imports = false;
    for (let i = 0; i < vector_size(&formatter.program.statements); i += 1) {
        let stmt = formatter.program.statements[i].value;
        if (stmt matches Statement::Import(path)) {
            formatter.output += "import \"";
            formatter.output += path.value;
            formatter.output += "\";";
            formatter.output += "\n";
            has_any_imports = true;
        }
    }

    if (has_any_imports) {
        formatter.output += "\n\n";
    }
}


fn formatter_get_identation(&Formatter formatter): str {
    let result = "";

    for (let i = 0; i < formatter.indent_level; i += 1) {
        result += formatter.options.ident;
    }

    return result;
}

fn formatter_format_str_with_escaping(&str text): str {
    let bytes: u8[] = [];

    for (let i = 0; i < str_len(text); i += 1) {
        let byte = text[i] as u8;
        if (byte == 10 as u8) {
            vector_push(&bytes, 92 as u8);
            vector_push(&bytes, 110 as u8);
        } else if (byte == 92 as u8) {
            vector_push(&bytes, 92 as u8);
            vector_push(&bytes, 92 as u8);
        } else if (byte == 34 as u8) {
            vector_push(&bytes, 92 as u8);
            vector_push(&bytes, 34 as u8);
        } else {
            vector_push(&bytes, text[i] as u8);
        }
    }

    let result = "";
    for (let i = 0; i < vector_size(&bytes); i += 1) {
        result += bytes[i] as char;
    }

    return result;
}

fn formatter_format_expression(&Formatter formatter, &Expression expr): void {
    match (expr) {
        Expression::Variable(variable) {
            formatter.output += variable;
        },
        Expression::Literal(literal) {
            match (literal) {
                Literal::True formatter.output += "true";,
                Literal::False formatter.output += "false";,
                Literal::String(text) formatter.output += "\"" + formatter_format_str_with_escaping(&text) + "\"";,
                Literal::Char(ch) {
                    let text = ch as str;
                    formatter.output += "'" + formatter_format_str_with_escaping(&text) + "'";
                },
                Literal::I64(num) formatter.output += num as str;,
                Literal::F64(num) formatter.output += num as str;
            }
        },
        Expression::Casting(casting) {
            formatter_format_expression(&formatter, &casting.value.value);
            formatter.output += " as ";
            formatter.output += type_to_string(casting.to_type.value);
        },
        Expression::FieldAccess(field_access) {
            formatter_format_expression(&formatter, &field_access.instance.value);
            formatter.output += "." + field_access.field.value;
        },
        Expression::Index(index_expr) {
            formatter_format_expression(&formatter, &index_expr.collection.value);
            formatter.output += "[";
            formatter_format_expression(&formatter, &index_expr.index.value);
            formatter.output += "]";
        },
        Expression::FunctionCall(func_call) {
            formatter_format_function_call_without_semi(&formatter, &func_call.identifier.value, &func_call.arguments);
        },
        Expression::Alternative(binary_op) {
            formatter_format_expression(&formatter, &binary_op.left.value);
            formatter.output += " || ";
            formatter_format_expression(&formatter, &binary_op.right.value);
        },
        Expression::Concatenation(binary_op) {
            formatter_format_expression(&formatter, &binary_op.left.value);
            formatter.output += " && ";
            formatter_format_expression(&formatter, &binary_op.right.value);
        },
        Expression::Less(binary_op) {
            formatter_format_expression(&formatter, &binary_op.left.value);
            formatter.output += " < ";
            formatter_format_expression(&formatter, &binary_op.right.value);
        },
        Expression::LessEqual(binary_op) {
            formatter_format_expression(&formatter, &binary_op.left.value);
            formatter.output += " <= ";
            formatter_format_expression(&formatter, &binary_op.right.value);
        },
        Expression::Greater(binary_op) {
            formatter_format_expression(&formatter, &binary_op.left.value);
            formatter.output += " > ";
            formatter_format_expression(&formatter, &binary_op.right.value);
        },
        Expression::GreaterEqual(binary_op) {
            formatter_format_expression(&formatter, &binary_op.left.value);
            formatter.output += " >= ";
            formatter_format_expression(&formatter, &binary_op.right.value);
        },
        Expression::Equal(binary_op) {
            formatter_format_expression(&formatter, &binary_op.left.value);
            formatter.output += " == ";
            formatter_format_expression(&formatter, &binary_op.right.value);
        },
        Expression::NotEqual(binary_op) {
            formatter_format_expression(&formatter, &binary_op.left.value);
            formatter.output += " != ";
            formatter_format_expression(&formatter, &binary_op.right.value);
        },
        Expression::Addition(binary_op) {
            formatter_format_expression(&formatter, &binary_op.left.value);
            formatter.output += " + ";
            formatter_format_expression(&formatter, &binary_op.right.value);
        },
        Expression::Subtraction(binary_op) {
            formatter_format_expression(&formatter, &binary_op.left.value);
            formatter.output += " - ";
            formatter_format_expression(&formatter, &binary_op.right.value);
        },
        Expression::Multiplication(binary_op) {
            formatter_format_expression(&formatter, &binary_op.left.value);
            formatter.output += " * ";
            formatter_format_expression(&formatter, &binary_op.right.value);
        },
        Expression::Division(binary_op) {
            formatter_format_expression(&formatter, &binary_op.left.value);
            formatter.output += " / ";
            formatter_format_expression(&formatter, &binary_op.right.value);
        },
        Expression::Modulo(binary_op) {
            formatter_format_expression(&formatter, &binary_op.left.value);
            formatter.output += " % ";
            formatter_format_expression(&formatter, &binary_op.right.value);
        },
        Expression::BooleanNegation(expr_node) {
            formatter.output += "!";
            formatter_format_expression(&formatter, &expr_node.value);
        },
        Expression::ArithmeticNegation(expr_node) {
            formatter.output += "-";
            formatter_format_expression(&formatter, &expr_node.value);
        },
        Expression::Vector(exprs) {
            formatter.output += "[";
            for (let i = 0; i < vector_size(&exprs); i += 1) {
                if (i != 0) formatter.output += ", ";
                formatter_format_expression(&formatter, &exprs[i].value);
            }
            formatter.output += "]";
        },
        Expression::EnumLiteral(enum_literal) {
            formatter.output += enum_literal.enum_name.value;
            formatter.output += "::";
            formatter.output += enum_literal.variant_name.value;
            if (enum_literal.variant_value matches OptionExpressionNode::Some(enum_expr)) {
                formatter.output += "(";
                formatter_format_expression(&formatter, &enum_expr.value);
                formatter.output += ")";
            }
        },
        Expression::StructLiteral(struct_literal_node) {
            let struct_literal = struct_literal_node.value;
            formatter.output += struct_literal.identifier.value;
            formatter.output += " { ";
            for (let i = 0; i < vector_size(&struct_literal.fields); i += 1) {
                if (i != 0) formatter.output += ", ";
                let field = struct_literal.fields[i].value;
                formatter.output += field.identifier.value;
                formatter.output += ": ";
                formatter_format_expression(&formatter, &field.value.value);
            }
            formatter.output += " }";
        }
    }
}


fn formatter_format_decl_without_semi(&Formatter formatter, &Statement stmt): void {
    if (stmt matches Statement::Declaration(declaration)) {
        let var_name = declaration.identifier.value;
        match (declaration.kind) {
            VariableDeclarationKind::LET(let_decl) {
                formatter.output += "let " + var_name;
                if (let_decl.var_type matches OptionTypeNode::Some(type_node)) {
                    formatter.output += ": " + type_to_string(type_node.value);
                }
                formatter.output += " = ";
                formatter_format_expression(&formatter, &let_decl.value.value);
            },
            VariableDeclarationKind::TYPE(type_decl) {
                formatter.output += type_to_string(type_decl.var_type.value) + " " + var_name;
                if (type_decl.value matches OptionExpressionNode::Some(expr_node)) {
                    formatter.output += " = ";
                    formatter_format_expression(&formatter, &expr_node.value);
                }
            }
        }
    }
}


fn formatter_format_function_call_without_semi(&Formatter formatter, &str identifier, &ArgumentNode[] args): void {
    formatter.output += identifier;
    formatter.output += "(";

    for (let i = 0; i < vector_size(&args); i += 1) {
        if (i != 0) formatter.output += ", ";

        let argument = args[i].value;
        if (argument.passed_by matches PassedBy::Reference) {
            formatter.output += "&";
        }
        formatter_format_expression(&formatter, &argument.value.value);
    }

    formatter.output += ")";
}


fn formatter_format_assignment_without_semi(&Formatter formatter, &AssignmentStatement stmt): void {
    formatter.output += stmt.identifier.value;

    for (let i = 0; i < vector_size(&stmt.accessors); i += 1) {
        let accessor = stmt.accessors[i].value;
        match (accessor) {
            Accessor::Index(index) {
                formatter.output += "[";
                formatter_format_expression(&formatter, &index.value);
                formatter.output += "]";
            },
            Accessor::Field(ident) {
                formatter.output += "." + ident.value;
            }
        }
    }

    formatter.output += " = ";
    formatter_format_expression(&formatter, &stmt.value.value);
}


fn formatter_format_statement(&Formatter formatter, &Statement stmt): void {
    formatter.output += formatter_get_identation(&formatter);

    match (stmt) {
        Statement::FunctionCall(func_call) {
            formatter_format_function_call_without_semi(&formatter, &func_call.identifier.value, &func_call.arguments);
            formatter.output += ";";
        },
        Statement::Declaration {
            formatter_format_decl_without_semi(&formatter, &stmt);
            formatter.output += ";";
        },
        Statement::ForLoop(for_loop_stmt) {
            formatter.output += "for (";
            if (for_loop_stmt.declaration matches OptionStatementNode::Some(stmt_node)) {
                formatter_format_decl_without_semi(&formatter, &stmt_node.value);
            }
            formatter.output += "; ";
            formatter_format_expression(&formatter, &for_loop_stmt.condition.value);
            formatter.output += "; ";
            if (for_loop_stmt.assignment matches OptionStatementNode::Some(stmt_node)) {
                if (stmt_node.value matches Statement::Assignment(assignment_stmt)) {
                    formatter_format_assignment_without_semi(&formatter, &assignment_stmt);
                }
            }
            formatter.output += ") ";
            formatter_format_statement_block(&formatter, &for_loop_stmt.block.value);
        },
        Statement::Conditional(if_stmt) {
            formatter.output += "if (";
            formatter_format_expression(&formatter, &if_stmt.condition.value);
            formatter.output += ") ";
            formatter_format_statement_block(&formatter, &if_stmt.if_block.value);
            if (if_stmt.else_block matches OptionBlockNode::Some(else_block)) {
                formatter.output += " else ";
                formatter_format_statement_block(&formatter, &else_block.value);
            }
        },
        Statement::Assignment(assignment_stmt) {
            formatter_format_assignment_without_semi(&formatter, &assignment_stmt);
            formatter.output += ";";
        },
        Statement::Return(return_expr) {
            formatter.output += "return";
            if (return_expr matches OptionExpressionNode::Some(expr_node)) {
                formatter.output += " ";
                formatter_format_expression(&formatter, &expr_node.value);
            }
            formatter.output += ";";
        },
        Statement::WhileLoop(while_loop) {
            formatter.output += "while (";
            formatter_format_expression(&formatter, &while_loop.condition.value);
            formatter.output += ") ";
            formatter_format_statement_block(&formatter, &while_loop.block.value);
        },
        Statement::Match(match_stmt) {
            formatter.output += "match (";
            formatter_format_expression(&formatter, &match_stmt.expression.value);
            formatter.output += ") {\n";
            formatter.indent_level += 1;

            let arms_count = vector_size(&match_stmt.match_arms);
            for (let i = 0; i < arms_count; i += 1) {
                let arm = match_stmt.match_arms[i].value;
                formatter.output += formatter_get_identation(&formatter);
                formatter.output += arm.enum_name.value;
                formatter.output += "::";
                formatter.output += arm.variant_name.value;
                if (arm.variant_value matches OptionIdentifierNode::Some(ident)) {
                    formatter.output += "(" + ident.value + ")";
                }
                formatter.output += " ";
                formatter_format_statement_block(&formatter, &arm.block.value);
                if (i + 1 != arms_count) {
                    formatter.output += ",";
                } else if (match_stmt.rest_arm matches OptionBlockNode::Some) {
                    formatter.output += ",";
                }
                formatter.output += "\n";
            }

            if (match_stmt.rest_arm matches OptionBlockNode::Some(rest_block)) {
                formatter.output += formatter_get_identation(&formatter);
                formatter.output += "rest ";
                formatter_format_statement_block(&formatter, &rest_block.value);
                formatter.output += "\n";
            }
            formatter.indent_level -= 1;
            formatter.output += formatter_get_identation(&formatter);
            formatter.output += "}";
        },
        Statement::Break {
            formatter.output += "break;";
        },
        Statement::Continue {
            formatter.output += "continue;";
        },
        Statement::Import {},
        Statement::Switch(switch_stmt) {
            formatter.output += "switch (";
            for (let i = 0; i < vector_size(&switch_stmt.expressions); i += 1) {
                if (i != 0) formatter.output += ", ";
                let switch_expr = switch_stmt.expressions[i].value;
                formatter_format_expression(&formatter, &switch_expr.expression.value);
                if (switch_expr.alias matches OptionIdentifierNode::Some(ident)) {
                    formatter.output += ": " + ident.value;
                }
            }
            formatter.output += ") {\n";
            formatter.indent_level += 1;
            for (let i = 0; i < vector_size(&switch_stmt.cases); i += 1) {
                let case = switch_stmt.cases[i].value;
                formatter.output += formatter_get_identation(&formatter);
                formatter.output += "(";
                formatter_format_expression(&formatter, &case.condition.value);
                formatter.output += ") -> ";
                formatter_format_statement_block(&formatter, &case.block.value);
                formatter.output += "\n";
            }
            formatter.indent_level -= 1;
            formatter.output += "}";
        }
    }
}


fn formatter_format_statement_block(&Formatter formatter, &Block block): void {
    if (vector_size(&block.statements) == 0) {
        formatter.output += "{}";
        return;
    }

    formatter.indent_level += 1;
    formatter.output += "{\n";

    for (let i = 0; i < vector_size(&block.statements); i += 1) {
        formatter_format_statement(&formatter, &block.statements[i].value);
        formatter.output += "\n";
    }

    formatter.indent_level -= 1;
    formatter.output += formatter_get_identation(&formatter);
    formatter.output += "}";
}


fn formatter_format_function_declarations(&Formatter formatter): void {
    for (let i = 0; i < vector_size(&formatter.program.functions); i += 1) {
        let function = formatter.program.functions[i].value;
        let function_decl = "fn " + function.identifier.value + "(";

        for (let j = 0; j < vector_size(&function.parameters); j += 1) {
            if (j != 0) function_decl += ", ";

            let parameter = function.parameters[j].value;
            let parameter_decl = "";
            if (parameter.passed_by matches PassedBy::Reference) {
                parameter_decl += "&";
            }
            parameter_decl += type_to_string(parameter.parameter_type.value);
            parameter_decl += " ";
            parameter_decl += parameter.identifier.value;

            function_decl += parameter_decl;
        }

        function_decl += "): ";
        function_decl += type_to_string(function.return_type.value);
        function_decl += " ";
        formatter.output += function_decl;
        formatter_format_statement_block(&formatter, &function.block.value);
        formatter.output += "\n\n";
    }
}
