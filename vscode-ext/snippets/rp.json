{
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params}): ${3:type} {",
      "\t$0",
      "}"
    ],
    "description": "Create Raptor function"
  },
  "Extern function": {
    "prefix": "extern",
    "body": [
      "extern fn ${1:name}(${2:params}): ${3:type};"
    ],
    "description": "Create Raptor extern function"
  },
  "If statement": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "\t$0",
      "}"
    ],
    "description": "Create Raptor if statement"
  },
  "For loop": {
    "prefix": "for",
    "body": [
      "for (i64 ${1:i} = 0; ${1:i} < ${2:end}; ${1:i} = ${1:i} + 1) {",
      "\t$0",
      "}"
    ],
    "description": "Create Raptor for loop"
  },
  "While loop": {
    "prefix": "while",
    "body": [
      "while (${1:expr}) {",
      "\t$0",
      "}"
    ],
    "description": "Create Raptor while loop"
  },
  "Vector": {
    "prefix": "vec",
    "body": [
      "${1:i64}[] ${2:name} = [$0];"
    ],
    "description": "Create Raptor vector"
  },
  "Print": {
    "prefix": "print",
    "body": [
      "println(${1:value});"
    ],
    "description": "Print value"
  }
}