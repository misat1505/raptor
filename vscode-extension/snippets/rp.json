{
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params}): ${3:type} {",
      "\t$0",
      "}"
    ],
    "description": "Create RP function"
  },
  "If statement": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "\t$0",
      "}"
    ],
    "description": "Create RP if statement"
  },
  "For loop": {
    "prefix": "for",
    "body": [
      "for (i64 ${1:i} = 0; ${1:i} < ${2:end}; ${1:i} = ${1:i} + 1) {",
      "\t$0",
      "}"
    ],
    "description": "Create RP for loop"
  },
  "Vector": {
    "prefix": "vec",
    "body": [
      "${1:i64}[] ${2:name} = [$0];"
    ],
    "description": "Create RP vector"
  },
  "Print": {
    "prefix": "print",
    "body": [
      "println(${1:value});"
    ],
    "description": "Print value"
  }
}